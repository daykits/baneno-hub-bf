        SmoothnessLabel.Parent = SmoothnessContainer
        
        local SmoothnessBox = Instance.new("TextBox")
        SmoothnessBox.Size = UDim2.new(0.6, -10, 0, 30)
        SmoothnessBox.Position = UDim2.new(0.4, 0, 0.5, -15)
        SmoothnessBox.Text = tostring(MoonConfig.Smoothness)
        SmoothnessBox.Font = Enum.Font.Gotham
        SmoothnessBox.TextSize = 16
        SmoothnessBox.TextColor3 = Color3.new(1, 1, 1)
        SmoothnessBox.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
        SmoothnessBox.Parent = SmoothnessContainer
        
        SmoothnessBox.FocusLost:Connect(function()
            local newSmoothness = tonumber(SmoothnessBox.Text)
            if newSmoothness then
                MoonConfig.Smoothness = math.clamp(newSmoothness, 0.1, 1.0)
                SmoothnessBox.Text = string.format("%.1f", MoonConfig.Smoothness)
            end
        end)
        
        -- UI effects
        MainFrame.Visible = false
        task.wait()
        MainFrame.Visible = true
        MainFrame.Position = UDim2.new(0.5, -175, 0, -600)
        TweenService:Create(
            MainFrame,
            TweenInfo.new(0.7, Enum.EasingStyle.Quint),
            {Position = UDim2.new(0.5, -175, 0.5, -250)}
        ):Play()
        
        -- Make the UI draggable
        local Dragging, DragInput, DragStart, StartPos
        
        TitleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then
                Dragging = true
                DragStart = input.Position
                StartPos = MainFrame.Position
                
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        Dragging = false
                    end
                end)
            end
        end)
        
        TitleBar.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement then
                DragInput = input
            end
        end)
        
        UserInputService.InputChanged:Connect(function(input)
            if input == DragInput and Dragging then
                local Delta = input.Position - DragStart
                MainFrame.Position = UDim2.new(
                    StartPos.X.Scale,
                    StartPos.X.Offset + Delta.X,
                    StartPos.Y.Scale,
                    StartPos.Y.Offset + Delta.Y
                )
            end
        end)
        
        return ScreenGui
    end

    -- Create UI
    ui = CreateMoonUI()
    
    -- Setup hotkeys
    connections.uiToggle = UserInputService.InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode[MoonConfig.UIKey] then
            if ui then
                ui.Enabled = not ui.Enabled
            end
        end
    end)
    
    -- Memory cleanup on reload
    connections.unloading = game:GetService("CoreGui").DescendantRemoving:Connect(function(descendant)
        if descendant.Name == "MoonKillerUI" then
            for _, conn in pairs(connections) do
                if conn then
                    conn:Disconnect()
                end
            end
            if Circle then
                Circle:Remove()
            end
            for player, esp in pairs(EspObjects) do
                for _, drawing in pairs(esp) do
                    if typeof(drawing) == "table" and drawing.Remove then
                        pcall(drawing.Remove, drawing)
                    end
                end
            end
            getgenv().MoonKillerLoaded = false
        end
    end)
end

-- Start safe loading
if not getgenv().MoonKillerLoaded then
    getgenv().MoonKillerLoaded = true
    local success, err = pcall(SafeLoad)
    if not success then
        warn(string.format(t("failed"), err))
        getgenv().MoonKillerLoaded = false
    else
        print(t("loaded"))
        print(string.format(t("press_key"), MoonConfig.UIKey))
        print(t("features"))
    end
else
    warn(t("already_loaded"))
end
