--// HELPERS
local function GetTargetPart(character)
	if not character then return nil end
	local part = character:FindFirstChild(AimbotTargetPart)
	if part then return part end
	-- Fallback nếu part không tồn tại
	return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
end

local function IsVisible(targetPart)
	if not AimbotWallCheck then return true end
	if not targetPart then return false end
	if not Camera then return false end

	local origin = Camera.CFrame.Position
	local targetPos = targetPart.Position
	local direction = targetPos - origin

	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {
		LocalPlayer.Character,
		targetPart.Parent,
		CurrentTargetPart and CurrentTargetPart.Parent or nil
	}
	rayParams.IgnoreWater = true

	local result = Workspace:Raycast(origin, direction, rayParams)
	if result then
		return false
	end
	return true
end

local function IsKnocked(character)
	-- Phát hiện địch đã gục (chỉ áp dụng cho 1 số game)
	if not character then return false end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	if humanoid.Health <= 0 then return true end
	-- Check "Knocked"/"Downed" state qua attribute nếu game có
	if character:GetAttribute("Knocked") == true then return true end
	if character:GetAttribute("Downed") == true then return true end
	-- Một số game đổi tên part "Head" thành "KnockedHead"
	if character:FindFirstChild("KnockedHead") then return true end
	return false
end

local function PredictPosition(targetPart, player)
	if not AimbotPrediction then return targetPart.Position end
	local character = player.Character
	if not character then return targetPart.Position end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then return targetPart.Position end
	local velocity = hrp.AssemblyLinearVelocity
	local predicted = targetPart.Position + velocity * AimbotPredictionAmount
	-- Không dự đoán quá xa
	local dist = (predicted - targetPart.Position).Magnitude
	if dist > 50 then
		return targetPart.Position + velocity.Unit * 50
	end
	return predicted
end

local function GetClosestTarget()
	if not Camera then return nil, nil end

	local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
	local closestScore = math.huge
	local bestPlayer = nil
	local bestPart = nil

	local myChar = LocalPlayer.Character
	local myPos = myChar and myChar:FindFirstChild("HumanoidRootPart") and myChar.HumanoidRootPart.Position or Camera.CFrame.Position

	for _, player in ipairs(Players:GetPlayers()) do
		if player == LocalPlayer then continue end

		-- Team check
		if AimbotTeamCheck and player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
			continue
		end

		local character = player.Character
		if not character then continue end

		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then continue end

		if AimbotIgnoreKnocked and IsKnocked(character) then continue end

		local targetPart = GetTargetPart(character)
		if not targetPart then continue end

		-- Distance check
		local dist3D = (targetPart.Position - myPos).Magnitude
		if dist3D > AimbotMaxDistance then continue end

		-- Screen position check
		local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
		if not onScreen then continue end

		local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
		local dist2D = (viewportCenter - screenPos2D).Magnitude

		if dist2D > AimbotFOV then continue end

		-- Wall check
		if not IsVisible(targetPart) then continue end

		-- Score: kết hợp khoảng cách màn hình (chính) + khoảng cách 3D (phụ)
		local score = dist2D + dist3D * 0.05

		if score < closestScore then
			closestScore = score
			bestPlayer = player
			bestPart = targetPart
		end
	end

	return bestPlayer, bestPart
end

--// CHECK HOLD KEY
local function IsAimKeyHeld()
	if not AimbotHoldKey then return true end
	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then return true end
	if UserInputService:IsKeyDown(Enum.KeyCode.E) then return true end
	return false
end

--// AIMBOT LOOP (dùng RenderStepped để mượt)
RunService.RenderStepped:Connect(function(dt)
	if not AimbotEnabled then
		CurrentTarget = nil
		CurrentTargetPart = nil
		TargetLine.Visible = false
		return
	end

	if not Camera then return end

	-- Hold key
	if not IsAimKeyHeld() then
		TargetLine.Visible = false
		return
	end

	local now = tick()

	-- Sticky target: giữ target cũ trong 0.5s nếu vẫn còn valid
	if CurrentTarget and CurrentTargetPart and (now - LastTargetTime) < StickyTargetDuration then
		local char = CurrentTarget.Character
		if char and CurrentTargetPart.Parent == char then
			local hum = char:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				-- Vẫn giữ target cũ, không cần tìm mới
				-- (nhưng vẫn cần check FOV, nếu ra ngoài FOV thì bỏ)
				local sp, onScreen = Camera:WorldToViewportPoint(CurrentTargetPart.Position)
				if onScreen then
					local dist2D = (Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2) - Vector2.new(sp.X, sp.Y)).Magnitude
					if dist2D <= AimbotFOV * 1.5 then
						-- Vẫn aim target cũ
						goto aim
					end
				end
			end
		end
		-- Nếu target cũ invalid -> reset
		CurrentTarget = nil
		CurrentTargetPart = nil
	end

	-- Tìm target mới
	local newTarget, newPart = GetClosestTarget()
	if newTarget and newPart then
		CurrentTarget = newTarget
		CurrentTargetPart = newPart
		LastTargetTime = now
	end

	::aim::

	if CurrentTargetPart and CurrentTargetPart.Parent then
		local aimPos = PredictPosition(CurrentTargetPart, CurrentTarget)

		-- Cập nhật đường chỉ
		local sp, onScreen = Camera:WorldToViewportPoint(CurrentTargetPart.Position)
		if onScreen then
			local vp = Camera.ViewportSize
			local center = Vector2.new(vp.X / 2, vp.Y / 2)
			local targetScreen = Vector2.new(sp.X, sp.Y)
			local diff = targetScreen - center
			local length = diff.Magnitude
			local angle = math.deg(math.atan2(diff.Y, diff.X)) - 90

			TargetLine.Size = UDim2.new(0, 1.5, 0, length)
			TargetLine.Position = UDim2.new(0, center.X, 0, center.Y)
			TargetLine.Rotation = angle
			TargetLine.Visible = true
		else
			TargetLine.Visible = false
		end

		-- Camera aim
		local currentCF = Camera.CFrame
		local newCF = CFrame.new(currentCF.Position, aimPos)

		if AimbotSmoothness >= 1 then
			Camera.CFrame = newCF
		else
			-- Smoothness chuẩn theo delta time
			-- smoothFactor: 0.05 = rất chậm, 1 = tức thời
			local alpha = math.clamp(AimbotSmoothness * (dt * 60), 0, 1)
			Camera.CFrame = currentCF:Lerp(newCF, alpha)
		end
	end
end)

--// DRAGGING
local dragging = false
local dragStart
local startPos

TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

TopBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		local dragInput = input
		dragInput.Changed:Connect(function()
			if dragging then
				local delta = dragInput.Position - dragStart
				MainFrame.Position = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
			end
		end)
	end
end)

