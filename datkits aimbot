local function SafeLoad()
    -- ===== [Core Aimbot System] =====
    -- Core services
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer
    local Camera = Workspace.CurrentCamera

    -- Drawing library
    local DrawingLib = Drawing.new
    local EspObjects = {}
    local Circle = DrawingLib("Circle")
    local connections = {}
    local autoShooting = false
    local lastDamageCheck = 0
    local ui -- Define the UI variable here

    -- Circle setup
    Circle.Visible = MoonConfig.ShowFOV
    Circle.Thickness = 1
    Circle.Color = Color3.fromRGB(255, 255, 255)
    Circle.Transparency = 1
    Circle.Radius = MoonConfig.FOV
    Circle.Filled = false
    Circle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

    -- === [Auto Heal Feature] ===
    local function AutoHeal()
        if not MoonConfig.AutoHealth then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health < 100 then
            humanoid.Health = 100
        end
    end

    -- Run auto heal
    connections.autoHeal = RunService.Heartbeat:Connect(function()
        AutoHeal()
    end)

    -- === [One Shot Kill Feature] ===
    local function ApplyOneShotKill()
        if not MoonConfig.OneShotKill then return end
        
        for _, weapon in ipairs(workspace:GetDescendants()) do
            if weapon:IsA("Tool") and weapon:FindFirstChild("Damage") then
                weapon.Damage.Value = 100
            end
        end
        
        local character = LocalPlayer.Character
        if character then
            for _, tool in ipairs(character:GetChildren()) do
                if tool:IsA("Tool") and tool:FindFirstChild("Damage") then
                    tool.Damage.Value = 100
                end
            end
        end
    end

    -- Circle update function
    local function UpdateCircle()
        if not Circle then return end
        Circle.Visible = MoonConfig.ShowFOV
        Circle.Radius = MoonConfig.FOV
        Circle.Position = UserInputService:GetMouseLocation()
    end

    -- Character validation
    local function IsValidCharacter(player)
        if not player or not player.Character then return false end
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
        return humanoid and humanoid.Health > 0 and rootPart
    end

    -- ESP creation function
    local function CreateEsp(player)
        if player == LocalPlayer or EspObjects[player] then return end
        
        local Esp = {
            Box = DrawingLib("Square"),
            Name = DrawingLib("Text"),
            Health = DrawingLib("Text"),
            HealthBar = DrawingLib("Line"),
            TeamColor = player.TeamColor.Color,
            Connection = nil
        }
        
        Esp.Box.Visible = false
        Esp.Box.Color = MoonConfig.BoxColor
        Esp.Box.Thickness = MoonConfig.BoxThickness
        Esp.Box.Filled = false
        
        Esp.Name.Visible = false
        Esp.Name.Color = Color3.new(1, 1, 1)
        Esp.Name.Size = 13
        Esp.Name.Center = true
        Esp.Name.Outline = true
        
        Esp.Health.Visible = false
        Esp.Health.Size = 13
        Esp.Health.Outline = true
        
        Esp.HealthBar.Visible = false
        Esp.HealthBar.Thickness = 2
        
        EspObjects[player] = Esp
        
        -- Add a connection to update ESP when team changes
        Esp.Connection = player:GetPropertyChangedSignal("Team"):Connect(function()
            Esp.TeamColor = player.TeamColor.Color
        end)
    end

    -- ESP update function
    local function UpdateEsp()
        for player, esp in pairs(EspObjects) do
            if IsValidCharacter(player) then
                local character = player.Character
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                
                local position, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                
                if onScreen then
                    local size = Vector2.new(1800 / position.Z, 2500 / position.Z)
                    local pos = Vector2.new(position.X - size.X / 2, position.Y - size.Y / 2)
                    
                    -- Update box
                    esp.Box.Size = size -- Fixed here (was BBox)
                    esp.Box.Position = pos -- Fixed here (was BBox)
                    esp.Box.Visible = MoonConfig.ESP
                    esp.Box.Color = MoonConfig.TeamCheck and player.Team == LocalPlayer.Team and Color3.fromRGB(0, 100, 255) or MoonConfig.BoxColor
                    
                    -- Update name
                    esp.Name.Text = player.Name
                    esp.Name.Position = Vector2.new(pos.X + size.X / 2, pos.Y - 16)
                    esp.Name.Visible = MoonConfig.ESP
                    
                    -- Update health
                    local health = humanoid.Health
                    local maxHealth = humanoid.MaxHealth
                    esp.Health.Text = "HP: " .. math.floor(health)
                    esp.Health.Position = Vector2.new(pos.X + size.X / 2, pos.Y + size.Y + 2)
                    esp.Health.Visible = MoonConfig.ESP
                    esp.Health.Color = Color3.fromRGB(255 - (255 * (health/maxHealth)), 255 * (health/maxHealth), 0)
                    
                    -- Health bar
                    local barPos = Vector2.new(pos.X - 3, pos.Y + size.Y * (1 - health/maxHealth))
                    esp.HealthBar.From = barPos
                    esp.HealthBar.To = Vector2.new(barPos.X, barPos.Y + size.Y * (health/maxHealth))
                    esp.HealthBar.Visible = MoonConfig.ESP
                    esp.HealthBar.Color = esp.Health.Color
                else
                    esp.Box.Visible = false
                    esp.Name.Visible = false
                    esp.Health.Visible = false
                    esp.HealthBar.Visible = false
                end
            else
                esp.Box.Visible = false
                esp.Name.Visible = false
                esp.Health.Visible = false
                esp.HealthBar.Visible = false
            end
        end
    end

    -- Wall check function (optimized)
    local function IsVisible(part)
        if not MoonConfig.WallCheck then return true end
        
        local origin = Camera.CFrame.Position
        local target = part.Position
        local direction = (target - origin) -- Fixed here (was a calculation error)
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
        
        local raycastResult = Workspace:Raycast(origin, direction, raycastParams)
        
        -- If there is no obstacle, or if the obstacle is part of the target's character
        return not raycastResult or raycastResult.Instance:IsDescendantOf(part.Parent)
    end

    -- Aimbot function (optimized)
    local function AimAtClosest()
        if not MoonConfig.Aimbot then return nil end
        
        local closestTarget = nil
        local shortestDistance = math.huge
        
        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if not IsValidCharacter(player) then continue end
            if MoonConfig.TeamCheck and player.Team == LocalPlayer.Team then continue end
            
            local character = player.Character
            local aimPart = character:FindFirstChild(MoonConfig.AimPart) or character:FindFirstChild("HumanoidRootPart")
            if not aimPart then continue end
            
            local position, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
            if not onScreen then continue end
            if MoonConfig.VisibleOnly and not IsVisible(aimPart) then continue end
            
            local mousePos = UserInputService:GetMouseLocation()
            local distance = (Vector2.new(position.X, position.Y) - mousePos).Magnitude
            
            if distance < MoonConfig.FOV and distance < shortestDistance then
                shortestDistance = distance
                closestTarget = aimPart
            end
        end
        
        return closestTarget
    end

    -- Main update loop (optimized)
    local function MainLoop()
        UpdateCircle()
        
        if MoonConfig.ESP then
            UpdateEsp()
        end
        
        -- Apply one shot kill every 5 seconds
        if MoonConfig.OneShotKill and os.clock() - lastDamageCheck > 5 then
            ApplyOneShotKill()
            lastDamageCheck = os.clock()
        end
        
        -- Check aim key state
        local aimKeyPressed = UserInputService:IsMouseButtonPressed(Enum.UserInputType[MoonConfig.AimKey])
        
        if aimKeyPressed then
            local target = AimAtClosest()
            
            if target then
                -- Calculate new mouse position
                local targetPos = Camera:WorldToViewportPoint(target.Position)
                local mousePos = UserInputService:GetMouseLocation()
                local newPos = mousePos:Lerp(Vector2.new(targetPos.X, targetPos.Y), MoonConfig.Smoothness)
                
                -- Move mouse
                mousemoverel(newPos.X - mousePos.X, newPos.Y - mousePos.Y)
                
                -- Auto shoot control
                if MoonConfig.AutoShoot then
                    if not autoShooting then
                        mouse1press()
                        autoShooting = true
                    end
                end
            else
                -- Stop shooting if there is no target
                if autoShooting then
                    mouse1release()
                    autoShooting = false
                end
            end
        else
            -- Stop shooting when aim key is released
            if autoShooting then
                mouse1release()
                autoShooting = false
            end
        end
    end

    -- Initialize players
    for _, player in pairs(Players:GetPlayers()) do
        CreateEsp(player)
    end

    -- Player management
    connections.playerAdded = Players.PlayerAdded:Connect(CreateEsp)
    connections.playerRemoving = Players.PlayerRemoving:Connect(function(player)
        if EspObjects[player] then
            for _, drawing in pairs(EspObjects[player]) do
                if typeof(drawing) == "table" and drawing.Remove then
                    pcall(drawing.Remove, drawing)
                end
            end
            if EspObjects[player].Connection then
                EspObjects[player].Connection:Disconnect()
            end
            EspObjects[player] = nil
        end
    end)

    -- Setup update
    connections.renderStepped = RunService.RenderStepped:Connect(MainLoop)
    
