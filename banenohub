local function GetQuestData()
    local lvl = LocalPlayer.Data.Level.Value
    local questModule = require(ReplicatedStorage.Quests)
    local bestQuest = nil
    local bestLvl = 0

    for questName, questData in pairs(questModule) do
        if questName ~= "MarineQuest" 
            and questName ~= "BartiloQuest" 
            and questName ~= "CitizenQuest" 
            and not string.find(questName, "Trainees") then
            for id, info in pairs(questData) do
                local lvlReq = info.LevelReq or 0
                if lvl >= lvlReq and lvlReq >= bestLvl then
                    for mobName, count in pairs(info.Task) do
                        if count > 1 then
                            bestLvl = lvlReq
                            bestQuest = {
                                Mob = mobName,
                                Quest = questName,
                                ID = id,
                                Lvl = lvlReq
                            }
                        end
                    end
                end
            end
        end
    end
    return bestQuest
end

