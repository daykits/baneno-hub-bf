Tabs.Fish:AddToggle({
    Title = "Auto Fishing",
    Default = false,
    Callback = function(Value)
        _G.AutoFishing = Value
    end
})

task.spawn(function()
    while task.wait(0.5) do
        if not _G.AutoFishing then continue end
        pcall(function()
            local FishReplicated = ReplicatedStorage:FindFirstChild("FishReplicated")
            if not FishReplicated then return end
            local FishingRequest = FishReplicated:FindFirstChild("FishingRequest")
            if not FishingRequest then return end
            if not Character then return end
            local HRP = Character:FindFirstChild("HumanoidRootPart")
            if not HRP then return end
            local tool = Character:FindFirstChildOfClass("Tool")
            if _G.SelectedRod and (not tool or tool.Name ~= _G.SelectedRod) then
                local backpackTool = LocalPlayer.Backpack:FindFirstChild(_G.SelectedRod)
                if backpackTool and Humanoid then
                    Humanoid:EquipTool(backpackTool)
                    tool = backpackTool
                end
            end
            if tool then
                local state = tool:GetAttribute("State")
                local serverState = tool:GetAttribute("ServerState")
                if state == "ReeledIn" or serverState == "ReeledIn" then
                    FishingRequest:InvokeServer("StartCasting")
                    task.wait()
                    local targetPos = HRP.Position + HRP.CFrame.LookVector * 50
