local function Alive(model)
    if not model then return false end
    local hum = model:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function EquipWeapon(toolName)
    if not toolName then return end
    if not Character or not Humanoid then return end
    if _G.NotAutoEquip then return end
    local tool = LocalPlayer.Backpack:FindFirstChild(toolName)
    if tool then
        Humanoid:EquipTool(tool)
    end
end

local function weaponSc(toolTip)
    for _, v in ipairs(LocalPlayer.Backpack:GetChildren()) do
        if v:IsA("Tool") and v.ToolTip == toolTip then
            EquipWeapon(v.Name)
            return v.Name
        end
    end
    return nil
end

local function GetConnectionEnemies(a)
    for _, v in ipairs(ReplicatedStorage:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            if (type(a) == "table" and table.find(a, v.Name)) or v.Name == a then
                return v
            end
        end
    end
    for _, v in ipairs(workspace.Enemies:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            if (type(a) == "table" and table.find(a, v.Name)) or v.Name == a then
                return v
            end
        end
    end
    return nil
end

local function GetBP(name)
    return LocalPlayer.Backpack:FindFirstChild(name) or LocalPlayer.Character:FindFirstChild(name)
end

local function GetM(name)
    for _, tab in ipairs(ReplicatedStorage.Remotes.CommF_:InvokeServer("getInventory")) do
        if type(tab) == "table" and tab.Type == "Material" and tab.Name == name then
            return tab.Count
