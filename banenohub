-- ============================================================
-- FAST ATTACK SYSTEM
-- ============================================================
local FastAttackModule = {}

FastAttackModule.Rate = 0.000000002

local function GetEnemiesInRange(character, range)
    local targets = {}
    local myPos = character:GetPivot().Position

    for _, enemy in ipairs(workspace.Enemies:GetChildren()) do
        local hum = enemy:FindFirstChild("Humanoid")
        local root = enemy:FindFirstChild("HumanoidRootPart")
        if hum and root and hum.Health > 0 then
            if (root.Position - myPos).Magnitude <= range then
                table.insert(targets, enemy)
            end
        end
    end
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer and other.Character then
            local root = other.Character:FindFirstChild("HumanoidRootPart")
            local hum = other.Character:FindFirstChild("Humanoid")
            if hum and root and hum.Health > 0 then
                if (root.Position - myPos).Magnitude <= range then
                    table.insert(targets, other.Character)
                end
            end
        end
    end
    return targets
end

function FastAttackModule.Execute()
    if not _G.Seriality then return end
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return end

    local targets = GetEnemiesInRange(char, 60)
    if #targets < 1 then return end

    local attackRemote = ReplicatedStorage.Modules.Net["RE/RegisterAttack"]
    local hitRemote = ReplicatedStorage.Modules.Net["RE/RegisterHit"]
    if not attackRemote or not hitRemote then return end

    local targetParts = {}
    for _, t in ipairs(targets) do
        local head = t:FindFirstChild("Head") or t.PrimaryPart
        if head then table.insert(targetParts, { t, head }) end
    end
    if #targetParts < 1 then return end

    attackRemote:FireServer(FastAttackModule.Rate)
    hitRemote:FireServer(targetParts[1][2], targetParts)
end

task.spawn(function()
    while task.wait(FastAttackModule.Rate) do
        pcall(FastAttackModule.Execute)
    end
end)

