local function GetWP(swordName)
    for _, v in ipairs(ReplicatedStorage.Remotes.CommF_:InvokeServer("getInventory")) do
        if type(v) == "table" and v.Type == "Sword" then
            if v.Name == swordName or LocalPlayer.Character:FindFirstChild(swordName) or LocalPlayer.Backpack:FindFirstChild(swordName) then
                return true
