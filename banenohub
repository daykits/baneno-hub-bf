function Attack.Kill(model, enable)
    if not model or not enable then return end
    if not Alive(model) then return end
    BringEnemy()
    EquipWeapon(_G.SelectWeapon)
    repeat
        task.wait(0.1)
        if not Root or not model:FindFirstChild("HumanoidRootPart") then break end
        _tp(model.HumanoidRootPart.CFrame * CFrame.new(0, 25, 0))
        pcall(function()
            VirtualUser:CaptureController()
            VirtualUser:Button1Down(Vector2.new(1280, 672))
        end)
    until not enable or not model.Parent or not Alive(model)
end

