-- ============================================================
-- KAVO HELPERS (thay thế Rayfield)
-- ============================================================
local function AddSection(tab, name)
    return tab:NewSection(name)
end

local function AddToggle(tab, name, default, callback)
    local state = { value = default or false }
    tab:NewToggle(name, default or false, function(value)
        state.value = value
        if callback then callback(value) end
    end)
    return state
end

local function AddDropdown(tab, name, options, default, callback)
    if not options or #options == 0 then options = {"None"} end
    local current = default or options[1]
    local dropdown
    dropdown = tab:NewDropdown(name, options, function(value)
        current = value
        if callback then callback(value) end
    end)
    if default and default ~= options[1] then
        pcall(function() dropdown:Set(default) end)
    end
    return dropdown
end

local function AddButton(tab, name, callback)
    tab:NewButton(name, "Nhấn để thực hiện", function()
        if callback then callback() end
    end)
end

local function AddParagraph(tab, title, content)
    local label = tab:NewLabel("[" .. title .. "] " .. (content or ""))
    local obj = {}
    function obj:SetDesc(newContent)
        pcall(function()
            label:Set("[" .. title .. "] " .. (newContent or ""))
        end)
    end
    return obj
end

local function AddSlider(tab, name, min, max, default, increment, callback)
    local slider
    slider = tab:NewSlider(name, max, min, default, function(value)
        if callback then callback(value) end
    end)
    return slider
end

local function AddTextBox(tab, name, default, callback)
    local box
    box = tab:NewTextBox(name, default or "", function(text)
        if callback then callback(text) end
    end)
    return box
end

local function AddKeybind(tab, name, defaultKey, callback)
    local kb
    kb = tab:NewKeybind(name, "Nhấn để đổi phím", defaultKey or Enum.KeyCode.F, function()
        if callback then callback() end
    end)
    return kb
end

