n LightingSvc.Sky.MoonTextureId end)\010        if ok and tex == \"http://www.roblox.com/asset/?id=9709149431\" then return true end\010        local ok2, phase = pcall(function() return LightingSvc:GetAttribute(\"MoonPhase\") end)\010        return ok2 and tonumber(phase) == 5\010    end\010    -- fase vizinha a cheia (5): nao sabemos a duracao exata de cada fase, entao isto e uma aproximacao de \"faltando pouco\" (nao exatamente 5 min)\010    local function moonNear()\010        local ok, phase = pcall(function() return LightingSvc:GetAttribute(\"MoonPhase\") end)\010        return ok and (tonumber(phase) == 4 or tonumber(phase) == 6)\010    end\010    local kitAt = 0\010    local kitTradeActive = false -- v108: fica \"em sequencia de trade\" ate acabar o Azure Ember, nao so ate cruzar o limite de novo\010    local KITSEACMD = { \"TravelMain\", \"TravelDressrosa\", \"TravelZou\" }\010    local kitTravelAt, kitTravelN = 0, 0\010    local kitSaved\010    -- v55: Auto Fully Kitsune Island com JANELA DE TEMPO. Faz hop ate achar um servidor onde a lua cheia comeca daqui a\010    -- KitMinMin..KitMaxMin minutos (ou ja esta ativa, se KitJoinActive). Ai garante o Mar 3, liga Spawn/Summon/Collect/Trade/TP\010    -- sozinho e deixa o kitStep fazer o resto. O servidor aceito fica \"travado\" ate o evento acabar (nao sai quando o relogio\010    -- passa de 15 para 5 min). Nada e inventado: sem medida confiavel o tempo fica \"unknown\" e o servidor e recusado.\010    --   Medida: a velocidade real do Lighting.ClockTime (segundos reais por hora do jogo) e medida duas vezes e so e usada\010    --   se as duas concordarem. Premissa (confira no jogo): fase 4 (3/4) vira fase 5 (cheia) quando a noite comeca (ClockTime 18).\010    local function moonPhase()\010        -- v57: textura de lua cheia = lua cheia (e o que o jogador ve); vence um atributo MoonPhase diferente/atrasado\010        local okT, texF = pcall(function() return tostring(LightingSvc:FindFirstChildOfClass(\"Sky\").MoonTextureId):find(\"9709149431\", 1, true) ~= nil end)\010        if okT and texF then return 5 end\010        local ok, ph = pcall(function() return LightingSvc:GetAttribute(\"MoonPhase\") end)\010        ph = ok and tonumber(ph) or nil\010        if ph then return ph end\010        -- v56 fallback: when the attribute is missing only the full-moon texture is known (same id as Status > Sky & Moon)\010        local ok2, tex = pcall(function() return LightingSvc:FindFirstChildOfClass(\"Sky\").MoonTextureId end)\010        if ok2 and tostring(tex):find(\"9709149431\", 1, true) then return 5 end\010        return nil\010    end\010    local KIT_DUSK = 18\010    local KIT_NEAR_MAX = 10   -- \"near full moon\" = phase before the full moon AND at most this many minutes left (internal, no slider)\010    local KIT_Z6 = Vector3.new(-44541.7617, 30, -1244.8584)   -- zone 6 of Sea 3\010    local kitJob, kitCommit, kitSince, kitSample, kitRate = nil, false, 0, nil, nil\010    local kitMeasJob, kitWP, kitWPAt, kitLeaveAt\010    local kitTradeBefore\010    local function kitMeasure()\010        if kitMeasJob ~= game.JobId then kitMeasJob, kitSample, kitRate = game.JobId, nil, nil end\010        local now, c = os.clock(), LightingSvc.ClockTime\010        if not kitSample then kitSample = { c = c, t = now }; return end\010        local dt = now - kitSample.t\010        if dt < 6 then return end\010        local dh = (c - kitSample.c) % 24\010        if dh > 0.002 and dh < 6 then\010            local r = dt / dh\010            if kitRate and kitRate.n >= 2 then\010                -- v56: once two samples agree the rate is kept (it used to fall back to n=1 and flip the status to \"measuring\" again)\010                if math.abs(r - kitRate.v) / kitRate.v < 0.25 then kitRate = { v = (kitRate.v * 3 + r) / 4, n = kitRate.n + 1 } end\010            elseif kitRate and kitRate.n == 1 and math.abs(r - kitRate.v) / kitRate.v < 0.25 then kitRate = { v = (r + kitRate.v) / 2, n = 2 }\010            else kitRate = { v = r, n = 1 } end\010        end\010        kitSample = { c = c, t = now }\010    end\010    -- true = aceita | false = recusa | nil = ainda medindo\010    local function kitServerOk()\010        local ph = moonPhase()\010        if ph == nil then\010            if os.clock() - kitSince < 10 then SE.kitMoon = \"waiting for the moon phase...\"; return nil, \"waiting for the moon phase\" end\010            SE.kitMoon = \"moon phase unknown (Lighting attribute MoonPhase not found)\"\010            return false, \"moon phase unknown\"\010        end\010        if ph == 5 and night() then\010            -- full moon already active: can stay (avoids hopping all the time) unless the Kitsune event here already finished\010            if SE.kitDone then\010                SE.kitMoon = \"full moon active but the event here is finished: next server\"\010                return false, \"event finished in this server\"\010            end\010            SE.kitMoon = \"full moon active now\"\010            return true, \"full moon already active\"\010        end\010        if not game:IsLoaded() or not LightingSvc:FindFirstChildOfClass(\"Sky\") then kitSince = os.clock() end\010        if os.clock() - kitSince < 6 then\010            SE.kitMoon = string.format(\"reading the moon phase... (hop check in %d s)\", math.ceil(6 - (os.clock() - kitSince)))\010            return nil, \"reading the moon phase\"\010        end\010        if ph ~= 4 then\010            SE.kitMoon = string.format(\"moon phase %s, clock %.1f: full moon is not next\", tostring(ph or \"?\"), LightingSvc.ClockTime)\010            return false, \"full moon is not the next phase\"\010        end\010        kitMeasure()\010        if not (kitRate and kitRate.n >= 2) then SE.kitMoon = \"measuring the day cycle...\"; return nil, \"measuring the day cycle\" end\010        local m = ((KIT_DUSK - LightingSvc.ClockTime) % 24) * kitRate.v / 60\010        SE.kitMoon = string.format(\"near full moon: ~%.1f min left\", m)\010        if m > KIT_NEAR_MAX then return false, string.format(\"%.1f min left (> %d, not near)\", m, KIT_NEAR_MAX) end\010        return true, string.format(\"near full moon (~%.1f min left)\", m)\010    end\010    -- minutos ate a lua cheia (para o painel Kitsune Status): number | nil, texto\010    function SE.moonRemain()\010        pcall(kitMeasure)\010        local ph = moonPhase()\010        if ph == nil then return nil, \"reading the moon...\" end\010        if ph == 5 and night() then return 0, \"ACTIVE NOW\" end\010        if ph ~= 4 then return nil, string.format(\"not near (moon phase %s)\", tostring(ph)) end\010        if not (kitRate and kitRate.n >= 2) then return nil, \"measuring the day cycle...\" end\010        local m = ((KIT_DUSK - LightingSvc.ClockTime) % 24) * kitRate.v / 60\010        return m, string.format(\"in %d:%02d\", math.floor(m), math.floor((m % 1) * 60))\010    end\010    local function kitRestore()\010        if kitSaved then\010            Config.KitSpawn, Config.KitSummon, Config.KitCollect, Config.KitTrade, Config.KitTP, Config.KitDrive = kitSaved[1], kitSaved[2], kitSaved[3], kitSaved[4], kitSaved[5], kitSaved[6]\010            kitSaved = nil\010        end\010    end\010    local function kitFlat(a, b) return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude end\010    local function kitSpeed() return math.clamp(tonumber(Config.KitSpeed) or 200, 100, 500) end\010    -- Sea Events engine (the tested one): flies to the Tiki Outpost dealer, buys the boat, gets on it and can sail to zone 6\010    local function kitSeaStep()\010        local prevBoat, prevSpd, prevZone = Config.SeaBoat, Config.SeaSpeed, Sea.zone\010        Config.SeaBoat = Config.KitBoat or \"Guardian\"\010        Config.SeaSpeed = kitSpeed()\010        Sea.zone = 6\010        local okS, sr = pcall(Sea.step, true)\010        Config.SeaBoat, Config.SeaSpeed, Sea.zone = prevBoat, prevSpd, prevZone\010        return okS and sr\010    end\010    -- moves the boat with the Sea Events cruise mover (PivotTo every frame at KitSpeed studs/s): the same one that works at Speed Boat\010    local function kitCruise(boat, seat, target)\010        local st = Sea.st\010        if not st then kitSeaStep(); return end\010        Sea.forceUntil = os.clock() + 1.5\010        Config.SeaSitUntil = os.clock() + 1.5\010        st.cruise = { boat = boat, seat = seat, target = target, fly = false, speed = kitSpeed() }\010    end\010    local function kitStopBoat()\010        stopBoat()\010        if Sea.st then Sea.st.cruise = nil end\010    end\010    -- returns boat, seat when we are sitting on OUR boat; otherwise lets the Sea Events engine buy it / get on it and returns nil\010    local function kitBoat(hum, label)\010        local boat, seat = myBoat()\010        if boat and hum.SeatPart == seat then\010            if Sea.st then Sea.st.cruise = nil end   -- from here our own tween drives the boat\010            stepBoatNoclip(boat)\010            return boat, seat\010        end\010        kitStopBoat()\010        busy(label .. \": getting the boat\")\010        kitSeaStep()\010        SE.kit = label .. \": getting the boat (\" .. tostring(Config.KitBoat or \"Guardian\") .. \") | \" .. tostring(Diag.sea)\010        return nil\010    end\010    -- near full moon accepted: go to zone 6 by boat and keep sailing in random directions (no hop) until the moon / island shows up\010    local function kitWander(hum)\010        local boat, seat = kitBoat(hum, \"Waiting for the full moon\")\010        if not boat then return true end\010        local spd = kitSpeed()\010        local dz = kitFlat(seat.Position, KIT_Z6)\010        if dz > 1800 then\010            busy(\"Waiting for the full moon: sailing to zone 6\")\010            kitSeaStep()\010            SE.kit = string.format(\"waiting for the full moon: sailing to zone 6 (%d studs)\", dz)\010            return true\010        end\010        if not kitWP or kitFlat(seat.Position, kitWP) < 80 or os.clock() - (kitWPAt or 0) > 45 then\010            local ang, rad = math.random() * math.pi * 2, math.random(300, 1400)\010            kitWP = Vector3.new(KIT_Z6.X + math.cos(ang) * rad, seat.Position.Y, KIT_Z6.Z + math.sin(ang) * rad)\010            kitWPAt = os.clock()\010        end\010        busy(\"Waiting for the full moon: sailing around zone 6\")\010        SE.kit = \"waiting for the full moon: sailing around zone 6 (random heading, no hop)\"\010        kitCruise(boat, seat, kitWP)\010        return true\010    end\010    function SE.fullKitsuneStep()\010        if not Config.FullKitsune then kitRestore(); kitCommit = false; AFL.kitLocked = false; return false end\010        if getSea() ~= 3 then\010            if getPlayerLevel() < 1500 then busy(\"Fully Kitsune: needs Sea 3 (level 1500+)\"); SE.kit = \"needs level 1500 for Sea 3\"; return true end\010            if not Config.FullTravel then\010                busy(\"Fully Kitsune: go to Sea 3 yourself (Auto Travel is off in Auto Fully)\")\010                SE.kit = \"waiting for you to reach Sea 3\"\010                return true\010            end\010            if os.clock() - kitTravelAt > 25 then\010                kitTravelAt = os.clock()\010                kitTravelN += 1\010                if kitTravelN <= 4 then invoke(KITSEACMD[3]) end\010            end\010            busy(\"Fully Kitsune: travelling to Sea 3\")\010            SE.kit = \"travelling to Sea 3\"\010            return true\010        end\010        if kitJob ~= game.JobId then kitJob, kitCommit, kitSince, kitSample, kitRate = game.JobId, false, os.clock(), nil, nil; SE.kitRejectAt, SE.kitZ6At, SE.kitOverAt = nil, nil, nil; SE.kitIslandSeen, SE.kitTimerSeen, SE.kitEndAt, SE.kitDone = nil, nil, nil, nil; kitWP = nil; AFL.kitLocked = false end\010        -- servidor aceito (near full moon): fica ate o EVENTO acabar. Acabou o evento da Kitsune = hop na hora (nao espera a lua cheia terminar)\010        if kitCommit then\010            local ph = moonPhase()\010            local k = kitIsland()\010            local timerOn = raidTimer() and true or false\010            local emb = ember()\010            if k then SE.kitIslandSeen = true end\010            if timerOn then SE.kitTimerSeen = true end\010            local goalNow = Config.KitTrade and k and AFL.Inv.count(\"Azure Ember\") >= math.max(1, tonumber(Config.KitAzure) or 10)\010            -- (a) o evento ja rodou e terminou (timer sumiu e sem ember no chao, ou a ilha sumiu): sai em 4 s (espera so uma troca pendente, ate 2 min)\010            local evOver = (SE.kitTimerSeen and not timerOn and not emb) or (SE.kitIslandSeen and not k)\010            if evOver then\010                SE.kitEndAt = SE.kitEndAt or os.clock()\010                local waited = os.clock() - SE.kitEndAt\010                if goalNow and waited < 120 then\010                    SE.kitMoon = \"event over: finishing the trade before leaving\"\010                elseif waited > 4 then\010                    kitCommit = false\010                    SE.kitDone = true\010                    SE.kitEndAt = nil\010                    kitRestore()\010                    SE.kitMoon = \"event finished: hopping to the next near full moon server\"\010                else\010                    SE.kitMoon = string.format(\"event over: leaving in %ds\", math.ceil(4 - waited))\010                end\010            else\010                SE.kitEndAt = nil\010                -- (b) fallback: a lua passou (nem fase 4 nem lua cheia ativa) sem o evento acontecer: sai depois de 20 s seguidos\010                local fullNow = (ph == 5) and night()\010                local over = ph ~= nil and ph ~= 4 and not fullNow\010                if over then SE.kitOverAt = SE.kitOverAt or os.clock() else SE.kitOverAt = nil end\010                local waited = SE.kitOverAt and (os.clock() - SE.kitOverAt) or 0\010                local holdEvent = (timerOn and emb) and true or false\010                local holdTrade = goalNow and waited < 120\010                if over and not holdEvent and not holdTrade then\010                    if waited > 20 then\010                        kitCommit = false\010                        SE.kitOverAt = nil\010                        kitRestore()\010                        SE.kitMoon = \"moon ended: looking for the next server\"\010                    else\010                        SE.kitMoon = string.format(\"moon ended: leaving in %ds\", math.ceil(20 - waited))\010                    end\010                elseif over then\010                    SE.kitMoon = \"moon ended: finishing the event / trade before leaving\"\010                end\010            end\010        end\010        -- v57: servidor aceito = TRAVADO. Nenhum hop (de qualquer funcao do hub) enquanto a lua nao acabar\010        AFL.kitLocked = kitCommit and true or false\010        if not kitCommit then\010            local ok, why = kitServerOk()\010            if ok == nil and os.clock() - kitSince > 45 then ok, why = false, \"time until full moon unknown\" end\010            if ok == nil then\010                busy(\"Fully Kitsune: measuring the moon timer\")\010                SE.kit = \"measuring the moon timer\"\010                return true\010            end\010            if ok then\010                kitCommit = true\010                SE.kitRejectAt = nil\010                SE.kit = \"server accepted: \" .. tostring(why)\010            else\010                kitRestore()\010                busy(\"Fully Kitsune: \" .. tostring(why) .. \" - hopping\")\010                SE.kit = \"rejected: \" .. tostring(why) .. \" - hopping\"\010                local mnK, mxK = 0, KIT_NEAR_MAX\010                -- v57 watchdog: se 40 s depois de recusar o servidor ainda estamos nele, o hop travou: destrava e tenta de novo\010                SE.kitRejectAt = SE.kitRejectAt or os.clock()\010                if os.clock() - SE.kitRejectAt > 40 and not (AFL.Hop.running and os.clock() - AFL.Hop.running < 180) then\010                    SE.kitRejectAt = os.clock()\010                    AFL.Hop.active, AFL.Hop.failAt = false, 0\010                    if AFL.QApi then AFL.QApi.joining, AFL.QApi.last = false, 0 end\010                    SE.kit = \"hop was stuck: trying again\"\010                end\010                local chk = function() return kitServerOk() == true end\010                -- v57: primeiro a lista da API (servidores perto da lua cheia); se ela nao servir, cai no hop normal\010                if AFL.apiJoinMoon then AFL.apiJoinMoon(mnK, mxK, chk)\010                else AFL.hopRequest(\"Near full moon (0-\" .. mxK .. \" min)\", chk, 1) end\010                return true\010            end\010        end\010        if not kitSaved then\010            kitSaved = { Config.KitSpawn, Config.KitSummon, Config.KitCollect, Config.KitTrade, Config.KitTP, Config.KitDrive }\010            Config.KitSpawn, Config.KitSummon, Config.KitCollect, Config.KitTrade, Config.KitTP, Config.KitDrive = true, true, true, true, true, true\010        end\010        return SE.kitStep()\010    end\010    function SE.kitStep()\010        if not (Config.KitTP or Config.KitSpawn or Config.KitDrive or Config.KitSummon or Config.KitCollect or Config.KitTrade) then return false end\010        if getSea() ~= 3 then\010            if getPlayerLevel() < 1500 then SE.kit = \"Kitsune needs Sea 3 (level 1500+)\"; return false end\010            if Config.FullTravel == false then SE.kit = \"Kitsune only works in Sea 3 (Auto Travel is off)\"; return false end\010            if os.clock() - kitTravelAt > 25 then\010                kitTravelAt = os.clock()\010                kitTravelN += 1\010                if kitTravelN <= 4 then invoke(KITSEACMD[3]) end\010            end\010            busy(\"Kitsune: travelling to Sea 3\")\010            SE.kit = \"travelling to Sea 3\"\010            return true\010        end\010        local char, hrp, hum