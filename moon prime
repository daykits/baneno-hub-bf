to Random Fruit (gacha). Cooldown de 2h compartilhado entre os mares.\010-- 1) tenta o remote de onde estiver; 2) se n\195\163o vier fruta, voa at\195\169 o NPC e tenta de novo\010--    (remote, ProximityPrompt e bot\195\163o da janela do gacha). O resultado fica em Status > Diagn\195\179stico.\010local Gacha = { nextAt = 0, last = \"has not spun yet\", tries = 0, phase = \"idle\", travelSince = 0, pauseUntil = 0 }\010pcall(function()\010    if canFile() and isfile(\"MoonHub_gacha.txt\") then\010        Gacha.nextAt = tonumber(readfile(\"MoonHub_gacha.txt\")) or 0\010    end\010end)\010local function saveGacha()\010    pcall(function()\010        if canFile() then writefile(\"MoonHub_gacha.txt\", tostring(Gacha.nextAt)) end\010    end)\010end\010\010local function describe(v)\010    if type(v) == \"table\" then\010        local parts, n = {}, 0\010        for k, x in pairs(v) do\010            n += 1\010            if n > 5 then break end\010            parts[#parts + 1] = tostring(k) .. \"=\" .. tostring(x)\010        end\010        return \"{\" .. table.concat(parts, \", \") .. \"}\"\010    end\010    return tostring(v)\010end\010\010local function npcPart(m)\010    return m:FindFirstChild(\"HumanoidRootPart\") or m.PrimaryPart or m:FindFirstChildWhichIsA(\"BasePart\")\010end\010\010-- Nomes de NPCs por perto (ajuda a achar o NPC certo se o gacha mudar de nome)\010local function nearbyNpcNames()\010    local names, seen = {}, {}\010    local _, hrp = getChar()\010    local npcs = workspace:FindFirstChild(\"NPCs\")\010    if npcs and hrp then\010        for _, m in ipairs(npcs:GetChildren()) do\010            local part = npcPart(m)\010            if part and not seen[m.Name] and (part.Position - hrp.Position).Magnitude < 400 then\010                seen[m.Name] = true\010                names[#names + 1] = m.Name\010                if #names >= 8 then break end\010            end\010        end\010    end\010    return #names > 0 and table.concat(names, \", \") or \"none\"\010end\010\010local ZiolesCache, ZiolesLast = nil, 0\010local function findGachaNpc()\010    local _, hrp = getChar()\010    -- NPC \"Zioles\": primeiro em workspace.NPCs, depois uma busca geral (no m\195\161x. a cada 5s)\010    if ZiolesCache and ZiolesCache.Parent then return ZiolesCache end\010    local z = workspace:FindFirstChild(\"NPCs\") and workspace.NPCs:FindFirstChild(\"Zioles\")\010    if not z and os.clock() - ZiolesLast > 5 then\010        ZiolesLast = os.clock()\010        z = workspace:FindFirstChild(\"Zioles\", true)\010    end\010    if z and z:IsA(\"Model\") and npcPart(z) then\010        ZiolesCache = z\010        return z\010    end\010    local npcs = workspace:FindFirstChild(\"NPCs\")\010    if not npcs then return end\010    local best, bestD = nil, math.huge\010    for _, m in ipairs(npcs:GetChildren()) do\010        local n = string.lower(m.Name)\010        if string.find(n, \"cousin\", 1, true) or string.find(n, \"gacha\", 1, true) or string.find(n, \"zioles\", 1, true) then\010            local part = npcPart(m)\010            if part then\010                local d = hrp and (hrp.Position - part.Position).Magnitude or 0\010                if d < bestD then best, bestD = m, d end\010            end\010        end\010    end\010    return best\010end\010\010-- Chama o remote e confere se veio fruta (ou se a resposta parece o tempo restante do cooldown)\010-- Quantas frutas est\195\163o GUARDADAS no invent\195\161rio (o gacha pode mandar a fruta direto para l\195\161)\010local function invFruitCount()\010    local ok, inv = invoke(\"getInventoryFruits\")\010    if ok and type(inv) == \"table\" then\010        local n = 0\010        for _ in pairs(inv) do n += 1 end\010        return n\010    end\010end\010\010-- Recebeu fruta? (mochila OU invent\195\161rio)\010local function gotFruit(beforeBag, beforeInv)\010    if countFruits() > beforeBag then return true end\010    local now = invFruitCount()\010    return beforeInv ~= nil and now ~= nil and now > beforeInv\010end\010\010local function tryRoll()\010    local before, beforeInv = countFruits(), invFruitCount()\010    Gacha.rollClock = os.clock()\010    local ok, r\010    local net = ReplicatedStorage:FindFirstChild(\"Modules\") and ReplicatedStorage.Modules:FindFirstChild(\"Net\")\010    local rf = net and net:FindFirstChild(\"RF/GachaNetworkRF\")\010    if rf then\010        ok, r = pcall(function()\010            return rf:InvokeServer({ Context = \"Purchase\", BoxName = \"ZiolesGacha\" })\010        end)\010    else\010        ok, r = invoke(\"Cousin\", \"Buy\") -- plano B (remote antigo)\010    end\010    Gacha.tries += 1\010    Gacha.last = (ok and \"reply: \" or \"error: \") .. describe(r)\010    task.wait(1.5)\010    if gotFruit(before, beforeInv) then return true, \"fruit received\" end\010    if ok and type(r) == \"string\" then\010        local l = string.lower(r)\010        if string.find(l, \"cooldown\", 1, true) or string.find(l, \"wait\", 1, true)\010            or string.find(l, \"hour\", 1, true) or string.find(l, \"minute\", 1, true) then\010            return true, \"on cooldown (game text)\", 1800\010        end\010    end\010    if ok and type(r) == \"number\" and r >= 30 and r <= 7200 then\010        return true, \"on cooldown\", math.floor(r)\010    end\010    if ok and type(r) == \"table\" then\010        if r.Success == true or r.success == true then return true, \"gacha accepted\" end\010        for k, v in pairs(r) do\010            local key = string.lower(tostring(k))\010            if type(v) == \"number\" and v >= 30 and v <= 7200\010                and (string.find(key, \"cool\", 1, true) or string.find(key, \"remain\", 1, true) or string.find(key, \"time\", 1, true)) then\010                return true, \"on cooldown (\" .. tostring(k) .. \")\", math.floor(v)\010            end\010        end\010    end\010    return false\010end\010\010-- Plano B: ProximityPrompt do NPC e bot\195\163o de girar dentro de uma janela de gacha\010local function pressGachaUi(npc)\010    pcall(function()\010        for _, d in ipairs(npc:GetDescendants()) do\010            if d:IsA(\"ProximityPrompt\") then\010                fireproximityprompt(d)\010                break\010            elseif d:IsA(\"ClickDetector\") and fireclickdetector then\010                fireclickdetector(d)\010            end\010        end\010    end)\010    task.wait(1.2)\010    pcall(function()\010        local pg = Player:FindFirstChild(\"PlayerGui\")\010        if not pg or not firesignal then return end\010        for _, b in ipairs(pg:GetDescendants()) do\010            if (b:IsA(\"TextButton\") or b:IsA(\"ImageButton\")) and b.Visible then\010                local inGacha, a = false, b.Parent\010                while a and a ~= pg do\010                    local n = string.lower(a.Name)\010                    if string.find(n, \"gacha\", 1, true) or string.find(n, \"cousin\", 1, true) then\010                        inGacha = true\010                        break\010                    end\010                    a = a.Parent\010                end\010                if inGacha then\010                    local label = string.lower(b.Name .. \" \" .. (b:IsA(\"TextButton\") and b.Text or \"\"))\010                    if string.find(label, \"roll\", 1, true) or string.find(label, \"spin\", 1, true)\010                        or string.find(label, \"buy\", 1, true) or string.find(label, \"open\", 1, true)\010                        or string.find(label, \"girar\", 1, true) then\010                        firesignal(b.MouseButton1Click)\010                        Gacha.last = \"clicked: \" .. b:GetFullName()\010                        return\010                    end\010                end\010            end\010        end\010    end)\010end\010\010-- Retorna true enquanto estiver usando o personagem (voando at\195\169 o NPC)\010local function gachaMission()\010    -- v55: gira de LONGE. Nao voa mais ate o Zioles: tenta o remote de onde o jogador estiver (ate 3 vezes, com pausa curta).\010    -- O botao/prompt do NPC so e usado como plano B se o NPC JA estiver carregado perto (ate 60 studs), sem mover o personagem.\010    local now = os.time()\010    if now < Gacha.nextAt or now < Gacha.pauseUntil then return false end\010    if getPlayerLevel() < 50 then\010        Diag.gacha = \"minimum level 50 for the gacha\"\010        return false\010    end\010    local done, why, secs\010    for _ = 1, 3 do\010        done, why, secs = tryRoll()\010        if done then break end\010        task.wait(1)\010    end\010    local npc\010    if not done then\010        npc = findGachaNpc()\010        local part = npc and npcPart(npc)\010        if part and distanceTo(part.CFrame) <= 60 then\010            local before, beforeInv = countFruits(), invFruitCount()\010            pressGachaUi(npc)\010            task.wait(2)\010            if gotFruit(before, beforeInv) then done, why = true, \"fruit received (NPC/window, nearby)\" end\010        end\010    end\010    Gacha.phase = \"idle\"\010    if done then\010        Gacha.nextAt = os.time() + (secs or 7200)\010        Gacha.tries = 0\010        saveGacha()\010        Diag.gacha = \"ok (\" .. why .. \") | \" .. Gacha.last\010        return false\010    end\010    Gacha.pauseUntil = os.time() + ((Gacha.tries < 6) and 120 or 900)\010    Diag.gacha = string.format(\"could not spin from here (%d attempts) | %s | if the server only accepts spins next to Zioles this cannot work from afar\",\010        Gacha.tries, Gacha.last)\010    return false\010end\010\010-- v31: Remove Gacha Effect esconde a roleta/animacao E a janela de resultado (a janela de resultado no fim do giro\010-- nem sempre tem \"gacha\"/\"roleta\" no nome, entao alem do nome tambem conta qualquer GuiObject novo que apareceu\010-- pouco depois de um giro de verdade - Gacha.rollClock e marcado em tryRoll()). Alem disso, fecha essa janela de\010-- resultado sozinho (acha o botao de fechar - \"X\"/\"Close\"/\"Exit\" - e clica) mesmo com o Remove Gacha Effect\010-- desligado, pra nao ficar travada na tela depois do giro (o bug reportado).\010local function nameLooksGacha(n)\010    n = string.lower(n)\010    return string.find(n, \"gacha\", 1, true) or string.find(n, \"roulette\", 1, true)\010        or string.find(n, \"roleta\", 1, true) or string.find(n, \"ziole\", 1, true)\010end\010local function hideGachaUi(inst)\010    pcall(function()\010        local recent = Gacha.rollClock and (os.clock() - Gacha.rollClock < 6)\010        if not (nameLooksGacha(inst.Name) or recent) then return end\010        if inst:IsA(\"ScreenGui\") then\010            inst.Enabled = false\010        elseif inst:IsA(\"GuiObject\") then\010            inst.Visible = false\010        end\010    end)\010end\010local function closeButtonIn(root)\010    local found\010    pcall(function()\010        for _, b in ipairs(root:GetDescendants()) do\010            if (b:IsA(\"TextButton\") or b:IsA(\"ImageButton\")) and b.Visible then\010                local txt = b:IsA(\"TextButton\") and tostring(b.Text) or \"\"\010                local nm = string.lower(b.Name)\010                if txt == \"X\" or txt == \"x\" or nm == \"close\" or nm == \"closebutton\" or nm == \"exitbutton\" or nm == \"exit\"\010                    or string.find(nm, \"close\", 1, true) or string.find(nm, \"exitbtn\", 1, true) then\010                    found = b\010                    break\010                end\010            end\010        end\010    end)\010    return found\010end\010Gacha.recentUi = {} -- {inst=GuiObject, at=os.clock()} - janelas que apareceram perto de um giro, candidatas a serem a janela de resultado\010local function closeGachaPopups()\010    for i = #Gacha.recentUi, 1, -1 do\010        local e = Gacha.recentUi[i]\010        if not (e.inst and e.inst.Parent) or os.clock() - e.at > 8 then\010            table.remove(Gacha.recentUi, i)\010        elseif os.clock() - e.at >= 0.4 then -- da um tempinho pra janela terminar de montar antes de procurar o botao\010            local b = closeButtonIn(e.inst)\010            if b then\010                pcall(function() if firesignal then firesignal(b.MouseButton1Click) end end)\010                table.remove(Gacha.recentUi, i)\010            end\010        end\010    end\010end\010task.spawn(function()\010    local pg = Player:WaitForChild(\"PlayerGui\", 10)\010    if pg then\010        table.insert(Connections, pg.DescendantAdded:Connect(function(d)\010            if Config.RemoveGachaEffect then task.defer(hideGachaUi, d) end\010            if (d:IsA(\"ScreenGui\") or d:IsA(\"Frame\") or d:IsA(\"ImageLabel\") or d:IsA(\"CanvasGroup\"))\010                and Gacha.rollClock and os.clock() - Gacha.rollClock < 6 then\010                Gacha.recentUi[#Gacha.recentUi + 1] = { inst = d, at = os.clock() }\010            end\010        end))\010        table.insert(Connections, RunService.Heartbeat:Connect(function()\010            if #Gacha.recentUi > 0 then closeGachaPopups() end\010        end))\010    end\010end)\010\010-- v27: sem fruta carregada por perto -> visita cada ilha do mapa (a fruta so existe no cliente perto de voce,\010-- igual ao Auto Farm Chest). So depois de rodar o mapa inteiro sem achar nada e que entra o hop (mesmo AFL.hopRequest de sempre).\010AFL.FruitTour = { tour = nil, tourI = 1, tourAt = 0, dwell = nil, restUntil = 0, noneSince = nil }\010local function fruitTourBuild(from)\010    local list = {}\010    local map = workspace:FindFirstChild(\"Map\")\010    if map then\010        for _, m in ipairs(map:GetChildren()) do\010            if m:IsA(\"Model\") then\010                local ok, sz = pcall(function() return m:GetExtentsSize() end)\010                if ok and sz.Magnitude > 150 then\010                    local ok2, cf = pcall(function() return m:GetPivot() end)\010                    if ok2 then list[#list + 1] = cf.Position end\010                end\010            end\010        end\010    end\010    local out, cur = {}, from\010    while #list > 0 do\010        local bi, bd = 1, math.huge\010        for i, p in ipairs(list) do\010            local d = (p - cur).Magnitude\010            if d < bd then bi, bd = i, d end\010        end\010        cur = table.remove(list, bi)\010        out[#out + 1] = cur\010    end\010    return out\010end\010function AFL.fruitSearchStep()\010    local _, hrp = getChar()\010    if not hrp then return false end\010    local FT = AFL.FruitTour\010    if os.clock() < FT.restUntil then return false end\010    if not FT.tour then FT.tour, FT.tourI, FT.tourAt, FT.dwell = fruitTourBuild(hrp.Position), 1, os.clock(), nil end\010    local tgt = FT.tour[FT.tourI]\010    if not tgt then\010        FT.tour, FT.restUntil = nil, os.clock() + 20\010        FT.noneSince = FT.noneSince or os.clock()\010        return false\010    end\010    State.Mode = \"Auto Collect Fruit\"\010    State.Text = string.format(\"Searching the whole map for fruits (island %d/%d)\", FT.tourI, #FT.tour)\010    local goal = tgt + Vector3.new(0, 80, 0)\010    local _, hrpNow = getChar()\010    if hrpNow and (hrpNow.Position - goal).Magnitude > 60 and os.clock() - FT.tourAt < 35 then\010        flyTo(CFrame.new(goal))\010        return true\010    end\010    FT.dwell = FT.dwell or (os.clock() + 1)\010    if os.clock() < FT.dwell then return true end\010    FT.tourI, FT.tourAt, FT.dwell = FT.tourI + 1, os.clock(), nil\010    return true\010end\010\010-- Auto Collect: frutas no ch\195\163o (inclusive as que acabaram de nascer)\010local FruitBlacklist = setmetatable({}, { __mode = \"k\" })\010local CollectTarget, CollectStart = nil, 0\010\010local function findGroundFruit()\010    local _, hrp = getChar()\010    if not hrp then return end\010    local best, bestDist = nil, math.huge\010    local SKIP = { Map = true, Enemies = true, NPCs = true, _WorldOrigin = true, Characters = true, Boats = true, SeaBeasts = true, Camera = true }\010    local function consider(v)\010        if v:IsA(\"Tool\") and string.find(v.Name, \"Fruit\") and (FruitBlacklist[v] or 0) < os.clock() then\010            local handle = v:FindFirstChild(\"Handle\")\010            if handle then\010                local d = (hrp.Position - handle.Position).Magnitude\010                if d < bestDist then best, bestDist = v, d end\010            end\010        end\010    end\010    for _, v in ipairs(workspace:GetChildren()) do\010        consider(v)\010        if (v:IsA(\"Folder\") or v:IsA(\"Model\")) and not SKIP[v.Name] and not Players:GetPlayerFromCharacter(v) then\010            for _, w in ipairs(v:GetChildren()) do consider(w) end\010        end\010    end\010    return best\010end\010\010local function collectStep(fruit)\010    local handle = fruit:FindFirstChild(\"Handle\")\010    if not handle then return end\010    local _, hrp0 = getChar()\010    local dist0 = hrp0 and (hrp0.Position - handle.Position).Magnitude or math.huge\010    if CollectTarget ~= fruit then CollectTarget, CollectStart, State.collectBest = fruit, os.clock(), math.huge end\010    -- sem limite de distancia: so conta como travado se ficar 45s sem chegar mais perto\010    if dist0 < (State.collectBest or math.huge) - 5 then State.collectBest, CollectStart = dist0, os.clock() end\010    if os.clock() - CollectStart > 45 then\010        FruitBlacklist[fruit] = os.clock() + 60\010        CollectTarget = nil\010        return\010    end\010    State.Mode = \"Auto Collect Fruit\"\010    State.Text = \"Collecting \" .. fruit.Name\010    flyTo(handle.CFrame)\010    local _, hrp = getChar()\010    if hrp and (hrp.Position - handle.Position).Magnitude < 15 then\010        pcall(function()\010            firetouchinterest(hrp, handle, 0)\010            firetouchinterest(hrp, handle, 1)\010        end)\010    end\010end\010\010-- ============ AUTO BUY FRUITS (stock normal) ============\010-- Uma \195\186nica tentativa por stock (o stock normal reseta a cada 4h). Ordem de prioridade: compra a PRIMEIRA\010-- fruta da lista que estiver \195\160 venda e para ali, sem tentar as de prioridade menor.\010local FruitNames = { \"Rocket-Rocket\", \"Spin-Spin\", \"Blade-Blade\", \"Spring-Spring\", \"Bomb-Bomb\", \"Smoke-Smoke\",\010    \"Spike-Spike\", \"Flame-Flame\", \"Falcon-Falcon\", \"Ice-Ice\", \"Sand-Sand\", \"Dark-Dark\", \"Diamond-Diamond\",\010    \"Light-Light\", \"Rubber-Rubber\", \"Ghost-Ghost\", \"Magma-Magma\", \"Quake-Quake\", \"Buddha-Buddha\", \"Love-Love\",\010    \"Creation-Creation\", \"Spider-Spider\", \"Sound-Sound\", \"Phoenix-Phoenix\", \"Portal-Portal\", \"Rumble-Rumble\",\010    \"Pain-Pain\", \"Blizzard-Blizzard\", \"Gravity-Gravity\", \"Mammoth-Mammoth\", \"T-Rex-T-Rex\", \"Dough-Dough\",\010    \"Shadow-Shadow\", \"Venom-Venom\", \"Gas-Gas\", \"Control-Control\", \"Spirit-Spirit\", \"Dragon-Dragon\",\010    \"Leopard-Leopard\", \"Yeti-Yeti\", \"Kitsune-Kitsune\",\010    \"Kilo-Kilo\", \"Chop-Chop\", \"Revive-Revive\", \"Paw-Paw\", \"Magnet-Magnet\", \"Dragon East-Dragon East\", \"Dragon West-Dragon West\" }\010\010-- Tenta comprar SEMPRE que o stock normal resetar (mudan\195\167a de \195\169poca de 4h OU mudan\195\167a no conte\195\186do do stock).\010-- S\195\179 considera frutas de prioridade MAIOR que a melhor que voc\195\170 j\195\161 tem; compra a primeira \195\160 venda e n\195\163o repete a compra.\010local Buy = { epoch = nil, sig = nil, reads = 0, bought = {} }\010-- v30: compara nomes de fruta de forma tolerante (\"Dragon East-Dragon East\", \"Dragon (East)-Dragon (East)\", \"Dragon East\" -> \"dragoneast\")\010local function normFruit(n)\010    n = string.lower(tostring(n))\010    local half = string.match(n, \"^(.+)%-%1$\")\010    if half then n = half end\010    return (string.gsub(n, \"[^%w]\", \"\"))\010end\010local function ownsFruit(name)\010    local short = string.lower(string.sub(name, 1, math.floor((#name - 1) / 2))) -- \"Dragon-Dragon\" -> \"dragon\", \"T-Rex-T-Rex\" -> \"t-rex\"\010    local function match(n) return n and string.find(string.lower(n), short, 1, true) end\010    for _, c in ipairs({ Player.Backpack, Player.Character }) do\010        if c then\010            for _, t in ipairs(c:GetChildren()) do\010                if t:IsA(\"Tool\") and string.find(t.Name, \"Fruit\", 1, true) == nil and match(t.Name) and t.ToolTip == \"Blox Fruit\" then return true end\010            end\010        end\010    end\010    local okD, eaten = pcall(function() return Player.Data.DevilFruit.Value end)\010    if okD and type(eaten) == \"string\" and eaten ~= \"\" and match(eaten) then return true end\010    return invCount(name) > 0\010end\010local function buyStep()\010    local prios = {}\010    for _, f in ipairs(Config.BuyPrio) do\010        if f and f ~= \"None\" then prios[#prios + 1] = f end\010    end\010    if #prios == 0 then\010        Diag.buy = \"choose at least 1 fruit in the priorities\"\010        return\010    end\010    local ok, stock = invoke(\"GetFruits\")\010    if not ok or type(stock) ~= \"table\" then\010        Buy.reads += 1\010        Diag.buy = \"could not read the stock: \" .. tostring(stock)\010        return\010    end\010    Buy.reads = 0\010    local hasFlag, onSale, names = false, {}, {}\010    for _, v in pairs(stock) do\010        if type(v) == \"table\" and v.Name and v.OnSale ~= nil then hasFlag = true end\010    end\010    for _, v in pairs(stock) do\010        if type(v) == \"table\" and v.Name and ((not hasFlag) or v.OnSale == true) then\010            onSale[normFruit(v.Name)] = v.Name\010            names[#names + 1] = v.Name\010        end\010    end\010    table.sort(names)\010    local epoch, sig = math.floor(os.time() / 14400), table.concat(names, \",\")\010    if Buy.epoch == epoch and Buy.sig == sig then return end -- mesmo stock: nada novo para tentar\010    if Buy.epoch ~= epoch or Buy.sig ~= sig then Buy.bought = {} end -- stock novo: libera novas compras\010    Buy.epoch, Buy.sig = epoch, sig