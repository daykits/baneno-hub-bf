------- botoes ----\010function D.changeRace()\010    if myRace() == \"Draco\" then notify(\"You are already a Draco\", 3) return end\010    AFL.goDo(\"Dragon Wizard\", WIZARD, function()\010        if not approach(WIZARD, 5, 8) then notify(\"Could not get close to the Dragon Wizard\", 4) return end\010        local ok, r = call(net(\"RF/InteractDragonQuest\"), { NPC = \"Dragon Wizard\", Command = \"DragonRace\" })\010        task.wait(1.5)\010        if myRace() == \"Draco\" then notify(\"Your race is now Draco!\", 5)\010        elseif not ok then notify(\"Change race failed: \" .. tostring(r), 5)\010        else notify(\"Request sent, but the race did not change (the server may want something first)\", 6) end\010    end)\010end\010function D.toTrial()\010    local function where()\010        local map = workspace:FindFirstChild(\"Map\")\010        local isl = map and map:FindFirstChild(\"PrehistoricIsland\")\010        local tp = isl and isl:FindFirstChild(\"TrialTeleport\")\010        return tp and posOf(tp) or nil\010    end\010    AFL.goDo(\"Draco Trial\", where, function()\010        local pos = where()\010        if pos then approach(pos, 3, 8) end\010        task.wait(2)\010    end)\010end\010function D.upgradeOnce()\010    AFL.goDo(\"Uzoth\", TALON, function()\010        if not approach(TALON, 5, 8) then notify(\"Could not get close to Uzoth\", 4) return end\010        local ok, r = call(net(\"RF/InteractDragonQuest\"), { NPC = \"Uzoth\", Command = \"Upgrade\" })\010        if ok and r ~= false then D.talons += 1; notify(\"Dragon Talon upgrade requested\", 4)\010        else notify(\"Dragon Talon: \" .. tostring(ok and \"the server refused (materials missing?)\" or r), 5) end\010    end)\010end\010\010-- ----------------------------------------------------------------------- UI ----\010do\010    local T = Tabs.Races\010    local function tog(id, title, desc)\010        T:AddToggle(id, { Title = title, Description = desc, Default = Config[id] and true or false })\010            :OnChanged(function(v) Config[id] = v and true or false; persist() end)\010    end\010    T:AddSection(\"Draco Race\")\010    local info = T:AddParagraph({ Title = \"Draco\", Content = \"Checking...\" })\010    task.spawn(function()\010        while Alive do\010            pcall(function()\010                info:SetDesc(string.format(\"Race: %s | Trial: %s | Flowers: %d | Talon upgrades: %d\\nStatus: %s\",\010                    myRace(), timerOn() and trialModel() and \"in progress\" or \"-\", D.flowers, D.talons, D.status))\010            end)\010            task.wait(1.5)\010        end\010    end)\010    T:AddButton({ Title = \"Change To Draco Race\", Description = \"Flies to the Dragon Wizard (Dragon Dojo) and asks for the Draco race\", Callback = D.changeRace })\010    tog(\"DracoTrial\", \"Auto Complete Draco Trial\", \"Inside the trial it takes the relics in order and goes to the door. Outside it asks the server to start the trial\")\010    T:AddButton({ Title = \"Teleport To Draco Trial\", Description = \"Flies to the trial entrance on the Prehistoric Island (the island has to be spawned)\", Callback = D.toTrial })\010    tog(\"DracoFlowers\", \"Auto Draco Race V2 (Fire Flowers)\", \"Collects the Fire Flowers; with none on the map it hunts Forest Pirates\")\010\010    T:AddSection(\"Fully Draco\")\010    T:AddDropdown(\"DracoTarget\", { Title = \"Target Version\", Description = \"How far to push the race automatically\", Values = { \"V3\", \"V4\" }, Default = (Config.DracoTarget == \"V4\") and 2 or 1 })\010        :OnChanged(function(v) Config.DracoTarget = v; persist() end)\010    tog(\"FullDraco\", \"Fully Draco (V1 -> V3/V4)\", \"Changes race to Draco, farms Fire Flowers for V2, fights the Terrorshark for V3, and for V4 checks Dragonheart+Dragonstorm at mastery 500 plus the Leviathan Heart - freezing the Hydra and the Vault Room puzzle still need to be done by hand\")\010\010    T:AddSection(\"Dragon Dojo\")\010    tog(\"DracoTalon\", \"Auto Upgrade Dragon Talon\", \"Stays next to Uzoth and keeps asking for the upgrade\")\010    T:AddButton({ Title = \"Upgrade Dragon Talon Once\", Description = \"Flies to Uzoth and asks for one upgrade\", Callback = D.upgradeOnce })\010    for _, e in ipairs(DOJO) do\010        T:AddButton({ Title = \"Teleport: \" .. e[1], Callback = function()\010            AFL.goDo(e[1], e[2], function() task.wait(0.5) end)\010        end })\010    end\010end\010\010\010\010";
