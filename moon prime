    local function equipTool(t)\010            local _, _, hum = getChar()\010            if hum and t and t.Parent ~= Player.Character and every(\"equip\" .. t.Name, 1) then pcall(function() hum:EquipTool(t) end) end\010        end\010        local function iceDoorOpen()\010            local ok, door = pcall(function() return workspace.Map.Ice.Door end)\010            if ok and door and door:IsA(\"BasePart\") then\010                return door.CanCollide == false and door.Transparency >= 0.9\010            end\010            return false\010        end\010\010        -- ===== Mar 2 =====\010        local function sea2Step()\010            if getSea() ~= 1 then return false end\010            local lv = myLevel()\010            if lv < 700 then\010                note(\"Auto Sea 2: needs level 700 (you are level \" .. lv .. \") - another farm raises the level\")\010                return false\010            end\010            if (SF.cool.sea2 or 0) > os.clock() then\010                note(\"Auto Sea 2: paused for a few minutes after repeated failures\")\010                return false\010            end\010            -- 1) se a viagem ja esta liberada, vai direto\010            if not SF.s2Tried then\010                SF.s2Tried = true\010                SF.s2WaitUntil = os.clock() + 8\010                invoke(\"TravelDressrosa\")\010            end\010            if os.clock() < (SF.s2WaitUntil or 0) then\010                set(\"Auto Sea 2: trying to travel to the Second Sea\")\010                return true\010            end\010            -- 2) Ice Admiral vivo: mata\010            local boss = findEnemy({ \"Ice Admiral\" })\010            if boss then\010                set(\"Auto Sea 2: killing the Ice Admiral\")\010                fightEnemy(boss, { boss.Name }, false)\010                return true\010            end\010            -- 3) Key do Detective (so precisa se a porta ainda esta fechada)\010            local open = iceDoorOpen()\010            local key = tool(\"Key\")\010            if not key and not open then\010                if (SF.cool.s2key or 0) > os.clock() then\010                    note(\"Auto Sea 2: the Detective did not give the Key (reply: \" .. tostring(SF.s2Reply) .. \") - paused for 2 min\")\010                    return false\010                end\010                local dn = findNpc({ \"detective\" })\010                if dn and not goTo(dn, 20, \"the Detective\") then return true end\010                if every(\"s2key\", 5) then\010                    SF.keyN = (SF.keyN or 0) + 1\010                    if SF.keyN > 6 then\010                        SF.keyN, SF.cool.s2key = 0, os.clock() + 120\010                        return false\010                    end\010                    local _, r = invoke(\"DressrosaQuestProgress\", \"Detective\")\010                    SF.s2Reply = tostring(r)\010                end\010                set(\"Auto Sea 2: asking the Detective for the Key (reply: \" .. tostring(SF.s2Reply) .. \")\")\010                return true\010            end\010            SF.keyN = 0\010            if key then equipTool(key) end\010            -- 4) vai ate a porta do Ice Castle com a Key na mao\010            if not goTo(ICE_DOOR, 12, \"the Ice Castle door\") then return true end\010            if open then\010                local sp = findSpawn({ \"Ice Admiral\" })\010                if sp and (sp.Position - ICE_DOOR.Position).Magnitude > 30 then\010                    set(\"Auto Sea 2: flying to the Ice Admiral spawn\")\010                    flyTo(sp.CFrame * CFrame.new(0, 25, 0))\010                    return true\010                end\010            end\010            -- 5) o Ice Admiral ja morreu (ou vai nascer): tenta viajar de tempos em tempos\010            if every(\"s2travel\", 15) then\010                SF.s2TravelN = (SF.s2TravelN or 0) + 1\010                if SF.s2TravelN > 40 then\010                    SF.s2TravelN, SF.cool.sea2 = 0, os.clock() + 300\010                    return false\010                end\010                invoke(\"TravelDressrosa\")\010            end\010            set(open and \"Auto Sea 2: door open - waiting for the Ice Admiral / sea change\"\010                or \"Auto Sea 2: at the Ice Castle door with the Key\")\010            return true\010        end\010\010        -- ===== Mar 3: missao do Bartilo. Retorna (ocupado, concluida) =====\010        local function bartiloStep()\010            if os.clock() - (SF.bartAt or 0) > 2 then\010                SF.bartAt = os.clock()\010                local ok, p = invoke(\"BartiloQuestProgress\", \"Bartilo\")\010                if ok then SF.bartVal, SF.bartErr = p, nil else SF.bartVal, SF.bartErr = \"err\", tostring(p) end\010            end\010            local p = SF.bartVal\010            if p == \"err\" then\010                note(\"Auto Sea 3: could not read Bartilo's quest (\" .. tostring(SF.bartErr) .. \")\")\010                return false, false\010            end\010            if p == 0 then\010                -- Swan Pirates x50\010                local okq, vis, known = pcall(questVisible)\010                local haveQuest = okq and known and vis\010                if not haveQuest and os.clock() - (SF.at.s3quest or 0) > 30 then\010                    if not goTo(BARTILO_NPC, 14, \"Bartilo\") then return true, false end\010                    SF.at.s3quest = os.clock()\010                    invoke(\"StartQuest\", \"BartiloQuest\", 1)\010                    set(\"Auto Sea 3: took Bartilo's quest\")\010                    return true, false\010                end\010                local e = findEnemy({ \"Swan Pirate\" })\010                if e then\010                    set(\"Auto Sea 3: Bartilo's quest - killing Swan Pirates\")\010                    fightEnemy(e, { e.Name }, true)\010                    return true, false\010                end\010                local sp = findSpawn({ \"Swan Pirate\" })\010                set(\"Auto Sea 3: Bartilo's quest - going to the Swan Pirates\")\010                flyTo((sp and sp.CFrame or SWAN_AREA) * CFrame.new(0, 25, 0))\010                return true, false\010            elseif p == 1 then\010                -- Jeremy\010                local e = findEnemy({ \"Jeremy\" })\010                if e then\010                    set(\"Auto Sea 3: Bartilo's quest - killing Jeremy\")\010                    fightEnemy(e, { e.Name }, false)\010                    return true, false\010                end\010                if not goTo(JEREMY_POS, 15, \"Jeremy\") then return true, false end\010                set(\"Auto Sea 3: Bartilo's quest - waiting for Jeremy to spawn\")\010                return true, false\010            elseif p == 2 then\010                -- placas\010                local _, hrp = getChar()\010                if not hrp then return true, false end\010                SF.plate = SF.plate or 1\010                local tgt = CFrame.new(PLATES[SF.plate] + V3(0, 1, 0))\010                if (hrp.Position - tgt.Position).Magnitude > 4 then\010                    set(\"Auto Sea 3: Bartilo's quest - stepping on the plates (\" .. SF.plate .. \"/\" .. #PLATES .. \")\")\010                    flyTo(tgt)\010                    return true, false\010                end\010                SF.plateAt = SF.plateAt or os.clock()\010                if os.clock() - SF.plateAt < 0.7 then\010                    set(\"Auto Sea 3: Bartilo's quest - stepping on the plates (\" .. SF.plate .. \"/\" .. #PLATES .. \")\")\010                    return true, false\010                end\010                SF.plateAt = nil\010                SF.plate = SF.plate + 1\010                if SF.plate > #PLATES then SF.plate = 1 end\010                return true, false\010            end\010            return false, true -- 3 ou qualquer outra resposta: missao concluida\010        end\010\010        local function sea3Step()\010            local sea = getSea()\010            if sea == 3 then return false end\010            if sea == 1 then return sea2Step() end -- sozinho, o Auto Sea 3 tambem leva do Mar 1 ao Mar 2\010            if sea ~= 2 then return false end\010            local lv = myLevel()\010            if lv < 850 then\010                note(\"Auto Sea 3: needs level 850 for Bartilo's quest (you are level \" .. lv .. \") - another farm raises the level\")\010                return false\010            end\010            if (SF.cool.sea3 or 0) > os.clock() then\010                note(\"Auto Sea 3: paused for a few minutes (TravelZou reply: \" .. tostring(SF.s3Reply) .. \", ZQuest check: \" .. tostring(SF.zCheck) .. \")\")\010                return false\010            end\010            local busy, done = bartiloStep()\010            if busy then return true end\010            if not done then return false end\010            if lv < 1500 then\010                note(\"Auto Sea 3: Bartilo's quest is done; the Third Sea needs level 1500 (you are level \" .. lv .. \")\")\010                return false\010            end\010            -- 1) viagem direta (ja liberada)\010            if not SF.s3Tried then\010                SF.s3Tried = true\010                SF.s3WaitUntil = os.clock() + 8\010                invoke(\"TravelZou\")\010            end\010            if os.clock() < (SF.s3WaitUntil or 0) then\010                set(\"Auto Sea 3: trying to travel to the Third Sea\")\010                return true\010            end\010            -- 2) bosses do caminho do Mar 3\010            local boss = findEnemy({ \"rip_indra\", \"Rip_Indra\", \"Don Swan\" })\010            if boss then\010                set(\"Auto Sea 3: killing \" .. boss.Name)\010                fightEnemy(boss, { boss.Name }, false)\010                return true\010            end\010            -- 3) tenta a missao Zou / viagem de tempos em tempos\010            if every(\"s3z\", 15) then\010                SF.s3N = (SF.s3N or 0) + 1\010                if SF.s3N > 20 then\010                    SF.s3N, SF.cool.sea3 = 0, os.clock() + 300\010                    return false\010                end\010                local _, c = invoke(\"ZQuestProgress\", \"Check\")\010                SF.zCheck = tostring(c)\010                if c == 0 then invoke(\"ZQuestProgress\", \"Begin\") end\010                local _, r = invoke(\"TravelZou\")\010                SF.s3Reply = tostring(r)\010            end\010            if not goTo(DON_SWAN_ROOM, 25, \"Don Swan's room\") then return true end\010            set(\"Auto Sea 3: waiting - TravelZou reply: \" .. tostring(SF.s3Reply) .. \" | ZQuest check: \" .. tostring(SF.zCheck))\010            return true\010        end\010\010        SF.sea2Step, SF.sea3Step = sea2Step, sea3Step\010    end\010\010    -- ---------- passo do scheduler ----------\010    local ORDER = {\010        { \"SubSea2\", SF.sea2Step }, { \"SubSea3\", SF.sea3Step },\010        { \"SubC2\", c2Step },\010        { \"SubGod\", function() return ensure(GOD) end }, { \"SubV2\", function() return ensure(SUP) end }, { \"SubDT\", function() return ensure(DT) end },\010        { \"SubDS\", function() return ensure(DS) end }, { \"SubSK\", function() return ensure(SK) end }, { \"SubEC\", function() return ensure(EC) end },\010        { \"SubSan\", function() return ensure(SAN) end }, { \"SubBL\", function() return ensure(BL) end }, { \"SubEl\", function() return ensure(EL) end },\010        { \"SubFK\", function() return ensure(FK) end }, { \"SubDC\", function() return ensure(DC) end },\010        { \"SubYama\", yamaStep }, { \"SubTushita\", tushitaStep }, { \"SubCDK\", cdkStep }, { \"SubFullTTK\", ttkFullStep },\010    }\010    function SF.listed()\010        for _, o in ipairs(ORDER) do if Config[o[1]] then return true end end\010        return false\010    end\010    function SF.step()\010        if not getChar() then return false end\010        for _, o in ipairs(ORDER) do\010            if Config[o[1]] then\010                local ok, busy = pcall(o[2])\010                if not ok then AFL.logErr(\"SubFarm \" .. o[1], busy)\010                elseif busy then return true end\010            end\010        end\010        return false\010    end\010\010    -- ---------- UI ----------\010    local function sub(text)\010        local seen = {}\010        local scanRoot = T.Container or Window.Root\010        for _, x in ipairs(scanRoot:GetDescendants()) do\010            if x:IsA(\"TextLabel\") then seen[x] = true end\010        end\010        pcall(function() T:AddSection(text) end)\010        for _, x in ipairs(scanRoot:GetDescendants()) do\010            if x:IsA(\"TextLabel\") and not seen[x] and x.Text == text then\010                pcall(function() x.TextSize = 12; x.TextTransparency = 0.15 end)\010                break\010            end\010        end\010    end\010    local function tog(id, title, desc)\010        T:AddToggle(id, { Title = title, Description = desc, Default = Config[id] and true or false })\010            :OnChanged(function(v) Config[id] = v; persist() end)\010    end\010\010    T:AddSection(\"Sub Farm\")\010    local info = T:AddParagraph({ Title = \"Status\", Content = \"idle\" })\010    local mast = T:AddParagraph({ Title = \"Melee mastery\", Content = \"...\" })\010    task.spawn(function()\010        while Alive do\010            pcall(function()\010                local txt = SF.status\010                if SF.legStatus and Config.SubLegSword then txt = txt .. \"\\n\" .. SF.legStatus end\010                if SF.ttkStatus and Config.SubTTK then txt = txt .. \"\\n\" .. SF.ttkStatus end\010                info:SetDesc(txt)\010                local parts = {}\010                for _, n in ipairs({ \"Black Leg\", \"Electro\", \"Fishman Karate\", \"Dragon Claw\", \"Superhuman\", \"Death Step\", \"Sharkman Karate\", \"Electric Claw\", \"Dragon Talon\", \"Godhuman\", \"Sanguine Art\" }) do\010                    if tool(n) then parts[#parts + 1] = n .. \" \" .. lvl(n) end\010                end\010                mast:SetDesc(#parts > 0 and table.concat(parts, \" | \") or \"No melee found yet\")\010            end)\010            task.wait(2)\010        end\010    end)\010    tog(\"SubTravel\", \"Auto travel between seas\",\010        \"Lets the Sub Farm options switch seas by themselves (TravelMain / TravelDressrosa / TravelZou) when a step needs another sea. Off = it only tells you which sea to go to.\")\010\010    T:AddSection(\"Seas\")\010    tog(\"SubSea2\", \"Auto Sea 2\",\010        \"First Sea, level 700+: asks the Detective for the Key, opens the Ice Castle door, kills the Ice Admiral and travels to the Second Sea by itself. Below level 700 it does nothing, so your level farm keeps running.\")\010    tog(\"SubSea3\", \"Auto Sea 3\",\010        \"Second Sea: does Bartilo's quest (50 Swan Pirates, Jeremy, plates), kills Don Swan / Rip_Indra if they are up, and travels to the Third Sea at level 1500. Turned on in the First Sea it also does Auto Sea 2 first. The Status line shows each step and the server replies.\")\010\010    T:AddSection(\"Unlock Melees\")\010    tog(\"SubGod\", \"Auto God Human\",\010        \"Buys / trains everything Godhuman needs (Superhuman, Death Step, Sharkman Karate, Electric Claw, Dragon Talon at 400 mastery), farms the materials (Fish Tail 20, Magma Ore 20, Mystic Droplet 10, Dragon Scale 10) and buys it at the Ancient Monk. Needs the beli / fragments.\")\010    tog(\"SubC2\", \"Auto Combat v2 (Advanced Combat)\",\010        \"Automatic Advanced Combat: does ALL the Sea 1 Island Secrets (every island, ignores the selection), flies you to the Remove Blox Fruit NPC when they are done, keeps Combat equipped, triggers and kills the Awakened bosses (counted in Status), then flies you to the Secrets Master. Only the dialogue choices (remove fighting style / take Advanced Combat) are yours.\")\010    tog(\"SubV2\", \"Auto Superhuman\",\010        \"Buys Dark Step, Electro, Water Kung Fu and Dragon Breath, trains each to 300 mastery, then buys Superhuman at the Martial Arts Master.\")\010    tog(\"SubDT\", \"Auto Dragon Talon\", \"Dragon Breath 400 mastery + Fire Essence (spend Bones at the Death King) -> Uzoth in the Third Sea.\")\010    tog(\"SubDS\", \"Auto Death Step\", \"Black Leg 400 mastery + Library Key (Awakened Ice Admiral) -> Phoeyu in the Second Sea.\")\010    tog(\"SubSK\", \"Auto Sharkman Karate\", \"Fishman Karate 400 mastery + Water Key (Tide Keeper) -> Sharkman teacher in the Second Sea.\")\010    tog(\"SubEC\", \"Auto Electric Claw\", \"Electro 400 mastery -> Previous Hero (Floating Turtle), then the timed run to the Mansion.\")\010    tog(\"SubSan\", \"Auto Sanguine Art\", \"Farms 20 Vampire Fang + 20 Demonic Wisp, needs a Leviathan Heart (kill the Leviathan yourself), then buys it from Shafi in the Third Sea.\")\010    sub(\"Basic styles\")\010    tog(\"SubBL\", \"Auto Black Leg (Dark Step)\", \"Buys it from the Dark Step Teacher.\")\010    tog(\"SubEl\", \"Auto Electro\", \"Buys it from the Mad Scientist.\")\010    tog(\"SubFK\", \"Auto Fishman Karate\", \"Buys it from the Water Kung-fu Teacher.\")\010    tog(\"SubDC\", \"Auto Dragon Breath\", \"Buys it for 1,500 fragments from Sabi (Kingdom of Rose, Second Sea).\")\010\010    T:AddSection(\"Swords\")\010    sub(\"CDK\")\010    tog(\"SubYama\", \"Auto Fully Yama\", \"Sea 3: hops until 30 Elite Hunters are dead, then takes the Yama.\")\010    tog(\"SubTushita\", \"Auto Fully Tushita\", \"Sea 3: Hydra Island > Rip_Indra server (Quantum API) > Holy Torch > Longma.\")\010    tog(\"SubCDK\", \"Auto Fully CDK\", \"Gets Yama and Tushita if missing, trains them to 400 mastery and runs the Cursed Dual Katana trials (Pain, Haze, Hell, Boat, Raid, Heavenly, Alucard).\")\010    sub(\"TTK\")\010    tog(\"SubFullTTK\", \"Auto Fully TTK\", \"Does the whole True Triple Katana by itself: buys Shizu, Saishi and Oroshi at the Legendary Sword Dealer (Sea 2, hops servers when the dealer has nothing), trains each sword to 300 mastery (raises to 350 if needed) and buys the TTK from the Mysterious Man. Needs the Beli for the swords.\")\010    tog(\"SubTTK\", \"Auto Buy TTK\", \"Asks the Mysterious Man for the True Triple Katana every few seconds (needs Shizu, Saishi and Oroshi at 300 mastery).\")\010    tog(\"SubLegSword\", \"Auto Buy Legendary Swords\", \"Second Sea: asks the Legendary Sword Dealer for a sword every few seconds and buys it (Shizu / Saishi / Oroshi). Works from anywhere in the sea.\")\010    tog(\"SubLegHop\", \"Hop when the dealer has no sword\", \"Only with Auto Buy Legendary Swords on: server hops when the dealer has nothing.\")\010\010    -- botoes de apoio do Combat v2\010    local tok\010    local function fly(pos, label)\010        local mine = {}\010        tok = mine\010        Fluent:Notify({ Title = \"Moon Decompiled Hub - Sub Farm\", Content = \"Flying to \" .. label, Duration = 3 })\010        task.spawn(function()\010            local t0 = os.clock()\010            while Alive and tok == mine and os.clock() - t0 < 150 do\010                local _, hrp = getChar()\010                if not hrp or (hrp.Position - pos).Magnitude < 8 then break end\010                flyTo(CFrame.new(pos + Vector3.new(0, 3, 0)))\010                task.wait(0.25)\010            end\010            if tok == mine then tok = nil end\010        end)\010    end\010    T:AddButton({ Title = \"Reset Combat v2 boss counter\", Description = \"Forgets which Awakened bosses were counted\",\010        Callback = function() Config.SubC2Kills = {}; persist() end })\010    T:AddButton({ Title = \"Fly To The Remove Blox Fruit NPC\", Description = \"Top of the Prison: remove your fruit, then 'Remove my Fighting Style' (needed for Combat v2)\",\010        Callback = function() fly(V3(5262.8, 345.9, 766.7), \"Remove Blox Fruit NPC\") end })\010    T:AddButton({ Title = \"Fly To The Secrets Master\", Description = \"Middle Town: final step of Combat v2\",\010        Callback = function() fly(V3(-838.9, 28.4, 1603.1), \"Secrets Master\") end })\010end)()\010\010\010\010\010";
        end;
        DV.src.mastery = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Aim, Config, FruitM1, LV, Player, State, Tabs = __E.Aim, __E.Config, __E.FruitM1, __E.LV, __E.Player, __E.State, __E.Tabs\010local aliveParts, enemiesList, fightEnemy, findEnemy, findSpawn, findTool, flyTo = __E.aliveParts, __E.enemiesList, __E.fightEnemy, __E.findEnemy, __E.findSpawn, __E.findTool, __E.flyTo\010local getChar, getSea, invoke, persist = __E.getChar, __E.getSea, __E.invoke, __E.persist\010local VirtualInputManager = game:GetService(\"VirtualInputManager\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ---------- Farm Mastery ----------\010-- Banana (Farm Mastery: bate normal at\195\169 o mob chegar em X% de vida e termina com fruta/gun) + Quantum (Enable Mastery / Health Mob% / Auto Mastery Swords).\010(function()\010    local T = Tabs.Mastery\010    local M = {}\010    AFL.Mast = M\010    local function d(k, v) if Config[k] == nil then Config[k] = v end end\010    d(\"MastOn\", false); d(\"MastMethod\", \"Blox Fruit\"); d(\"MastHP\", 40); d(\"MastKeys\", { Z = true, X = true, C = true, V = true })\010    d(\"MastGunKeys\", { M1 = true, Z = true, X = true }); d(\"MastMode\", \"Finish at Health %\")\010    d(\"MastGunAim\", true); d(\"MastAim\", true); d(\"MastFast\", true); d(\"MastHold\", 0.3); d(\"MastAllSword\", false); d(\"MastAllMelee\", false); d(\"MastAllGun\", false); d(\"MastAllFruit\", false)\010    local KEYS = { \"Z\", \"X\", \"C\", \"V\", \"F\" }\010    local ki, keyAt = 0, 0\010    M.status = \"idle\"\010\010    local function ratio(h) return h.MaxHealth > 0 and (h.Health / h.MaxHealth) or 1 end\010    local function methodTool() return (findTool(Config.MastMethod)) end\010    -- mobs com pouca vida: o ataque normal ignora eles (ficam vivos) e a fruta/gun termina\010    local function onlyMode() return Config.MastMode == \"Mastery weapon only\" end\010    Config.MastSkip = function(h)\010        if not Config.MastOn or not h then return false end\010        if not onlyMode() and ratio(h) > (tonumber(Config.MastHP) or 40) / 100 then return false end\010        return methodTool() ~= nil\010    end\010    local function lowMob(hrp)\010        local f = workspace:FindFirstChild(\"Enemies\"); if not f then return end\010        local best, bd\010        local cur = M.lastMob\010        if cur and cur.Parent == f then\010            local h, r = cur:FindFirstChildOfClass(\"Humanoid\"), cur:FindFirstChild(\"HumanoidRootPart\")\010            if h and r and h.Health > 0 and (r.Position - hrp.Position).Magnitude <= 80 then return cur end\010        end\010        for _, m in ipairs(f:GetChildren()) do\010            local h, r = m:FindFirstChildOfClass(\"Humanoid\"), m:FindFirstChild(\"HumanoidRootPart\")\010            if h and r and h.Health > 0 and not m:GetAttribute(\"IsBoat\") and (onlyMode() or ratio(h) <= (tonumber(Config.MastHP) or 40) / 100) then\010                local dist = (r.Position - hrp.Position).Magnitude\010                if dist <= 80 and (not bd or dist < bd) then best, bd = m, dist end\010            end\010        end\010        M.lastMob = best\010        return best\010    end\010    -- aimbot da Mastery: crava a c\195\162mera no mob (com previs\195\163o de movimento) para fruta e gun sempre acertarem\010    local function aimAt(part)\010        if not (Config.MastAim and part and part.Parent) then return part and part.Position end\010        local pos = part.Position\010        pcall(function() pos = pos + part.AssemblyLinearVelocity * 0.1 end)\010        pcall(function()\010            local cam = workspace.CurrentCamera\010            if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, pos) end\010        end)\010        return pos\010    end\010    local function pickKey(set)\010        for _ = 1, #KEYS do\010            ki = ki % #KEYS + 1\010            if set[KEYS[ki]] then return KEYS[ki] end\010        end\010    end\010    -- uma rodada de ataques da arma de maestria: M1 (clique) e/ou a pr\195\179xima skill escolhida, com a mira cravada no mob\010    local function fireRound(kind, part)\010        local set = (kind == \"Gun\") and (Config.MastGunKeys or {}) or (Config.MastKeys or {})\010        Aim.part = part\010        local apos = aimAt(part)\010        if set.M1 then\010            if kind == \"Gun\" then\010                if Config.MastGunAim then\010                    -- aimbot de gun: crava a c\195\162mera no mob e clica com a arma (Tool:Activate)\010                    pcall(function()\010                        aimAt(part)\010                        local char = Player.Character\010                        local tool = char and char:FindFirstChildOfClass(\"Tool\")\010                        if tool then tool:Activate() end\010                    end)\010                    if Config.ShotFire then pcall(Config.ShotFire, { kind = \"gun\", part = part }) end\010                elseif Config.ShotFire then pcall(Config.ShotFire, { kind = \"gun\", part = part }) end\010            elseif kind == \"Melee\" or kind == \"Sword\" then\010                -- v60 fix: antes QUALQUER coisa que nao fosse \"Gun\" caia aqui e chamava FruitM1.tick (golpe de fruta) -\010                -- Melee/Sword na Mastery nunca davam o golpe de verdade. Agora usa o mesmo click unificado do motor principal.\010                pcall(Core.meleeSwordClick, kind)\010            else\010                pcall(FruitM1.tick)\010            end\010        end\010        local gap = Config.MastFast and 0.07 or ((tonumber(Config.MastHold) or 0.3) + 0.1)\010        if os.clock() - keyAt < gap then return true end\010        local key = pickKey(set)\010        if not key then\010            if not set.M1 then M.status = \"no skill / M1 selected for \" .. kind end\010            return true\010        end\010        keyAt = os.clock()\010        M.status = kind .. \": \" .. key .. (set.M1 and \" + M1\" or \"\") .. \" on \" .. tostring(part.Parent and part.Parent.Name)\010        pcall(AFL.tvHook)\010        AFL.TV.aimPos, AFL.TV.aimPart = apos or part.Position, part\010        pcall(function()\010            local kc = Enum.KeyCode[key]\010            VirtualInputManager:SendKeyEvent(true, kc, false, game)\010            task.wait(Config.MastFast and 0.03 or (tonumber(Config.MastHold) or 0.3))\010            VirtualInputManager:SendKeyEvent(false, kc, false, game)\010        end)\010        task.delay(0.2, function() if AFL.TV.aimPart == part then AFL.TV.aimPos, AFL.TV.aimPart = nil, nil end end)\010        return true\010    end\010    -- chamado pelo loop de ataque: devolve true quando a Mastery cuidou do tick (o ataque normal pula)\010    function M.tick()\010        -- Auto Farm ALL Gun 600: a arma de fogo equipada pelo farm atira no mob mais perto (M1 + skills escolhidas)\010        if Config.MastName and (M.curKind == \"Gun\" or M.curKind == \"Fruit\") then\010            local char, hrp = getChar()\010            local f = workspace:FindFirstChild(\"Enemies\")\010            if char and hrp and f then\010                local best, bd\010                for _, m in ipairs(f:GetChildren()) do\010                    local h, r = m:FindFirstChildOfClass(\"Humanoid\"), m:FindFirstChild(\"HumanoidRootPart\")\010                    if h and r and h.Health > 0 and not m:GetAttribute(\"IsBoat\") then\010                        local dist = (r.Position - hrp.Position).Magnitude\010                        if dist <= 120 and (not bd or dist < bd) then best, bd = r, dist end\010                    end\010                end\010                local held = char:FindFirstChildOfClass(\"Tool\")\010                if best and held and held.Name == Config.MastName then\010                    return fireRound(M.curKind, best)\010                end\010            end\010            return false\010        end\010        if not Config.MastOn then return false end\010        local char, hrp, hum = getChar()\010        if not char then return false end\010        local mob = lowMob(hrp)\010        if not mob then return false end\010        -- v30: enquanto acabando o mob, o equipWeapon do farm N\195\131O troca de volta para a arma normal (era o \"troca troca\")\010        Config.MastFinishUntil = os.clock() + 0.6\010        local tool, equipped = findTool(Config.MastMethod)\010        if not tool then M.status = \"no \" .. tostring(Config.MastMethod) .. \" in the backpack\"; return false end\010        if not equipped then hum:EquipTool(tool); M.status = \"equipping \" .. tool.Name; return true end\010        local part = mob:FindFirstChild(\"HumanoidRootPart\")\010        return fireRound(Config.MastMethod == \"Gun\" and \"Gun\" or \"Fruit\", part)\010    end\010    Config.MastTick = M.tick\010\010    -- Auto Farm ALL Sword/Melee 600: uma arma por vez (sticky) at\195\169 600, depois a pr\195\179xima, sem parar\010    local MAXM = 600\010    local MELEES = { [\"combat\"]=1, [\"black leg\"]=1, [\"electro\"]=1, [\"fishman karate\"]=1, [\"dragon claw\"]=1, [\"superhuman\"]=1, [\"death step\"]=1, [\"sharkman karate\"]=1, [\"electric claw\"]=1, [\"dragon talon\"]=1, [\"godhuman\"]=1, [\"sanguine art\"]=1, [\"advanced combat\"]=1 }\010    local function kind(t)\010        local tip = t.ToolTip\010        if tip == \"Sword\" or tip == \"Melee\" or tip == \"Gun\" then return tip end\010        if tip == \"Blox Fruit\" then return \"Fruit\" end\010        if MELEES[string.lower(t.Name)] then return \"Melee\" end\010        return nil\010    end\010    local function readMast(t)\010        local v = t:FindFirstChild(\"Level\") or t:FindFirstChild(\"Mastery\")\010        if v and v:IsA(\"ValueBase\") and tonumber(v.Value) then return tonumber(v.Value) end\010        local a = t:GetAttribute(\"Level\") or t:GetAttribute(\"Mastery\")\010        if tonumber(a) then return tonumber(a) end\010        return AFL.Inv.mastery and AFL.Inv.mastery(t.Name) or nil\010    end\010    M.readMast = readMast\010    local function tools(want)\010        local out = {}\010        for _, c in ipairs({ Player.Backpack, Player.Character }) do\010            if c then for _, t in ipairs(c:GetChildren()) do\010                if t:IsA(\"Tool\") and kind(t) == want then out[#out + 1] = t end\010            end end\010        end\010        return out\010    end\010    M.cur = nil\010    function M.pickWeapon()\010        Config.MastName = nil\010        for _, want in ipairs({ \"Sword\", \"Melee\", \"Gun\", \"Fruit\" }) do\010            if (want == \"Sword\" and Config.MastAllSword) or (want == \"Melee\" and Config.MastAllMelee) or (want == \"Gun\" and Config.MastAllGun) or (want == \"Fruit\" and Config.MastAllFruit) then\010                local list = tools(want)\010                -- continua na arma atual at\195\169 600\010                if M.cur and M.curKind == want then\010                    for _, t in ipairs(list) do\010                        if t.Name == M.cur then\010                            local m = readMast(t)\010                            if m and m < MAXM then Config.MastName = t.Name; M.weaponText = want .. \": \" .. t.Name .. \" (\" .. math.floor(m) .. \"/\" .. MAXM .. \")\"; return end\010                        end\010                    end\010                end\010                local best, bm, unk, done = nil, nil, 0, 0\010                for _, t in ipairs(list) do\010                    local m = readMast(t)\010                    if not m then unk += 1\010                    elseif m >= MAXM then done += 1\010                    elseif not bm or m < bm then best, bm = t, m end\010                end\010                if best then\010                    M.cur, M.curKind = best.Name, want\010                    Config.MastName = best.Name\010                    M.weaponText = want .. \": \" .. best.Name .. \" (\" .. math.floor(bm) .. \"/\" .. MAXM .. \") | done \" .. done .. \"/\" .. #list\010                    return\010                end\010                M.weaponText = want .. \": nothing to farm (\" .. done .. \" at 600, \" .. unk .. \" unreadable of \" .. #list .. \")\"\010            end\010        end\010    end\010    task.spawn(function()\010        while Alive do\010            pcall(M.pickWeapon)\010            task.wait(3)\010        end\010    end)\010    -- v26: o Auto 600 agora trabalha SOZINHO (antes so funcionava dentro de outra farm): mata o mob mais perto com a arma que esta subindo ate 600\010    function M.farm()\010        if not (Config.MastAllSword or Config.MastAllMelee or Config.MastAllGun or Config.MastAllFruit) then return false end\010        pcall(M.pickWeapon)\010        if not Config.MastName then M.status = \"Auto 600: every selected weapon is at 600 (or its mastery cannot be read)\"; return false end\010        local _, hrp = getChar()\010        if not hrp then return false end\010        local best, bd\010        for _, e in ipairs(enemiesList()) do\010            local h, r = aliveParts(e)\010            if h and r and not e:GetAttribute(\"IsBoat\") then\010                local dist = (r.Position - hrp.Position).Magnitude\010                if not bd or dist < bd then best, bd = e, dist end\010            end\010        end\010        if best and bd <= 700 then\010            M.status = \"Auto 600: \" .. tostring(M.weaponText or Config.MastName) .. \" on \" .. best.Name\010            State.Mode, State.Text = \"Auto Mastery 600\", M.status\010            fightEnemy(best, { best.Name }, true)\010            -- v60 fix: so o fightEnemy (golpe normal) rodava aqui - as skills escolhidas (MastKeys/MastGunKeys) e a mira\010            -- cravada no mob (fireRound/aimAt) nunca eram chamadas pro Auto 600 ALL, so pro \"Farm Mastery\" de 1 arma so.\010            local _, r = aliveParts(best)\010            if r then pcall(fireRound, M.curKind, r) end\010            return true\010        end\010        local sp\010        pcall(function()\010            local e = LV and LV.entry\010            if e and e.sp and e.sp[1] then sp = Vector3.new(e.sp[1][1], e.sp[1][2] + 25, e.sp[1][3]) end\010        end)\010        if not sp then\010            local f = workspace:FindFirstChild(\"_WorldOrigin\")\010            f = f and f:FindFirstChild(\"EnemySpawns\")\010            local nd\010            for _, s in ipairs(f and f:GetChildren() or {}) do\010                local p = s:IsA(\"BasePart\") and s or s:FindFirstChildWhichIsA(\"BasePart\")\010                if p then\010                    local dist = (p.Position - hrp.Position).Magnitude\010                    if not nd or dist < nd then nd, sp = dist, p.Position + Vector3.new(0, 25, 0) end\010                end\010            end\010        end\010        if sp then\010            M.status = \"Auto 600: flying to the mobs\"\010            State.Mode, State.Text = \"Auto Mastery 600\", M.status\010            flyTo(CFrame.new(sp)); return true\010        end\010        M.status = \"Auto 600: no mobs found\"\010        return false\010    end\010\010    -- ===== Auto Upgrade Materials (v29) =====\010    -- Farma os materiais do Ferreiro (Port Town) pra colocar estrela em Guns/Swords. Materiais comuns (Angel Wings, Scrap Metal,\010    -- Leather) caem de qualquer NPC no mar certo; os outros tem mob especifico (tabela conferida: bloxodes.com/wiki/blox-fruits/materials,\010    -- cruzada com os materiais de estilo de luta ja usados neste projeto). Angel Wings so existe no Mar 1 -> viaja pra la sozinho.\010    -- NAO automatiza o clique final no Ferreiro: nao achei o remote exato pra isso com seguranca, so farma e avisa quando tiver o suficiente.\010    d(\"FullMastMats\", false); d(\"MastMatTarget\", 15)\010    local MATS = {\010        { name = \"Angel Wings\", seas = { 1 } },\010        { name = \"Scrap Metal\", seas = { 1, 2, 3 } },\010        { name = \"Leather\", seas = { 1, 2, 3 } },\010        { name = \"Magma Ore\", seas = { 1, 2 }, mobs = { \"Military Soldier\", \"Military Spy\", \"Lava Pirate\" } },\010        { name = \"Fish Tail\", seas = { 1, 3 }, mobs = { \"Fishman Warrior\", \"Fishman Commando\" } },\010        { name = \"Mystic Droplet\", seas = { 2 }, mobs = { \"Sea Soldier\", \"Water Fighter\" } },\010        { name = \"Vampire Fang\", seas = { 2 }, mobs = { \"Vampire\" } },\010        { name = \"Dragon Scale\", seas = { 3 }, mobs = { \"Dragon Crew Warrior\", \"Dragon Crew Archer\" } },\010        { name = \"Demonic Wisp\", seas = { 3 }, mobs = { \"Demonic Soul\" } },\010    }\010    local MATSEACMD = { \"TravelMain\", \"TravelDressrosa\", \"TravelZou\" }\010    local matTravelAt, matTravelN = 0, 0\010    local function matWrongSea(seas)\010        local cur = getSea()\010        for _, s in ipairs(seas) do if s == cur then return false end end\010        local target = seas[1]\010        if not Config.FullTravel then M.status = \"Materials: go to Sea \" .. target .. \" yourself (Auto Travel is off in Auto Fully)\"; return true end\010        if os.clock() - matTravelAt > 25 then\010            matTravelAt = os.clock()\010            matTravelN += 1\010            if matTravelN <= 4 then invoke(MATSEACMD[target]) end\010        end\010        M.status = \"Materials: travelling to Sea \" .. target\010        return true\010    end\010    function M.materialsStep()\010        if not Config.FullMastMats then return false end\010        local target = tonumber(Config.MastMatTarget) or 15\010        for _, mat in ipairs(MATS) do\010            local have = 0\010            pcall(function() have = AFL.Inv.count(mat.name) end)\010            if have < target then\010                if matWrongSea(mat.seas) then State.Mode, State.Text = \"Auto Upgrade Materials\", M.status; return true end\010                State.Mode = \"Auto Upgrade Materials\"\010                M.status = string.format(\"Farming %s %d/%d\", mat.name, have, target)\010                State.Text = M.status\010                if mat.mobs then\010                    local e = findEnemy(mat.mobs)\010                    if e then fightEnemy(e, mat.mobs, true); return true end\010                    local sp = findSpawn(mat.mobs)\010                    if sp then flyTo(sp.CFrame * CFrame.new(0, 25, 0)); return true end\010                    M.status = \"Materials: no \" .. mat.mobs[1] .. \" found for \" .. mat.name\010                    return true\010                end\010                -- material comum (sem mob especifico): qualquer NPC do mar serve\010                local f = workspace:FindFirstChild(\"Enemies\")\010                local best, bd\010                local _, hrp = getChar()\010                if f and hrp then\010                    for _, e in ipairs(f:GetChildren()) do\010                        local eh, er = aliveParts(e)\010                        if eh and er then\010                            local dist = (er.Position - hrp.Position).Magnitude\010                            if not bd or dist < bd then best, bd = e, dist end\010                        end\010                    end\010                end\010                if best then fightEnemy(best, { best.Name }, true); return true end\010                M.status = \"Materials: waiting for mobs to farm \" .. mat.name\010                return true\010            end\010        end\010        M.status = \"Materials: all at \" .. target .. \"+ - go upgrade at the Blacksmith (Port Town)\"\010        return false\010    end\010\010    -- ===== UI =====\010    local function tg(id, title, desc)\010        T:AddToggle(id, { Title = title, Description = desc, Default = Config[id] and true or false }):OnChanged(function(v) Config[id] = v; persist() end)\010    end\010    T:AddSection(\"Mastery Farm\")\010    local MV = { \"Blox Fruit\", \"Gun\" }\010    T:AddDropdown(\"MastMethod\", { Title = \"Select Method Farm Mastery\", Description = \"Weapon that finishes the mobs (the one that gains mastery)\", Values = MV, Default = (Config.MastMethod == \"Gun\") and 2 or 1 })\010        :OnChanged(function(v) Config.MastMethod = v; persist() end)\010    T:AddSlider(\"MastHP\", { Title = \"Health %\", Description = \"The normal attack stops when the mob reaches this life; the fruit/gun finishes it\", Min = 15, Max = 100, Default = tonumber(Config.MastHP) or 40, Rounding = 0 })\010        :OnChanged(function(v) Config.MastHP = math.floor(v); persist() end)\010    tg(\"MastOn\", \"Farm Mastery\", \"Works inside the other farms (Level, Bones, Dough...): hits normally, then finishes each mob with the fruit skills or the gun\")\010    T:AddDropdown(\"MastMode\", { Title = \"Mastery Mode\", Description = \"Finish at Health % = hit with your Farm weapon, then finish with the mastery weapon | Mastery weapon only = never swaps: kills everything with the mastery weapon\", Values = { \"Finish at Health %\", \"Mastery weapon only\" }, Default = (Config.MastMode == \"Mastery weapon only\") and 2 or 1 })\010        :OnChanged(function(v) Config.MastMode = v; persist() end)\010    local function setOf(val)\010        local set = {}\010        if type(val) == \"table\" then for k, x in pairs(val) do if x == true then set[k] = true elseif type(x) == \"string\" then set[x] = true end end end\010        return set\010    end\010    local function copy(t) local o = {} for k, v in pairs(t or {}) do if v == true then o[k] = true end end return o end\010    T:AddSection(\"Skills (Blox Fruit)\")\010    T:AddDropdown(\"MastKeysDD\", { Title = \"Fruit Attacks\", Description = \"M1 = fruit click, Z X C V F = skills. Used on the mob with the aim locked on it\", Values = { \"M1\", \"Z\", \"X\", \"C\", \"V\", \"F\" }, Multi = true, Default = copy(Config.MastKeys) })\010        :OnChanged(function(val) Config.MastKeys = setOf(val); persist() end)\010    T:AddSection(\"Skills (Gun)\")\010    tg(\"MastAim\", \"Mastery Aimbot (always hit)\", \"Locks the camera on the mob with movement prediction before every fruit skill / gun shot so they always land\")\010    tg(\"MastGunAim\", \"Gun Aimbot (gun click)\", \"Locks the camera on the mob and clicks with the gun (Tool click) on every shot of the Farm Mastery / ALL Gun 600\")\010    T:AddDropdown(\"MastGunKeysDD\", { Title = \"Gun Attacks\", Description = \"M1 = gun shot (click), Z X = gun skills. Also used by Auto Farm ALL Gun 600\", Values = { \"M1\", \"Z\", \"X\" }, Multi = true, Default = copy(Config.MastGunKeys) })\010        :OnChanged(function(val) Config.MastGunKeys = setOf(val); persist() end)\010    tg(\"MastFast\", \"Use skill fast (don't hold)\", \"Taps the keys quickly. Off: holds each key for the time below\")\010    T:AddSlider(\"MastHold\", { Title = \"Skill Hold Time (s)\", Min = 0, Max = 3, Default = tonumber(Config.MastHold) or 0.3, Rounding = 1 })\010        :OnChanged(function(v) Config.MastHold = v; persist() end)\010    T:AddSection(\"Mastery Weapon\")\010    tg(\"MastAllSword\", \"Auto Farm ALL Sword 600\", \"Finds the sword below 600 mastery, equips it, farms it to 600, then switches to the next one, forever (one at a time)\")\010    tg(\"MastAllMelee\", \"Auto Farm ALL Melee 600\", \"Same for fighting styles: equips the one below 600 and farms it to 600, then the next (one at a time)\")\010    tg(\"MastAllFruit\", \"Auto Farm ALL Fruit 600\", \"Same for Blox Fruits in your backpack: equips the fruit below 600 mastery and uses its skills on the mobs until 600, then the next (one at a time)\")\010    tg(\"MastAllGun\", \"Auto Farm ALL Gun 600\", \"Same for guns: equips the gun below 600 mastery and shoots the mobs by remote until 600, then the next (one at a time)\")\010    T:AddSection(\"Upgrade Materials\")\010    tg(\"FullMastMats\", \"Auto Upgrade Gun & Sword (Farm Materials)\", \"Farms the Blacksmith materials (Scrap Metal, Angel Wings, Magma Ore...) one at a time; travels to Sea 1 by itself for Angel Wings (Sea 1 only). Does not click the final upgrade - notifies when you have enough\")\010    T:AddSlider(\"MastMatTarget\", { Title = \"Target per Material\", Min = 5, Max = 50, Default = math.clamp(tonumber(Config.MastMatTarget) or 15, 5, 50), Rounding = 0 })\010        :OnChanged(function(v) Config.MastMatTarget = math.floor(v); persist() end)\010    T:AddSection(\"Mastery Status\")\010    local info = T:AddParagraph({ Title = \"Mastery\", Content = \"Checking...\" })\010    task.spawn(function()\010        while Alive do\010            pcall(function()\010                info:SetDesc(table.concat({\010                    \"Method: \" .. tostring(Config.MastMethod) .. \" | finishes at \" .. tostring(Config.MastHP) .. \"% life | \" .. (Config.MastOn and \"ON\" or \"off\"),\010                    \"Now: \" .. tostring(M.status),\010                    \"Weapon being farmed: \" .. tostring(M.weaponText or \"-\"),\010                    \"Inventory: \" .. tostring(AFL.Inv.state),\010                }, \"\\n\"))\010            end)\010            task.wait(2)\010        end\010    end)\010end)()\010\010\010\010\010\010";
