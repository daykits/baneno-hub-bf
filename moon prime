\010    -- uma tentativa de comprar: Check + Select com a fruta na m\195\163o, depois espera o chip chegar\010    local function trySelect(adv)\010        if Config.PayMode == \"Fruit\" then\010            local f = R.heldFruit\010            if not (f and f.Parent) or not holdFruit(f) then return false, \"fruit is not in hand\" end\010            setHold(os.clock() + 25)\010        end\010        invoke(\"RaidsNpc\", \"Check\")\010        local ok, res = invoke(\"RaidsNpc\", \"Select\", Config.RaidType)\010        Diag.raid = string.format(\"Auto Pay (%s) %s -> %s\", Config.PayMode, Config.RaidType, ok and describe(res) or (\"error: \" .. tostring(res)))\010        local got = waitFor(hasChip, 2.5)\010        return got\010    end\010\010    -- v40: quando o pagamento com fruta falha, avisa na tela e copia o diagnostico (cole no chat para eu ver o que o jogo respondeu)\010    local function reportFail(reason)\010        if os.clock() - (R.reportAt or 0) < 60 then return end\010        R.reportAt = os.clock()\010        local bag = {}\010        for _, c in ipairs({ Player.Backpack, Player.Character }) do\010            for _, t in ipairs(c and c:GetChildren() or {}) do if t:IsA(\"Tool\") then bag[#bag + 1] = t.Name end end\010        end\010        local rep = table.concat({\010            \"Auto Pay: \" .. tostring(reason),\010            \"Sea \" .. tostring(getSea()) .. \" | Level \" .. tostring(getPlayerLevel()) .. \" | PayMode \" .. tostring(Config.PayMode) .. \" | Raid \" .. tostring(Config.RaidType) .. \" | Only-1M \" .. tostring(Config.PayOnly1M),\010            \"Inventory: \" .. tostring(R.invSummary),\010            \"Load: \" .. tostring(R.loadFail),\010            \"Bag: \" .. table.concat(bag, \", \"),\010        }, \"\\n\")\010        local okc = pcall(function() setclipboard(rep) end)\010        pcall(function()\010            Fluent:Notify({ Title = \"Moon Decompiled Hub - Auto Pay\", Content = tostring(reason) .. (okc and \"\\n(diagnostic copied: 