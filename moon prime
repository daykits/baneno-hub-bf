oked = setmetatable({}, { __mode = \"k\" }), boss = false, seenRev = -1, scanAt = 0, revAt = 0, pending = false }\010    local Watch = { rev = 0, folder = nil }\010    -- v53: o Tyrant pode nascer longe (fora do alcance de carregamento): ai o jogo guarda o modelo no ReplicatedStorage\010    V.tyrantFar = function()\010        local m = ReplicatedStorage:FindFirstChild(\"Tyrant of the Skies\")\010        if not m then return nil end\010        local h = m:FindFirstChildOfClass(\"Humanoid\")\010        local p = m:FindFirstChild(\"HumanoidRootPart\") or m.PrimaryPart\010        if p and (not h or h.Health > 0) then return p end\010    end\010\010    -- todos os nomes de mobs vivos na ilha (para matar TODOS, nao so o tipo da quest)\010    local function tikiNames(loc)\010        local names, seen = {}, {}\010        for _, n in ipairs(TikiMobs) do names[#names + 1] = n; seen[n] = true end\010        for _, e in ipairs(enemiesList()) do\010            local eh, er = aliveParts(e)\010            if eh and not seen[e.Name] and not string.find(e.Name, \"Tyrant\", 1, true) and (er.Position - loc).Magnitude < 1500 then\010                seen[e.Name] = true\010                names[#names + 1] = e.Name\010            end\010        end\010        return names\010    end\010    local function tikiLocation()\010        if Tiki.pos or os.clock() - Tiki.at < 20 then return Tiki.pos end\010        Tiki.at = os.clock()\010        local pos\010        pcall(function()\010            local wo = workspace:FindFirstChild(\"_WorldOrigin\")\010            local locs = wo and wo:FindFirstChild(\"Locations\")\010            if locs then\010                for _, p in ipairs(locs:GetChildren()) do\010                    if string.find(string.lower(p.Name), \"tiki\", 1, true) then\010                        pos = p:IsA(\"BasePart\") and p.Position or (p.PrimaryPart and p.PrimaryPart.Position)\010                        if pos then break end\010                    end\010                end\010            end\010            if not pos then\010                local map = workspace:FindFirstChild(\"Map\")\010                if map then\010                    for _, m in ipairs(map:GetChildren()) do\010                        if string.find(string.lower(m.Name), \"tiki\", 1, true) and m:IsA(\"Model\") then\010                            pos = m:GetPivot().Position\010                            break\010                        end\010                    end\010                end\010            end\010        end)\010        Tiki.pos = pos\010        return pos\010    end\010    -- pontos de spawn de mobs perto do Tiki (do mais perto do centro para o mais longe)\010    local function tikiSpawns(loc)\010        local folders = {}\010        local origin = workspace:FindFirstChild(\"_WorldOrigin\")\010        local f1 = origin and origin:FindFirstChild(\"EnemySpawns\")\010        local f2 = workspace:FindFirstChild(\"EnemySpawns\")\010        if f1 then table.insert(folders, f1) end\010        if f2 then table.insert(folders, f2) end\010        local out = {}\010        for _, folder in ipairs(folders) do\010            for _, sp in ipairs(folder:GetChildren()) do\010                if sp:IsA(\"BasePart\") and (sp.Position - loc).Magnitude < 1500 then\010                    out[#out + 1] = { cf = sp.CFrame, d = (sp.Position - loc).Magnitude }\010                end\010            end\010        end\010        table.sort(out, function(a, b) return a.d < b.d end)\010        return out\010    end\010    -- contador de mudancas da pasta Enemies (mob entrou/saiu): quem so precisa saber \"algo mudou?\" le Watch.rev\010    local function watchEnemies()\010        local f = workspace:FindFirstChild(\"Enemies\")\010        if f == Watch.folder then return f end\010        for _, c in ipairs(Watch.cons or {}) do pcall(function() c:Disconnect() end) end\010        Watch.folder, Watch.cons, Watch.rev = f, {}, Watch.rev + 1\010        if f then\010            local function bump() Watch.rev += 1 end\010            Watch.cons[1], Watch.cons[2] = f.ChildAdded:Connect(bump), f.ChildRemoved:Connect(bump)\010            table.insert(Connections, Watch.cons[1]); table.insert(Connections, Watch.cons[2])\010        end\010        return f\010    end\010    -- O jogo nao expoe o contador de kills; o script conta as mortes de mobs do Tiki que ele enxerga (usado so se o mapa\010    -- nao tiver o modelo dos olhos). 300 kills = 4 olhos. Zera quando o Tyrant nasce.\010    local function track()\010        if getSea() ~= 3 then return end\010        local loc = tikiLocation()\010        watchEnemies()\010        local now = os.clock()\010        if Watch.rev == Count.seenRev then\010            if now - Count.scanAt < 2 and not (Count.pending and now - Count.revAt < 3) then return end\010        else\010            Count.seenRev, Count.revAt = Watch.rev, now\010        end\010        Count.scanAt, Count.pending = now, false\010        if bossAlive(\"Tyrant of the Skies\") then\010            Count.boss, Count.n = true, 0 -- o boss nasceu: o ciclo foi consumido\010            V.needReset = true\010            return\010        end\010        Count.boss = false\010        for _, e in ipairs(enemiesList()) do\010            if not Count.hooked[e] then\010                local hum, er = e:FindFirstChildOfClass(\"Humanoid\"), e:FindFirstChild(\"HumanoidRootPart\")\010                if not (hum and er) then Count.pending = true end\010                if hum and er and hum.Health > 0 then\010                    Count.hooked[e] = true\010                    if not string.find(e.Name, \"Tyrant\", 1, true)\010                        and ((loc and (er.Position - loc).Magnitude < 1500) or matchName(e.Name, TikiMobs)) then\010                        local done, c1, c2 = false, nil, nil\010                        local function dead()\010                            if done then return end\010                            done = true\010                            if c1 then c1:Disconnect() end\010                            if c2 then c2:Disconnect() end\010                            if not Count.boss then Count.n = math.min(TyrantNeed, Count.n + 1) end\010                        end\010                        c1 = hum.Died:Connect(dead)\010                        c2 = hum:GetPropertyChangedSignal(\"Health\"):Connect(function()\010                            if hum.Health <= 0 then dead() end\010                        end)\010                    end\010                end\010            end\010        end\010    end\010    task.spawn(function()\010        while Alive do\010            if Config.KillTyrant then pcall(track) end\010            task.wait(0.25)\010        end\010    end)\010\010    -- olhos: lidos do mapa (TikiOutpost.IslandModel.Eye1..4, Transparency == 0)\010    local function eyes()\010        local map = workspace:FindFirstChild(\"Map\")\010        local tiki = map and map:FindFirstChild(\"TikiOutpost\")\010        local island = tiki and tiki:FindFirstChild(\"IslandModel\")\010        if not island then return 0, false end\010        local c = 0\010        for i = 1, 4 do\010            local eye = island:FindFirstChild(\"Eye\" .. i, true)\010            if eye and eye:IsA(\"BasePart\") and eye.Transparency == 0 then c += 1 end\010        end\010        return c, true\010    end\010\010    -- vasos: arma e teclas escolhidas na aba Normal Farm. Padrao: Skull Guitar com M1 + X\010    local function potWeapon()\010        local w = Config.PotWeapon\010        if type(w) ~= \"string\" or w == \"\" then w = \"Skull Guitar\" end\010        return w\010    end\010    local function potKeys()\010        local k = Config.PotKeys\010        if type(k) ~= \"table\" or next(k) == nil then return { M1 = true, X = true } end\010        return k\010    end\010    local function potKey(name)\010        local kc = Enum.KeyCode[name]\010        if not kc then return end\010        pcall(function()\010            VirtualInputManager:SendKeyEvent(true, kc, false, game)\010            task.wait(0.1)\010            VirtualInputManager:SendKeyEvent(false, kc, false, game)\010        end)\010    end\010    -- mira PARA BAIXO (camera -89 graus + hook no mouse) e executa a acao\010    local function aimDown(pos, action)\010        local char = Player.Character\010        if not char then return end\010        local params = RaycastParams.new()\010        params.FilterType = Enum.RaycastFilterType.Exclude\010        params.FilterDescendantsInstances = { char, workspace:FindFirstChild(\"Enemies\") or char }\010        local hit = workspace:Raycast(pos, Vector3.new(0, -300, 0), params)\010        local aimPos = hit and hit.Position or (pos - Vector3.new(0, 20, 0))\010        local aimPart = hit and hit.Instance\010        AFL.tvHook()\010        V.aimPos, V.aimPart = aimPos, aimPart\010        local cam = workspace.CurrentCamera\010        pcall(function() RunService:UnbindFromRenderStep(\"MoonHubAimDown\") end)\010        pcall(function()\010            RunService:BindToRenderStep(\"MoonHubAimDown\", Enum.RenderPriority.Camera.Value + 2, function()\010                local _, yaw = cam.CFrame:ToOrientation()\010                cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.fromOrientation(-math.rad(89), yaw, 0)\010            end)\010        end)\010        task.wait(0.2)\010        pcall(action, aimPos, aimPart)\010        pcall(function() RunService:UnbindFromRenderStep(\"MoonHubAimDown\") end)\010        V.aimPos, V.aimPart = nil, nil\010    end\010    local function shoot(pos)\010        aimDown(pos, function(aimPos, aimPart)\010            local char = Player.Character\010            local hum = char and char:FindFirstChildOfClass(\"Humanoid\")\010            local netF = ReplicatedStorage:FindFirstChild(\"Modules\") and ReplicatedStorage.Modules:FindFirstChild(\"Net\")\010            local shootEvent = netF and netF:FindFirstChild(\"RE/ShootGunEvent\")\010            local cam = workspace.CurrentCamera\010            local keys = potKeys()\010            local function sgTool()\010                local tool = char and char:FindFirstChildOfClass(\"Tool\")\010                if not (tool and tool.Name == \"Skull Guitar\") then\010                    local g = Player.Backpack:FindFirstChild(\"Skull Guitar\")\010                    if g and hum then hum:EquipTool(g) task.wait(0.3) end\010                    tool = char and char:FindFirstChildOfClass(\"Tool\")\010                end\010                return tool\010            end\010            for _ = 1, (keys.M1 and 5 or 0) do\010                if not (Alive and Config.KillTyrant) then return end\010                local tool = sgTool()\010                if not tool then return end\010                pcall(function() tool:Activate() end)\010                pcall(function()\010                    VirtualUser:CaptureController()\010                    VirtualUser:Button1Down(Vector2.new(1280, 672))\010                    VirtualUser:Button1Up(Vector2.new(1280, 672))\010                end)\010                if mouse1click then pcall(mouse1click) end\010                pcall(function()\010                    local s = cam.ViewportSize\010                    local cx, cy = s.X / 2, s.Y / 2\010                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, true, game, 0)\010                    VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, game, 0)\010                end)\010                pcall(function()\010                    local s = cam.ViewportSize\010                    local cx, cy = s.X / 2, s.Y / 2\010                    VirtualInputManager:SendTouchEvent(1, 0, cx, cy)\010                    task.wait(0.05)\010                    VirtualInputManager:SendTouchEvent(1, 2, cx, cy)\010                end)\010                if shootEvent then pcall(shootEvent.FireServer, shootEvent, aimPos, { aimPart }) end\010                local sf = tool:FindFirstChild(\"RemoteFunctionShoot\")\010                if sf then task.spawn(pcall, sf.InvokeServer, sf, aimPos, aimPart) end\010                task.wait(0.3)\010            end\010            for _, k in ipairs({ \"Z\", \"X\", \"C\", \"V\", \"F\" }) do\010                if not (Alive and Config.KillTyrant) then return end\010                if keys[k] and sgTool() then\010                    potKey(k)\010                    task.wait(0.4)\010                end\010            end\010        end)\010    end\010    -- sem Skull Guitar: cada arma que voce tiver (fruta, melee, espada, gun): M1 por ~1s + skills Z X C V F\010    local function skills(abort, only)\010        local char = Player.Character\010        local hum = char and char:FindFirstChildOfClass(\"Humanoid\")\010        if not hum then return end\010        local keys = only and potKeys() or nil\010        for _, tip in ipairs(only and { only } or { \"Blox Fruit\", \"Melee\", \"Sword\", \"Gun\" }) do\010            if abort() then return end\010            local tool = findTool(tip)\010            if tool then\010                hum:EquipTool(tool)\010                task.wait(0.3)\010                local t0 = os.clock()\010                while (not keys or keys.M1) and os.clock() - t0 < 1.2 and not abort() do\010                    if tip == \"Melee\" then\010                        pcall(cfAttack)\010                    elseif tip == \"Blox Fruit\" then\010                        -- v53: M1 de fruta pelo motor do Premium (remote mirado) + Activate: bem mais rapido\010                        pcall(Core.fruitTick)\010                        pcall(function() tool:Activate() end)\010                    else\010                        pcall(function() tool:Activate() end)\010                    end\010                    task.wait(tip == \"Blox Fruit\" and 0.03 or 0.06)\010                end\010                local low = string.lower(tool.Name)\010                local isTransform = false\010                for _, w in ipairs(V.transform) do\010                    if tip == \"Blox Fruit\" and string.find(low, w, 1, true) then isTransform = true end\010                end\010                for _, k in ipairs({ \"Z\", \"X\", \"C\", \"V\", \"F\" }) do\010                    if abort() then return end\010                    if (not keys or keys[k]) and not (isTransform and k == \"V\" and not keys) then\010                        potKey(k)\010                        task.wait(0.3)\010                    end\010                end\010            end\010        end\010    end\010    -- uma rodada nos 4 vasos (em segundo plano; so inicia se nao houver outra em andamento)\010    local function round()\010        if V.running then return end\010        V.running = true\010        task.spawn(function()\010            local function abort()\010                if not (Alive and Config.KillTyrant and Config.TyrantSpawn) then return true end\010                if bossAlive(\"Tyrant of the Skies\") ~= nil or V.tyrantFar() ~= nil then return true end\010                -- v53: outra funcao (ou o Safe Mode) pegou o personagem: para a rodada em vez de brigar com ela pelo voo\010                if Core.owner and Core.owner ~= \"Auto Tyrant\" then return true end\010                return false\010            end\010            local ok, err = pcall(function()\010                for i, pos in ipairs(V.vases) do\010                    if abort() then break end\010                    V.idx = i\010                    local cf = CFrame.new(pos)\010                    local t0 = os.clock()\010                    while not abort() and os.clock() - t0 < 60 do\010                        local _, hrp = getChar()\010                        if not hrp or (hrp.Position - pos).Magnitude <= 8 then break end\010                        flyTo(cf)\010                        task.wait(0.1)\010                    end\010                    if abort() then break end\010                    local _, hrp = getChar()\010                    if hrp then\010                        if currentTween then currentTween:Cancel() end\010                        hrp.CFrame = cf\010                        hrp.AssemblyLinearVelocity = Vector3.zero\010                    end\010                    local pw = potWeapon()\010                    if pw ~= \"Skull Guitar\" and pw ~= \"All weapons\" and findTool(pw) then\010                        Diag.summon = string.format(\"Auto Tyrant step 2: pot %d/%d with %s (selected keys)\", i, #V.vases, pw)\010                        aimDown(pos, function() skills(abort, pw) end)\010                    elseif pw == \"Skull Guitar\" and findToolByName(\"skull guitar\") then\010                        Diag.summon = string.format(\"Auto Tyrant step 2: pot %d/%d with the Skull Guitar\", i, #V.vases)\010                        shoot(pos)\010                    else\010                        if os.clock() - V.warnAt > 30 then\010                            V.warnAt = os.clock()\010                            pcall(function() Fluent:Notify({ Title = \"Moon Decompiled Hub - Tyrant\", Content = \"No Skull Guitar: using M1 + weapon skills\", Duration = 5 }) end)\010                        end\010                        Diag.summon = string.format(\"Auto Tyrant step 2: pot %d/%d with M1 + skills (no Skull Guitar)\", i, #V.vases)\010                        aimDown(pos, function() skills(abort) end)\010                    end\010                    local t1 = os.clock()\010                    while os.clock() - t1 < 0.6 and not abort() do task.wait(0.1) end   -- v53: 2 s -> 0,6 s entre os vasos\010                end\010                V.done += 1\010            end)\010            if not ok then Diag.summon = \"Auto Tyrant step 2: error \" .. tostring(err) end\010            pcall(function() RunService:UnbindFromRenderStep(\"MoonHubAimDown\") end)\010            V.aimPos, V.aimPart = nil, nil\010            V.running = false\010        end)\010    end\010\010    function TyrantApi.statusText()\010        if getSea() ~= 3 then return \"Only works in Sea 3\" end\010        if Count.boss then return \"Tyrant of the Skies has already spawned! (count reset)\" end\010        local left = math.max(0, TyrantNeed - Count.n)\010        local tag = Config.KillTyrant and \"\" or \"  [Auto Tyrant off]\"\010        local eyesRead, known = eyes()\010        if known then\010            if eyesRead >= 4 then\010                return string.format(\"Eyes 4/4 lit - step 2: breaking the pots (rounds: %d). Then the Tyrant spawns.%s\", V.done or 0, tag)\010            end\010            return string.format(\"Eyes %d/4 (read from the map) - script count: %d/%d NPCs%s\", eyesRead, Count.n, TyrantNeed, tag)\010        end\010        if left <= 0 then\010            return string.format(\"%d/%d - step 2: breaking the pots (rounds: %d).%s\", Count.n, TyrantNeed, V.done or 0, tag)\010        end\010        local e4 = math.min(4, math.floor(Count.n / 75))\010        return string.format(\"%d NPCs left (%d/%d) - eyes %d/4, %d to the next%s\", left, Count.n, TyrantNeed, e4, 75 - (Count.n % 75), tag)\010    end\010\010    -- um passo do Auto Tyrant (chamado pelo arbitro)\010    function TyrantApi.step()\010        if getSea() ~= 3 then\010            Diag.summon = \"Auto Tyrant: only works in Sea 3\"\010            return false\010        end\010        local _, hrp = getChar()\010        if not hrp then return false end\010        -- boss vivo: mata primeiro (so com \"Auto Kill Tyrant\")\010        if Config.TyrantKill then\010            local boss = bossAlive(\"Tyrant of the Skies\")\010            if boss then\010                releaseGroupEngine()\010                State.Mode, State.Text = \"Auto Tyrant of the Skies\", \"Killing \" .. boss.Name\010                fightEnemy(boss, { boss.Name }, false)\010                return true\010            end\010            -- v53: o boss nasceu mas ainda nao carregou (longe): voa ate ele em vez de continuar farmando/quebrando vaso\010            local far = V.tyrantFar()\010            if far then\010                releaseGroupEngine()\010                State.Mode, State.Text = \"Auto Tyrant of the Skies\", \"Tyrant spawned: flying to it\"\010                Diag.summon = \"Auto Tyrant: the boss is alive but not loaded yet - flying to it\"\010                flyTo(far.CFrame * CFrame.new(0, 40, 0))\010                return true\010            end\010        end\010        -- 4 olhos acesos (lidos do mapa) = proxima missao: quebrar os 4 vasos. Sem o modelo dos olhos: 300 kills.\010        local eyeN, known = eyes()\010        local lit = known and (eyeN >= 4) or ((not known) and Count.n >= TyrantNeed)\010        if not lit then V.needReset, V.stuckSince = false, nil end\010        -- v71: anti-travada - se os \"4 olhos acesos\" continuam lidos assim por muito tempo com o boss ja morto/sem\010        -- nascer de novo e o round() nao estiver rodando, o ciclo provavelmente ficou presa (olhos nao resetaram\010        -- visualmente, ou a contagem de kills de reserva nunca chegou nos 300 nesse build do jogo). Forca um novo\010        -- ciclo em vez de ficar \"travado\" pra sempre - e o mesmo tipo de watchdog que o Status ja usa pro M1.\010        if lit and V.needReset and not Count.boss then\010            V.stuckSince = V.stuckSince or os.clock()\010            if os.clock() - V.stuckSince > 90 and not V.running then\010                Diag.summon = \"Auto Tyrant: still showing eyes 4/4 after 90s with no boss - forcing a new cycle\"\010                V.needReset = false\010            end\010        end\010        if lit and not V.needReset and not Count.boss then\010            if not Config.TyrantSpawn then\010                Diag.summon = \"Auto Tyrant: Auto Spawn is off (the pots will not be broken)\"\010                return false\010            end\010            releaseGroupEngine()\010            V.stuckSince = nil\010            State.Mode = \"Auto Tyrant of the Skies\"\010            State.Text = string.format(\"Breaking pots (%d/%d, rounds: %d)\", math.max(V.idx, 1), #V.vases, V.done)\010            round()\010            return true\010        end\010\010        local loc = tikiLocation()\010        if not loc then\010            Diag.summon = \"Auto Tyrant: could not find the Tiki Outpost on the map (go there once)\"\010            return false\010        end\010        local best, bd, n = nil, math.huge, 0\010        for _, e in ipairs(enemiesList()) do\010            local eh, er = aliveParts(e)\010            if eh and not string.find(e.Name, \"Tyrant\", 1, true)\010                and ((er.Position - loc).Magnitude < 1500 or matchName(e.Name, TikiMobs)) then\010                n += 1\010                local d = (hrp.Position - er.Position).Magnitude\010                if d < bd then best, bd = e, d end\010            end\010        end\010        State.Mode = \"Auto Tyrant of the Skies\"\010        local now = os.clock()\010        if best then\010            Tiki.since, Tiki.last = now, now\010            Diag.summon = string.format(\"Auto Tyrant: Tiki Outpost; mobs alive nearby: %d (every kill counts for the statues)\", n)\010            if getPlayerLevel() >= 2450 then\010                -- motor de farm do Premium (quest da ilha Tiki opcional): solta o motor de voo compartilhado\010                -- (senao os dois motores ficam escrevendo no CFrame do personagem ao mesmo tempo)\010                pcall(function() currentTween:Cancel() end)\010                Core.groupStep(Groups.Tiki, Config.TyrantQuest == true)\010                State.Text = \"Tiki Outpost: \" .. tostring(Groups.Tiki.text) .. string.format(\" (%d NPCs left)\", math.max(0, TyrantNeed - Count.n))\010            else\010                releaseGroupEngine()\010                State.Text = string.format(\"Farming the Tiki Outpost: %s (%d NPCs left)\", best.Name, math.max(0, TyrantNeed - Count.n))\010                fightEnemy(best, tikiNames(loc), true)\010            end\010            return true\010        end\010        -- nenhum mob carregado: patrulha para o jogo carregar/nascer os mobs\010        releaseGroupEngine()\010        if now - Tiki.last > 3 then Tiki.since = now end -- comecou uma nova busca\010        Tiki.last = now\010        local t = now - Tiki.since\010        local sps = tikiSpawns(loc)\010        local target\010        if #sps > 0 then\010            local idx = (math.floor(t / 6) % #sps) + 1\010            target = sps[idx].cf * CFrame.new(0, 25, 0)\010            State.Text = string.format(\"Tiki Outpost: looking for mobs (point %d/%d)\", idx, #sps)\010            Diag.summon = string.format(\"Auto Tyrant: no mobs alive; visiting Tiki spawns (%d/%d)\", idx, #sps)\010        else\010            local k = math.floor(t / 5) % 8\010            local ang = k * math.pi / 4\010            local r = 250 + 200 * (math.floor(t / 40) % 3)\010            target = CFrame.new(loc + Vector3.new(math.cos(ang) * r, 60, math.sin(ang) * r))\010            State.Text = \"Tiki Outpost: looking for mobs (patrolling around the island)\"\010            Diag.summon = string.format(\"Auto Tyrant: no mobs and no known spawns; patrolling around (radius %d)\", r)\010        end\010        flyTo(target)\010        return true\010    end\010    TyrantApi.potWeapon, TyrantApi.potKeys = potWeapon, potKeys\010end\010\010-- ===================================================================== DOUGH KING ====\010-- Auto Dough King: 1) Elite Hunter ate dropar o God's Chalice  2) 10 Conjured Cocoa  3) troca no Sweet Crafter pelo\010-- Sweet Chalice  4) com o calice, farma a Cake Land (500 kills) e invoca/mata o boss.\010do\010    local lastTrade = 0\010    local COCOA_NPC = CFrame.new(231, 23, -12200)\010    local function farmDough(label)\010        local g = Groups.Dough\010        pcall(function() currentTween:Cancel() end)\010        Core.groupStep(g, Config.AutoQuestKing ~= false)\010        State.Text = label .. \": \" .. tostring(g.text)\010    end\010    local function chain()\010        State.Mode = \"Auto Dough King\"\010        if Config.IgnoreDoughChaliceFarm and not hasItem(\"Sweet Chalice\") then\010            farmDough(\"Dough King: farm/boss only (Ignore item)\")\010            return\010        end\010        if hasItem(\"Sweet Chalice\") then\010            if not tostring(Diag.summon or \"\"):find(\"Dough King\") then Diag.summon = \"Sweet Chalice ready: farming Cake Land (500 kills)\" end\010            farmDough(\"Cake Land (500 kills)\")\010            return\010        end\010        if not hasItem(\"God's Chalice\") then\010            State.Text = \"Elite Hunter (looking for God's Chalice)\"\010            if eliteStep(Config.AutoQuestKing ~= false) then return end\010            farmDough(\"Cake Land\")\010            return\010        end\010        local cocoa = invCount(\"Conjured Cocoa\")\010        if cocoa < 10 then\010            local g = Groups.Cocoa\010            pcall(function() currentTween:Cancel() end)\010            Core.groupStep(g, Config.AutoQuestKing ~= false)\010            State.Text = string.format(\"Farming Conjured Cocoa (%d/10): %s\", cocoa, tostring(g.text))\010            return\010        end\010        State.Text = \"Switching to the Sweet Chalice\"\010        if os.clock() - lastTrade > 8 then\010            lastTrade = os.clock()\010            InvCache.at = 0\010            local ok, r = invoke(\"SweetChaliceNpc\")\010            Diag.summon = \"Sweet Crafter: \" .. (ok and \"\" or \"error \") .. tostring(r)\010        end\010        releaseGroupEngine()\010        if distanceTo(COCOA_NPC) > 300 then flyTo(COCOA_NPC) end -- Chocolate Land (o NPC fica por perto)\010    end\010\010    function KingApi.step()\010        if getSea() ~= 3 then return false end\010        local now = os.clock()\010        -- boss vivo: mata primeiro\010        if Config.KillDoughKing then\010            local boss = bossAlive(\"Dough King\")\010            if boss then\010                releaseGroupEngine()\010                State.Mode, State.Text = \"Auto Kill Dough King\", \"Killing \" .. boss.Name\010                fightEnemy(boss, { boss.Name }, false)\010                return true\010            end\010        end\010        -- invoca com o Sweet Chalice\010        if Config.SummonDoughKing and now - Sum.king > 6 and not bossAlive(\"Dough King\") then\010            Sum.king = now\010            if hasItem(\"Sweet Chalice\") then\010                task.spawn(function()\010                    local ok, r = invoke(\"CakePrinceSpawner\")\010                    Diag.summon = \"Dough King: \" .. (ok and \"\" or \"error \") .. tostring(r)\010                end)\010            else\010                Diag.summon = \"Dough King: no Sweet Chalice (use Auto Dough King to get one)\"\010            end\010        end\010        if Config.KingOn then\010            chain()\010            return true\010        end\010        return false\010    end\010    KingApi.chain = chain\010end\010\010-- =================================================================== SOUL REAPER ====\010do\010    function ReaperApi.step()\010        if getSea() ~= 3 then return false end\010        local now = os.clock()\010        if Config.KillReaper then\010            local boss = bossAlive(\"Soul Reaper\")\010            if boss then\010                State.Mode, State.Text = \"Auto Kill Soul Reaper\", \"Killing \" .. boss.Name\010                fightEnemy(boss, { boss.Name }, false)\010                return true\010            end\010        end\010        -- Soul Reaper: usa a Hallow Essence no altar (precisa estar com ela)\010        if Config.SummonReaper and not bossAlive(\"Soul Reaper\") then\010            if not hasItem(\"Hallow Essence\") then\010                Diag.summon = \"Soul Reaper: no Hallow Essence\"\010            elseif now - Sum.reaper > 8 then\010                local map = workspace:FindFirstChild(\"Map\")\010                local hc = map and map:FindFirstChild(\"Haunted Castle\")\010                local altar = hc and hc:FindFirstChild(\"Summoner\", true)\010                local cf = altar and posOf(altar)\010                if not cf then\010                    Diag.summon = \"Soul Reaper: altar not found (go to the Haunted Castle with the Hallow Essence)\"\010                elseif distanceTo(cf) > 14 then\010                    State.Mode, State.Text = \"Auto Summon Soul Reaper\", \"Going to the altar\"\010                    flyTo(cf * CFrame.new(0, 4, 0))\010                    return true\010                else\010                    Sum.reaper = now\010                    local _, hrp, hum = getChar()\010                    local tool = Player.Backpack:FindFirstChild(\"Hallow Essence\")\010                    if tool and hum then pcall(function() hum:EquipTool(tool) end) end\010                    pcall(function()\010                        for _, d in ipairs(altar:GetDescendants()) do\010                            if d:IsA(\"BasePart\") and hrp then\010                                firetouchinterest(hrp, d, 0)\010                                firetouchinterest(hrp, d, 1)\010                            end\010                        end\010                        if altar:IsA(\"BasePart\") and hrp then\010                            firetouchinterest(hrp, altar, 0)\010                            firetouchinterest(hrp, altar, 1)\010                        end\010                    end)\010                    Diag.summon = \"Soul Reaper: touched the altar with the Hallow Essence\"\010                end\010            end\010        end\010        return false\010    end\010end\010\010-- ===================================== extras do Bones (rotina de fundo, nao ocupa o personagem) ====\010task.spawn(function()\010    while Alive do\010        task.wait(0.5)\010        pcall(function()\010            local now = os.clock()\010            if Config.AutoPray and now - (Sum.pray or 0) > 1 then\010                Sum.pray = now\010                task.spawn(function() invoke(\"gravestoneEvent\", 1) end)\010            end\010            if Config.AutoTryLuck and now - (Sum.luck or 0) > 1 then\010                Sum.luck = now\010                task.spawn(function() invoke(\"gravestoneEvent\", 2) end)\010            end\010            if Config.RandomBones and now - Sum.bones > 2 and invCount(\"Bones\") >= 50 then\010                Sum.bones = now\010                task.spawn(function()\010                    local ok, r\010                    for _ = 1, 10 do -- 10 giros por rodada\010                        ok, r = invoke(\"Bones\", \"Buy\", 1, 1)\010                        if not ok then break end\010                        task.wait(0.15)\010                    end\010                    Diag.bones = \"Random Bones (10x): \" .. (ok and \"\" or \"error \") .. tostring(r)\010                end)\010            end\010        end)\010    end\010end)\010\010AFL.Tyrant, AFL.King, AFL.Reaper = TyrantApi, KingApi, ReaperApi\010\010-- ============================================================== UI: aba Normal Farm ====\010do\010    local T = Tabs.Normal\010    local function opt(id, title, desc, key, def)\010        T:AddToggle(id, { Title = title, Description = desc, Default = (Config[key] == nil) and (def and true or false) or (Config[key] and true or false) })\010            :OnChanged(function(v) Config[key] = v; persist() end)\010    end\010    T:AddSection(\"Tyrant of the Skies\")\010    opt(\"AutoTyrant\", \"Auto Tyrant of the Skies\", \"Sea 3: farms the Tiki Outpost mobs (300 kills light the 4 eyes), breaks the pots and kills the Tyrant. Has priority over the farms below it in the priority list.\", \"KillTyrant\")\010    opt(\"QuestTyrant\", \"Auto Quest Tyrant\", \"Takes the Tiki quests while farming the island (the kills count the same either way)\", \"TyrantQuest\")\010    opt(\"SpawnTyrant\", \"Auto Spawn Tyrant of the Skies\", \"With the 4 eyes lit, breaks the 4 pots so the boss spawns\", \"TyrantSpawn\", true)\010    opt(\"KillTyrantBoss\", \"Auto Kill Tyrant of the Skies\", \"Kills the boss when it appears\", \"TyrantKill\", true)\010    do\010        local W = { \"Skull Guitar\", \"Blox Fruit\", \"Melee\", \"Sword\", \"Gun\", \"All weapons\" }\010        local idx = table.find(W, TyrantApi.potWeapon()) or 1\010        T:AddDropdown(\"PotWeapon\", { Title = \"Tyrant Vases: break with\", Values = W, Default = idx,\010            Description = \"Weapon used to break the Tyrant vases. Skull Guitar (default) = click + the keys below. 'All weapons' = every weapon you own, M1 + all skills\" })\010            :OnChanged(function(v) Config.PotWeapon = v; persist() end)\010        local kd = T:AddDropdown(\"PotKeys\", { Title = \"Tyrant Vases: click / keys\", Values = { \"M1\", \"Z\", \"X\", \"C\", \"V\", \"F\" }, Multi = true, Default = {},\010            Description = \"What to press on each vase with the chosen weapon (default: M1 click + X)\" })\010        kd:OnChanged(function(val)\010            local set = {}\010            if type(val) == \"table\" then\010                for k, x in pairs(val) do\010                    if x == true then set[k] = true elseif type(x) == \"string\" then set[x] = true end\010                end\010            end\010            Config.PotKeys = set\010            persist()\010        end)\010        pcall(function()\010            local m = {}\010            for k, x in pairs(TyrantApi.potKeys()) do if x == true then m[k] = true end end\010            kd:SetValue(m)\010        end)\010    end\010    local tyP = T:AddParagraph({ Title = \"Tyrant status\", Content = \"...\" })\010\010    T:AddSection(\"Dough King\")\010    opt(\"AutoKing\", \"Auto Dough King\", \"Elite Hunter until the God's Chalice drops, farms 10 Conjured Cocoa and trades them for the Sweet Chalice, then farms the Cake Land\", \"KingOn\")\010    opt(\"IgnoreChalice\", \"Ignore Farm Dough King Item\", \"Only the boss: does not try to get the Sweet Chalice\", \"IgnoreDoughChaliceFarm\")\010    opt(\"QuestKing\", \"Auto Quest Dough King\", \"Takes the quests (Cacau / Cake Land) only when you have none active\", \"AutoQuestKing\", true)\010    opt(\"KillKing\", \"Auto Kill Dough King\", \"Kills the boss when it appears\", \"KillDoughKing\")\010    opt(\"SummonKing\", \"Auto Summon Dough King\", \"Summons it with the Sweet Chalice\", \"SummonDoughKing\")\010\010    T:AddSection(\"Soul Reaper\")\010    opt(\"KillReaper\", \"Auto Kill Soul Reaper\", \"Kills the Soul Reaper when it is alive\", \"KillReaper\")\010    opt(\"SummonReaper\", \"Auto Summon Soul Reaper\", \"Flies to the Haunted Castle altar and uses the Hallow Essence (50 Bones at the Death King)\", \"SummonReaper\")\010\010    T:AddSection(\"Bones extras\")\010    opt(\"RandomSurprise\", \"Auto Random Surprise\", \"Spins the Random Bones (10x per round) when you have 50+ Bones\", \"RandomBones\")\010    opt(\"AutoPray\", \"Auto Pray\", \"Prays at the Haunted Castle gravestone\", \"AutoPray\")\010    opt(\"AutoTryLuck\", \"Auto Try Luck\", \"Tries your luck at the Haunted Castle gravestone\", \"AutoTryLuck\")\010\010    task.spawn(function()\010        while Alive do\010            task.wait(1.5)\010            pcall(function() tyP:SetDesc(TyrantApi.statusText()) end)\010        end\010    end)\010end\010\010\010\010";
        end;
        DV.src.fish = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Connections, Diag, Fluent, Player, State, Tabs = __E.Config, __E.Connections, __E.Diag, __E.Fluent, __E.Player, __E.State, __E.Tabs\010local flyTo, getChar, invoke, persist = __E.flyTo, __E.getChar, __E.invoke, __E.persist\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local RunService = game:GetService(\"RunService\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ============ Auto Fishing (portado do bomba.lua / Axl Hub, com ideias do Banana Hub) ============\010-- Remotes (conferidos nos dumps do jogo):\010--   ReplicatedStorage.FishReplicated.FishingRequest            RemoteFunction  (\"StartCasting\", \"CastLineAtLocation\", \"Catching\", \"Catch\")\010--   ReplicatedStorage.Modules.Net[\"RF/JobsRemoteFunction\"]    (\"FishingNPC\", \"Angler\", \"AskQuest\" / \"CheckQuest\" / \"Speak\") e (\"FishingNPC\", \"SellFish\")\010--   ReplicatedStorage.Modules.Net[\"RF/JobToolAbilities\"]      (\"Z\", true)  -> habilidade da vara\010--   ReplicatedStorage.Modules.Net[\"RF/Craft\"]                 (\"Craft\", isca, 1, {})\010--   Remotes.CommF_  (\"LoadItem\", isca, {\"Usables\"}), (\"getInventory\")\010-- A parte que mexe no personagem (vara na mao, posicao salva, lancar/pegar) roda pelo arbitro (Auto Fishing) para nao brigar\010-- com os farms; o resto (isca, quest, vender, Fish Slap) e rotina de fundo que so usa remotes.\010local RS = ReplicatedStorage\010local Fish = { status = \"Off\", caught = 0, sold = 0, busy = false, busyAt = 0, castAt = 0, at = {}, stateAt = 0, lastState = nil, warnAt = {} }\010AFL.Fish = Fish\010\010local BAITS = { \"Basic Bait\", \"Kelp Bait\", \"Good Bait\", \"Abyssal Bait\", \"Frozen Bait\", \"Epic Bait\", \"Carnivore Bait\" }\010local function d(k, v) if Config[k] == nil then Config[k] = v end end\010d(\"FishBait\", \"Basic Bait\")\010\010-- ------------------------------------------------------------------ helpers ----\010local function say(txt) Fish.status = txt; Diag.fish = txt end\010local function notify(txt, secs)\010    pcall(function() Fluent:Notify({ Title = \"Moon Decompiled Hub - Fishing\", Content = txt, Duration = secs or 4 }) end)\010end\010local function warnEvery(key, secs, txt)\010    if os.clock() - (Fish.warnAt[key] or 0) >= secs then Fish.warnAt[key] = os.clock(); notify(txt, 4) end\010end\010local function net(name)\010    local m = RS:FindFirstChild(\"Modules\")\010    local n = m and m:FindFirstChild(\"Net\")\010    return n and n:FindFirstChild(name)\010end\010local function request()\010    local f = RS:FindFirstChild(\"FishReplicated\")\010    return f and f:FindFirstChild(\"FishingRequest\")\010end\010-- InvokeServer com limite de tempo (um remote sem resposta nao trava nada)\010local function call(rf, ...)\010    if not rf then return false, \"remote not found\" end\010    local args = table.pack(...)\010    local done, ok, res = false, false, nil\010    task.spawn(function()\010        ok, res = pcall(function() return rf:InvokeServer(table.unpack(args, 1, args.n)) end)\010        done = true\010    end)\010    local t0 = os.clock()\010    while not done and os.clock() - t0 < 6 do task.wait(0.05) end\010    if not done then return false, \"no response (6s)\" end\010    return ok, res\010end\010local function jobs(...) return call(net(\"RF/JobsRemoteFunction\"), ...) end\010\010local function isRod(t)\010    if not (t and t:IsA(\"Tool\")) then return false end\010    if string.find(t.Name, \"Rod\", 1, true) then return true end\010    return t:FindFirstChild(\"FishingRodData\") ~= nil\010end\010local function findRod()\010    local char = Player.Character\010    if char then\010        for _, t in ipairs(char:GetChildren()) do if isRod(t) then return t, true end end\010    end\010    local bp = Player:FindFirstChild(\"Backpack\")\010    if bp then\010        for _, t in ipairs(bp:GetChildren()) do if isRod(t) then return t, false end end\010    end\010end\010\010-- config do jogo (distancia maxima do arremesso) e altura da agua; tudo opcional\010local Mods = { tried = 0 }\010local function loadMods()\010    if Mods.ok or os.clock() - Mods.tried < 5 then return Mods.ok end\010    Mods.tried = os.clock()\010    pcall(function()\010        local fr = RS:FindFirstChild(\"FishReplicated\")\010        local cm = fr and fr:FindFirstChild(\"FishingClient\") and fr.FishingClient:FindFirstChild(\"Config\")\010        if cm then Mods.cfg = require(cm) end\010        local util = RS:FindFirstChild(\"Util\")\010        local wm = util and util:FindFirstChild(\"GetWaterHeightAtLocation\")\010        if wm then Mods.water = require(wm) end\010        local bd = fr and fr:FindFirstChild(\"BaitData\")\010        if bd then\010            local bm = require(bd)\010            local list = {}\010            for name in pairs(bm.Types or {}) do list[#list + 1] = name end\010            table.sort(list)\010            if #list > 0 then Mods.baits = list end\010        end\010    end)\010    Mods.ok = Mods.cfg ~= nil\010    return Mods.ok\010end\010\010-- ponto onde a linha cai: raio a frente do personagem (ate a distancia maxima da vara), na altura da agua\010local function castTarget(char, hrp, rod)\010    loadMods()\010    local maxDist = tonumber(rod:GetAttribute(\"MaxLaunchDistance\")) or (Mods.cfg and Mods.cfg.Rod and tonumber(Mods.cfg.Rod.MaxLaunchDistance)) or 100\010    local water = 0\010    if Mods.water then\010        local ok, h = pcall(Mods.water, hrp.Position)\010        if ok and tonumber(h) then water = h end\010    end\010    local head = char:FindFirstChild(\"Head\")\010    local origin = head and head.Position or hrp.Position\010    local dir = hrp.CFrame.LookVector * maxDist\010    local ignore = { char }\010    for _, n in ipairs({ \"Characters\", \"Enemies\" }) do\010        local f = workspace:FindFirstChild(n)\010        if f then ignore[#ignore + 1] = f end\010    end\010    local hit = origin + dir\010    pcall(function()\010        local rp = RaycastParams.new()\010        rp.FilterType = Enum.RaycastFilterType.Exclude\010        rp.FilterDescendantsInstances = ignore\010        local r = workspace:Raycast(origin, dir, rp)\010        if r and r.Position then hit = r.Position end\010    end)\010    return Vector3.new(hit.X, math.max(hit.Y, water), hit.Z)\010end\010\010-- -------------------------------------------------------------------- isca ----\010local invAt, invCache = -1e9, nil\010local function inventory()\010    if os.clock() - invAt > 4 then\010        invAt = os.clock()\010        local ok, inv = invoke(\"getInventory\")\010        if ok and type(inv) == \"table\" then invCache = inv end\010    end\010    return invCache\010end\010local function baitOwned(name)\010    local inv = inventory()\010    if not inv then return nil end\010    local n = 0\010    for _, it in pairs(inv) do\010        if type(it) == \"table\" and it.Name then\010            local nm = tostring(it.Name)\010            if string.find(nm, \"-\", 1, true) then nm = string.split(nm, \"-\")[1] end\010            if nm == name then n += tonumber(it.Count or it.Amount) or 1 end\010        end\010    end\010    return n\010end\010local function fishOwned()\010    local inv = inventory()\010    if not inv then return 0 end\010    local n = 0\010    for _, it in pairs(inv) do\010        if type(it) == \"table\" and it.Type == \"Fish\" then n += tonumber(it.Count or it.Amount) or 1 end\010    end\010    return n\010end\010local function selectedBait()\010    local ok, v = pcall(function() return Player.Data.FishingData:GetAttribute(\"SelectedBait\") end)\010    if ok and type(v) == \"string\" and v ~= \"\" then return v end\010    local ok2, t = pcall(function() return Player.PlayerGui.Main.BottomHUDList.CurrentBait.Text end)\010    if ok2 and type(t) == \"string\" then return string.match(t, \"Selected Bait: (.-) x%d+\") end\010end\010-- coloca a isca escolhida na vara (no maximo a cada 5s)\010local function ensureBait()\010    local want = Config.FishBait\010    if type(want) ~= \"string\" or want == \"\" then return end\010    if selectedBait() == want then return end\010    local n = baitOwned(want)\010    if n ~= nil and n <= 0 then warnEvery(\"nobait\", 6, \"You don't have \" .. want .. \" to use\"); return end\010    if os.clock() - (Fish.at.load or 0) < 5 then return end\010    Fish.at.load = os.clock()\010    task.spawn(function() invoke(\"LoadItem\", want, { \"Usables\" }) end)\010end\010\010-- --------------------------------------------------------- rotina de fundo (so remotes) ----\010local function questActive()\010    local pg = Player:FindFirstChild(\"PlayerGui\")\010    local q = pg and (pg:FindFirstChild(\"Quest\") or pg:FindFirstChild(\"QuestGui\"))\010    return q ~= nil and q:FindFirstChild(\"Container\") ~= nil and q.Container:FindFirstChild(\"QuestTitle\") ~= nil\010end\010task.spawn(function()\010    while Alive do\010        task.wait(0.5)\010        pcall(function()\010            local now = os.clock()\010            if Config.FishBuyBait and now - (Fish.at.craft or 0) > 2 then\010                Fish.at.craft = now\010                task.spawn(function() call(net(\"RF/Craft\"), \"Craft\", Config.FishBait, 1, {}) end)\010            end\010            if Config.FishQuest and now - (Fish.at.ask or 0) > 1 and not questActive() then\010                Fish.at.ask = now\010                task.spawn(function() jobs(\"FishingNPC\", \"Angler\", \"AskQuest\") end)\010            end\010            if Config.FishQuestDone and now - (Fish.at.done or 0) > 5 then\010                Fish.at.done = now\010                task.spawn(function()\010                    local had = questActive()\010                    local ok, r = jobs(\"FishingNPC\", \"Angler\", \"CheckQuest\")\010                    if ok and r ~= false and had then\010                        task.wait(0.5)\010                        if not questActive() then notify(\"Fishing quest completed!\", 5) end\010                    end\010                end)\010            end\010            if Config.FishSell and now - (Fish.at.sell or 0) > 5 then\010                Fish.at.sell = now\010                task.spawn(function()\010                    invAt = -1e9\010                    local before = fishOwned()\010                    jobs(\"FishingNPC\", \"SellFish\")\010                    task.wait(0.8)\010                    invAt = -1e9\010                    local gone = before - fishOwned()\010                    if gone > 0 then Fish.sold += gone end\010                end)\010            end\010            -- habilidade da vara com ela na mao (mesmo sem o Auto Fishing)\010            if Config.FishSkill and not Config.FishOn and now - (Fish.at.skill or 0) > 0.5 then\010                local rod, eq = findRod()\010                if rod and eq then\010                    Fish.at.skill = now\010                    task.spawn(function() call(net(\"RF/JobToolAbilities\"), \"Z\", true) end)\010                end\010            end\010        end)\010    end\010end)\010\010-- Fish Slap: acerta o botao quando o ponteiro passa pela zona verde\010table.insert(Connections, RunService.RenderStepped:Connect(function()\010    if not Config.FishSlap then return end\010    pcall(function()\010        local pg = Player:FindFirstChildOfClass(\"PlayerGui\")\010        local g = pg and pg:FindFirstChild(\"FishSlapMinigame\")\010        if not g then return end\010        local bar = g:FindFirstChild(\"Bar\")\010        local zone, tick_, btn = bar and bar:FindFirstChild(\"GreenZone\"), bar and bar:FindFirstChild(\"Tick\"), g:FindFirstChild(\"SlapButton\")\010        if zone and tick_ and btn then\010            local p, s, zp, zs = tick_.AbsolutePosition, tick_.AbsoluteSize, zone.AbsolutePosition, zone.AbsoluteSize\010            if p.X < zp.X + zs.X and zp.X < p.X + s.X and p.Y < zp.Y + zs.Y and zp.Y < p.Y + s.Y then\010                firesignal(btn.Activated)\010            end\010        end\010        local cs = pg:FindFirstChild(\"ContinueScreen\")\010        local cont = cs and cs:FindFirstChild(\"Continue\")\010        if cont and cont.Visible then firesignal(cont.Activated) end\010    end)\010end))\010\010-- -------------------------------------------------------------- posicao e vortex ----\010local function savedGoal()\010    local p = Config.FishPos\010    if type(p) ~= \"table\" or not tonumber(p.x) then return nil end\010    local pos = Vector3.new(p.x, p.y, p.z)\010    return CFrame.new(pos, pos + Vector3.new(tonumber(p.lx) or 0, 0, tonumber(p.lz) or -1))\010end\010function Fish.savePosition()\010    local _, hrp = getChar()\010    if not hrp then return false end\010    local look = hrp.CFrame.LookVector\010    Config.FishPos = { x = hrp.Position.X, y = hrp.Position.Y, z = hrp.Position.Z, lx = look.X, lz = look.Z }\010    persist()\010    return true\010end\010\010-- Golden Vortex (evento de pesca): fica numa superficie firme perto dele, olhando para ele\010local Vortex = { part = nil, stand = nil, scanning = false }\010local function findVortex()\010    local f = workspace:FindFirstChild(\"ActiveFishingSpots\")\010    local best, bd = nil, math.huge\010    local _, hrp = getChar()\010    if f and hrp then\010        for _, v in ipairs(f:GetChildren()) do\010            if v.Name == \"GoldenVortex\" then\010                local pos = v:IsA(\"BasePart\") and v.Position or (v.PrimaryPart and v.PrimaryPart.Position)\010                if pos then\010                    local dist = (hrp.Position - pos).Magnitude\010                    if dist < bd then best, bd = v, dist end\010                end\010            end\010        end\010    end\010    return best\010end\010local function vortexPos(v) return v:IsA(\"BasePart\") and v.Position or (v.PrimaryPart and v.PrimaryPart.Position) end\010-- procura (aos poucos, sem travar o jogo) o chao firme mais perto do vortex\010local function scanStand(v)\010    if Vortex.scanning then return end\010    Vortex.scanning = true\010    task.spawn(function()\010        local vp = vortexPos(v)\010        local map = workspace:FindFirstChild(\"Map\")\010        local best, bd = nil, math.huge\010        if vp and map then\010            local n = 0\010            for _, p in ipairs(map:GetDescendants()) do\010                n += 1\010                if n % 400 == 0 then task.wait() end\010                if p:IsA(\"BasePart\") and p.CanCollide and p.Size.X > 4 and p.Size.Z > 4 then\010                    local top = p.Position.Y + p.Size.Y / 2\010                    local dist = (p.Position - vp).Magnitude\010                    if top > vp.Y + 1 and dist < bd and dist < 400 then best, bd = Vector3.new(p.Position.X, top + 3, p.Position.Z), dist end\010                end\010            end\010        end\010        Vortex.part, Vortex.stand, Vortex.scanning = v, best, false\010    end)\010end\010\010-- ------------------------------------------------------------------ o passo ----\010-- chamado pelo arbitro (a cada ~0.12s) enquanto o Auto Fishing estiver ligado. Devolve true quando ocupa o personagem.\010function Fish.step()\010    local char, hrp, hum = getChar()\010    if not char then say(\"Waiting for your character\"); return false end\010    local now = os.clock()\010    State.Mode, State.Text = \"Auto Fishing\", Fish.status\010\010    -- 1) onde ficar: vortex do evento ou posicao salva\010    local goal, why\010    if Config.FishVortex then\010        local v = findVortex()\010        if v then\010            if Vortex.part ~= v and not Vortex.scanning then scanStand(v) end\010            if Vortex.part == v and Vortex.stand then goal, why = CFrame.new(Vortex.stand), \"Golden Vortex\" end\010            if not goal then say(\"Golden Vortex found: looking for solid ground nearby\"); return true end\010        end\010    end\010    if not goal and Config.FishStay then\010        goal, why = savedGoal(), \"your saved spot\"\010    end\010    if goal then\010        local face = Vector3.new(goal.LookVector.X, 0, goal.LookVector.Z)\010        if why == \"Golden Vortex\" then\010            local v = Vortex.part\010            local vp = v and vortexPos(v)\010            if vp then face = Vector3.new(vp.X - goal.X, 0, vp.Z - goal.Z) end\010        end\010        if (hrp.Position - goal.Position).Magnitude > 8 then\010            say(\"Going to \" .. why)\010            State.Text = Fish.status\010            flyTo(goal)\010            return true\010        end\010        if face.Magnitude > 0.1 and hrp.CFrame.LookVector:Dot(face.Unit) < 0.98 then\010            hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + face.Unit)\010        end\010    end\010\010    -- 2) vara na mao\010    local rod, equipped = findRod()\010    if not rod then\010        say(\"No fishing rod in your backpack\")\010        warnEvery(\"norod\", 8, \"You don't have any fishing rod in your backpack\")\010        return false\010    end\010    if not equipped then\010        say(\"Equipping the rod\")\010        hum:EquipTool(rod)\010        return true\010    end\010\010    -- 3) trabalhos que usam a mao (bau afundado) e isca\010    if Fish.busy and now - Fish.busyAt > 12 then Fish.busy = false end\010    if Fish.busy then return true end\010    if Config.FishChest and now - (Fish.at.chest or 0) > 1.5 then\010        local bp = Player:FindFirstChild(\"Backpack\")\010        local chest = bp and bp:FindFirstChild(\"Sunken Chest\")\010        if chest then\010            Fish.at.chest = now\010            Fish.busy, Fish.busyAt = true, now\010            say(\"Opening a Sunken Chest\")\010            task.spawn(function()\010                pcall(function()\010                    hum:EquipTool(chest)\010                    task.wait(0.5)\010                    local re = chest:FindFirstChild(\"RemoteEvent\")\010                    if re then\010                        re:FireServer(\"Visual\")\010                        task.wait(0.3)\010                        re:FireServer(\"Open\")\010                    end\010                end)\010                Fish.busy = false\010            end)\010            return true\010        end\010    end\010    ensureBait()\010\010    -- 4) maquina de estados da vara\010    local state, server = rod:GetAttribute(\"State\"), rod:GetAttribute(\"ServerState\")\010    local cur = tostring(server or state)\010    if cur ~= Fish.lastState then Fish.lastState, Fish.stateAt = cur, now end\010    if Config.FishSkill and now - (Fish.at.skill or 0) > 0.5 then\010        local charge = rod:GetAttribute(\"SkillChargeAlpha\")\010        if charge == nil or tonumber(charge) >= 1 then\010            Fish.at.skill = now\010            task.spawn(function() call(net(\"RF/JobToolAbilities\"), \"Z\", true) end)\010        end\010    end\010    if server == \"Biting\" then\010        Fish.busy, Fish.busyAt = true, now\010        say(\"Fish biting: catching it\")\010        task.spawn(function()\010            local rf = request()\010            if rf then\010                pcall(function()\010                    rf:InvokeServer(\"Catching\", true)\010                    task.wait(0.1)\010                    local ok, r = pcall(function() return rf:InvokeServer(\"Catch\", 1, 1, 1) end)\010                    task.wait(0.1)\010                    pcall(function() rf:InvokeServer(\"Catching\", false) end)\010                    if ok and r ~= false then Fish.caught += 1 end\010                    local w = 0\010                    while w < 3 and Alive and rod.Parent and rod:GetAttribute(\"ServerState\") == \"Biting\" do task.wait(0.1); w += 0.1 end\010                end)\010            end\010            Fish.castAt = os.clock() - 1.5\010            Fish.busy = false\010        end)\010    elseif (state == \"ReeledIn\" or server == \"ReeledIn\") and now - Fish.castAt > 2.5 then\010        Fish.castAt = now\010        Fish.busy, Fish.busyAt = true, now\010        say(\"Casting the line\")\010        task.spawn(function()\010            local rf = request()\010            if rf then\010                pcall(function()\010                    local target = castTarget(char, hrp, rod)\010                    rf:InvokeServer(\"StartCasting\")\010                    task.wait()\010                    rf:InvokeServer(\"CastLineAtLocation\", target, 100, true)\010                end)\010            end\010            Fish.busy = false\010        end)\010    else\010        say(\"Waiting for a fish (\" .. cur .. \")\")\010        -- vara travada no mesmo estado por muito tempo: guarda e pega de novo\010        if now - Fish.stateAt > 25 then\010            Fish.stateAt = now\010            pcall(function() hum:UnequipTools() end)\010        end\010    end\010    State.Text = Fish.status\010    return true\010end\010\010-- ----------------------------------------------------------------------- UI ----\010do\010    local T = Tabs.Fish\010    local function opt(id, title, desc, key, def)\010        T:AddToggle(id, { Title = title, Description = desc, Default = (Config[key] == nil) and (def and true or false) or (Config[key] and true or false) })\010            :OnChanged(function(v) Config[key] = v; persist() end)\010    end\010    T:AddSection(\"Fishing\")\010    opt(\"FishOn\", \"Auto Fishing\", \"Equips your fishing rod, casts the line toward the water in front of you and catches the fish. Face the water (or save a spot below). It is part of the priority list: it takes over from the farms below it.\", \"FishOn\")\010    do\010        local b = T:AddButton({ Title = \"Save Fishing Position\", Description = \"Saves where you are standing and which way you are looking\", Callback = function()\010            local ok = Fish.savePosition()\010            notify(ok and \"Fishing position saved\" or \"Could not save: no character\", 3)\010        end })\010    end\010    opt(\"FishStay\", \"Stay At Saved Position\", \"Flies back to the saved position (and direction) before fishing\", \"FishStay\")\010    opt(\"FishVortex\", \"Go To Golden Vortex\", \"During the Golden Vortex event, stands on solid ground near it and fishes toward it (experimental)\", \"FishVortex\")\010    opt(\"FishSkill\", \"Auto Skill Rod\", \"Uses the rod skill when it is charged\", \"FishSkill\")\010    opt(\"FishChest\", \"Auto Open Sunken Chest\", \"Opens the Sunken Chests you caught while fishing\", \"FishChest\")\010    opt(\"FishSlap\", \"Auto Fish Slap\", \"Completes the Fish Slap minigame automatically\", \"FishSlap\")\010\010    T:AddSection(\"Bait\")\010    do\010        local list = BAITS\010        loadMods()\010        if Mods.baits then list = Mods.baits end\010        local idx = table.find(list, Config.FishBait) or 1\010        T:AddDropdown(\"FishBait\", { Title = \"Select Bait\", Description = \"Bait used by Auto Fishing (loaded onto the rod when you own it)\", Values = list, Default = idx })\010            :OnChanged(function(v) Config.FishBait = v; persist(); invAt = -1e9 end)\010    end\010    opt(\"FishBuyBait\", \"Auto Buy Bait\", \"Crafts the selected bait over and over\", \"FishBuyBait\")\010\010    T:AddSection(\"Quest and Sell\")\010    opt(\"FishQuest\", \"Auto Quest Fishing\", \"Asks the Angler for a fishing quest when you have none\", \"FishQuest\")\010    opt(\"FishQuestDone\", \"Auto Complete Quest\", \"Turns in the fishing quest when it is done\", \"FishQuestDone\")\010    opt(\"FishSell\", \"Auto Sell Fish\", \"Sells every fish you catch\", \"FishSell\")\010\010    T:AddSection(\"Info\")\010    local info = T:AddParagraph({ Title = \"Status\", Content = \"Off\" })\010    T:AddButton({ Title = \"Open Fish Index\", Description = \"Opens the fish index window\", Callback = function()\010        pcall(function() Player:WaitForChild(\"PlayerGui\"):SetAttribute(\"FishIndexVisible\", true) end)\010    end })\010    task.spawn(function()\010        while Alive do\010            task.wait(1.5)\010            pcall(function()\010                info:SetDesc(string.format(\"%s\\nCaught: %d | Sold: %d\", Fish.status, Fish.caught, Fish.sold))\010            end)\010        end\010    end)\010end\010\010\010\010";
