        DV.src.dungeon2 = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Fluent, Player, Tabs, persist = __E.Config, __E.Fluent, __E.Player, __E.Tabs, __E.persist\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ============ DUNGEON EXTRAS (portado do bomba.lua + QuantumOnyx): Trinkets, Unlock Difficulty, Dungeon Hub ============\010-- Remotes (conferidos nos dumps do jogo):\010--   ReplicatedStorage.Remotes.AccessoryInteract                  RemoteFunction  (\"d\") comprar | (\"a\", u1, u2, u3) fundir | (\"c\", u1) refinar | (\"b\", {uids}) desmanchar\010--   ReplicatedStorage.Modules.Net[\"RF/GetAllItemValues\"]         devolve a lista de itens; os Trinkets tem Key \"AccessoryType\"/\"Type\" = \"Trinket\" e NetworkedUID\010--   ReplicatedStorage.DungeonShared.DataRemote                   (\"TryUnlockDifficulty\", \"Simulation\", \"Hard\"|\"Challenge\")\010--   ReplicatedStorage.Modules.Net[\"RF/DungeonNPCNetworkFunction\"] (\"TeleportToDungeonHub\", false) | (\"TeleportBack\") | (\"UnlockDifficulty\"/\"UnlockNext\")\010local RS = ReplicatedStorage\010local X = { status = \"Idle\", uids = {}, uidsAt = -1e9, at = {}, buys = 0, fuses = 0, refines = 0, scraps = 0 }\010AFL.Dun2 = X\010local DUNGEON_PLACE = 73902483975735\010local function d(k, v) if Config[k] == nil then Config[k] = v end end\010d(\"TrinketBuy\", false); d(\"TrinketFuse\", false); d(\"TrinketRefine\", false); d(\"TrinketScrap\", false); d(\"DunUnlock\", false)\010\010local function notify(txt, secs)\010    pcall(function() Fluent:Notify({ Title = \"Moon Decompiled Hub - Dungeon\", Content = txt, Duration = secs or 4 }) end)\010end\010local function net(name)\010    local m = RS:FindFirstChild(\"Modules\")\010    local n = m and m:FindFirstChild(\"Net\")\010    return n and n:FindFirstChild(name)\010end\010-- InvokeServer com limite de tempo\010local function call(rf, ...)\010    if not rf then return false, \"remote not found\" end\010    local args = table.pack(...)\010    local done, ok, res = false, false, nil\010    task.spawn(function()\010        ok, res = pcall(function() return rf:InvokeServer(table.unpack(args, 1, args.n)) end)\010        done = true\010    end)\010    local t0 = os.clock()\010    while not done and os.clock() - t0 < 6 do task.wait(0.05) end\010    if not done then return false, \"no response (6s)\" end\010    return ok, res\010end\010local function accessory()\010    local r = RS:FindFirstChild(\"Remotes\")\010    return r and r:FindFirstChild(\"AccessoryInteract\")\010end\010local function inRun()\010    local map = workspace:FindFirstChild(\"Map\")\010    return map ~= nil and map:FindFirstChild(\"Dungeon\") ~= nil\010end\010\010-- ------------------------------------------------------------------ trinkets ----\010-- uids dos Trinkets que voce tem (lista guardada por 1.5s, as 4 funcoes dividem a mesma leitura)\010local function trinkets(force)\010    if not force and os.clock() - X.uidsAt < 1.5 then return X.uids end\010    X.uidsAt = os.clock()\010    local ok, res = call(net(\"RF/GetAllItemValues\"))\010    if ok and type(res) == \"table\" then\010        local list, seen = {}, {}\010        for _, e in pairs(res) do\010            if type(e) == \"table\" and (e.Key == \"AccessoryType\" or e.Key == \"Type\") and e.Value == \"Trinket\" and e.NetworkedUID and not seen[e.NetworkedUID] then\010                seen[e.NetworkedUID] = true\010                list[#list + 1] = e.NetworkedUID\010            end\010        end\010        X.uids = list\010    end\010    return X.uids\010end\010function X.buy()\010    local ok, r = call(accessory(), \"d\")\010    if ok and r ~= false then X.buys += 1 end\010    return ok and r ~= false, r\010end\010function X.fuse()\010    local u = trinkets(true)\010    if #u < 3 then return false, \"need 3 trinkets (you have \" .. #u .. \")\" end\010    local ok, r = call(accessory(), \"a\", u[1], u[2], u[3])\010    if ok and r ~= false then X.fuses += 1; X.uidsAt = -1e9 end\010    return ok and r ~= false, r\010end\010function X.refine()\010    local u = trinkets(true)\010    if #u < 1 then return false, \"no trinket to refine\" end\010    local ok, r = call(accessory(), \"c\", u[1])\010    if ok and r ~= false then X.refines += 1; X.uidsAt = -1e9 end\010    return ok and r ~= false, r\010end\010-- desmancha os que passam de 3 (fica com os 3 primeiros, ate 7 por vez)\010function X.scrap()\010    local u = trinkets(true)\010    if #u <= 3 then return false, \"nothing extra to scrap (keeps the first 3)\" end\010    local extra = {}\010    for i = 4, math.min(#u, 10) do extra[#extra + 1] = u[i] end\010    local ok, r = call(accessory(), \"b\", extra)\010    if ok and r ~= false then X.scraps += #extra; X.uidsAt = -1e9 end\010    return ok and r ~= false, r\010end\010function X.unlock()\010    local shared = RS:FindFirstChild(\"DungeonShared\")\010    local data = shared and shared:FindFirstChild(\"DataRemote\")\010    if data then\010        call(data, \"TryUnlockDifficulty\", \"Simulation\", \"Hard\")\010        call(data, \"TryUnlockDifficulty\", \"Simulation\", \"Challenge\")\010    end\010    local rf = net(\"RF/DungeonNPCNetworkFunction\")\010    if rf then\010        for _, a in ipairs({ \"UnlockDifficulty\", \"UnlockNext\", \"Unlock\" }) do call(rf, a) end\010    end\010end\010\010-- rotinas automaticas (cada uma no seu ritmo; se o servidor recusar espera mais antes de tentar de novo)\010local PLAN = {\010    { \"TrinketBuy\", 1.5, \"buy\" }, { \"TrinketFuse\", 2, \"fuse\" }, { \"TrinketRefine\", 2, \"refine\" }, { \"TrinketScrap\", 3, \"scrap\" },\010}\010task.spawn(function()\010    while Alive do\010        task.wait(0.5)\010        pcall(function()\010            local now = os.clock()\010            for _, p in ipairs(PLAN) do\010                local key, every, fn = p[1], p[2], p[3]\010                if Config[key] and now - (X.at[key] or 0) >= every then\010                    X.at[key] = now\010                    task.spawn(function()\010                        local ok = X[fn]()\010                        if not ok then X.at[key] = os.clock() + 4 end   -- recusou: espera mais um pouco\010                    end)\010                end\010            end\010            -- desbloquear dificuldades: so no lugar da dungeon e fora de uma run\010            if Config.DunUnlock and game.PlaceId == DUNGEON_PLACE and not inRun() and now - (X.at.unlock or 0) >= 5 then\010                X.at.unlock = now\010                task.spawn(X.unlock)\010            end\010        end)\010    end\010end)\010\010-- ----------------------------------------------------------------------- UI ----\010do\010    local T = Tabs.Dungeons\010    local function tog(id, title, desc, key)\010        T:AddToggle(id, { Title = title, Description = desc, Default = Config[key] and true or false })\010            :OnChanged(function(v) Config[key] = v and true or false; persist() end)\010    end\010    local function shot(title, desc, fn, okText)\010        T:AddButton({ Title = title, Description = desc, Callback = function()\010            task.spawn(function()\010                local ok, r = fn()\010                if ok then notify((okText or title) .. \": done\", 3)\010                else notify(title .. \": \" .. (type(r) == \"string\" and r or \"the server refused\"), 4) end\010            end)\010        end })\010    end\010\010    T:AddSection(\"Dungeon Hub\")\010    T:AddButton({ Title = \"Teleport To Dungeon Hub\", Description = \"Goes to the dungeon hub from any sea\", Callback = function()\010        task.spawn(function() call(net(\"RF/DungeonNPCNetworkFunction\"), \"TeleportToDungeonHub\", false) end)\010    end })\010    T:AddButton({ Title = \"Return To Previous Sea\", Description = \"Leaves the dungeon hub and goes back to the sea you came from\", Callback = function()\010        task.spawn(function() call(net(\"RF/DungeonNPCNetworkFunction\"), \"TeleportBack\") end)\010    end })\010\010    T:AddSection(\"Difficulty\")\010    tog(\"DunUnlock\", \"Auto Unlock Difficulties\", \"Unlocks Hard and Challenge with your Simulation Data (only works inside the dungeon hub, between runs)\", \"DunUnlock\")\010    shot(\"Unlock Next Difficulty\", \"Tries to unlock the next difficulty once (dungeon hub)\", function() X.unlock(); return true end, \"Unlock attempt\")\010\010    T:AddSection(\"Trinkets\")\010    tog(\"TrinketBuy\", \"Auto Buy Trinkets\", \"Buys trinkets over and over\", \"TrinketBuy\")\010    tog(\"TrinketFuse\", \"Auto Fuse Trinkets\", \"Fuses 3 trinkets at a time\", \"TrinketFuse\")\010    tog(\"TrinketRefine\", \"Auto Refine Trinkets\", \"Refines your trinkets\", \"TrinketRefine\")\010    tog(\"TrinketScrap\", \"Auto Scrap Trinkets\", \"Scraps the extra trinkets and keeps the first 3\", \"TrinketScrap\")\010    shot(\"Buy Trinket\", \"Buys one trinket\", X.buy)\010    shot(\"Fuse 3 Trinkets\", \"Fuses 3 of your trinkets\", X.fuse)\010    shot(\"Refine Trinket\", \"Refines one trinket\", X.refine)\010    shot(\"Scrap Extra Trinkets\", \"Scraps the trinkets after the first 3\", X.scrap)\010    local function open(label, gui, arg)\010        T:AddButton({ Title = \"Open \" .. label, Description = \"Opens the game's \" .. label .. \" window\", Callback = function()\010            local ok = pcall(function()\010                local g = Player.PlayerGui:WaitForChild(gui, 3)\010                if arg == nil then g.Open:Fire() else g.Open:Fire(arg) end\010            end)\010            if not ok then notify(label .. \" could not be opened here\", 3) end\010        end })\010    end\010    open(\"Trinket Merge\", \"AccessoryMerge\", false)\010    open(\"Trinket Refine\", \"AccessoryMerge\", true)\010    open(\"Trinket Scrap\", \"AccessoryTrasher\", nil)\010\010    T:AddSection(\"Trinket Info\")\010    local info = T:AddParagraph({ Title = \"Trinkets\", Content = \"Idle\" })\010    task.spawn(function()\010        while Alive do\010            task.wait(2)\010            pcall(function()\010                info:SetDesc(string.format(\"Bought %d | Fused %d | Refined %d | Scrapped %d\", X.buys, X.fuses, X.refines, X.scraps))\010            end)\010        end\010    end)\010end\010\010\010\010";
        end;
        DV.src.draco = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Fluent, Player, State, Tabs, fightEnemy, findEnemy = __E.Config, __E.Fluent, __E.Player, __E.State, __E.Tabs, __E.fightEnemy, __E.findEnemy\010local findSpawn, flyTo, getChar, persist = __E.findSpawn, __E.flyTo, __E.getChar, __E.persist\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ============ DRACO / DRAGON DOJO (portado do QuantumOnyx): trocar pra Draco, Trial, Fire Flowers, Dragon Talon ============\010-- Tudo copiado da logica do Quantum (remotes e caminhos conferidos la):\010--   ReplicatedStorage.Modules.Net[\"RF/InteractDragonQuest\"]   ({ NPC = \"Dragon Wizard\", Command = \"DragonRace\" })  vira Draco (perto do Dragon Wizard)\010--                                                             ({ NPC = \"Uzoth\", Command = \"Upgrade\" })            melhora o Dragon Talon\010--   ReplicatedStorage.Remotes.DracoTrial                      RemoteFunction que comeca a Trial da raca Draco\010--   workspace.Map.DracoTrial                                  mapa da Trial: Relic1, EndRelic1, Relic2, EndRelic2, Relic3, EndRelic3 (ProximityPrompt) e TrialDoor.DoorTouch\010--   workspace.FireFlowers                                     flores de fogo (Models com ProximityPrompt), usadas no V2 do Draco\010--   workspace.Map.PrehistoricIsland.TrialTeleport             entrada da Trial\010-- As funcoes que ficam rodando (Trial, Fire Flowers, Dragon Talon) entram no arbitro como \"Draco\"; os botoes usam o AFL.goDo.\010local RS = ReplicatedStorage\010local D = { status = \"Idle\", stage = 1, flowers = 0, talons = 0, trials = 0, trialAt = -1e9, seenAt = -1e9, talonAt = -1e9, modelAt = -1e9 }\010AFL.Draco = D\010local function dflt(k, v) if Config[k] == nil then Config[k] = v end end\010dflt(\"DracoTrial\", false); dflt(\"DracoFlowers\", false); dflt(\"DracoTalon\", false)\010\010local SEQ = { \"Relic1\", \"EndRelic1\", \"Relic2\", \"EndRelic2\", \"Relic3\", \"EndRelic3\" }\010local WIZARD = Vector3.new(5773, 1210, 807)\010local TALON = Vector3.new(5661.89, 1211.32, 864.84)\010local DOJO = {\010    { \"Dojo Trainer\", Vector3.new(5867, 1208, 870) },\010    { \"Dragon Hunter\", Vector3.new(5864, 1209, 808) },\010    { \"Dragon Wizard\", Vector3.new(5775, 1209, 806) },\010    { \"Uzoth (Dragon Talon)\", TALON },\010}\010\010-- ------------------------------------------------------------------ helpers ----\010local function notify(txt, secs)\010    pcall(function() Fluent:Notify({ Title = \"Moon Decompiled Hub - Draco\", Content = txt, Duration = secs or 4 }) end)\010end\010local function net(name)\010    local m = RS:FindFirstChild(\"Modules\")\010    local n = m and m:FindFirstChild(\"Net\")\010    return n and n:FindFirstChild(name)\010end\010-- InvokeServer com limite de tempo (um remote sem resposta nao trava o hub)\010local function call(rf, ...)\010    if not rf then return false, \"remote not found\" end\010    local args = table.pack(...)\010    local done, ok, res = false, false, nil\010    task.spawn(function()\010        ok, res = pcall(function() return rf:InvokeServer(table.unpack(args, 1, args.n)) end)\010        done = true\010    end)\010    local t0 = os.clock()\010    while not done and os.clock() - t0 < 6 do task.wait(0.05) end\010    if not done then return false, \"no response (6s)\" end\010    return ok, res\010end\010local function myRace()\010    local ok, v = pcall(function() return Player.Data.Race.Value end)\010    return ok and tostring(v) or \"?\"\010end\010local function trialRemote()\010    local r = RS:FindFirstChild(\"Remotes\")\010    return r and r:FindFirstChild(\"DracoTrial\")\010end\010-- o relogio da Trial e o mesmo da Raid (TopHUDList.RaidTimer)\010local function timerOn()\010    local ok, v = pcall(function() return Player.PlayerGui.Main.TopHUDList.RaidTimer.Visible end)\010    return ok and v == true\010end\010local cachedModel\010local function trialModel()\010    if cachedModel and cachedModel.Parent then return cachedModel end\010    local map = workspace:FindFirstChild(\"Map\")\010    local m = map and map:FindFirstChild(\"DracoTrial\")\010    -- a busca funda no workspace inteiro e pesada: so de vez em quando\010    if not m and os.clock() - D.modelAt > 3 then\010        D.modelAt = os.clock()\010        m = workspace:FindFirstChild(\"DracoTrial\", true)\010    end\010    cachedModel = m\010    return m\010end\010local function partOf(o)\010    if not o then return nil end\010    if o:IsA(\"BasePart\") then return o end\010    return o.PrimaryPart or o:FindFirstChildWhichIsA(\"BasePart\", true)\010end\010local function posOf(p)\010    local ok, v = pcall(function() return p:GetPivot().Position end)\010    if ok and v then return v end\010    return p.Position\010end\010-- voa ate chegar perto (raio) ou estourar o tempo; devolve se chegou\010local function approach(pos, radius, secs)\010    local t0 = os.clock()\010    while os.clock() - t0 < (secs or 8) do\010        local _, hrp = getChar()\010        if not hrp then return false end\010        if (hrp.Position - pos).Magnitude <= (radius or 5) then return true end\010        flyTo(CFrame.new(pos))\010        task.wait(0.1)\010    end\010    return false\010end\010local function itemPrompt(o)\010    return o and (o:FindFirstChildOfClass(\"ProximityPrompt\") or o:FindFirstChildWhichIsA(\"ProximityPrompt\", true))\010end\010\010-- ------------------------------------------------------------ passos do arbitro ----\010-- Trial: dentro dela pega as reliquias na ordem e vai ate a porta; fora dela pede ao servidor para comecar\010function D.trialStep()\010    if not timerOn() then\010        D.stage = 1\010        if os.clock() - D.trialAt >= 2.5 then\010            D.trialAt = os.clock()\010            task.spawn(function()\010                local rf = trialRemote()\010                if rf then\010                    local ok = call(rf)\010                    if ok then D.trials += 1 end\010                end\010            end)\010        end\010        -- acabou de sair/entrar: segura o controle 2s para as outras funcoes nao puxarem o personagem no meio\010        return os.clock() - D.seenAt < 2\010    end\010    local trial = trialModel()\010    if not trial then return false end              -- relogio ligado por outro evento (raid etc.)\010    D.seenAt = os.clock()\010    local _, hrp = getChar()\010    if not hrp then return false end\010    for i = D.stage, #SEQ do\010        local obj = trial:FindFirstChild(SEQ[i], true)\010        local pp = itemPrompt(obj)\010        if pp and pp.Enabled then\010            D.stage = i\010            local part = pp.Parent:IsA(\"BasePart\") and pp.Parent or partOf(obj)\010            if part then\010                flyTo(part.CFrame)\010                if (part.Position - hrp.Position).Magnitude <= 20 then\010                    if fireproximityprompt then pcall(fireproximityprompt, pp, math.huge) end\010                    task.wait(0.3)\010                    if not pp.Enabled then D.stage = i + 1 end\010                end\010            end\010            D.status = \"Trial: \" .. SEQ[i]\010            return true\010        end\010    end\010    local door = trial:FindFirstChild(\"TrialDoor\", true)\010    local touch = door and (door:FindFirstChild(\"DoorTouch\", true) or door:FindFirstChildWhichIsA(\"BasePart\", true))\010    if touch then\010        flyTo(touch.CFrame)\010        D.status = \"Trial: door\"\010        return true\010    end\010    D.status = \"Trial: waiting\"\010    return true\010end\010\010-- Fire Flowers (V2 do Draco): pega as flores do mapa; sem flor, caca Forest Pirate\010function D.flowerStep()\010    local _, hrp = getChar()\010    if not hrp then return false end\010    local folder = workspace:FindFirstChild(\"FireFlowers\")\010    if folder then\010        for _, f in ipairs(folder:GetChildren()) do\010            local part = f:IsA(\"Model\") and (f.PrimaryPart or f:FindFirstChildOfClass(\"MeshPart\") or f:FindFirstChildWhichIsA(\"BasePart\", true))\010            if part then\010                D.status = \"Fire Flowers: collecting\"\010                if (part.Position - hrp.Position).Magnitude > 6 then\010                    flyTo(part.CFrame)\010                else\010                    local pp = itemPrompt(f)\010                    if pp and fireproximityprompt then pcall(fireproximityprompt, pp, math.huge) end\010                    D.flowers += 1\010                    task.wait(0.5)\010                end\010                return true\010            end\010        end\010    end\010    local e = findEnemy({ \"Forest Pirate\" })\010    if e then\010        D.status = \"Fire Flowers: Forest Pirates\"\010        fightEnemy(e, { e.Name }, true)\010        return true\010    end\010    local sp = findSpawn({ \"Forest Pirate\" })\010    if sp then\010        D.status = \"Fire Flowers: going to the Forest Pirates\"\010        flyTo(sp.CFrame * CFrame.new(0, 12, 0))\010        return true\010    end\010    D.status = \"Fire Flowers: no flowers and no Forest Pirates here\"\010    return false\010end\010\010-- Dragon Talon: fica no Uzoth e pede o upgrade a cada 0.5s\010function D.talonStep()\010    local _, hrp = getChar()\010    if not hrp then return false end\010    if (hrp.Position - TALON).Magnitude > 5 then\010        D.status = \"Dragon Talon: going to Uzoth\"\010        flyTo(CFrame.new(TALON))\010        return true\010    end\010    D.status = \"Dragon Talon: upgrading\"\010    if os.clock() - D.talonAt >= 0.5 then\010        D.talonAt = os.clock()\010        task.spawn(function()\010            local ok, r = call(net(\"RF/InteractDragonQuest\"), { NPC = \"Uzoth\", Command = \"Upgrade\" })\010            if ok and r ~= false then D.talons += 1 end\010        end)\010    end\010    return true\010end\010\010-- passo unico do arbitro (ordem: Trial > Fire Flowers > Dragon 