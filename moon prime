010    end)\010end\010\010-- -------------------------------------------------------------------- servidor ----\010local function jobId()\010    local sb = RS:FindFirstChild(\"__ServerBrowser\")\010    if sb and AFL.invokeT then\010        local ok, id = AFL.invokeT(sb, 5, \"getjob\")\010        if ok and type(id) == \"string\" and #id > 5 then return id end\010    end\010    return game.JobId\010end\010\010-- ----------------------------------------------------------------------- UI ----\010do\010    local T = Tabs.Player\010    local function tog(id, title, desc, key, fn)\010        T:AddToggle(id, { Title = title, Description = desc, Default = Config[key] and true or false })\010            :OnChanged(function(v) Config[key] = v and true or false; persist(); if fn then fn(v and true or false) end end)\010    end\010\010    T:AddSection(\"Movement\")\010    tog(\"PlrDash\", \"Set Dash Length\", \"Changes how far your dash goes (the game's DashLength). Turn it off to get the normal value back\", \"PlrDash\", function() dashApply(Player.Character) end)\010    T:AddInput(\"PlrDashV\", { Title = \"Dash Length Value\", Description = \"Normal is around 60; try 100-200\", Default = tostring(Config.PlrDashV or \"100\"), Placeholder = \"100\", Numeric = true, Finished = true })\010        :OnChanged(function(v)\010            if tonumber(v) then Config.PlrDashV = tostring(v); persist(); dashApply(Player.Character) end\010        end)\010    tog(\"PlrZoom\", \"Infinite Zoom\", \"Lets the camera zoom out as far as you want\", \"PlrZoom\", zoom)\010    tog(\"PlrSpeedOn\", \"Custom WalkSpeed\", \"Sets your running speed to the value below. Turn off to go back to normal (16)\", \"PlrSpeedOn\", function() speedApply() end)\010    T:AddInput(\"PlrSpeedV\", { Title = \"WalkSpeed Value\", Description = \"Normal is 16. Try 20-40 - very high values look choppy for other players\", Default = tostring(Config.PlrSpeedV or \"16\"), Placeholder = \"16\", Numeric = true, Finished = true })\010        :OnChanged(function(v) if tonumber(v) then Config.PlrSpeedV = tostring(v); persist(); speedApply() end end)\010    tog(\"PlrJumpOn\", \"Custom JumpPower\", \"Sets your jump height to the value below. Turn off to go back to normal (50)\", \"PlrJumpOn\", function() speedApply() end)\010    T:AddInput(\"PlrJumpV\", { Title = \"JumpPower Value\", Description = \"Normal is 50. Try 60-120\", Default = tostring(Config.PlrJumpV or \"50\"), Placeholder = \"50\", Numeric = true, Finished = true })\010        :OnChanged(function(v) if tonumber(v) then Config.PlrJumpV = tostring(v); persist(); speedApply() end end)\010    tog(\"PlrNoclip\", \"Noclip\", \"Walk through walls and floors. Only affects your own character\", \"PlrNoclip\", noclip)\010\010    T:AddSection(\"Screen and Performance\")\010    tog(\"PlrBlack\", \"Black Screen\", \"Covers the game with a black screen (menus stay visible). Saves a bit of GPU. Press End anytime to force it off\", \"PlrBlack\", blackScreen)\010    tog(\"PlrWhite\", \"White Screen (3D Rendering Off)\", \"Turns the 3D world off completely: the biggest FPS and battery saver. The hub keeps working. Press End anytime to force it off\", \"PlrWhite\", render3d)\010    tog(\"PlrNoDmg\", \"Remove Damage Indicators\", \"Hides the damage numbers and the game's notification pop-ups (less lag)\", \"PlrNoDmg\", function(v) if not v then damageGui(false) end end)\010\010    T:AddSection(\"Stats\")\010    do\010        local names = {}\010        for i, s in ipairs(STATS) do names[i] = s[1] end\010        T:AddDropdown(\"PlrStats\", { Title = \"Select Stats\", Description = \"Stats that receive your points\", Values = names, Multi = true, Default = Config.PlrStats })\010            :OnChanged(function(v)\010                local list = {}\010                for _, n in ipairs(names) do if type(v) == \"table\" and v[n] then list[#list + 1] = n end end\010                Config.PlrStats = list\010                persist()\010            end)\010        T:AddSlider(\"PlrStatN\", { Title = \"Points Per Add\", Description = \"How many points go into each selected stat every time\", Min = 1, Max = 100, Default = tonumber(Config.PlrStatN) or 1, Rounding = 0 })\010            :OnChanged(function(v) Config.PlrStatN = math.floor(tonumber(v) or 1); persist() end)\010        tog(\"PlrStatOn\", \"Auto Add Points\", \"Spends your free stat points on the selected stats as soon as you get them\", \"PlrStatOn\")\010        T:AddButton({ Title = \"Add Points Now\", Description = \"Spends your free points once\", Callback = function()\010            task.spawn(function()\010                local n = Plr.addPoints()\010                notify(n > 0 and (\"Added \" .. n .. \" points\") or \"No free points (or no stat selected)\", 3)\010            end)\010        end })\010    end\010\010    T:AddSection(\"Codes\")\010    tog(\"PlrFetchCodes\", \"Read Codes From The Wiki\", \"Also tries the working codes listed on the Blox Fruits wiki (needs an executor with HTTP requests)\", \"PlrFetchCodes\")\010    T:AddButton({ Title = \"Redeem All Codes\", Description = \"Redeems every known Blox Fruits code (2x EXP, Beli, stat refund...). Expired or used codes are skipped\", Callback = function() Plr.redeemAll() end })\010\010    T:AddSection(\"Team\")\010    T:AddButton({ Title = \"Set Pirate Team\", Description = \"Switches your team to Pirates\", Callback = function()\010        task.spawn(function() invoke(\"SetTeam\", \"Pirates\"); notify(\"Team change requested: Pirates\", 3) end)\010    end })\010    T:AddButton({ Title = \"Set Marine Team\", Description = \"Switches your team to Marines\", Callback = function()\010        task.spawn(function() invoke(\"SetTeam\", \"Marines\"); notify(\"Team change requested: Marines\", 3) end)\010    end })\010\010    T:AddSection(\"Server\")\010    T:AddButton({ Title = \"Server Hop\", Description = \"Switches to another server after a 10 second countdown (use Cancel Hop to stop it)\", Callback = function()\010        Plr.cancelHop = false\010        if AFL.hopRequest then AFL.hopRequest(\"manual hop\", function() return Plr.cancelHop end) end\010    end })\010    T:AddButton({ Title = \"Cancel Hop\", Description = \"Stops a hop that is counting down\", Callback = function() Plr.cancelHop = true; notify(\"Hop cancelled\", 3) end })\010    T:AddButton({ Title = \"Rejoin Server\", Description = \"Leaves and joins this same server again\", Callback = function()\010        task.spawn(function()\010            notify(\"Rejoining...\", 3)\010            if AFL.tpJob then AFL.tpJob(jobId(), 8) end\010        end)\010    end })\010    do\010        local jid = \"\"\010        T:AddInput(\"PlrJobId\", { Title = \"Job ID\", Description = \"Paste the Job ID of the server you want to join\", Default = \"\", Placeholder = \"paste the Job ID\", Numeric = false, Finished = true })\010            :OnChanged(function(v) jid = string.gsub(tostring(v or \"\"), \"[%s`]\", \"\") end)\010        T:AddButton({ Title = \"Join Job ID\", Description = \"Teleports to the server with that Job ID\", Callback = function()\010            if #jid < 10 then notify(\"Paste a valid Job ID first\", 3) return end\010            task.spawn(function()\010                notify(\"Joining that server...\", 3)\010                if AFL.tpJob then AFL.tpJob(jid, 8) end\010            end)\010        end })\010    end\010    T:AddButton({ Title = \"Copy Job ID\", Description = \"Copies this server's Job ID\", Callback = function()\010        local ok = pcall(function() setclipboard(game.JobId) end)\010        notify(ok and \"Job ID copied\" or \"Your executor cannot copy to the clipboard\", 3)\010    end })\010\010    T:AddSection(\"Tools\")\010    T:AddButton({ Title = \"Reset Character\", Description = \"Kills your character so it respawns\", Callback = function()\010        local _, _, hum = getChar()\010        if hum then hum.Health = 0 end\010    end })\010    T:AddButton({ Title = \"Open Dev Console\", Description = \"Opens the Roblox developer console (F9)\", Callback = function()\010        pcall(function() game:GetService(\"StarterGui\"):SetCore(\"DevConsoleVisible\", true) end)\010    end })\010\010    T:AddSection(\"Info\")\010    local info = T:AddParagraph({ Title = \"Player\", Content = \"Idle\" })\010    task.spawn(function()\010        while Alive do\010            task.wait(1.5)\010            pcall(function()\010                info:SetDesc(string.format(\"%s\\nFree points: %d | Dash: %s\", Plr.status, dataNum(\"Points\"), tostring(Player.Character and Player.Character:GetAttribute(\"DashLength\") or \"?\")))\010            end)\010        end\010    end)\010end\010\010\010\010";
