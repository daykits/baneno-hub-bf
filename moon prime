            return "local __E = ...\010local AFL = __E.AFL\010local Config, Diag, State, Tabs, aliveParts, distanceTo, enemiesList = __E.Config, __E.Diag, __E.State, __E.Tabs, __E.aliveParts, __E.distanceTo, __E.enemiesList\010local fightEnemy, flyTo, getSea, invoke, matchName, persist, questVisible = __E.fightEnemy, __E.flyTo, __E.getSea, __E.invoke, __E.matchName, __E.persist, __E.questVisible\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ============ BOSSES (Update 30 names) ============\010-- Quest data (quest name, index) comes from memory/wiki and is a best guess; NPC position is unknown, so the quest is requested from where the player is.\010AFL.Boss = { list = {}, q = {}, last = 0 }\010do\010    local B = AFL.Boss\010    local defs = {\010        -- quest names/indexes confirmed from the game's Quests module (Moon Dump)\010        -- Sea 1\010        { \"The Gorilla King\", \"JungleQuest\", 3 }, { \"Chef\", \"BuggyQuest1\", 3 }, { \"The Saw\", nil }, { \"Yeti\", \"SnowQuest\", 3 },\010        { \"Mob Leader\", nil }, { \"Vice Admiral\", \"MarineQuest2\", 2 }, { \"Saber Expert\", nil }, { \"Warden\", \"ImpelQuest\", 2 },\010        { \"Chief Warden\", nil }, { \"Swan\", nil }, { \"Magma Admiral\", \"MagmaQuest\", 3 },\010        { \"Fishman Lord\", \"FishmanQuest\", 3 }, { \"Wysper\", \"SkyExp1Quest\", 3 }, { \"Thunder God\", \"SkyExp2Quest\", 3 },\010        { \"Cyborg\", \"FountainQuest\", 3 },\010        -- Sea 2\010        { \"Diamond\", \"Area1Quest\", 3 }, { \"Jeremy\", \"Area2Quest\", 3 }, { \"Orbitus\", \"MarineQuest3\", 3 }, { \"Don Swan\", nil },\010        { \"Smoke Admiral\", \"IceSideQuest\", 3 }, { \"Tide Keeper\", \"ForgottenQuest\", 3 },\010        { \"Darkbeard\", nil }, { \"Order\", nil }, { \"Cursed Captain\", nil },\010        -- Sea 3\010        { \"Stone\", \"PiratePortQuest\", 3 }, { \"Hydra Leader\", \"VenomCrewQuest\", 3 }, { \"Kilo Admiral\", \"MarineTreeIsland\", 3 },\010        { \"Captain Elephant\", \"DeepForestIsland\", 3 }, { \"Beautiful Pirate\", \"DeepForestIsland2\", 3 }, { \"Cake Queen\", \"IceCreamIslandQuest\", 3 },\010        { \"Island Empress\", nil }, { \"Longma\", nil }, { \"Soul Reaper\", nil }, { \"rip_indra True Form\", nil }, { \"Dough King\", nil }, { \"Cake Prince\", nil },\010        { \"Greybeard\", nil }, { \"Leviathan\", nil }, { \"Terrorshark\", nil }, { \"Tyrant of the Skies\", nil },\010        { \"Deandre\", nil }, { \"Urban\", nil }, { \"Diablo\", nil }, { \"Core\", nil },\010    }\010    -- Select Boss only shows the bosses of the sea you are in (Sea 1 -> Sea 1 bosses, ...)\010    local seaOf = {}\010    for _, n in ipairs({ \"The Gorilla King\", \"Chef\", \"The Saw\", \"Yeti\", \"Mob Leader\", \"Vice Admiral\", \"Saber Expert\", \"Warden\", \"Chief Warden\",\010        \"Swan\", \"Magma Admiral\", \"Fishman Lord\", \"Wysper\", \"Thunder God\", \"Cyborg\", \"Greybeard\" }) do seaOf[n] = 1 end\010    for _, n in ipairs({ \"Diamond\", \"Jeremy\", \"Orbitus\", \"Don Swan\", \"Smoke Admiral\", \"Tide Keeper\", \"Darkbeard\", \"Order\", \"Cursed Captain\", \"Core\" }) do seaOf[n] = 2 end\010    local mySea = getSea()\010    for _, d in ipairs(defs) do\010        if mySea == 0 or (seaOf[d[1]] or 3) == mySea then B.list[#B.list + 1] = d[1] end\010        if d[2] then B.q[d[1]] = { d[2], d[3] } end\010    end\010end\010function AFL.Boss.find()\010    local sel, any = Config.BossSel or {}, false\010    for _ in pairs(sel) do any = true break end\010    if not any then return nil end\010    for _, e in ipairs(enemiesList()) do\010        local en = e.Name\010        for name in pairs(sel) do\010            if en == name or string.find(en, name, 1, true) == 1 then\010                if aliveParts(e) then return e, name end\010                break\010            end\010        end\010    end\010end\010function AFL.Boss.step()\010    if not (Config.BossKill or Config.BossQuest or Config.BossHop) then return false end\010    local boss, name = AFL.Boss.find()\010    if boss then\010        State.Mode, State.Text = \"Auto Boss\", \"Killing \" .. boss.Name\010        Diag.boss = \"killing \" .. boss.Name\010        if Config.BossQuest and AFL.Boss.q[name] and os.clock() - AFL.Boss.last > 8 then\010            local visible, known = questVisible()\010            if not (known and visible) then\010                AFL.Boss.last = os.clock()\010                invoke(\"StartQuest\", AFL.Boss.q[name][1], AFL.Boss.q[name][2])\010            end\010        end\010        if Config.BossKill then\010            fightEnemy(boss, { boss.Name }, false)\010        else\010            local _, r = aliveParts(boss)\010            if r and distanceTo(r.CFrame) > 60 then flyTo(r.CFrame * CFrame.new(0, 20, 0)) end\010        end\010        return true\010    end\010    -- boss not spawned: model may sit in ReplicatedStorage (like Elite), fly there\010    for name in pairs(Config.BossSel or {}) do\010        local m = ReplicatedStorage:FindFirstChild(name)\010        local part = m and (m:FindFirstChild(\"HumanoidRootPart\") or m.PrimaryPart)\010        if part and Config.BossKill then\010            State.Mode, State.Text = \"Auto Boss\", \"Going to \" .. name\010            flyTo(part.CFrame * CFrame.new(0, 20, 0))\010            return true\010        end\010    end\010    Diag.boss = \"waiting for a selected boss to spawn\"\010    if Config.BossHop then\010        AFL.hopRequest(\"boss\", function() return AFL.Boss.find() ~= nil end)\010    end\010    return false\010end\010\010-- ---- Awakened bosses ----\010-- Awakened bosses are triggered by finishing the island secret (see wiki Awakened_Bosses). The Secrets Master tells which one comes next.\010AFL.Awk = { names = { \"Awakened Gorilla King\", \"Awakened Chef\", \"Awakened Yeti\", \"Awakened Vice Admiral\", \"Awakened Warden\",\010    \"Awakened Magma General\", \"Awakened Fishman Lord\", \"Awakened Cyborg\", \"Awakened Sky Warlord\", \"Awakened Thunder God\" },\010    how = {\010        [\"Awakened Gorilla King\"] = \"Jungle [Banana Tree]. Needs The Thief + The Grappling Hook done (NPC Adventurer, -1680,49,176). When the server says something woke in the canopy, hit the big tree near the dock so bananas fall (banana trees ~ -1530,90,-600), then kill the boss\",\010        [\"Awakened Chef\"] = \"Pirate Village [Chef's Kiss]. Needs Windmill + Tavern Brawl done (Pirate Adventurer, -1152,14,3863). Tavern 2nd floor: Cauldron (-1136,54,4185) -> put the 2 requested ingredients (they change) -> Cook -> kill the Chef\",\010        [\"Awakened Yeti\"] = \"Frozen Village [Frozen Defense]. Needs Snowballs + Breaking the Ice done (Villager, 1401,77,-1311). When the blizzard stops, destroy the 3 green ice blocks, then kill the Yeti\",\010        [\"Awakened Vice Admiral\"] = \"Marine Fortress [Battle Plans]. Needs The Flagpole + The Pirate Raid done (Parlus -4832,234,3851 / Marine -4699,5,4228). Use the dock cannons to destroy the 3 marked structure parts (gate -4862,56,4298), then kill him\",\010        [\"Awakened Warden\"] = \"Prison [Lever Jailbreak]. Needs Escaping Prisoners + Don Megalo done (Jail Keeper, 5208,16,737). Main building ground floor: 4 levers, the combination changes every time (remotes Pull/Release)\",\010        [\"Awakened Magma General\"] = \"Magma Village [One Last Eruption]. Needs Magma Geyser + Magma Drilling done (Mayor, -5309,17,8483). Destroy the glowing geysers around the volcano, then kill him\",\010        [\"Awakened Fishman Lord\"] = \"Underwater City [Pearl of the Deep]. Needs Bubble Cave + Mysterious Lights done (King Neptune, 61406,25,1627). Open the Clam Shells (12 in the city) until the Pearl appears, claim it, kill him in the main building\",\010        [\"Awakened Cyborg\"] = \"Fountain City [Fountain Wire Repair]. Needs Pipe Repair + The Sewer Gang done (Freezeburg Quest Giver, 5263,75,4088). Hit the broken wires at the Cyborg area, then kill him\",\010        [\"Awakened Sky Warlord\"] = \"Upper Skylands [The Tyrant Awakens]. Needs The Old Temple done (Sky Quest Giver 2, -7033,5591,1353). Destroy the black clouds above the Sky Warlord area, then kill him\",\010        [\"Awakened Thunder God\"] = \"Upper Skylands [Echoes Through the Clouds]. Mole (-5949,5468,2087). Interact with the Golden Bell (Map.SkyArea2) and hit 6 sequences with the symbol type (sword / gun / melee), then kill him\",\010    } }\010-- v53: so os Awakened dos Island Secrets (Mar 1). Antes qualquer nome com \"Awakened\" contava (ex.: o Awakened Ice Admiral\010-- do Mar 2) e o Auto Awk / Auto Awaken / Combat v2 ficavam presos nele.\010function AFL.Awk.find()\010    for _, e in ipairs(enemiesList()) do\010        local low = string.lower(e.Name)\010        if (matchName(e.Name, AFL.Awk.names) or (string.find(low, \"awakened\", 1, true) and not string.find(low, \"ice admiral\", 1, true))) and aliveParts(e) then return e end\010    end\010end\010-- v53: o boss acordou mas esta longe (fora do alcance de carregamento): o jogo guarda o modelo no ReplicatedStorage\010function AFL.Awk.findFar()\010    for _, n in ipairs(AFL.Awk.names) do\010        local m = ReplicatedStorage:FindFirstChild(n)\010        local p = m and (m:FindFirstChild(\"HumanoidRootPart\") or m.PrimaryPart)\010        local h = m and m:FindFirstChildOfClass(\"Humanoid\")\010        if p and (not h or h.Health > 0) then return m, p end\010    end\010end\010function AFL.Awk.hint()\010    local A = AFL.Awk\010    if A.hintAt and os.clock() - A.hintAt < 10 then return A.hintData end\010    A.hintAt = os.clock()\010    -- v53: pergunta em segundo plano (o InvokeServer travava o laco principal quando o servidor demorava) e guarda a\010    -- ultima resposta boa por ate 60 s (antes zerava a dica a cada 10 s e o Auto Awk \"esquecia\" a ilha sem resposta)\010    if A.hintGotAt and os.clock() - A.hintGotAt > 60 then A.hintData = nil end\010    if A.hintBusy and os.clock() - (A.hintAskAt or 0) > 20 then A.hintBusy = false end\010    if not A.hintBusy then\010        A.hintBusy, A.hintAskAt = true, os.clock()\010        task.spawn(function()\010            pcall(function()\010                local m = ReplicatedStorage:FindFirstChild(\"Modules\")\010                local net = m and m:FindFirstChild(\"Net\")\010                local rf = net and net:FindFirstChild(\"RF/RequestNextRaidHint\")\010                if rf then\010                    local r = rf:InvokeServer()\010                    if typeof(r) == \"table\" then A.hintData, A.hintGotAt = r, os.clock() end\010                end\010            end)\010            A.hintBusy = false\010        end)\010    end\010    return A.hintData\010end\010function AFL.Awk.status()\010    local e = AFL.Awk.find()\010    if e then return \"ALIVE: \" .. e.Name end\010    local h = AFL.Awk.hint()\010    if h then\010        local st = tostring(h.State)\010        if st == \"Arming\" then return tostring(h.Boss) .. \" is about to stir on \" .. tostring(h.Island) .. \" (get there now)\" end\010        if st == \"Armed\" or st == \"Triggered\" then return tostring(h.Boss) .. \" is already up on \" .. tostring(h.Island) end\010        if st == \"Deferred\" then return tostring(h.Boss) .. \" is waiting to stir on \" .. tostring(h.Island) .. \" (another fight is blocking)\" end\010        local mins = math.max(1, math.ceil((tonumber(h.Seconds) or 0) / 60))\010        return \"Next: \" .. tostring(h.Island) .. \" (\" .. tostring(h.Boss or \"?\") .. \") in about \" .. mins .. \" min\"\010    end\010    return \"Nothing is stirring right now (the Secrets Master says the same). Next one is announced a few minutes before.\"\010end\010AFL.Awk.spots = {\010    { \"jungle\", CFrame.new(-1680, 60, 176) }, { \"pirate\", CFrame.new(-1136, 70, 4185) }, { \"frozen\", CFrame.new(1401, 90, -1311) },\010    { \"marine\", CFrame.new(-4862, 70, 4298) }, { \"prison\", CFrame.new(5208, 30, 737) }, { \"magma\", CFrame.new(-5309, 30, 8483) },\010    { \"underwater\", CFrame.new(61406, 40, 1627) }, { \"fountain\", CFrame.new(5263, 90, 4088) },\010}\010function AFL.Awk.spot(h)\010    local isl = string.lower(tostring(h.Island))\010    if string.find(isl, \"sky\", 1, true) then\010        if string.find(string.lower(tostring(h.Boss)), \"thunder\", 1, true) then\010            local m = workspace:FindFirstChild(\"Map\")\010            local sa = m and m:FindFirstChild(\"SkyArea2\")\010            local gb = sa and sa:FindFirstChild(\"Golden Bell\")\010            if gb then\010                local ok, p = pcall(function() return gb:GetPivot().Position end)\010                if ok then return CFrame.new(p + Vector3.new(0, 40, 0)) end\010            end\010            return CFrame.new(-7070, 5620, 488)\010        end\010        return CFrame.new(-7033, 5605, 1353)\010    end\010    for _, sp in ipairs(AFL.Awk.spots) do\010        if string.find(isl, sp[1], 1, true) then return sp[2] end\010    end\010end\010-- flies to the hinted island shortly before the boss stirs and keeps the player there (also used by Auto Secret Quest)\010function AFL.Awk.waitAt(h, mode)\010    if not (h and h.Island) then return false end\010    local st = tostring(h.State)\010    local soon = st == \"Arming\" or st == \"Armed\" or st == \"Triggered\" or (tonumber(h.Seconds) or 9999) <= 150\010    local cf = soon and AFL.Awk.spot(h)\010    if not cf then return false end\010    State.Mode, State.Text = mode, \"Waiting at \" .. tostring(h.Island)\010    Diag.awk = \"waiting at \" .. tostring(h.Island) .. \" for \" .. tostring(h.Boss)\010    if distanceTo(cf) > 40 then flyTo(cf) end\010    return true\010end\010function AFL.Awk.step()\010    if not Config.AwkOn then return false end\010    -- v53: os Awakened bosses so existem no Mar 1 (nos outros mares o Auto Awk ficava \"esperando\" a toa)\010    local okS, sea = pcall(getSea)\010    if okS and sea and sea ~= 1 then Diag.awk = \"Awakened bosses only spawn in the First Sea\"; return false end\010    local e = AFL.Awk.find()\010    if not e then\010        local far, fp = AFL.Awk.findFar()\010        if far then\010            State.Mode, State.Text = \"Auto Awk Boss\", \"Flying to \" .. far.Name\010            Diag.awk = far.Name .. \" is up but not loaded yet: flying to it\"\010            flyTo(fp.CFrame * CFrame.new(0, 30, 0))\010            return true\010        end\010    end\010    if e then\010        State.Mode, State.Text = \"Auto Awk Boss\", \"Awakened: \" .. e.Name\010        Diag.awk = (Config.AwkKill and \"killing \" or \"following (Auto Kill Boss Awk is off) \") .. e.Name\010        if Config.AwkKill then\010            fightEnemy(e, { e.Name }, false)\010        else\010            local _, r = aliveParts(e)\010            if r and distanceTo(r.CFrame) > 60 then flyTo(r.CFrame * CFrame.new(0, 20, 0)) end\010        end\010        return true\010    end\010    -- not spawned yet: the server announces the next one (Secrets Master hint); wait at the island shortly before it stirs\010    if AFL.Awk.waitAt(AFL.Awk.hint(), \"Auto Awk Boss\") then return true end\010    Diag.awk = \"waiting for the next Awakened boss\"\010    return false\010end\010\010-- ---------- Bosses ----------\010do\010    local function sub(tab, text) pcall(function() tab:AddSection(text) end) end\010    local T = Tabs.Bosses\010    T:AddSection(\"Bosses\")\010    local bd = T:AddDropdown(\"BossSel\", { Title = \"Select Boss\", Values = AFL.Boss.list, Multi = true, Default = {},\010        Description = \"Bosses to hunt (Update 30 names)\" })\010    bd:OnChanged(function(val)\010        local set = {}\010        if type(val) == \"table\" then\010            for k, x in pairs(val) do\010                if x == true then set[k] = true elseif type(x) == \"string\" then set[x] = true end\010            end\010        end\010        Config.BossSel = set; persist()\010    end)\010    pcall(function()\010        local d = {}\010        for k in pairs(Config.BossSel or {}) do d[k] = true end\010        bd:SetValue(d)\010    end)\010    T:AddToggle(\"BossKill\", { Title = \"Auto Kill Boss\", Default = Config.BossKill and true or false })\010        :OnChanged(function(v) Config.BossKill = v; persist() end)\010    T:AddToggle(\"BossQuest\", { Title = \"Auto Quest Boss\", Description = \"Takes the boss quest only when no quest is active\", Default = Config.BossQuest and true or false })\010        :OnChanged(function(v) Config.BossQuest = v; persist() end)\010    T:AddToggle(\"BossHop\", { Title = \"Auto Hop Boss\", Description = \"Hops server when the selected boss is not found (Hop in 10 seconds)\", Default = Config.BossHop and true or false })\010        :OnChanged(function(v) Config.BossHop = v; persist() end)\010\010    T:AddSection(\"Auto Awk Boss\")\010    T:AddToggle(\"AwkOn\", { Title = \"Auto Awk Boss\", Description = \"Flies to the Awakened boss when it spawns\", Default = Config.AwkOn and true or false })\010        :OnChanged(function(v) Config.AwkOn = v; persist() end)\010    T:AddToggle(\"AwkKill\", { Title = \"Auto Kill Boss Awk\", Default = Config.AwkKill and true or false })\010        :OnChanged(function(v) Config.AwkKill = v; persist() end)\010    local info = T:AddParagraph({ Title = \"Awakened boss\", Content = \"Checking...\" })\010    task.spawn(function()\010        while Alive do\010            local txt = \"?\"\010            pcall(function() txt = AFL.Awk.status() end)\010            pcall(function() info:SetDesc(txt) end)\010            task.wait(3)\010        end\010    end)\010    for _, n in ipairs(AFL.Awk.names) do\010        if AFL.Awk.how[n] then T:AddParagraph({ Title = n, Content = AFL.Awk.how[n] }) end\010    end\010end\010\010\010\010";
        end;
        DV.src.secrets = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Aim, Config, Diag, Fluent, Player, State, Tabs = __E.Aim, __E.Config, __E.Diag, __E.Fluent, __E.Player, __E.State, __E.Tabs\010local aliveParts, cfAttack, currentTween, enemiesList, equipWeapon, fightEnemy, flyTo = __E.aliveParts, __E.cfAttack, __E.currentTween, __E.enemiesList, __E.equipWeapon, __E.fightEnemy, __E.flyTo\010local getChar, persist = __E.getChar, __E.persist\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ============ AUTO FARM CHEST ============\010-- ============ SECRET QUEST (Island Secrets, Sea 1) ============\010\010\010-- Automated: the Awakened boss secrets (Gorilla King, Chef, Fishman Lord, Yeti, Cyborg). They spawn about once an hour;\010-- the regular boss does not count, so only enemies with \"Awakened\" in the name are attacked.\010AFL.SecretDefs = {\010    { \"Jungle\", \"The Thief\" }, { \"Jungle\", \"The Grappling Hook\" }, { \"Jungle\", \"Awakened Gorilla King\", \"gorilla\" },\010    { \"Pirate Village\", \"Free the Windmill\" }, { \"Pirate Village\", \"Tavern Brawl\" }, { \"Pirate Village\", \"Awakened Chef\", \"chef\" },\010    { \"Desert\", \"Saving Hasan\" }, { \"Desert\", \"Cleaning the Runes\" }, { \"Desert\", \"Prickly Harvest\" },\010    { \"Frozen Village\", \"Snowballs\" }, { \"Frozen Village\", \"Breaking the Ice\" }, { \"Frozen Village\", \"Awakened Yeti\", \"yeti\" },\010    { \"Marine Fortress\", \"The Flagpole\" }, { \"Marine Fortress\", \"The Pirate Raid\" }, { \"Marine Fortress\", \"Awakened Vice Admiral\", \"vice admiral\" },\010    { \"Lower Skylands\", \"The Mad Scientist's Lightning Bolt\" }, { \"Lower Skylands\", \"A Cloudy Treasure\" }, { \"Lower Skylands\", \"Invaders in the Castle\" },\010    { \"Upper Skylands\", \"The Old Temple\" }, { \"Upper Skylands\", \"Awakened Sky Warlord\", \"sky warlord\" }, { \"Upper Skylands\", \"Awakened Thunder God\", \"thunder god\" },\010    { \"Prison\", \"Escaping Prisoners\" }, { \"Prison\", \"Don Megalo\" }, { \"Prison\", \"Awakened Warden\", \"warden\" },\010    { \"Colosseum\", \"Colosseum Fight\" }, { \"Colosseum\", \"The Champion's Statues\" }, { \"Colosseum\", \"The Crowd Favorite\" },\010    { \"Magma Village\", \"The Magma Geyser\" }, { \"Magma Village\", \"Magma Drilling\" }, { \"Magma Village\", \"Awakened Magma General\", \"magma general\" },\010    { \"Underwater City\", \"Bubble Cave\" }, { \"Underwater City\", \"Mysterious Lights\" }, { \"Underwater City\", \"Awakened Fishman Lord\", \"fishman\" },\010    { \"Fountain City\", \"Pipe Repair\" }, { \"Fountain City\", \"The Sewer Gang\" }, { \"Fountain City\", \"Awakened Cyborg\", \"cyborg\" },\010    { \"Middle Town\", \"The Gamer\" }, { \"Middle Town\", \"Lookout Duty\" }, { \"Middle Town\", \"The Treasure Hunt\" },\010}\010AFL.SecretList, AFL.SecretKey, AFL.SecretManual = {}, {}, {}\010for _, d in ipairs(AFL.SecretDefs) do\010    local label = d[1] .. \" - \" .. d[2] \010    AFL.SecretList[#AFL.SecretList + 1] = label\010    if d[3] then AFL.SecretKey[label] = d[3] end -- v32: todas automaticas (sem [manual])\010end\010function AFL.secretFind(key)\010    for _, e in ipairs(enemiesList()) do\010        local n = string.lower(e.Name)\010        if string.find(n, \"awakened\", 1, true) and string.find(n, key, 1, true) and aliveParts(e) then return e end\010    end\010end\010function AFL.secretStep()\010    if not Config.SecretOn then return false end\010    local any = false\010    for _ in pairs(Config.SecretSel or {}) do any = true break end\010    for _, label in ipairs(AFL.SecretList) do\010        if AFL.SecretKey[label] and ((not any) or Config.SecretSel[label]) then\010            local boss = AFL.secretFind(AFL.SecretKey[label])\010            if boss then\010                State.Mode, State.Text = \"Auto Secret Quest\", \"Killing \" .. boss.Name\010                Diag.secret = \"killing \" .. boss.Name\010                fightEnemy(boss, { boss.Name }, false)\010                return true\010            end\010        end\010    end\010    -- no selected boss alive: if the server announces one of them, wait at its island\010    local h = AFL.Awk.hint()\010    if h and h.Boss then\010        local nm = string.lower(tostring(h.Boss))\010        for _, label in ipairs(AFL.SecretList) do\010            local key = AFL.SecretKey[label]\010            if key and ((not any) or Config.SecretSel[label]) and string.find(nm, key, 1, true) then\010                if AFL.Awk.waitAt(h, \"Auto Secret Quest\") then return true end\010            end\010        end\010    end\010    Diag.secret = \"waiting for a selected Awakened boss to spawn\"\010    return false\010end\010\010\010Tabs.Secrets:AddSection(\"Auto Secret Quest\")\010Tabs.Secrets:AddToggle(\"SecretOn\", { Title = \"Auto Secret Quest\",\010    Description = \"Sea 1 Island Secrets, fully automatic for what you select below (empty = all): flies to each pending secret, kills its enemies, presses its prompts, triggers the Awakened boss of the islands you picked and kills it. A few puzzles are still yours (pipes, crystals, statues, lookout...). Full guide in the Secrets tab.\",\010    Default = Config.SecretOn and true or false })\010    :OnChanged(function(v) Config.SecretOn = v; persist() end)\010do\010    local sd = Tabs.Secrets:AddDropdown(\"SecretSel\", { Title = \"Auto Select Secret Quest\", Values = AFL.SecretList, Multi = true, Default = {},\010        Description = \"Which secrets to automate. Empty = all. Picking an Awakened boss also does the 2 secrets of its island first. Every secret is automatic: flies there, kills the enemies, presses the prompts.\" })\010    sd:OnChanged(function(val)\010        local set = {}\010        if type(val) == \"table\" then\010            for k, x in pairs(val) do\010                if x == true then set[k] = true elseif type(x) == \"string\" then set[x] = true end\010            end\010        end\010        for label in pairs(set) do\010            if AFL.SecretManual[label] and not (Config.SecretSel or {})[label] then\010                Fluent:Notify({ Title = \"Secret Quest\", Content = label .. \": no boss to kill here - Auto Secret Quest will fly to its NPC and run the steps it knows.\", Duration = 6 })\010            end\010        end\010        Config.SecretSel = set\010        persist()\010    end)\010    pcall(function()\010        local m = {}\010        for k, x in pairs(Config.SecretSel or {}) do if x == true then m[k] = true end end\010        sd:SetValue(m)\010    end)\010end\010\010-- ---------- Secrets (Sea 1 Island Secrets): catalogo, progresso real do servidor, voar ate o NPC, ajudante de prompts ----------\010-- Fonte: dumps do jogo (ReplicatedStorage.BonusMoments.*, workspace/ReplicatedStorage.NPCs, Net remotes).\010-- TODOS os secrets usam o mesmo par de remotes: ReplicatedStorage.Remotes.BonusMomentsRemoteEvent / BonusMomentsRemoteFunction,\010-- com o 1o argumento = nome do modulo (ex: FireServer(\"Chef's Kiss\", \"Cook\")). O script NAO dispara esses remotes sozinho (o servidor valida o estado).\010(function()\010    local T = Tabs.Secrets\010    local S = { done = nil, at = -100, busy = false, skip = {}, cur = nil, curSince = 0 }\010    AFL.Sec = S\010    local V = Vector3.new\010    -- \"Auto Secret Quest\" (Normal Farm) agora liga TUDO sozinho: ajudante + passos automaticos + gatilho dos Awakened selecionados\010    local function assistOn() return Config.SecretOn or Config.SecretAssist or Config.SecretAuto end\010    local function autoOn() return Config.SecretOn or Config.SecretAuto end\010\010    -- { ilha, nome na lista (igual ao SecretDefs), id interno do progresso, NPC, posicao do NPC, o que fazer, textos de prompt que o ajudante aperta }\010    S.defs = {\010        { \"Jungle\", \"The Thief\", \"Sea1/Jungle/The Thieving Monkey\", \"Adventurer\", V(-1680, 49, 176),\010            \"Footprints near a tree