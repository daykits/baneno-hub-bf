- ===== movimento (hover alto + tween), igual ao NightDungeon =====\010    local target, tween, tgoal, hb, nc, lastPos, rescueUntil, hover = nil, nil, nil, nil, nil, nil, 0, false\010    local function cancelTween() if tween then pcall(function() tween:Cancel() end); tween = nil end end\010    local function velocity(on)\010        local c = char(); if not c then return end\010        local head = c:FindFirstChild(\"Head\") or c:FindFirstChild(\"HumanoidRootPart\")\010        if not head then return end\010        local bv = head:FindFirstChild(\"MHDunVel\")\010        if on and not bv then\010            bv = Instance.new(\"BodyVelocity\")\010            bv.Name, bv.MaxForce, bv.Velocity, bv.P = \"MHDunVel\", Vector3.new(40000, 40000, 40000), Vector3.zero, 1500\010            bv.Parent = head\010        elseif not on and bv then bv:Destroy() end\010    end\010    local function noclip(on)\010        if on and not nc then\010            nc = RunSvc.Stepped:Connect(function()\010                local c = char(); if not c then return end\010                for _, p in ipairs(c:GetDescendants()) do if p:IsA(\"BasePart\") and p.CanCollide then p.CanCollide = false end end\010            end)\010        elseif not on and nc then nc:Disconnect(); nc = nil end\010    end\010    local function stepTo(cf)\010        local hrp, hum = hrpf(), humf()\010        if not hrp or not hum or hum.Health <= 0 then cancelTween(); return false end\010        if hum.Sit then hum.Sit = false end\010        local dist = (cf.Position - hrp.Position).Magnitude\010        if dist <= CFG.arrive then cancelTween(); return true end\010        if tween and tgoal and (tgoal.Position - cf.Position).Magnitude < 6 and tween.PlaybackState == Enum.PlaybackState.Playing then return false end\010        local sp = os.clock() < rescueUntil and CFG.rescue or (tonumber(Config.TweenSpeed) or CFG.speed)\010        cancelTween()\010        tgoal = cf\010        tween = TweenSvc:Create(hrp, TweenInfo.new(math.max(dist / sp, 0.05), Enum.EasingStyle.Linear), { CFrame = cf })\010        tween:Play()\010        return false\010    end\010    local function heartbeat(on)\010        if on and not hb then\010            lastPos = nil\010            hb = RunSvc.Heartbeat:Connect(function()\010                if not target then return end\010                local hrp, hum = hrpf(), humf()\010                if not hrp or not hum or hum.Health <= 0 then lastPos = nil; return end\010                local pos = hrp.Position\010                if lastPos and (pos - lastPos).Magnitude > CFG.jump then\010                    cancelTween()\010                    target = CFrame.new(pos.X, pos.Y + CFG.hover, pos.Z)\010                    lastPos = pos\010                    return\010                end\010                lastPos = pos\010                if hrp.AssemblyAngularVelocity.Magnitude > 0.05 then hrp.AssemblyAngularVelocity = Vector3.zero end\010                if hum:GetState() ~= Enum.HumanoidStateType.Physics then hum:ChangeState(Enum.HumanoidStateType.Physics) end\010                if hum.PlatformStand then hum.PlatformStand = false end\010                velocity(true)\010                stepTo(target)\010            end)\010        elseif not on and hb then hb:Disconnect(); hb = nil; cancelTween(); lastPos = nil end\010    end\010    local function goto_(cf)\010        local hrp, hum = hrpf(), humf()\010        if not hrp or not hum or hum.Health <= 0 then cancelTween(); return false end\010        noclip(true); velocity(true); hover = false\010        if not target or (target.Position - cf.Position).Magnitude > 1 then target = cf end\010        heartbeat(true)\010        return (cf.Position - hrp.Position).Magnitude <= CFG.arrive\010    end\010    local function hoverHigh(force)\010        local hrp = hrpf(); if not hrp then return end\010        if hover and target and hb and not force then noclip(true); velocity(true); return end\010        cancelTween()\010        local