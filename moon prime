           firetouchinterest(hrp, part, 1)\010            end)\010        end\010    end\010    function MV.hold()\010        if Sea.st then Sea.st.cruise = nil end\010    end\010    function MV.sail(zone)\010        Sea.zone = zone\010        local r = Sea.step and Sea.step(true)\010        Sea.zone = nil\010        return r\010    end\010    function MV.pressKey(name)\010        local kc = Enum.KeyCode[name]\010        if not kc then return end\010        pcall(function()\010            VirtualInputManager:SendKeyEvent(true, kc, false, game)\010            task.wait(0.1)\010            VirtualInputManager:SendKeyEvent(false, kc, false, game)\010        end)\010    end\010    function MV.equip(sub)\010        local tool = findToolByName(sub)\010        local ch = Player.Character\010        local hum = ch and ch:FindFirstChildOfClass(\"Humanoid\")\010        if tool and hum and tool.Parent ~= ch then pcall(function() hum:EquipTool(tool) end) end\010        return tool ~= nil\010    end\010    function MV.islandTop(isl)\010        local ok, cf, size = pcall(function() return isl:GetBoundingBox() end)\010        if ok then return cf.Position + Vector3.new(0, size.Y / 2 + 30, 0) end\010        local p = isl:FindFirstChildWhichIsA(\"BasePart\", true)\010        return p and (p.Position + Vector3.new(0, 150, 0))\010    end\010end\010\010-- ---- Mirage Island (Sea 3) ----\010AFL.Mirage = { gearAt = 0, leverDone = false, lookAt = 0, gearTouches = 0 }\010do\010    local M, MV = AFL.Mirage, AFL.MV\010    local Lighting = game:GetService(\"Lighting\") -- v31 fix: was only declared in the MV block above, so the \"look at the moon\" step crashed (nil index)\010    local TEMPLE = Vector3.new(28286, 14897, 103) -- Temple of Time (from other hubs)\010    function M.island() return MV.mapChild(\"mysticisland\") or MV.mapChild(\"mirage\") end\010    function M.findGear(isl)\010        local best, bd\010        local _, hrp = getChar()\010        for _, d in ipairs(isl:GetDescendants()) do\010            if d:IsA(\"BasePart\") and d.Material == Enum.Material.Neon and (d.Name:lower():find(\"gear\", 1, true) or d:IsA(\"MeshPart\")) then\010                local dist = hrp and (d.Position - hrp.Position).Magnitude or 0\010                if not bd or dist < bd then best, bd = d, dist end\010            end\010        end\010        return best\010    end\010    function M.step()\010        if not Config.MirageOn then return false end\010        if getSea() ~= 3 then Diag.mirage = \"Mirage only works in Sea 3\"; return false end\010        local char, hrp, hum = getChar()\010        if not char then return false end\010        local isl = M.island()\010        if not isl then\010            M.gearTouches, M.leverDone = 0, false\010            State.Mode = \"Auto Mirage\"\010            Diag.mirage = \"sailing, ignoring sea events\"\010            return MV.sail(Config.SeaZone > 0 and Config.SeaZone or nil)\010        end\010        MV.hold()\010        State.Mode = \"Auto Mirage\"\010        if not Config.PullLever then\010            State.Text = \"Mirage Island found\"\010            Diag.mirage = \"Mirage Island found (Auto Pull Lever is off)\"\010            return false\010        end\010        if M.leverDone then Diag.mirage = \"lever already pulled on this island\"; return false end\010        -- 1) blue gear\010        local gear = (M.gearTouches < 6) and M.findGear(isl)\010        if gear then\010            State.Text = \"Getting the Blue Gear\"\010            Diag.mirage = \"touching the gear\"\010            hrp.CFrame = CFrame.new(gear.Position + Vector3.new(0, 3, 0))\010            MV.touch(gear)\010            MV.trigger(gear:FindFirstChildWhichIsA(\"ProximityPrompt\", true) or gear:FindFirstChildWhichIsA(\"ClickDetector\", true) or gear)\010            M.gearTouches += 1\010            task.wait(0.4)\010            return true\010        end\010        -- 2) no gear yet: go up, look at the moon and use the race ability (key T) during the night\010        if M.gearTouches == 0 then\010            local top = MV.islandTop(isl)\010            local t = Lighting.ClockTime\010            local night = t >= 18 or t <= 5\010            if top then flyTo(CFrame.new(top)) end\010            if night then\010                State.Text = \"Looking at the moon (race ability)\"\010                Diag.mirage = \"night: looking at the moon + race ability\"\010                local cam = workspace.CurrentCamera\010                pcall(function()\010                    local dir = Lighting:GetMoonDirection()\010                    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + dir * 1000)\010                end)\010                if os.clock() - M.lookAt > 1.5 then M.lookAt = os.clock(); MV.pressKey(\"T\") end\010            else\010                Diag.mirage = \"waiting for the night to find the gear\"\010            end\010            return true\010        end\010        -- 3) gear touched: Temple of Time lever\010        State.Text = \"Temple of Time: lever\"\010        if (hrp.Position - TEMPLE).Magnitude > 150 then\010            hrp.CFrame = CFrame.new(TEMPLE + Vector3.new(0, 5, 0))\010            task.wait(0.5)\010            return true\010        end\010        local found\010        for _, d in ipairs(workspace:GetDescendants()) do\010            if (d:IsA(\"ProximityPrompt\") or d:IsA(\"ClickDetector\")) and d.Parent then\010                local nm = (d.Parent.Name .. \" \" .. (d:IsA(\"ProximityPrompt\") and tostring(d.ActionText) or \"\")):lower()\010                local pp = d.Parent:IsA(\"BasePart\") and d.Parent.Position or nil\010                if pp and (pp - hrp.Position).Magnitude < 200 and (nm:find(\"lever\", 1, true) or nm:find(\"pull\", 1, true)) then\010                    found = d\010                    hrp.CFrame = CFrame.new(pp + Vector3.new(0, 4, 4))\010                    task.wait(0.3)\010                    MV.trigger(d)\010                    break\010                end\010            end\010        end\010        if found then M.leverDone = true; Diag.mirage = \"lever pulled\" else Diag.mirage = \"lever not found near the Temple of Time\" end\010        return true\010    end\010end\010\010-- ---- Inventory read straight from the game's client data (same method as the Banana hub) ----\010-- Finds, at runtime, the store (GetItems/ReadItem), the KEYS table (QUANTITY/MASTERY) and ReplicatedStorage.ItemConfig.\010AFL.Inv = { map = {}, at = 0, tries = 0, state = \"not started\" }\010do\010    local I = AFL.Inv\010    local RS = game:GetService(\"ReplicatedStorage\")\010    local store, keys, cfg\010    local function try(f) local ok, v = pcall(f); if ok then return v end end\010    local function discover()\010        if store and keys and cfg then return true end\010        if not cfg then\010            local ms = RS:FindFirstChild(\"ItemConfig\")\010            cfg = ms and try(function() return require(ms) end)\010        end\010        if (not store or not keys) and getgc and os.clock() - (I.lastScan or -99) > 20 then\010            I.lastScan = os.clock()\010            I.tries += 1\010            for _, v in ipairs(getgc(true)) do\010                if type(v) == \"table\" then\010                    if not keys and try(function() return rawget(v, \"QUANTITY\") end) ~= nil and try(function() return rawget(v, \"MASTERY\") end) ~= nil then keys = v end\010                    if not store and type(try(function() return v.GetItems end)) == \"function\" and type(try(function() return v.ReadItem end)) == \"function\" then store = v end\010                    if store and keys then break end\010                end\010            end\010        end\010        return (store and keys and cfg) and true or false\010    end\010    -- M\195\169todo principal (Quantum Onyx): remote GetAllItemValues devolve {ItemId, NetworkedUID, Key, Value}; o nome vem do ItemConfig\010    local netMod\010    local function viaRemote()\010        if not netMod then\010            local mods = RS:FindFirstChild(\"Modules\")\010            local nf = mods and mods:FindFirstChild(\"Net\")\010            netMod = nf and try(function() return require(nf) end)\010        end\010        local cfg2 = cfg\010        if not cfg2 then\010            local ms = RS:FindFirstChild(\"ItemConfig\")\010            cfg2 = ms and try(function() return require(ms) end)\010            cfg = cfg2 or cfg\010        end\010        if not (netMod and cfg2) then return nil, \"Net/ItemConfig missing\" end\010        local ok, res = pcall(function() return netMod:RemoteFunction(\"GetAllItemValues\"):InvokeServer() end)\010        if not ok or type(res) ~= \"table\" then return nil, \"GetAllItemValues failed: \" .. tostring(res) end\010        local by, rows = {}, 0\010        for _, r in next, res do\010            rows += 1\010            local k = tostring(r.ItemId) .. \"_\" .. tostring(r.NetworkedUID)\010            by[k] = by[k] or { id = r.ItemId, at = {} }\010            if r.Value ~= nil then by[k].at[r.Key] = r.Value end\010        end\010        local m, n, mast = {}, 0, {}\010        for _, it in next, by do\010            local okc, conf = pcall(function() return cfg2.match(it.id):unwrap() end)\010            local names = {}\010            if okc and conf then\010                local dl = conf.Index and conf.Index.DebugLabel\010                if dl then dl = tostring(dl); names[#names + 1] = dl:match(\"^(.-)%s*%[\") or dl end\010                local d = conf.Display and conf.Display.Name\010                if d then names[#names + 1] = tostring(d) end\010                local sk = conf.Index and conf.Index.StorageKey\010                if sk then names[#names + 1] = tostring(sk) end\010            end\010            local mv = tonumber(it.at.Mastery)\010            if mv and it.at.IsOwned == true then for _, nm in ipairs(names) do mast[nm] = math.max(mast[nm] or 0, mv) end end\010            local q = tonumber(it.at.Quantity) -- s\195\179 Quantity conta (IsOwned tamb\195\169m vale para receitas/itens desbloqueados e dava falso positivo)\010            if q and q > 0 and #names > 0 then\010                n += 1\010                for _, nm in ipairs(names) do\010                    m[nm] = math.max(m[nm] or 0, q)\010                    local nk = \"#\" .. string.lower(string.gsub(nm, \"[^%w]\", \"\"))\010                    m[nk] = math.max(m[nk] or 0, q)\010                end\010            end\010        end\010        if n == 0 then return nil, \"GetAllItemValues returned \" .. rows .. \" rows but no item matched\" end\010        I.mast = mast\010        return m, n .. \" items read (GetAllItemValues)\"\010    end\010    function I.refresh()\010        if os.clock() - I.at < 4 then return end\010        I.at = os.clock()\010        local m0, st0 = viaRemote()\010        if m0 then I.map, I.state = m0, st0 return end\010        I.remoteErr = st0\010        if not discover() then\010            I.state = string.format(\"module not found (store=%s keys=%s config=%s) | remote: %s\", tostring(store ~= nil), tostring(keys ~= nil), tostring(cfg ~= nil), tostring(I.remoteErr))\010            return\010        end\010        local m, n, mast = {}, 0, {}\010        local ok, err = pcall(function()\010            local a, b, c = store:GetItems(keys.QUANTITY)\010            local function each(fn)\010                if type(a) == \"function\" then for k, v in a, b, c do fn(k, v) end\010                elseif type(a) == \"table\" then for k, v in pairs(a) do fn(k, v) end end\010            end\010            each(function(_, it)\010                local q = type(it) == \"table\" and tonumber(it.Value)\010                if q and q > 0 then\010                    local okc, conf = pcall(function() return cfg.match(it.ItemId):unwrap() end)\010                    local name\010                    if okc and conf then\010                        local d = conf.Display\010                        name = (d and d.Name) or (conf.Index and conf.Index.StorageKey)\010                    end\010                    name = tostring(name or (\"ItemId_\" .. tostring(it.ItemId)))\010                    n += 1\010                    m[name] = (m[name] or 0) + q\010                    local nk = \"#\" .. string.lower(string.gsub(name, \"[^%w]\", \"\"))\010                    m[nk] = (m[nk] or 0) + q\010                    -- v85 fix: esse fallback (quando o remote \"GetAllItemValues\" do viaRemote() nao existe/muda de nome\010                    -- na build atual do jogo) so lia Quantity - NUNCA lia a Mastery, entao I.mast ficava sempre vazio e\010                    -- TODA arma virava \"mastery nao pode ser ler\" pro Auto Mastery/Auto 600 (ele so fica parado sem\010                    -- treinar nada). Igual o VX Hub faz (ReadItem direto pelo ItemId+NetworkedUID do proprio item, sem\010                    -- depender do remote que pode ter mudado de nome): le a mastery de cada item aqui tambem.\010                    local okm, mv = pcall(function() return store:ReadItem(keys.MASTERY, it.ItemId, it.NetworkedUID) end)\010                    mv = okm and tonumber(mv)\010                    if mv then\010                        mast[name] = math.max(mast[name] or 0, mv)\010                        mast[nk] = math.max(mast[nk] or 0, mv)\010                    end\010                end\010            end)\010        end)\010        if ok and next(mast) then I.mast = mast end\010        if ok then I.map, I.state = m, n .. \" item types read from the game data\"\010        else I.state = \"read error: \" .. tostring(err) end\010    end\010    function I.mastery(name) return I.mast and I.mast[name] or nil end\010    function I.count(name)\010        pcall(I.refresh)\010        local nk = \"#\" .. string.lower(string.gsub(tostring(name), \"[^%w]\", \"\"))\010        return I.map[name] or I.map[nk] or 0\010    end\010end\010\010\010-- ---- Tiro por remote (Dragonstorm / Skull Guitar): mira sozinho no alvo, sem clicar na tela e sem mexer na c\195\162mera ----\010-- Base: Quantum Onyx (RE/ShootGunEvent + Validator2 com o contador do CombatController) e Banana (SpamGunDragonStorm / Skull Guitar \"TAP\").\010AFL.Shot = { last = 0, state = \"not started\" }\010do\010    local S = AFL.Shot\010    local RS = game:GetService(\"ReplicatedStorage\")\010    local getup = getupvalue or (debug and debug.getupvalue)\010    local setup = setupvalue or (debug and debug.setupvalue)\010    local ctrlFn, shootEv, validator\010    local function init()\010        if shootEv and validator then return true end\010        pcall(function()\010            local mods = RS:FindFirstChild(\"Modules\")\010            local net = mods and mods:FindFirstChild(\"Net\")\010            shootEv = shootEv or (net and net:FindFirstChild(\"RE/ShootGunEvent\"))\010            local rem = RS:FindFirstChild(\"Remotes\")\010            validator = validator or (rem and rem:FindFirstChild(\"Validator2\"))\010        end)\010        return shootEv ~= nil\010    end\010    -- contador que o servidor confere (mesma conta do CombatController)\010    local function sig()\010        if not ctrlFn and getup then\010            pcall(function()\010                local cc = require(RS.Controllers.CombatController)\010                ctrlFn = getup(cc.Attack, 9)\010            end)\010        end\010        if not (ctrlFn and getup and setup) then return 0, 0 end\010        local ok, a, b = pcall(function()\010            local v19, v20, v21, v22 = getup(ctrlFn, 15), getup(ctrlFn, 13), getup(ctrlFn, 16), getup(ctrlFn, 17)\010            local v23, v24, v25 = getup(ctrlFn, 14), getup(ctrlFn, 18), getup(ctrlFn, 19)\010            if not (v19 and v20 and v21 and v22 and v23 and v24 and v25) then return 0, 0 end\010            local n = ((v19 * v23 + v20 * v21) % v22 * v22 + v20 * v23) % v24\010            local n2 = math.floor(n / v22)\010            local n3 = n - n2 * v22\010            local n4 = v25 + 1\010            setup(ctrlFn, 15, n2); setup(ctrlFn, 13, n3); setup(ctrlFn, 19, n4)\010            return math.floor(n / v24 * 16777215), n4\010        end)\010        if ok then return a, b end\010        return 0, 0\010    end\010    function S.fire(sc)\010        local char = Player.Character\010        local tool = char and char:FindFirstChildOfClass(\"Tool\")\010        local part = sc.part\010        if not (tool and part and part.Parent) then return end\010        local name = string.lower(tool.Name)\010        local pos = part.Position\010        if os.clock() - S.last < 0.1 then return end\010        if sc.kind == \"sg\" and string.find(name, \"skull guitar\", 1, true) then\010            S.last = os.clock()\010            local re = tool:FindFirstChild(\"RemoteEvent\")\010            if re then re:FireServer(\"TAP\", pos); S.state = \"Skull Guitar: TAP\" end\010        elseif sc.kind == \"gun\" and tool.ToolTip == \"Gun\" then\010            S.last = os.clock()\010            local re = tool:FindFirstChild(\"RemoteEvent\")\010            if re and string.find(name, \"skull guitar\", 1, true) then re:FireServer(\"TAP\", pos); S.state = \"Skull Guitar: TAP\"; return end\010            if not init() then S.state = \"RE/ShootGunEvent not found\"; return end\010            pcall(function()\010                tool:SetAttribute(\"IsReloading_Client\", false)\010                tool:SetAttribute(\"LocalShotsLeft\", 100)\010                tool:SetAttribute(\"LocalTotalShots\", (tool:GetAttribute(\"LocalTotalShots\") or 0) + 1)\010            end)\010            local a, b = sig()\010            if validator then pcall(function() validator:FireServer(a, b) end) end\010            pcall(function() shootEv:FireServer(pos, { part }) end)\010            S.state = \"Gun \" .. tool.Name .. \": shot at \" .. tostring(part.Name)\010        elseif sc.kind == \"ds\" and string.find(name, \"dragonstorm\", 1, true) then\010            if not init() then S.state = \"RE/ShootGunEvent not found\"; return end\010            S.last = os.clock()\010            pcall(function()\010                tool:SetAttribute(\"IsReloading_Client\", false)\010                tool:SetAttribute(\"LocalShotsLeft\", 100)\010                tool:SetAttribute(\"LocalTotalShots\", (tool:GetAttribute(\"LocalTotalShots\") or 0) + 1)\010            end)\010            local a, b = sig()\010            if validator then pcall(function() validator:FireServer(a, b) end) end\010            pcall(function() shootEv:FireServer(pos, { part }) end)\010            S.state = \"Dragonstorm: shot at \" .. tostring(part.Name)\010        end\010    end\010    Config.ShotFire = S.fire\010end\010\010function AFL.invDebug()\010    local raw = InvCache.raw\010    if type(raw) ~= \"table\" then return \"game data: \" .. tostring(AFL.Inv.state) .. \" | remote: no data\" end\010    local n, hits = 0, {}\010    for _, it in pairs(raw) do\010        n += 1\010        local nm = type(it) == \"table\" and tostring(it.Name) or tostring(_)\010        local l = string.lower(nm)\010        if string.find(l, \"scrap\", 1, true) or string.find(l, \"ember\", 1, true) or string.find(l, \"magnet\", 1, true) then\010            local f = {}\010            if type(it) == \"table\" then for k, v in pairs(it) do if type(v) ~= \"table\" then f[#f + 1] = tostring(k) .. \"=\" .. tostring(v) end end\010            else f[1] = tostring(it) end\010            hits[#hits + 1] = nm .. \"{\" .. table.concat(f, \",\") .. \"}\"\010        end\010    end\010    return \"game data: \" .. tostring(AFL.Inv.state) .. \" | remote: \" .. n .. \" entries | \" .. (#hits > 0 and table.concat(hits, \" \") or \"no scrap/ember/magnet entry\")\010end\010\010-- ---- Vulcan (Prehistoric Island, Sea 3, Sea Danger Level 6) ----\010AFL.Vulc = { scrapAt = 0, last = 0 }\010do\010    local V, MV = AFL.Vulc, AFL.MV\010    -- Real names taken from the Banana hub code: workspace.Map.PrehistoricIsland, Core.ActivationPrompt, Core.PrehistoricRelic.Skull,\010    -- Core.VolcanoRocks.Rock (VFXLayer.Specs.Enabled), Core.SpawnedDragonEggs.DragonEgg.Molten, workspace.DinoBone, HUD timers.\010    function V.island()\010        local map = workspace:FindFirstChild(\"Map\")\010        return (map and map:FindFirstChild(\"PrehistoricIsland\")) or MV.mapChild(\"prehistor\")\010    end\010    -- v24: marcador GLOBAL da ilha (_WorldOrigin.Locations[\"Prehistoric Island\"], como o Quantum/Banana): existe assim que o\010    -- evento nasce no servidor, mesmo quando o modelo do mapa ainda nao carregou (ilha longe). Devolve (objeto, Vector3).\010    function V.marker()\010        local ok, m = pcall(function()\010            local wo = workspace:FindFirstChild(\"_WorldOrigin\")\010            local locs = wo and wo:FindFirstChild(\"Locations\")\010            return locs and locs:FindFirstChild(\"Prehistoric Island\")\010        end)\010        if not (ok and m) then return nil end\010        local okP, p = pcall(function() return m:IsA(\"BasePart\") and m.Position or m:GetPivot().Position end)\010        return m, okP and p or nil\010    end\010    -- posicao da ilha: do modelo carregado ou do marcador. Devolve (Vector3, \"map\"|\"marker\")\010    function V.islandPos()\010        local isl = V.island()\010        if isl then\010            local ok, p = pcall(function() return isl:GetPivot().Position end)\010            if ok then return p, \"map\" end\010        end\010        local _, mp = V.marker()\010        if mp then return mp, \"marker\" end\010    end\010    -- contadores da sessao (aparecem na aba Vulcan)\010    V.stats = { islands = 0, golems = 0, rocks = 0, eggs = 0, bones = 0, resets = 0, crafts = 0, since = os.clock() }\010    V.golemSeen = setmetatable({}, { __mode = \"k\" })\010    V.act, V.actT = nil, 0                                     -- o que o motor esta fazendo agora (para o painel de status). NAO usar V.actAt: ele e o horario da ativacao do evento\010    local function setAct(a) V.act, V.actT = a, os.clock() end\010    local function vnotify(text, secs)\010        pcall(function() Fluent:Notify({ Title = \"Vulcan\", Content = text, Duration = secs or 4 }) end)\010    end\010    local function flag(k) return Config.VulcFull or Config[k] end\010    local function hud(name)\010        local ok, v = pcall(function() return Player.PlayerGui.Main.TopHUDList[name].Visible end)\010        return ok and v == true\010    end\010    local function netCall(name, ...)\010        local m = ReplicatedStorage:FindFirstChild(\"Modules\")\010        local n = m and m:FindFirstChild(\"Net\")\010        local r = n and n:FindFirstChild(name)\010        if not r then return false, \"remote \" .. name .. \" not found\" end\010        local args, done, ok, res = table.pack(...), false, false, nil\010        task.spawn(function() ok, res = pcall(r.InvokeServer, r, table.unpack(args, 1, args.n)); done = true end)\010        local t0 = os.clock()\010        while not done and os.clock() - t0 < 8 do task.wait(0.05) end\010        if not done then return false, \"no response (8s)\" end\010        return ok, res\010    end\010    local function npcCF(name)\010        for _, holder in ipairs({ workspace:FindFirstChild(\"NPCs\"), ReplicatedStorage:FindFirstChild(\"NPCs\") }) do\010            local n = holder and holder:FindFirstChild(name)\010            local p = n and (n:FindFirstChild(\"HumanoidRootPart\") or n.PrimaryPart or n:FindFirstChildWhichIsA(\"BasePart\", true))\010            if p then return p.CFrame end\010        end\010    end\010    local function spawnOf(name)\010        local wo = workspace:FindFirstChild(\"_WorldOrigin\")\010        local es = wo and wo:FindFirstChild(\"EnemySpawns\")\010        for _, p in ipairs(es and es:GetChildren() or {}) do\010            if p:IsA(\"BasePart\") and string.find(p.Name, name, 1, true) then return p end\010        end\010    end\010    local function killMob(name, why)\010        local e = findEnemy({ name })\010        State.Mode = \"Auto Volcanic Magnet\"\010        -- v42: findEnemy acha o mob mais proximo em QUALQUER lugar do mapa, sem limite de distancia. Sem este teto, um\010        -- Jungle Pirate / Hydra Enforcer / Venomous Assailant que spawna longe (ex.: perto de outro jogador, outra ilha)\010        -- \"sequestrava\" o Fully Vulcan: o motor parava de chamar MV.sail() para tentar chegar nele, e o barco (que so\010        -- anda enquanto o sail e chamado a cada tick) ficava parado no meio do mar ate o mob sumir ou morrer.\010        if e then\010            local _, hrp = getChar()\010            local eh, er = aliveParts(e)\010            local d = (hrp and er) and (hrp.Position - er.Position).Magnitude or math.huge\010            if d > 2000 then e = nil end\010        end\010        if e then\010            -- v24: puxa varios mobs juntos (Jungle Pirate / Hydra Enforcer / Venomous Assailant) para o Scrap Metal e a missao do Dragon Hunter sairem bem mais rapido\010            local n = math.clamp(math.floor(tonumber(Config.VulcMobPull) or 5), 1, 10)\010            if n > 1 then Fight.bringMax, Fight.bringRange, Fight.bringUntil = n, 350, os.clock() + 1.5 end\010            State.Text = why\010            fightEnemy(e, { name }, true)\010            return true\010        end\010        local sp = spawnOf(name)\010        if sp then State.Text = why .. \" (going to the spawn)\"; flyTo(sp.CFrame * CFrame.new(0, 30, 0)); return true end\010        return false\010    end\010    local function skills()\010        pcall(equipWeapon)\010        for _, k in ipairs({ Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V }) do\010            pressKey(k)\010            task.wait(0.15)\010        end\010    end\010    -- ===== v30: usa as armas e ataques escolhidos (Melee / Blox Fruit / Sword / Gun; M1 e teclas) contra uma parte =====\010    local VWEAPONS = { \"Melee\", \"Blox Fruit\", \"Sword\", \"Gun\" }\010    local VKEYS = { \"Z\", \"X\", \"C\", \"V\", \"F\" }\010    local function needClose(wset)\010        return wset and (wset.Melee or wset.Sword) and true or false -- Melee/Sword s\195\179 alcan\195\167am de perto\010    end\010    -- v53: clique bem mais rapido (1 por frame em vez de 1 a cada 0,05 s; a fruta clica 2x por frame e mira na parte)\010    -- v55 fix: Melee usava so o golpe do jogo (cfAttack) e Sword nao tinha NENHUM golpe aqui (so o Activate generico\010    -- la embaixo) - Sword praticamente nao batia nos golens. Agora os dois usam o MESMO click do motor principal\010    -- (Core.meleeSwordClick: golpe do jogo + registro de hit pelo remote + anti-travada), igual ao resto do hub.\010    local function m1Burst(tip, part)\010        local t0 = os.clock()\010        while Alive and part.Parent and os.clock() - t0 < 0.9 do\010            Aim.part = part\010            if tip == \"Melee\" or tip == \"Sword\" then pcall(Core.meleeSwordClick, tip)\010            elseif tip == \"Blox Fruit\" then pcall(FruitM1.tick); pcall(FruitM1.tick)\010            elseif tip == \"Gun\" and Config.ShotFire then pcall(Config.ShotFire, { kind = \"gun\", part = part }) end\010            pcall(function()\010                local tool = Player.Character and Player.Character:FindFirstChildOfClass(\"Tool\")\010                if tool and tip ~= \"Melee\" and tip ~= \"Sword\" then tool:Activate() end\010            end)\010            if tip == \"Gun\" then task.wait(0.05) else task.wait() end\010        end\010    end\010    -- devolve true se pelo menos uma arma escolhida foi usada\010    function V.useSet(wkey, kkey, part)\010        local used = false\010        local wset, kset = Config[wkey] or {}, Config[kkey] or {}\010        for _, tip in ipairs(VWEAPONS) do\010            if Alive and wset[tip] and part and part.Parent then\010                Config.SeaTool, Config.SeaUntil = { tip = tip }, os.clock() + 1.5\010                pcall(equipWeapon)\010                local tool = findTool(tip)\010                if tool then\010                    used = true\010                    task.wait(0.2)\010                    local ks = kset[tip] or {}\010                    Aim.part = part\010                    if ks.M1 then m1Burst(tip, part) end\010                    for _, k in ipairs(VKEYS) do\010                        if ks[k] and Alive and part.Parent then\010                            local kc = Enum.KeyCode[k]\010                            if kc then\010                                Config.SeaUntil = os.clock() + 1.5\010                                pcall(AFL.tvHook)\010                                AFL.TV.aimPos, AFL.TV.aimPart = part.Position, part\010                                VirtualInputManager:SendKeyEvent(true, kc, false, game)\010                                task.wait(0.15)\010                                VirtualInputManager:SendKeyEvent(false, kc, false, game)\010                                task.wait(0.06)\010                            end\010                        end\010                    end\010                end\010            end\010        end\010        Config.SeaUntil = 0\010        AFL.TV.aimPos, AFL.TV.aimPart = nil, nil\010        return used\010    end\010    -- \195\161rvores / plantas da miss\195\163o (v41): S\195\147 as plantas quebr\195\161veis do jogo (\"Meshes/plant1_Icosphere\") perto do plat\195\180 da miss\195\163o.\010    -- Antes aceitava qualquer \"tree\"/\"meshes/\" num raio de 900 studs: o personagem ficava batendo em \195\161rvore decorativa que n\195\163o quebra.\010    -- Varredura leve: s\195\179 o Map, no m\195\161ximo 1x a cada 12s (3s quando acabaram as plantas).\010    V.badPlant, V.plantTry = setmetatable({}, { __mode = \"k\" }), setmetatable({}, { __mode = \"k\" })\010    V.plants, V.plantsAt, V.plantsDry = {}, 0, false\010    local PLANT_CENTER = Vector3.new(5290, 1000, 390)\010    local PLANT_NAME = \"meshes/plant1_icosphere\"\010    local function plantNear(p, r, ry) -- horizontal <= r e vertical <= ry em rela\195\167\195\163o ao plat\195\180 da miss\195\163o\010        local d = p - PLANT_CENTER\010        return math.sqrt(d.X * d.X + d.Z * d.Z) <= r and math.abs(d.Y) <= ry\010    end\010    local function plantAlive(d)\010        if not d.Parent or V.badPlant[d] then return false end\010        local m = d:FindFirstAncestorWhichIsA(\"Model\")\010        return not (m and m:GetAttribute(\"AlreadyDestroyedClient\"))\010    end\010    local function nearestPlant(hrp)\010        local now = os.clock()\010        if now - V.plantsAt > (V.plantsDry and 3 or 12) then\010            V.plantsAt = now\010            local area, wide = {}, {}\010            -- 1) consulta espacial (r\195\161pida) s\195\179 no plat\195\180; 2) se n\195\163o achar nada, varre o Map inteiro (mais pesado)\010            local okQ, near = pcall(function() return workspace:GetPartBoundsInRadius(PLANT_CENTER, 450, OverlapParams.new()) end)\010            if okQ and type(near) == \"table\" then\010                for _, d in ipairs(near) do\010                    if string.lower(d.Name) == PLANT_NAME and plantNear(d.Position, 450, 250) and plantAlive(d) then area[#area + 1] = d end\010                end\010            end\010            if #area == 0 then\010                for _, d in ipairs((workspace:FindFirstChild(\"Map\") or workspace):GetDescendants()) do\010                    if d:IsA(\"BasePart\") and string.lower(d.Name) == PLANT_NAME and plantAlive(d) then\010                        if plantNear(d.Position, 450, 250) then area[#area + 1] = d\010                        elseif plantNear(d.Position, 1200, 450) then wide[#wide + 1] = d end\010                    end\010                end\010            end\010            V.plants = { area, wide }\010        end\010        for _, list in ipairs(V.plants) do\010            local best, bd\010            for _, d in ipairs(list) do\010                if plantAlive(d) then\010                    local dist = (d.Position - hrp.Position).Magnitude\010                    if not bd or dist < bd then best, bd = d, dist end\010                end\010            end\010            if best then V.plantsDry = false; return best end\010        end\010        V.plantsDry = true\010    end\010    -- toca na caveira da rel\195\173quia (voa at\195\169 ela, firetouchinterest + prompt/click se houver)\010    local function touchSkull(skull, hrp)\010        if (hrp.Position - skull.Position).Magnitude > 9 then\010            flyTo(skull.CFrame * CFrame.new(0, 3, 0))\010            return false\010        end\010        pcall(function()\010            if firetouchinterest then\010                firetouchinterest(hrp, skull, 0)\010                task.wait()\010                firetouchinterest(hrp, skull, 1)\010            end\010        end)\010        for _, o in ipairs({ skull, skull.Parent }) do\010            if o then\010                for _, dsc in ipairs(o:GetDescendants()) do\010                    if dsc:IsA(\"ProximityPrompt\") or dsc:IsA(\"ClickDetector\") then MV.trigger(dsc) end\010                end\010            end\010        end\010        return true\010    end\010    local function ember()\010        for _, d in ipairs(workspace:GetChildren()) do\010            if d.Name == \"EmberTemplate\" and not V.badEmber[d] then\010                local p = d:FindFirstChild(\"Part\")\010                if p and p.Position.Y > -100 then return d, p end\010            end\010        end\010    end\010    V.badEmber = setmetatable({}, { __mode = \"k\" })\010\010    -- Blaze Ember (l\195\179gica do Quantum Onyx + Banana): Dragon Hunter fica no Dojo (5864, 1209, 808).\010    -- RequestQuest + Check devolvem o texto da miss\195\163o (Defeat Hydra Enforcers / Venomous Assailants, ou Destroy trees).\010    -- Ao terminar aparece \"Task completed!\" -> pede a pr\195\179xima. Os Blaze Ember caem como EmberTemplate (Part com Y > 10).\010    local DH_CF = CFrame.new(5864, 1209, 808)\010    local function taskDone()\010        local ok, r = pcall(function()\010            local n = Player.PlayerGui:FindFirstChild(\"Notifications\")\010            if not n then return false end\010            for _, d in ipairs(n:GetDescendants()) do\010                if d:IsA(\"TextLabel\") and (string.find(d.Text, \"Task completed!\", 1, true) or string.find(d.Text, \"Head back to the Dojo\", 1, true)) then return true end\010            end\010            return false\010        end)\010        return ok and r\010    end\010    function V.checkQuest()\010        netCall(\"RF/DragonHunter\", { Context = \"RequestQuest\" })\010        local ok, r = netCall(\"RF/DragonHunter\", { Context = \"Check\" })\010        if not (ok and type(r) == \"table\" and r.Text) then return nil, tostring(r) end\010        local t = tostring(r.Text)\010        if string.find(t, \"Destroy\", 1, true) or string.find(t, \"Tree\", 1, true) or string.find(t, \"tree\", 1, true) then return { kind = \"tree\", text = t } end\010        if string.find(t, \"Venomous\", 1, true) or string.find(t, \"Assailant\", 1, true) then return { kind = \"kill\", mob = \"Venomous Assailant\", text = t } end\010        if string.find(t, \"Hydra\", 1, true) or string.find(t, \"Enforcer\", 1, true) or string.find(t, \"Defeat\", 1, true) then return { kind = \"kill\", mob = \"Hydra Enforcer\", text = t } end\010        return { kind = \"unknown\", text = t }\010    end\010    V.treePts = { Vector3.new(5326, 1000.5, 441.52), Vector3.new(5344.88, 1000.5, 359.94), Vector3.new(5260.73, 1000.5, 345.5), Vector3.new(5237.99, 1000.5, 429.64) }\010\010    function V.emberStep()\010        setAct(\"ember\")\010        State.Mode = Config.VulcEmber and not Config.VulcFull and not Config.VulcMagnet and \"Auto Blaze Ember\" or \"Auto Volcanic Magnet\"\010        local e, part = ember()\010        if e then\010            V.emberSince = V.emberSince or os.clock()\010            State.Text = \"Collecting Blaze Ember\"\010            Diag.vulc = \"Blaze Ember \" .. invCount(\"Blaze Ember\") .. \"/15: collecting the drop\"\010            if os.clock() - V.emberSince > 15 then V.badEmber[e] = true; V.emberSince = nil; return true end\010            flyTo(part.CFrame * CFrame.new(0, 3, 0))\010            return true\010        end\010        if V.emberSince then V.emberSince, V.cur = nil, nil end -- ember collected: next task\010        if V.cur and os.clock() - (V.curAt or 0) > 4 and taskDone() then V.cur = nil end\010        local _, hrp = getChar()\010        if not V.cur or os.clock() - (V.curAt or 0) > 180 then\010            local cf = npcCF(\"Dragon Hunter\") or DH_CF\010            if hrp and (hrp.Position - cf.Position).Magnitude > 12 then\010                State.Text = \"Going to the Dragon Hunter\"\010                Diag.vulc = \"going to the Dragon Hunter (Dojo)\"\010                flyTo(cf * CFrame.new(0, 4, 4))\010                return true\010            end\010            local q, err = V.checkQuest()\010            if q then\010                V.cur, V.curAt, V.unk = q, os.clock(), 0\010                V.plantsAt, V.plantsDry = 0, false -- miss\195\163o nova: varre as plantas de novo\010                Diag.vulc = \"Dragon Hunter task: \" .. q.text\010            else\010                Diag.vulc = \"Dragon Hunter gave no task: \" .. tostring(err)\010                task.wait(2)\010            end\010            return true\010        end\010        local q = V.cur\010        Diag.vulc = \"Blaze Ember \" .. invCount(\"Blaze Ember\") .. \"/15 | task: \" .. q.text\010        if q.kind == \"kill\" then\010            if killMob(q.mob, q.mob) then return true end\010            State.Text = \"Looking for \" .. q.mob\010            flyTo(CFrame.new(5251.9, 60, 453.6))\010            return true\010        elseif q.kind == \"tree\" then\010            State.Text = \"Breaking trees / plants\"\010            local tree = nearestPlant(hrp)\010            if tree then\010                local close = needClose(Config.VulcTreeW)\010                local goal = tree.Position + Vector3.new(0, close and 8 or 25, 0)\010                if (hrp.Position - goal).Magnitude > 12 then flyTo(CFrame.new(goal)); return true end\010                V.plantTry[tree] = (V.plantTry[tree] or 0) + 1\010                if V.plantTry[tree] > 6 then V.badPlant[tree] = true end -- n\195\163o quebrou depois de 6 rodadas: pula para a pr\195\179xima\010                if not V.useSet(\"VulcTreeW\", \"VulcTreeK\", tree) then\010                    Aim.part, Aim.level = tree, false\010                    skills()\010                end\010                return true\010            end\010            -- sem \195\161rvore carregada: patrulha os 4 pontos soltando as skills\010            V.pi = ((math.floor(os.clock() / 2)) % #V.treePts) + 1\010            local p = V.treePts[V.pi]\010            flyTo(CFrame.new(p))\010            return true\010        end\010        V.unk = (V.unk or 0) + 1\010        if V.unk > 20 then V.cur = nil end\010        return true\010    end\010\010    -- Volcanic Magnet: 10 Scrap Metal (kill Jungle Pirates) + 15 Blaze Ember (Dragon Hunter) -> craft with RF/Craft\010    function V.hasMagnet()\010        for _, c in ipairs({ Player.Backpack, Player.Character }) do\010            if c then for _, t in ipairs(c:GetChildren()) do\010                if t:IsA(\"Tool\") and string.find(string.lower(t.Name), \"volcanic magnet\", 1, true) then return true end\010            end end\010        end\010        local ok, has = pcall(function()\010            return hasItem(\"Volcanic Magnet\") or invCount(\"Volcanic Magnet\") > 0 or (AFL.Inv and AFL.Inv.count and AFL.Inv.count(\"Volcanic Magnet\") > 0)\010        end)\010        return ok and has and true or false\010    end\010    -- crafta um item da ilha pre-historica (RF/Craft \"Craft\" <nome> 1 {}); devolve (ok, resposta)\010    function V.craft(name)\010        local ok, r = netCall(\"RF/Craft\", \"Craft\", name, 1, {})\010        if not ok or r == false then                            -- plano B: o remote antigo (CommF_ \"CraftItem\"), igual ao da aba Shop\010            local ok2, r2 = invoke(\"CraftItem\", \"Craft\", name)\010            if ok2 and r2 ~= false then ok, r = ok2, r2 end\010        end\010        pcall(function() InvCache.at = 0 end)                   -- forca a leitura nova do inventario\010        return ok, r\010    end\010    -- posicao de um NPC (Vector3) para os botoes de atalho; \"Dragon Hunter\" tem posicao fixa de reserva\010    function V.npcPos(name)\010        local cf = npcCF(name) or (name == \"Dragon Hunter\" and DH_CF) or nil\010        return cf and cf.Position or nil\010    end\010    function V.magnetStep()\010        if V.hasMagnet() then Diag.vulc = \"already has the Volcanic Magnet\"; return false end\010        local scrap, ember = invCount(\"Scrap Metal\"), invCount(\"Blaze Ember\")\010        if scrap >= 10 and ember >= 15 then\010            setAct(\"magnet\")\010            State.Mode, State.Text = \"Auto Volcanic Magnet\", \"Crafting the Volcanic Magnet\"\010            if os.clock() - V.last > 5 then\010                V.last = os.clock()\010                local ok, r = V.craft(\"Volcanic Magnet\")\010                Diag.vulc = \"craft: \" .. tostring(ok) .. \" / \" .. tostring(r)\010                if ok and V.hasMagnet() then V.stats.crafts += 1; vnotify(\"Volcanic Magnet crafted!\", 5) end\010            end\010            return true\010        end\010        if scrap < 10 then\010            setAct(\"magnet\")\010            Diag.vulc = \"farming Scrap Metal \" .. scrap .. \"/10 (Jungle Pirate)\"\010            State.Text = \"Scrap Metal \" .. scrap .. \"/10\"\010            if killMob(\"Jungle Pirate\", \"Scrap Metal \" .. scrap .. \"/10\") then return true end\010            Diag.vulc = \"Jungle Pirate spawn not found (Sea 3, Deep Forest / Jungle)\"\010            return true -- fica no passo do magnet em vez de sair navegando sem o magnet\010        end\010        return V.emberStep()\010    end\010\010    -- ===== ovos e ossos (v24: varios de uma vez, o mais perto primeiro, sem travar num que nao da para pegar) =====\010    -- ovos: Core.SpawnedDragonEggs.DragonEgg.Molten (ProximityPrompt) | ossos: workspace.DinoBone\010    V.badEgg, V.eggTry, V.eggSeen = setmetatable({}, { __mode = \"k\" }), setmetatable({}, { __mode = \"k\" }), setmetatable({}, { __mode = \"k\" })\010    V.badBone, V.boneSeen = setmetatable({}, { __mode = \"k\" }), setmetatable({}, { __mode = \"k\" })\010    local function posOfAny(o)\010        if not o then return nil end\010        if o:IsA(\"BasePart\") then return o.Position end\010        local ok, p = pcall(function() return o:GetPivot().Position end)\010        return ok and p or nil\010    end\010    local function distP(p)\010        local _, hrp = getChar()\010        return (hrp and p) and (hrp.Position - p).Magnitude or math.huge\010    end\010    -- lista de ovos { e, m, pp, pos, d }: os que ja podem ser pegos primeiro, depois o mais perto\010    function V.eggs(isl)\010        local out = {}\010        local core = isl and isl:FindFirstChild(\"Core\")\010        local f = core and core:FindFirstChild(\"SpawnedDragonEggs\")\010        for _, e in ipairs(f and f:GetChildren() or {}) do\010            if e.Name == \"DragonEgg\" and not V.badEgg[e] then\010                local m = e:FindFirstChild(\"Molten\")\010                local pp = m and m:FindFirstChildOfClass(\"ProximityPrompt\")\010                local p = posOfAny(m)\010                if pp and p then out[#out + 1] = { e = e, m = m, pp = pp, pos = p, d = distP(p) } end\010            end\010        end\010        table.sort(out, function(a, b)\010            local ea, eb = a.pp.Enabled ~= false, b.pp.Enabled ~= false\010            if ea ~= eb then return ea end\010            return a.d < b.d\010        end)\010        return out\010    end\010    function V.egg(isl)                                       -- (compatibilidade com o v23)\010        local t = V.eggs(isl)[1]\010        if t then return t.m, t.pp end\010    end\010    function V.collectEgg(isl)\010        local list = V.eggs(isl)\010        local t = list[1]\010        if not t then return false end\010        local now = os.clock()\010        V.eggSeen[t.e] = V.eggSeen[t.e] or now\010        if now - V.eggSeen[t.e] > 120 then V.badEgg[t.e] = true; return false end     -- 2 min no mesmo ovo: desiste dele\010        setAct(\"egg\")\010        State.Mode, State.Text = \"Auto Collect Egg\", \"Collecting a Dragon Egg (\" .. #list .. \" on the island)\"\010        Diag.vulc = \"Dragon Egg: \" .. #list .. \" on the island\"\010        local _, hrp = getChar()\010        if hrp and (hrp.Position - t.pos).Magnitude > 8 then\010            flyTo(t.m:IsA(\"BasePart\") and t.m.CFrame or CFrame.new(t.pos))\010        elseif now - (V.eggFireAt or 0) > 0.3 then\010            V.eggFireAt, V.eggTarget = now, t.e\010            if t.pp.Enabled ~= false then\010                V.eggTry[t.e] = (V.eggTry[t.e] or 0) + 1\010                if V.eggTry[t.e] > 25 then V.badEgg[t.e] = true end                    -- 25 tentativas sem sumir: pula para o proximo\010            end\010            pcall(fireproximityprompt, t.pp)\010        end\010        return true\010    end\010    function V.bones()\010        local out = {}\010        for _, c in ipairs(workspace:GetChildren()) do\010            if c.Name == \"DinoBone\" and not V.badBone[c] then\010                local p = posOfAny(c)\010                if p then out[#out + 1] = { b = c, pos = p, d = distP(p) } end\010            end\010        end\010        table.sort(out, function(a, b) return a.d < b.d end)\010        return out\010    end\010    function V.collectBone()\010        local list = V.bones()\010        local t = list[1]\010        if not t then return false end\010        local now = os.clock()\010        V.boneSeen[t.b] = V.boneSeen[t.b] or now\010        if now - V.boneSeen[t.b] > 40 then V.badBone[t.b] = true; return false end    -- 40 s atras do mesmo osso: pula\010        setAct(\"bone\")\010        V.boneTarget = t.b\010        State.Mode, State.Text = \"Auto Collect Bone\", \"Collecting a Dino Bone (\" .. #list .. \" in the world)\"\010        Diag.vulc = \"Dino Bone: \" .. #list .. \" in the world\"\010        local part = t.b:IsA(\"BasePart\") and t.b or t.b:FindFirstChildWhichIsA(\"BasePart\", true)\010        flyTo(part and part.CFrame or CFrame.new(t.pos))\010        if part and t.d < 12 and now - (V.boneTouchAt or 0) > 0.4 then V.boneTouchAt = now; pcall(MV.touch, part) end\010        return true\010    end\010    -- 10 segundos depois da ilha terminar (ou sumir), reseta o personagem para recome\195\167ar o ciclo.\010    -- v41: s\195\179 reseta com o evento DE VERDADE encerrado (V.evtHold = tempo sem nenhum sinal do evento) e no m\195\161ximo 1x por ilha\010    -- (antes resetava em loop enquanto a ilha existia, e resetava no meio do evento quando o timer da HUD n\195\163o era lido).\010    function V.finish(why, force)\010        local now = os.clock()\010        local hold = force and 0 or ((V.evtHold or 0) - now)\010        if hold > 0 then\010            V.doneAt = nil\010            Diag.vulc = why .. \" | making sure the event ended (\" .. math.ceil(hold) .. \"s)\"\010            State.Mode, State.Text = Config.VulcFull and \"Auto Fully Vulcan\" or \"Auto Reset Vulcan\", \"Waiting for the event to end (\" .. math.ceil(hold) .. \"s)\"\010            return true\010        end\010        if V.resetDone then\010            Diag.vulc = why .. \" | already reset on this island: waiting for it to disappear\"\010            return false\010        end\010        V.doneAt = V.doneAt or now\010        local left = 10 - (now - V.doneAt)\010        Diag.vulc = why .. \" | reset in \" .. math.max(0, math.ceil(left)) .. \"s\"\010        if left <= 0 then\010            V.doneAt, V.seen, V.resetDone = nil, false, true\010            V.stats.resets += 1\010            local _, _, hum = getChar()\010            if hum then pcall(function() hum.Health = 0 end) end\010            return false\010        end\010        State.Mode, State.Text = Config.VulcFull and \"Auto Fully Vulcan\" or \"Auto Reset Vulcan\", why .. \" (reset in \" .. math.max(0, math.ceil(left)) .. \"s)\"\010        return true\010    end\010    -- true while an island is being worked on: the scheduler puts Vulcan first so nothing else steals the character\010    function V.engaged() return os.clock() - (V.activeAt or -1e9) < 3 end\010    -- devolve o golem mais perto e quantos existem\010    local function golem()\010        local _, hrp = getChar()\010        local best, bd, n = nil, 1e9, 0\010        for _, e in ipairs(enemiesList()) do\010            if e.Name == \"Lava Golem\" then\010                local eh, er = aliveParts(e)\010                if eh and hrp then\010                    local d = (hrp.Position - er.Position).Magnitude\010                    V.golemSeen[e] = d                                    -- guarda a ultima distancia (para contar a morte mesmo se o modelo sumir de uma vez)\010                    if d <= 1500 then\010                        n += 1\010                        if d < bd then best, bd = e, d end\010                    end\010                end\010            end\010        end\010        return best, n\010    end\010    -- v24: a pedra \"acesa\" tem VFXLayer.Specs.Enabled (Banana). Se a pedra nao tiver \"Specs\" (outra versao do jogo), confere\010    -- VFXLayer.At0.Glow.Enabled (Quantum). Com \"Specs\" presente o comportamento e exatamente o do v23.\010    local function rockOn(r)\010        local ok, on = pcall(function()\010            local vfx = r:FindFirstChild(\"VFXLayer\")\010            if not vfx then return false end\010            local sp = vfx:FindFirstChild(\"Specs\")\010            if sp then return sp.Enabled == true end\010            local at = vfx:FindFirstChild(\"At0\")\010            local gl = at and at:FindFirstChild(\"Glow\")\010            return gl ~= nil and gl.Enabled == true\010        end)\010        return ok and on == true\010    end\010    V.rocksSeen = setmetatable({}, { __mode = \"k\" })\010    local function activeRock(isl)\010        local core = isl and isl:FindFirstChild(\"Core\")\010        local f = core and core:FindFirstChild(\"VolcanoRocks\")\010        local best, bd, _, hrp = nil, 1e9, getChar()\010        for _, r in ipairs(f and f:GetChildren() or {}) do\010            if string.find(string.lower(r.Name), \"rock\", 1, true) then\010                local on = rockOn(r)\010                if on then V.rocksSeen[r] = true\010                elseif V.rocksSeen[r] then V.rocksSeen[r] = nil; V.stats.rocks += 1 end      -- apagou: pedra quebrada\010                if on and hrp then\010                    local d = (hrp.Position - r:GetPivot().Position).Magnitude\010                    if d < bd then best, bd = r, d end\010                end\010            end\010        end\010        return best\010    end\010    -- conta golens mortos (so quando o Humanoid chegou a vida 0); V.golemSeen e alimentado por golem()\010    -- (morreu = vida 0, ou o modelo sumiu estando perto de voce; um golem que some LONGE e so o jogo descarregando)\010    local function trackGolems()\010        for g, lastD in pairs(V.golemSeen) do\010            local hm = g.Parent and g:FindFirstChildOfClass(\"Humanoid\")\010            if not hm then\010                V.golemSeen[g] = nil\010                if type(lastD) == \"number\" and lastD < 400 then V.stats.golems += 1 end\010            elseif hm.Health <= 0 then\010                V.golemSeen[g] = nil\010                V.stats.golems += 1\010            end\010        end\010    end\010    -- touching lava hurts: remove the TouchInterest of the island and the interior lava (same as Banana)\010    -- v41: a rel\195\173quia (caveira) fica de fora: \195\169 ela que precisa ser tocada para encerrar o evento\010    local function cleanLava(isl)\010        if V.cleaned == isl then return end\010        V.cleaned = isl\010        pcall(function()\010            local relic = isl.Core:FindFirstChild(\"PrehistoricRelic\")\010            for _, d in ipairs(isl:GetDescendants()) do\010                if d.Name == \"TouchInterest\" and d.Parent and d.Parent.Name ~= \"TrialTeleport\" and not (relic and d:IsDescendantOf(relic)) then d:Destroy() end\010            end\010            local il = isl.Core:FindFirstChild(\"InteriorLava\")\010            if il then for _, c in ipairs(il:GetChildren()) do c:Destroy() end end\010        end)\010    end\010\010    -- v41: o evento conta como \"rodando\" por QUALQUER um destes sinais. Antes dependia s\195\179 do timer da HUD: se ele n\195\163o fosse lido\010    -- (nome diferente, some entre as fases...), o Fully achava que a ilha j\195\161 tinha acabado e resetava o personagem no meio do evento.\010    local function hudRunning()\010        local ok, v = pcall(function()\010            local list = Player.PlayerGui.Main.TopHUDList\010            local t = list:FindFirstChild(\"PrehistoricRaidTimer\")\010            if t and t:IsA(\"GuiObject\") and t.Visible then return true end\010            for _, c in ipairs(list:GetChildren()) do\010                if c:IsA(\"GuiObject\") and c.Visible and string.find(string.lower(c.Name), \"prehistoric\", 1, true) then return true end\010            end\010            return false\010        end)\010        return ok and v == true\010    end\010    local function eventSignals(isl)\010        local _, n = golem()\010        local s = { timer = hudRunning(), golems = n, rock = activeRock(isl) ~= nil }\010        -- timer da HUD \"preso\" depois que a caveira foi tocada e n\195\163o sobrou golem nem pedra: n\195\163o conta mais\010        if s.timer and n == 0 and not s.rock and V.skullDone and os.clock() - (V.skullAt or 0) > 45 then s.timer = false end\010        s.any = s.timer or n > 0 or s.rock\010        return s\010    end\010\010    -- ================================================================ funcoes ligadas (v24) ====\010    -- O Fully liga todas. Cada uma funciona SOZINHA:\010    --   magnet = Scrap Metal + Blaze Ember + craft | ember = so as missoes do Dragon Hunter (Blaze Ember) | find = navegar ate achar a ilha\010    --   start = ativar, golens, pedras, caveira   | egg / bone = coletar                    | reset = reseta 10 s depois do evento\010    function V.want()\010        local full = Config.VulcFull and true or false\010        local function f(k) return (full or Config[k]) and true or false end\010        local w = { full = full, magnet = f(\"VulcMagnet\"), find = f(\"VulcFind\"), start = f(\"VulcStart\"), egg = f(\"VulcEgg\"), bone = f(\"VulcBone\"), reset = f(\"VulcReset\"),\010            ember = (not full) and Config.VulcEmber and true or false }\010        w.act = w.start or w.egg or w.bone\010        w.any = w.magnet or w.ember or w.find or w.act\010        return w\010    end\010    local function unseat(hum, now)\010        if hum and hum.SeatPart and now - (V.unseatAt or 0) > 1 then V.unseatAt = now; pcall(function() hum.Sit = false end) end\010    end\010    -- a ilha existe no servidor mas o modelo ainda nao carregou (longe): voa ate o marcador para ele carregar\010    local function approachMarker(mpos, hrp, hum, now)\010        local d = (hrp.Position - mpos).Magnitude\010        if d < 450 then\010            V.mkNear = V.mkNear or now\010            if now - V.mkNear > 25 then\010                Diag.vulc = \"island marker reached, but the island model did not load (waiting)\"\010                return false\010            end\010        else\010            V.mkNear = nil\010        end\010        V.activeAt = now\010        MV.hold()\010        unseat(hum, now)\010        setAct(\"go\")\010        State.Mode, State.Text = \"Auto Vulcan\", \"Flying to the Prehistoric Island (\" .. math.floor(d) .. \" studs)\"\010        Diag.vulc = \"island marker found \" .. math.floor(d) .. \" studs away: flying closer so it loads\"\010        flyTo(CFrame.new(mpos + Vector3.new(0, 150, 0)))\010        return true\010    end\010    -- Auto Find sozinho: achou a ilha -> para o barco e (opcional) voa ate ela UMA vez; depois solta o personagem\010    local function goFind(hrp, hum, now)\010        local p = V.islandPos()\010        local d = p and (hrp.Position - p).Magnitude or 0\010        MV.hold()\010        setAct(\"find\")\010        if Config.VulcGo ~= false and p and not V.goArrived then\010            if d > 350 then\010                V.activeAt = now\010                unseat(hum, now)\010                State.Mode, State.Text = \"Auto Find Vulcan\", \"Island found: flying to it (\" .. math.floor(d) .. \" studs)\"\010                Diag.vulc = \"Prehistoric Island found \" .. math.floor(d) .. \" studs away: flying to it\"\010                flyTo(CFrame.new(p + Vector3.new(0, 200, 0)))\010                return true\010            end\010            V.goArrived = true\010        end\010        Diag.vulc = \"Prehistoric Island found\" .. (p and (\" (\" .. math.floor(d) .. \" studs away)\") or \"\")\010        return false\010    end\010\010    -- ======================================================================== a ilha ====\010    -- (mesma logica do v23, com as funcoes lidas de w.*). true = esta usando o personagem | false = nada a fazer agora\010    local function islandFlow(isl, w, hrp, hum, now)\010        V.seen = true\010        if V.islObj ~= isl then -- ilha nova (modelo diferente do ultimo visto): comeca uma \"visita\" nova, sem sobras da ilha anterior\010            V.islAt, V.sigAt, V.actAt, V.resetDone, V.doneAt, V.skullDone, V.skullAt = now, now, nil, false, nil, false, nil\010            V.started, V.cleaned, V.entered, V.skullGo, V.noRockAt, V.evtHold = nil, nil, nil, nil, nil, nil\010            V.ran, V.waitSince = nil, nil\010        end\010        V.islObj = isl\010        MV.hold()\010        local core = isl:FindFirstChild(\"Core\")\010        unseat(hum, now) -- v41: na ilha o personagem nao pode continuar sentado no barco (voava arrastando o barco)\010        -- 1) ainda nao esta dentro da ilha: o Fossil Expert fica na entrada\010        V.activeAt = now\010        if Player:GetAttribute(\"CurrentLocation\") == \"Prehistoric Island\" then V.entered = true end\010        if not V.entered then\010            local cf = npcCF(\"Fossil Expert\") or (core and core:GetPivot())\010            if cf and (hrp.Position - cf.Position).Magnitude > 12 then\010                setAct(\"enter\")\010                State.Mode, State.Text = \"Auto Vulcan\", \"Going to the Fossil Expert\"\010                Diag.vulc = \"phase: entering the island\"\010                flyTo(cf * CFrame.new(0, 4, 4))\010                return true\010            end\010            V.entered = true -- chegou na entrada: nunca mais volta para ela durante esta visita (evitava vai-e-vem)\010        end\010        cleanLava(isl)\010        -- v41: varios sinais (timer, golens, pedras) + a ativacao recente; \"V.evtHold\" = ate quando ainda NAO se pode dar a ilha por terminada\010        local sig = eventSignals(isl)\010        -- v53: V.ran = o evento RODOU de verdade nesta visita (golem / pedra / timer). So depois disso o reset pode acontecer.\010        -- v74 fix: \"V.actAt\" (ativou o evento) so era marcado quando o PROPRIO script apertava o ActivationPrompt - se o\010        -- jogador chegasse numa ilha onde o evento JA estava rodando (outro jogador ativou antes, ou o script detectou\010        -- o evento por um sinal qualquer sem nunca ter apertado o prompt), V.actAt ficava nil pra sempre nessa visita,\010        -- e so a folga curta (45s desde o ultimo sinal) valia - entao uma pausa normal entre fases (golens acabaram,\010        -- ainda sem pedra, timer da HUD \"preso\" um instante) conseguia ULTRAPASSAR esses 45s e resetar o personagem\010        -- NO MEIO do evento, sem ele ter de fato terminado (\"reset do nada\"). Agora qualquer sinal confirmado de\010        -- evento rodando tambem conta como \"ativado\" pra folga de 120s valer, tenha sido o script quem ativou ou nao.\010        if sig.any then\010            V.sigAt, V.resetDone, V.ran = now, false, true\010            V.actAt = V.actAt or now\010        end\010        if V.skullDone then V.ran = true end\010        -- v53: mais folga entre as fases (golens -> pedras -> caveira -> ovos) antes de dar o evento por terminado\010        local hold = V.sigAt + (V.skullDone and 20 or 45)\010        if V.actAt and not V.skullDone then hold = math.max(hold, V.actAt + 120) end\010        if V.skullAt then hold = math.max(hold, V.skullAt + 25) end\010        V.evtHold = math.max(hold, V.islAt + 45)\010        local running = sig.any or (V.actAt ~= nil and now - V.actAt < 45)\010        local why = \"timer \" .. (sig.timer and \"yes\" or \"no\") .. \", golems \" .. sig.golems .. \", rock \" .. (sig.rock and \"yes\" or \"no\")\010        -- 2) evento rodando: golens -> pedras -> caveira\010        if running and w.start then\010            V.doneAt = nil\010            State.bossAt = os.clock() -- evento rodando: coleta de fruta, dungeon, gacha e raid esperam\010            local g, gn = golem()\010            if g then\010                -- 2 ou mais golens: puxa todos para o mesmo ponto e bate neles juntos (ate o limite escolhido)\010                if Config.VulcPull ~= false and gn > 1 then\010                    Fight.bringMax = math.clamp(math.min(gn, tonumber(Config.VulcPullMax) or 6), 2, 10)\010                    Fight.bringRange, Fight.bringUntil = 1100, os.clock() + 1.5\010                end\010                V.noRockAt = nil\010                setAct(\"golem\")\010                State.Mode, State.Text = \"Auto Start Vulcan\", \"Killing \" .. gn .. \" Lava Golem\" .. (gn > 1 and \"s\" or \"\")\010                Diag.vulc = \"Lava Golems alive: \" .. gn .. (Fight.bringMax and (\" | pulling up to \" .. Fight.bringMax) or \"\")\010                fightEnemy(g, { \"Lava Golem\" }, true)\010                return true\010            end\010            local rock = activeRock(isl)\010            if rock then\010                setAct(\"rock\")\010                State.Mode, State.Text = \"Auto Start Vulcan\", \"Breaking the volcano rock\"\010                local pv = rock:GetPivot()\010                local up = needClose(Config.VulcRockW) and 10 or 45\010                -- v139: relato de comprador - \"morre atoa porque entra dentro do vulcao\" e \"erra os ataques nas pedras\".\010                -- (1) a altura era pv * CFrame.new(0, up, 0): o \"pra cima\" LOCAL da pedra - pedra inclinada/de lado jogava o\010                --     personagem pra dentro do vulcao/lava. Agora e o \"pra cima\" do MUNDO.\010                -- (2) o voo ia em linha reta ate la, atravessando o corpo do vulcao: agora sobe primeiro e so depois vai ate a pedra.\010                -- (3) a mira ia na primeira parte qualquer achada dentro da pedra (podia ser um detalhe pequeno fora do centro):\010                --     agora mira na MAIOR parte dela.\010                local gpos = pv.Position + Vector3.new(0, up, 0)\010                local hp0 = hrp.Position\010                if (hp0 - gpos).Magnitude > 14 then\010                    local hd0 = Vector3.new(gpos.X - hp0.X, 0, gpos.Z - hp0.Z).Magnitude\010                    local safeY = gpos.Y + 30\010                    if hd0 > 14 and hp0.Y < safeY - 8 then\010                        flyTo(CFrame.new(hp0.X, safeY, hp0.Z))\010                    else\010                        flyTo(CFrame.new(gpos))\010                    end\010                    return true\010                end\010                V.rockAim = V.rockAim or setmetatable({}, { __mode = \"k\" })\010                local part = V.rockAim[rock]\010                if not (part and part.Parent) then\010                    part = rock:IsA(\"BasePart\") and rock or nil\010                    local bv = part and (part.Size.X * part.Size.Y * part.Size.Z) or -1\010                    for _, d in ipairs(rock:GetDescendants()) do\010                        if d:IsA(\"BasePart\") then\010                            local vv = d.Size.X * d.Size.Y * d.Size.Z\010                            if vv > bv then part, bv = d, vv end\010                        end\010                    end\010                    V.rockAim[rock] = part\010                end\010                if part then\010                    Aim.part, Aim.level = part, false\010                    if not V.useSet(\"VulcRockW\", \"VulcRockK\", part) then skills() end\010                end\010                V.skullGo, V.noRockAt = true, nil\010                return true\010            end\010            V.noRockAt = V.noRockAt or os.clock()\010            local skull\010            pcall(function() skull = core.PrehistoricRelic.Skull end)\010            if V.skullGo and skull and os.clock() - V.noRockAt > 2 then\010                setAct(\"skull\")\010                State.Mode, State.Text = \"Auto Start Vulcan\", \"Going to the Relic Skull\"\010                if touchSkull(skull, hrp) then\010                    V.skullGo, V.skullDone, V.skullAt = false, true, os.clock()\010                    Diag.vulc = \"Relic Skull touched\"\010                end\010                return true\010            end\010            -- sem golem, pedra nem caveira pendente: os ovos que ja apareceram sao coletados mesmo com o timer ainda na tela\010            if w.egg and V.collectEgg(isl) then return true end\010            -- longe da ilha (ex.: morreu e renasceu longe): volta para ela em vez de ficar parado esperando\010            local apF = core and core:FindFirstChild(\"ActivationPrompt\")\010            if apF and (hrp.Position - apF.Position).Magnitude > 1000 then\010                setAct(\"go\")\010                State.Mode, State.Text = \"Auto Start Vulcan\", \"Returning to the island\"\010                Diag.vulc = \"far from the island: flying back (\" .. why .. \")\"\010                flyTo(apF.CFrame * CFrame.new(0, 40, 0))\010                return true\010            end\010            setAct(\"wait\")\010            Diag.vulc = \"event running (\" .. why .. \")\"\010            return true\010        end\010        -- 3) nao comecou: ActivationPrompt\010        if not running and not hud(\"RaidTimer\") and w.start then\010            local ap = core and core:FindFirstChild(\"ActivationPrompt\")\010            local pp = ap and ap:FindFirstChildOfClass(\"ProximityPrompt\")\010            if pp and pp.Enabled then\010                setAct(\"activate\")\010                State.Mode, State.Text = \"Auto Start Vulcan\", \"Activating the event\"\010                if (hrp.Position - ap.Position).Magnitude > 8 then flyTo(ap.CFrame) else pcall(fireproximityprompt, pp, 1); V.actAt = os.clock(); task.wait(3) end\010                return true\010            end\010        end\010        -- 4) coleta (ossos so enquanto nenhum timer esta rodando)\010        if w.egg and V.collectEgg(isl) then V.doneAt = nil; return true end\010        if w.bone and not running and not hud(\"RaidTimer\") and V.collectBone() then V.doneAt = nil; return true end\010        if w.reset and V.ran then return V.finish(\"island finished (\" .. why .. \")\") end\010        -- v53: a ilha apareceu mas o evento ainda NAO rodou nesta visita: nao reseta. Antes o Fully achava a ilha e resetava\010        -- uns 45 s depois, antes de terminar (ou sem nem comecar). Agora espera perto do ActivationPrompt (ate 5 min).\010        V.doneAt = nil\010        if w.start and not V.ran then\010            V.waitSince = V.waitSince or now\010            local apW = core and core:FindFirstChild(\"ActivationPrompt\")\010            if apW and now - V.waitSince < 300 then\010                setAct(\"wait\")\010                State.Mode = w.full and \"Auto Fully Vulcan\" or \"Auto Start Vulcan\"\010                State.Text = \"Waiting for the event to be ready (\" .. math.floor(now - V.waitSince) .. \"s)\"\010                Diag.vulc = \"island found, event not started yet - waiting at the activation point (no reset)\"\010                if (hrp.Position - apW.Position).Magnitude > 30 then flyTo(apW.CFrame * CFrame.new(0, 15, 0)) end\010                return true\010            end\010        end\010        Diag.vulc = \"Prehistoric Island found\" .. (V.ran and \"\" or \" (event did not run here: no reset)\")\010        return false\010    end\010\010    function V.step()\010        local w = V.want()\010        if not w.any then return false end\010        if getSea() ~= 3 then Diag.vulc = \"Vulcan only works in Sea 3\"; return false end\010        Fight.bringMax, Fight.bringRange = nil, nil -- so vale durante a luta contra os golens\010        local char, hrp, hum = getChar()\010        if not char then return false end\010        local now = os.clock()\010        -- contadores da sessao (o alvo sumiu = coletado)\010        if V.eggTarget and not V.eggTarget.Parent then V.stats.eggs += 1; V.eggTarget = nil end\010        if V.boneTarget and not V.boneTarget.Parent then V.stats.bones += 1; V.boneTarget = nil end\010        local isl = V.island()\010        local mobj, mpos = V.marker()\010        if isl then trackGolems() end\010        if isl or mpos then\010            V.nilAt = nil\010            local key = mobj or isl                  -- o marcador global dura o evento inteiro (o modelo pode carregar/descarregar)\010            if V.knownKey ~= key then -- ilha nova neste servidor\010                V.knownKey, V.known, V.foundNote, V.goArrived = key, now, false, false\010                V.stats.islands += 1\010            end\010            if not V.foundNote and (w.find or w.act) then\010                V.foundNote = true\010                local p = V.islandPos()\010                vnotify(\"Prehistoric Island found\" .. (p and (\" - \" .. math.floor((hrp.Position - p).Magnitude) .. \" studs away\") or \"\"))\010            end\010            if isl and w.act then\010                if islandFlow(isl, w, hrp, hum, now) then return true end\010            elseif mpos and w.act then\010                if approachMarker(mpos, hrp, hum, now) then return true end\010            elseif w.find and not w.act then\010                if goFind(hrp, hum, now) then return true end\010            end\010        else\010            -- sem ilha. v41: a ilha pode sumir por um instante (streaming / troca de modelo): espera 6s PARADO, sem navegar e sem resetar\010            V.known, V.knownKey, V.foundNote, V.goArrived, V.mkNear = nil, nil, false, false, nil\010            if V.seen and (w.act or w.reset) then\010                V.nilAt = V.nilAt or now\010                local gone = now - V.nilAt\010                if gone < 6 then\010                    MV.hold()\010                    Diag.vulc = \"island not visible for \" .. math.floor(gone) .. \"s: waiting (no boat, no reset)\"\010                    State.Mode, State.Text = w.full and \"Auto Fully Vulcan\" or \"Auto Vulcan\", \"Island not visible: waiting\"\010                    return true\010                end\010                V.islObj = nil\010                -- v53: so reseta se o evento rodou nesta ilha (antes resetava mesmo sem ter feito nada nela)\010                if w.reset and not V.resetDone and V.ran then\010                    if V.finish(\"island gone\", true) then return true end\010                end\010            end\010            V.seen, V.nilAt, V.doneAt, V.resetDone = false, nil, nil, false\010            V.started, V.cleaned, V.entered, V.skullGo, V.noRockAt, V.islObj, V.skullDone = nil, nil, nil, nil, nil, nil, nil\010            V.ran, V.waitSince = nil, nil\010        end\010        -- materiais do Im\195\163 e missoes do Dragon Hunter funcionam com ou sem ilha no servidor\010        if w.magnet and V.magnetStep() then return true end\010        if w.ember and V.emberStep() then return true end\010        if w.find and not (isl or mpos) then\010            setAct(\"sail\")\010            State.Mode = \"Auto Find Vulcan\"\010            Diag.vulc = \"sailing to Sea Danger Level 6, ignoring sea events\"\010            MV.equip(\"volcanic magnet\")\010            return MV.sail(0) -- sem trava na zona 6\010        end\010        return false\010    end\010\010\010    -- ================================================================ painel de status ====\010    -- Le o mundo (sem mexer em nada) e devolve o que cada funcao esta fazendo. A aba Vulcan chama isto a cada ~1,2 s.\010    function V.report()\010        local now = os.clock()\010        local w = V.want()\010        local rep = { w = w, stats = V.stats, fs = {} }\010        local sea = getSea()\010        local _, hrp = getChar()\010        local isl = V.island()\010        local _, mpos = V.marker()\010        local ipos = V.islandPos()\010        rep.sea, rep.isl, rep.mpos = sea, isl, mpos\010        rep.found = (isl ~= nil) or (mpos ~= nil)\010        rep.dist = (ipos and hrp) and math.floor((hrp.Position - ipos).Magnitude) or nil\010        rep.have = V.hasMagnet()\010        rep.scrap, rep.ember = invCount(\"Scrap Metal\"), invCount(\"Blaze Ember\")\010        local timer, gn, rock, eggs, bones, promptOn = false, 0, false, 0, #V.bones(), false\010        if isl then\010            timer = hudRunning()\010            local _, n = golem()\010            gn = n\010            rock = activeRock(isl) ~= nil\010            eggs = #V.eggs(isl)\010            pcall(function()\010                local pp = isl.Core.ActivationPrompt:FindFirstChildOfClass(\"ProximityPrompt\")\010                promptOn = pp ~= nil and pp.Enabled == true\010            end)\010        end\010        rep.timer, rep.golems, rep.rock, rep.eggs, rep.bones, rep.prompt = timer, gn, rock, eggs, bones, promptOn\010        local running = timer or gn > 0 or rock\010        rep.running = running\010        local function acting(...)\010            if now - (V.actT or 0) > 3 then return false end\010            for _, k in ipairs({ ... }) do if V.act == k then return true end end\010            return false\010        end\010        local fs = rep.fs\010        local function off(k) return not w[k] end\010        if sea ~= 3 then\010            for _, k in ipairs({ \"magnet\", \"ember\", \"find\", \"start\", \"egg\", \"bone\", \"reset\" }) do fs[k] = off(k) and \"Off\" or \"Waiting: Vulcan only works in Sea 3\" end\010            return rep\010        end\010        -- Volcanic Magnet\010        if off(\"magnet\") then fs.magnet = \"Off\"\010        elseif rep.have then fs.magnet = \"Done: you have the Volcanic Magnet\"\010        elseif rep.scrap >= 10 and rep.ember >= 15 then fs.magnet = \"Materials ready: crafting\" .. (acting(\"magnet\") and \" (working)\" or \"\")\010        elseif rep.scrap < 10 then fs.magnet = string.format(\"Scrap Metal %d/10 (Jungle Pirates)%s\", rep.scrap, acting(\"magnet\") and \" - working\" or \"\")\010        else fs.magnet = string.format(\"Blaze Ember %d/15 (Dragon Hunter)%s\", rep.ember, acting(\"ember\") and \" - working\" or \"\") end\010        -- Blaze Ember sozinho\010        if off(\"ember\") then fs.ember = \"Off\"\010        else fs.ember = string.format(\"Blaze Ember in bag: %d%s\", rep.ember, acting(\"ember\") and (V.cur and (\" | task: \" .. tostring(V.cur.text)) or \" - working\") or \"\") end\010        -- Find\010        if off(\"find\") then fs.find = \"Off\"\010        elseif rep.found then\010            fs.find = \"Island found\" .. (rep.dist and (\" - \" .. rep.dist .. \" studs away\") or \"\") .. (isl and \"\" or \" (not loaded yet)\")\010        else fs.find = (acting(\"sail\") and \"Sailing\" or \"Searching\") .. \" for the island\" .. (rep.have and \"\" or \" (no Volcanic Magnet yet)\") end\010        -- Start\010        if off(\"start\") then fs.start = \"Off\"\010        elseif not rep.found then fs.start = \"Waiting for the island to spawn\"\010        elseif not isl then fs.start = \"Island is far away - flying closer\"\010        elseif running then\010            fs.start = string.format(\"Event running - %d golem%s, rock %s, timer %s\", gn, gn == 1 and \"\" or \"s\", rock and \"active\" or \"no\", timer and \"on\" or \"off\")\010        elseif promptOn then fs.start = \"Ready: will activate the event\"\010        elseif V.skullDone then fs.start = \"Event finished\"\010        else fs.start = \"Nothing to do on this island right now\" end\010        -- Egg\010        if off(\"egg\") then fs.egg = \"Off\"\010        elseif not isl then fs.egg = rep.found and \"Island not loaded yet\" or \"Waiting for the island\"\010        elseif eggs > 0 then fs.egg = eggs .. \" egg\" .. (eggs == 1 and \"\" or \"s\") .. \" on the island\" .. (acting(\"egg\") and \" - collecting\" or \"\")\010        else fs.egg = \"No eggs right now\" end\010        -- Bone\010        if off(\"bone\") then fs.bone = \"Off\"\010        elseif bones > 0 then\010            fs.bone = bones .. \" bone\" .. (bones == 1 and \"\" or \"s\") .. \" in the world\" .. ((timer or hud(\"RaidTimer\")) and \" - waiting for the event timer to end\" or (acting(\"bone\") and \" - collecting\" or \"\"))\010        else fs.bone = \"No bones right now\" end\010        -- Reset\010        if off(\"reset\") then fs.reset = \"Off\"\010        elseif V.doneAt then fs.reset = \"Resetting in \" .. math.max(0, math.ceil(10 - (now - V.doneAt))) .. \"s\"\010        elseif V.resetDone then fs.reset = \"Already reset on this island\"\010        else fs.reset = \"Resets 10 s after the event ends (only if the event ran on this island)\" end\010        return rep\010    end\010end\010\010-- ================================================================ aba Vulcan (v24) ====\010-- Cartoes de estado ao vivo (motor + ilha), contadores da sessao, progresso do Volcanic Magnet, cada funcao com o seu proprio interruptor\010-- (e uma linha \"ao vivo\" dizendo o que ela esta fazendo), opcoes, armas para as pedras/arvores e atalhos (voar / craft).\010do\010    local T = Tabs.Vulcan\010    local V = AFL.Vulc\010    local TG = {}                                               -- interruptores (para o texto \"ao vivo\")\010    local function note(text, secs)\010        pcall(function() Fluent:Notify({ Title = \"Vulcan\", Content = text, Duration = secs or 4 }) end)\010    end\010    local function tg(id, title, desc)\010        local o = T:AddToggle(id, { Title = title, Description = desc, Default = Config[id] and true or false })\010        o:OnChanged(function(v) Config[id] = v; persist() end)\010        TG[id] = o\010        return o\010    end\010\010    -- ------------------------------------------------------------------ estado ao vivo ----\010    T:AddSection(\"Live Status\")\010    local sEngine = T:AddStatus({ Title = \"Vulcan Engine\", Content = \"Checking...\" })\010    local sIsland = T:AddStatus({ Title = \"Prehistoric Island\", Content = \"Checking...\" })\010    local sStats = T:AddStats({ Labels = { \"Islands\", \"Golems\", \"Rocks\", \"Eggs\", \"Bones\", \"Resets\" } })\010\010    -- ----------------------------------------------------------------------- fully ----\010    T:AddSection(\"Auto Fully\")\010    tg(\"VulcFull\", \"Auto Fully Vulcan\", \"Magnet items > sail > find the island > start it > eggs & bones > repeat\")\010    -- v54b: o \"so quando aparecer\" agora vale pra tudo e fica em Farm Settings > Events Only When They Spawn\010\010    -- ------------------------------------------------------------------------ im\195\163 ----\010    T:AddSection(\"Volcanic Magnet\")\010    local sMagnet = T:AddStatus({ Title = \"Volcanic Magnet\", Content = \"Checking...\", Height = 58 })\010    local pScrap = T:AddProgress({ Title = \"Scrap Metal\", Description = \"Dropped by Jungle Pirates (needs 10)\" })\010    local pEmber = T:AddProgress({ Title = \"Blaze Ember\", Description = \"Dragon Hunter tasks (needs 15)\" })\010    tg(\"VulcMagnet\", \"Auto Volcanic Magnet\", \"Farms 10 Scrap Metal + 15 Blaze Ember and crafts the Volcanic Magnet\")\010    tg(\"VulcEmber\", \"Auto Blaze Ember\", \"Only the Dragon Hunter tasks (Blaze Ember), without crafting the magnet\")\010    T:AddSlider(\"VulcMobPull\", { Title = \"Mob Pull\", Description = \"How many Jungle Pirates / Hydra Enforcers / Assailants are pulled together\",\010        Min = 1, Max = 10, Default = math.clamp(tonumber(Config.VulcMobPull) or 5, 1, 10), Rounding = 0 })\010        :OnChanged(function(v) Config.VulcMobPull = v; persist() end)\010    local crafting = false\010    local function craft(item, nice)\010        if crafting then return end\010        crafting = true\010        task.spawn(function()\010            local ok, r = V.craft(item)\010            crafting = false\010            if not ok then note(nice .. \": the craft request failed (\" .. tostring(r) .. \")\", 5)\010            elseif r == false then note(nice .. \": the server refused (missing materials?)\", 5)\010            else note(nice .. \": craft requested\", 4) end\010        end)\010    end\010    T:AddButton({ Title = \"Craft Volcanic Magnet\", Description = \"Needs 10 Scrap Metal and 15 Blaze Ember\", Label = \"Craft\", Callback = function() craft(\"Volcanic Magnet\", \"Volcanic Magnet\") end })\010\010    -- ------------------------------------------------------------------------ ilha ----\010    T:AddSection(\"Prehistoric Island\")\010    T:AddSubSection(\"1. Find\")\010    tg(\"VulcFind\", \"Auto Find Vulcan\", \"Sails to Danger Level 6 with the magnet until the island shows up\")\010    tg(\"VulcGo\", \"Fly To The Island\", \"After finding it, flies to the island once and lets go of the character\")\010    T:AddSubSection(\"2. Event\")\010    tg(\"VulcStart\", \"Auto Start Vulcan\", \"Activates the event, kills the golems, breaks the rocks, touches the skull\")\010    T:AddSubSection(\"3. Loot\")\010    tg(\"VulcEgg\", \"Auto Collect Egg\", \"Picks up every Dragon Egg on the island, nearest first\")\010    tg(\"VulcBone\", \"Auto Collect Bone\", \"Picks up the Dino Bones that drop after the event timers end\")\010    T:AddSubSection(\"4. After\")\010    tg(\"VulcReset\", \"Auto Reset Vulcan\", \"Resets your character 10 s after the event ends (use with Start / Egg / Bone)\")\010\010    -- ----------------------------------------------------------------------- golens ----\010    T:AddSection(\"Lava Golems\")\010    T:AddToggle(\"VulcPull\", { Title = \"Pull All Golems\", Description = \"With 2+ Lava Golems alive, pulls them together and hits them all at once\", Default = Config.VulcPull ~= false })\010        :OnChanged(function(v) Config.VulcPull = v; persist() end)\010    T:AddSlider(\"VulcPullMax\", { Title = \"Max Golems Pulled\", Description = \"How many golems are pulled together\", Min = 2, Max = 10, Default = math.clamp(tonumber(Config.VulcPullMax) or 6, 2, 10), Rounding = 0 })\010        :OnChanged(function(v) Config.VulcPullMax = v; persist() end)\010\010    -- ------------------------------------------- armas para as pedras e as arvores (v30) ----\010    local function multi(v)\010        local set = {}\010        if type(v) == \"table\" then\010            for k, val in pairs(v) do\010                if val == true then set[k] = true elseif type(val) == \"string\" then set[val] = true end\010            end\010        end\010        return set\010    end\010    local function copySet(t)\010        local o = {}\010        for k, v in pairs(t or {}) do if v == true then o[k] = true end end\010        return o\010    end\010    local VKEYS = {\010        Melee = { \"M1\", \"Z\", \"X\", \"C\", \"V\" }, [\"Blox Fruit\"] = { \"M1\", \"Z\", \"X\", \"C\", \"V\", \"F\" },\010        Sword = { \"M1\", \"Z\", \"X\", \"V\" }, Gun = { \"M1\", \"Z\", \"X\" },\010    }\010    local function weaponBlock(title, hint, wkey, kkey)\010        T:AddSection(title)\010        local wd = T:AddDropdown(wkey .. \"DD\", {\010            Title = \"Items to use\", Description = hint, Values = { \"Melee\", \"Blox Fruit\", \"Sword\", \"Gun\" }, Multi = true, Default = copySet(Config[wkey]),\010        })\010        wd:OnChanged(function(v) Config[wkey] = multi(v); persist() end)\010        for _, tip in ipairs({ \"Melee\", \"Blox Fruit\", \"Sword\", \"Gun\" }) do\010            Config[kkey] = Config[kkey] or {}\010            Config[kkey][tip] = Config[kkey][tip] or {}\010            T:AddDropdown(kkey .. string.gsub(tip, \" \", \"\"), {\010                Title = \"Attacks: \" .. tip, Description = \"M1 = basic click attack. Used only if \" .. tip .. \" is selected above\",\010                Values = VKEYS[tip], Multi = true, Default = copySet(Config[kkey][tip]),\010            }):OnChanged(function(v) Config[kkey][tip] = multi(v); persist() end)\010        end\010    end\010    weaponBlock(\"Volcano Pressure (break the rocks)\", \"Items used to break the glowing rocks and LOWER THE VOLCANO PRESSURE. Pick one or more; each one uses its own attacks below, one after the other\", \"VulcRockW\", \"VulcRockK\")\010    weaponBlock(\"Trees & Plants (Dragon Hunter task)\", \"Items used to destroy the trees and plants of the Blaze Ember task\", \"VulcTreeW\", \"VulcTreeK\")\010\010    -- --------------------------------------------------------------------- atalhos ----\010    T:AddSection(\"Shortcuts\")\010    local function fly(name, getPos, radius, up)\010        AFL.goDo(name, function()\010            local p = getPos()\010            return p and (p + Vector3.new(0, up or 0, 0)) or nil\010        end, function() task.wait(0.3) end, radius or 12)\010    end\010    T:AddButton({ Title = \"Fly To The Island\", Description = \"Flies above the Prehistoric Island (it has to exist in this server)\", Label = \"Go\", Callback = function()\010        fly(\"Prehistoric Island\", V.islandPos, 40, 90)\010    end })\010    T:AddButton({ Title = \"Go To Fossil Expert\", Description = \"The NPC at the entrance of the island\", Label = \"Go\", Callback = function()\010        fly(\"Fossil Expert\", function() return V.npcPos(\"Fossil Expert\") end, 14, 4)\010    end })\010    T:AddButton({ Title = \"Go To Dragon Hunter\", Description = \"The Dojo NPC that gives the Blaze Ember tasks\", Label = \"Go\", Callback = function()\010        fly(\"Dragon Hunter\", function() return V.npcPos(\"Dragon Hunter\") end, 14, 4)\010    end })\010    T:AddButton({ Title = \"Stop Flying\", Description = \"Cancels a shortcut that is still flying\", Label = \"Stop\", Callback = function() AFL.goStop() end })\010    for _, c in ipairs({ { \"Dragonheart\", \"Dragonheart\" }, { \"Dragonstorm\", \"Dragonstorm\" }, { \"DinoHood\", \"Dino Hood\" }, { \"TRexSkull\", \"T-Rex Skull\" } }) do\010        T:AddButton({ Title = \"Craft \" .. c[2], Description = \"Crafts the \" .. c[2] .. \" (needs the materials from the island)\", Label = \"Craft\", Callback = function() craft(c[1], c[2]) end })\010    end\010\010    -- ------------------------------------------------------------------- detalhes ----\010    T:AddSection(\"Details\")\010    local info = T:AddParagraph({ Title = \"Detection\", Content = \"Checking...\" })\010\010    -- ------------------------------------------------------------ atualizacao ao vivo ----\010    local ACT = {\010        magnet = \"Farming Scrap Metal / crafting the magnet\", ember = \"Dragon Hunter task (Blaze Ember)\", sail = \"Sailing to find the island\",\010        find = \"Heading to the island\", go = \"Flying to the island\", enter = \"Going to the Fossil Expert\", activate = \"Activating the event\",\010        golem = \"Killing Lava Golems\", rock = \"Breaking the volcano rocks\", skull = \"Touching the Relic Skull\", egg = \"Collecting Dragon Eggs\",\010        bone = \"Collecting Dino Bones\", wait = \"Waiting for the event\",\010    }\010    -- devolve (estado, \"o que esta fazendo\", \"detalhe\", selo)\010    local function engineOf(rep)\010        local w = rep.w\010        if not w.any then return \"off\", \"Idle\", \"Turn on Auto Fully Vulcan or any step below\", \"IDLE\" end\010        if rep.sea ~= 3 then return \"bad\", \"Wrong sea\", \"Vulcan only works in the Third Sea (you are in Sea \" .. tostring(rep.sea) .. \")\", \"SEA \" .. tostring(rep.sea) end\010        local owner = Core.owner\010        local diag = tostring(Diag.vulc or \"\")\010        if owner == \"Auto Vulcan\" then\010            local what = (os.clock() - (V.actT or 0) < 4 and ACT[V.act]) or tostring(State.Text or \"Working\")\010            return \"ok\", what, diag, w.full and \"FULLY\" or \"WORKING\"\010        elseif owner then\010            return \"info\", \"Standing by\", tostring(owner) .. \" has the character right now. Vulcan takes over when it has something to do\", \"STANDBY\"\010        end\010        return \"info\", \"Ready\", diag ~= \"\" and diag or \"Waiting for something to do\", \"READY\"\010    end\010    -- devolve (estado, nil, detalhe, selo)\010    local function islandOf(rep)\010        if rep.sea ~= 3 then return \"off\", nil, \"It only exists in the Third Sea\", \"N/A\" end\010        local d = rep.dist and (rep.dist .. \" studs away\") or nil\010        if rep.isl then\010            local state = rep.running and \"Event running\" or (rep.prompt and \"Ready to start\" or (V.skullDone and \"Event finished\" or \"Loaded\"))\010            local sub = string.format(\"%s%s | Golems %d | Rock %s | Timer %s | Eggs %d | Bones %d\", state, d and (\" | \" .. d) or \"\", rep.golems, rep.rock and \"on\" or \"off\", rep.timer and \"on\" or \"off\", rep.eggs, rep.bones)\010            return rep.running and \"ok\" or \"info\", nil, sub, rep.running and \"EVENT\" or (rep.prompt and \"READY\" or \"FOUND\")\010        elseif rep.mpos then\010          