d\", 600000, \"R\" },\010        { \"light\", 650000, \"R\" }, { \"rubber\", 750000, \"R\" }, { \"barrier\", 800000, \"R\" }, { \"ghost\", 940000, \"R\" }, { \"magma\", 960000, \"R\" },\010        { \"quake\", 1000000, \"L\" }, { \"buddha\", 1200000, \"L\" }, { \"love\", 1300000, \"L\" },\010        { \"spider\", 1500000, \"L\" }, { \"sound\", 1700000, \"L\" }, { \"soul\", 3300000, \"L\" }, { \"phoenix\", 1800000, \"L\" }, { \"portal\", 1900000, \"L\" },\010        { \"rumble\", 2100000, \"L\" }, { \"pain\", 2300000, \"L\" }, { \"blizzard\", 2400000, \"L\" }, { \"gravity\", 2500000, \"L\" },\010        { \"creation\", 1400000, \"M\" }, { \"mammoth\", 2700000, \"M\" }, { \"t-rex\", 2700000, \"M\" }, { \"trex\", 2700000, \"M\" },\010        { \"dough\", 2800000, \"M\" }, { \"shadow\", 2900000, \"M\" }, { \"venom\", 3000000, \"M\" }, { \"gas\", 3200000, \"M\" },\010        { \"control\", 3200000, \"M\" }, { \"spirit\", 3400000, \"M\" }, { \"dragon\", 3500000, \"M\" }, { \"yeti\", 3500000, \"M\" },\010        { \"leopard\", 5000000, \"M\" }, { \"kitsune\", 8000000, \"M\" },\010    }\010    local ADVANCED = { Dough = true, Phoenix = true }\010\010    -- fruit info from a name (\"Flame Fruit\", \"Flame-Flame\", \"Light\"...). Skin / unknown -> nil\010    local function infoOf(raw)\010        raw = string.lower(tostring(raw))\010        if string.find(raw, \"skin\", 1, true) then return nil end\010        -- v37: nomes internos do jogo: \"Bird-Bird: Falcon\", \"Bird-Bird: Phoenix\", \"Human-Human: Buddha\"\010        local sub = string.match(raw, \"^bird%-bird:%s*(%a+)\") or string.match(raw, \"^human%-human:%s*(%a+)\")\010        if sub then raw = sub end\010        for _, f in ipairs(FruitTable) do\010            local b = f[1]\010            if string.sub(raw, 1, #b) == b then\010                local nx = string.sub(raw, #b + 1, #b + 1)\010                if nx == \"\" or nx == \"-\" or nx == \" \" then return f end\010            end\010        end\010    end\010    local function toolInfo(tool) return infoOf(tool:GetAttribute(\"OriginalName\") or tool.Name) end\010\010    -- allowed to be spent? (never Mythical; -1M mode also bans Legendary and anything >= 1M; Advanced needs >= 1M)\010    local function eligible(f, only1M, needMin)\010        if not f then return false end\010        if only1M then\010            -- \"Pay With -1M Fruit\": so comum, incomum e rara abaixo de 1M\010            if not (f[3] == \"C\" or f[3] == \"U\" or f[3] == \"R\") or f[2] >= 1000000 then return false end\010        elseif f[3] == \"M\" and f[2] > 2500000 then\010            return false -- sem a opcao: usa todas as frutas, menos miticas acima de 2.5M\010        end\010        if needMin and f[2] < needMin then return false end\010        return true\010    end\010\010    local function okTool(t, only1M, need)\010        if R.ok[t] then return true end\010        return eligible(toolInfo(t), only1M, need)\010    end\010\010    local function bagFruits()\010        local list = {}\010        for _, c in ipairs({ Player.Backpack, Player.Character }) do\010            if c then\010                for _, t in ipairs(c:GetChildren()) do\010                    if t:IsA(\"Tool\") and (string.find(t.Name, \"Fruit\") or R.extra[t]) then\010                        list[#list + 1] = t\010                    end\010                end\010            end\010        end\010        return list\010    end\010\010    local function hasChip()\010        for _, c in ipairs({ Player.Backpack, Player.Character }) do\010            if c and c:FindFirstChild(\"Special Microchip\") then return true end\010        end\010        return false\010    end\010\010    -- ilha da raid perto de voc\195\170 (Banana: \"Island N\" a menos de 3000; Quantum: 3500)\010    local function nearIsland()\010        local wo = workspace:FindFirstChild(\"_WorldOrigin\")\010        local loc = wo and wo:FindFirstChild(\"Locations\")\010        local _, hrp = getChar()\010        if not (loc and hrp) then return nil end\010        local best, bn = nil, 0\010        for _, ch in ipairs(loc:GetChildren()) do\010            local n = tonumber(string.match(ch.Name, \"^Island (%d+)$\") or \"\")\010            -- v132: pedido do usuario - \"Auto Raid fica parado que nem estatua\". O bomba.lua (f85/f86) nao limita a\010            -- distancia: acha a \"Island N\" de maior numero em _WorldOrigin.Locations e vai ate ela. Aqui o limite de\010            -- 3500 studs fazia nearIsland() devolver nil (e active() dar falso) quando a raid comecava mais longe\010            -- que isso do personagem - o hub achava que nao tinha raid e ficava parado. Tirado o limite.\010            if n and ch:IsA(\"BasePart\") and n > bn then best, bn = ch, n end\010        end\010        return best\010    end\010    -- em raid = atributo IslandRaiding (Quantum) ou timer da raid vis\195\173vel + ilha por perto (Banana)\010    local function active()\010        if Player:GetAttribute(\"IslandRaiding\") == true then return true end\010        local ok, v = pcall(function() return Player.PlayerGui.Main.TopHUDList.RaidTimer.Visible end)\010        return (ok and v == true and nearIsland() ~= nil) or false\010    end\010    R.active = active\010\010    local function unequip()\010        local _, _, hum = getChar()\010        if hum then pcall(function() hum:UnequipTools() end) end\010    end\010\010    -- Mysterious Scientist: search the NPC folders; fallback = fixed spots (guess)\010    local function scientistCF()\010        for _, folder in ipairs({ workspace:FindFirstChild(\"NPCs\"), workspace }) do\010            if folder then\010                for _, d in ipairs(folder:GetChildren()) do\010                    local l = string.lower(d.Name)\010                    if d:IsA(\"Model\") and (string.find(l, \"scientist\", 1, true) or string.find(l, \"mysterious\", 1, true)) then\010                        local p = d:FindFirstChild(\"HumanoidRootPart\") or d.PrimaryPart or d:FindFirstChildWhichIsA(\"BasePart\")\010                        if p then return p.CFrame end\010                    end\010                end\010            end\010        end\010        local sea = getSea()\010        if sea == 2 then return CFrame.new(-6438, 250, -4501) end\010        if sea == 3 then return CFrame.new(-5017, 313, -2832) end\010    end\010\010    local function raidButton()\010        local map = workspace:FindFirstChild(\"Map\")\010        if not map then return end\010        local btn\010        pcall(function()\010            if getSea() == 3 then btn = map[\"Boat Castle\"].RaidSummon2.Button.Main\010            elseif getSea() == 2 then btn = (map.CircleIsland:FindFirstChild(\"RaidSummon2\") or map.CircleIsland.RaidSummon).Button.Main end\010        end)\010        if not (btn and btn:FindFirstChildOfClass(\"ClickDetector\")) then\010            btn = nil\010            local sm = map:FindFirstChild(\"RaidSummon2\", true) or map:FindFirstChild(\"RaidSummon\", true)\010            local m = sm and sm:FindFirstChild(\"Main\", true)\010            if m and m:FindFirstChildOfClass(\"ClickDetector\") then btn = m end\010        end\010        return btn\010    end\010\010    local function waitFor(fn, t)\010        local t0 = os.clock()\010        while os.clock() - t0 < t do\010            if fn() then return true end\010            task.wait(0.1)\010        end\010        return fn() and true or false\010    end\010    -- v38: remotes do modulo Net (o jogo migrou varias funcoes para la): acha por nome, chama com tempo limite\010    local function netRemotes(...)\010        local words, out = { ... }, {}\010        local m = ReplicatedStorage:FindFirstChild(\"Modules\")\010        local n = m and m:FindFirstChild(\"Net\")\010        for _, r in ipairs(n and n:GetChildren() or {}) do\010            local l = string.lower(r.Name)\010            for _, w in ipairs(words) do\010                if string.find(l, w, 1, true) then out[#out + 1] = r; break end\010            end\010        end\010        return out\010    end\010    local function netInvoke(r, ...)\010        if not (r and r:IsA(\"RemoteFunction\")) then return false, \"not a RemoteFunction\" end\010        local args, done, ok, res = table.pack(...), false, false, nil\010        task.spawn(function() ok, res = pcall(r.InvokeServer, r, table.unpack(args, 1, args.n)); done = true end)\010        local t0 = os.clock()\010        while not done and os.clock() - t0 < 6 do task.wait(0.05) end\010        if not done then return false, \"no response (6s)\" end\010        return ok, res\010    end\010    -- stored fruits (inventory) that are allowed: returns the candidates, cheapest first { {name, info}, ... }\010    -- v30: reads getInventoryFruits and, if empty, getInventory (fruit items); accepts several entry formats\010    -- v38: tambem aceita {[\"Flame-Flame\"] = {...}} (nome na chave), tenta remotes Net de inventario e guarda a resposta crua para o Status\010    local function storedList(only1M, needMin)\010        local names, seen = {}, {}\010        local function add(nm)\010            nm = tostring(nm)\010            if not seen[nm] then seen[nm] = true; names[#names + 1] = nm end\010        end\010        local function walk(t, depth, fruitOnly)\010            for k, it in pairs(t) do\010                if type(it) == \"table\" then\010                    local nm = it.Name or it.name or it.ItemName\010                    local ty = string.lower(tostring(it.Type or it.type or \"\"))\010                    if nm ~= nil and type(nm) ~= \"table\" then\010                        if not fruitOnly or string.find(ty, \"fruit\", 1, true) or infoOf(nm) then add(nm) end\010                    elseif type(k) == \"string\" and infoOf(k) then\010                        add(k)\010                    elseif depth < 3 then walk(it, depth + 1, fruitOnly) end\010                elseif type(it) == \"string\" and type(k) == \"number\" then\010                    add(it)\010                elseif type(k) == \"string\" and (it == true or type(it) == \"number\") and not fruitOnly then\010                    add(k)\010                end\010            end\010        end\010        local raw = {}\010        local function sample(tag, ok, inv)\010            local first\010            if type(inv) == \"table\" then\010                local k, v = next(inv)\010                first = (k ~= nil) and (tostring(k) .. \"=\" .. describe(v)) or \"empty table\"\010            else\010                first = tostring(inv)\010            end\010            raw[#raw + 1] = tag .. (ok and \"\" or \" (error)\") .. \": \" .. first\010        end\010        local ok, inv = invoke(\"getInventoryFruits\")\010        sample(\"getInventoryFruits\", ok, inv)\010        if ok and type(inv) == \"table\" then walk(inv, 1, false) end\010        if #names == 0 then\010            local ok2, inv2 = invoke(\"getInventory\")\010            sample(\"getInventory\", ok2, inv2)\010            if ok2 and type(inv2) == \"table\" then walk(inv2, 1, true) end\010        end\010        if #names == 0 then\010            for i, r in ipairs(netRemotes(\"inventory\")) do\010                if i > 4 then break end\010                local ok3, inv3 = netInvoke(r)\010                sample(r.Name, ok3, inv3)\010                if ok3 and type(inv3) == \"table\" then walk(inv3, 1, true) end\010                if #names > 0 then break end\010            end\010        end\010        -- v70: 2 fontes novas vindas dos scripts que o usuario mandou (Auto Pay nunca foi resolvido antes por falta\010        -- de dados reais de outra fonte que funcione em alguns builds do jogo):\010        -- 1) CommF_:InvokeServer(\"GetFruits\") sem o 2o argumento - formato diferente de \"getInventoryFruits\" (cada\010        --    entrada vem com .Name/.Price/.Rarity direto, sem aninhamento) - as vezes funciona quando a outra nao.\010        if #names == 0 then\010            local ok4, inv4 = invoke(\"GetFruits\")\010            sample(\"GetFruits\", ok4, inv4)\010            if ok4 and type(inv4) == \"table\" then\010                for _, it in pairs(inv4) do\010                    if type(it) == \"table\" and it.Name then add(it.Name) end\010                end\010            end\010        end\010        -- 2) le o cache do CLIENTE direto (ItemReplicationService/ItemConfig), sem depender de nenhum remote do\010        --    servidor responder certo - plano C de ultimo recurso quando os 2 de cima nao devolvem nada.\010        if #names == 0 then\010            pcall(function()\010                local rep = require(RS:WaitForChild(\"ItemReplicationService\", 3))\010                local icfg = require(RS:WaitForChild(\"ItemConfig\", 3))\010                local cache = rep._UserCache[Player.UserId]\010                for _, v in pairs(cache:GetItems(\"Quantity\") or {}) do\010                    local ok5, c = pcall(function() return icfg.match(v.ItemId):unwrap() end)\010                    if ok5 and c and c.Index and c.Index.IdType == \"PhysicalMoveset\" then\010                        local label = tostring(c.Index.DebugLabel or \"\"):gsub(\" %[.-%]\", \"\")\010                        add(label)\010                    end\010                end\010            end)\010            sample(\"ItemReplicationService cache\", true, tostring(#names) .. \" name(s) found\")\010        end\010        local out = {}\010        for _, nm in ipairs(names) do\010            local f = infoOf(nm)\010            if f and eligible(f, only1M, needMin) then out[#out + 1] = { nm, f } end\010        end\010        table.sort(out, function(x, y) return x[2][2] < y[2][2] end)\010        R.invSummary = #names .. \" in inventory, \" .. #out .. \" allowed\" .. (#out > 0 and (\" (cheapest: \" .. out[1][1] .. \")\") or \"\")\010        if #out == 0 then\010            if #names > 0 then R.invSummary = R.invSummary .. \" | names seen: \" .. table.concat(names, \", \", 1, math.min(#names, 6)) end\010            R.invSummary = R.invSummary .. \" | raw: \" .. table.concat(raw, \" ; \")\010        end\010        return out\010    end\010    -- takes ONE fruit out of the inventory and returns the new backpack tool (or nil)\010    -- v37: mais variacoes de nome para o LoadFruit, espera 4s por tentativa e aceita a fruta que ja esta na mochila/mao\010    -- v38: se o CommF_ nao entregar, tenta os remotes Net de \"load/take/equip fruit\"\010    local function loadOne(entry)\010        local before = {}\010        for _, c in ipairs({ Player.Backpack, Player.Character }) do\010            for _, t in ipairs(c and c:GetChildren() or {}) do before[t] = true end\010        end\010        local nm = entry[1]\010        local tries, seenT = {}, {}\010        local function addTry(a) if a and a ~= \"\" and not seenT[a] then seenT[a] = true; tries[#tries + 1] = a end end\010        addTry(nm)\010        local base = string.match(nm, \"^(%a+)\")\010        if base then\010            addTry(base .. \"-\" .. base)\010            addTry(base .. \" Fruit\")\010            addTry(base)\010        end\010        local lowBase = base and string.lower(base)\010        local function findLoaded()\010            for _, c in ipairs({ Player.Backpack, Player.Character }) do\010                for _, t in ipairs(c and c:GetChildren() or {}) do\010                    if t:IsA(\"Tool\") then\010                        if not before[t] and (c == Player.Backpack or string.find(t.Name, \"Fruit\")) then return t end\010                        if lowBase and string.find(t.Name, \"Fruit\") and string.sub(string.lower(t:GetAttribute(\"OriginalName\") or t.Name), 1, #lowBase) == lowBase then return t end\010                    end\010                end\010            end\010        end\010        local replies = {}\010        for _, arg in ipairs(tries) do\010            local ok, res = invoke(\"LoadFruit\", arg)\010            replies[#replies + 1] = arg .. \"->\" .. (ok and describe(res) or tostring(res))\010            Diag.raid = \"Auto Pay (fruit): LoadFruit \" .. arg .. \" -> \" .. (ok and describe(res) or tostring(res))\010            local found\010            waitFor(function() found = findLoaded(); return found ~= nil end, 4)\010            if found then R.extra[found] = true; R.ok[found] = true; return found end\010        end\010        -- plano B: remotes Net com nome de carregar/pegar a fruta\010        local cands = netRemotes(\"loadfruit\", \"takefruit\", \"equipfruit\", \"withdrawfruit\", \"getfruit\")\010        for i, r in ipairs(cands) do\010            if i > 3 then break end\010            for _, arg in ipairs({ nm, tries[2] or nm }) do\010                local ok, res = netInvoke(r, arg)\010                replies[#replies + 1] = r.Name .. \"(\" .. arg .. \")->\" .. (ok and describe(res) or tostring(res))\010                local found\010                waitFor(function() found = findLoaded(); return found ~= nil end, 3)\010                if found then R.extra[found] = true; R.ok[found] = true; return found end\010            end\010        end\010        local seenNet = {}\010        for _, r in ipairs(netRemotes(\"fruit\")) do seenNet[#seenNet + 1] = r.Name; if #seenNet >= 8 then break end end\010        R.loadFail = table.concat(replies, \" ; \") .. (#seenNet > 0 and (\" | Net fruit remotes: \" .. table.concat(seenNet, \", \")) or \" | no Net fruit remote\")\010    end\010\010    -- Buy the chip. Money = nothing in hand (once per 2h). Fruit = the cheapest allowed fruit in hand.\010    -- Before paying with fruit EVERY forbidden fruit (Mythical, Legendary in -1M mode, skin, unknown) is stored; if one cannot be stored, it does NOT pay.\010    -- v30: while paying, R.hold blocks Auto Store and weapon re-equip, so nothing takes the fruit out of the hand.\010    -- Returns true (got the chip), false (cannot pay now), nil (still working: traveling / loading a fruit)\010    local function setHold(v) R.hold = v; Config.PayHoldUntil = v end\010    local function holdFruit(tool)\010        local char, _, hum = getChar()\010        if not (char and hum and tool and tool.Parent) then return false end\010        if tool.Parent == char then return true end\010        pcall(function() hum:UnequipTools() end)\010        for _ = 1, 6 do\010            pcall(function() hum:EquipTool(tool) end)\010            task.wait(0.15)\010            if tool.Parent == char then return true end\010        end\010        return tool.Parent == char\010    end\010    local function prepare(adv, need)\010        if Config.PayMode == \"Fruit\" then\010            setHold(os.clock() + 25)\010            if adv and Config.PayOnly1M then\010                Diag.raid = \"Advanced raids need a fruit worth $1M+; turn off 'Pay With -1M Fruit' or pay with money (fragments)\"\010                setHold(0)\010                return false\010            end\010            local usable, blocked = {}, {}\010            for _, t in ipairs(bagFruits()) do\010                if okTool(t, Config.PayOnly1M, need) then usable[#usable + 1] = t\010                else blocked[#blocked + 1] = t end\010            end\010            if #usable == 0 then\010                local list = storedList(Config.PayOnly1M, need)\010                if #list == 0 then\010                    Diag.raid = \"Auto Pay (fruit): no allowed fruit in the backpack or inventory (\" .. tostring(R.invSummary or \"inventory unreadable\") .. \"). Nothing was spent.\"\010                    setHold(0)\010                    return false\010                end\010                local tool\010                for i = 1, math.min(3, #list) do\010                    Diag.raid = \"Auto Pay (fruit): taking \" .. list[i][1] .. \" out of the inventory\"\010                    tool = loadOne(list[i])\010                    if tool then break end\010                end\010                if not tool then\010                    Diag.raid = \"Auto Pay (fruit): the fruit d