o bot NAO tenta\010-- essa parte: ele para e avisa que falta fazer isso manualmente.\010local fullSubmitAt = -1e9\010local function findToolByName(nm)\010    for _, c in ipairs({ Player.Backpack, Player.Character }) do\010        if c then\010            local t = c:FindFirstChild(nm)\010            if t and t:IsA(\"Tool\") then return t end\010        end\010    end\010end\010local function submitToWizard()\010    if os.clock() - fullSubmitAt < 3 then return end\010    fullSubmitAt = os.clock()\010    task.spawn(function() call(net(\"RF/InteractDragonQuest\"), { NPC = \"Dragon Wizard\", Command = \"DragonRace\" }) end)\010end\010-- V1: vai ate o wizard e pede a troca de raca (repete ate Player.Data.Race virar \"Draco\")\010local function v1Step()\010    if myRace() == \"Draco\" then return false end\010    local _, hrp = getChar()\010    if not hrp then return true end\010    if (hrp.Position - WIZARD).Magnitude > 6 then\010        D.status = \"Full Draco V1: going to the Dragon Wizard\"\010        flyTo(CFrame.new(WIZARD))\010        return true\010    end\010    D.status = \"Full Draco V1: asking for the Draco race\"\010    submitToWizard()\010    return true\010end\010-- V2: junta 5 Fire Flowers (reusa D.flowerStep) e depois vai falar com o wizard algumas vezes; sem forma confiavel de saber se o\010-- servidor ja aceitou, para de tentar depois de algumas tentativas pra nao travar o V3 pra sempre caso a V2 ja tenha sido concluida antes\010local v2Submits = 0\010local function v2Step()\010    if D.flowers < 5 then\010        local ok, busy = pcall(D.flowerStep)\010        if ok then D.status = \"Full Draco V2: \" .. D.status; return busy end\010        return false\010    end\010    if v2Submits >= 6 then return false end\010    local _, hrp = getChar()\010    if hrp and (hrp.Position - WIZARD).Magnitude > 6 then\010        D.status = \"Full Draco V2: got the flowers, going to the Dragon Wizard\"\010        flyTo(CFrame.new(WIZARD))\010        return true\010    end\010    D.status = \"Full Draco V2: flowers ready, asking the Dragon Wizard (\" .. (v2Submits + 1) .. \"/6)\"\010    if os.clock() - fullSubmitAt >= 3 then v2Submits += 1 end\010    submitToWizard()\010    return true\010end\010-- V3: cata Terrorshark (mesmo mecanismo generico de combate das outras rotinas) e depois vai falar com o wizard algumas vezes\010local v3Submits = 0\010local function v3Step()\010    local e = findEnemy({ \"Terrorshark\" })\010    if e then\010        D.status = \"Full Draco V3: fighting the Terrorshark\"\010        fightEnemy(e, { \"Terrorshark\" }, true)\010        return true\010    end\010    local sp = findSpawn({ \"Terrorshark\" })\010    if sp then\010        D.status = \"Full Draco V3: going to the Terrorshark\"\010        flyTo(sp.CFrame * CFrame.new(0, 12, 0))\010        return true\010    end\010    if v3Submits >= 6 then return false end\010    local _, hrp = getChar()\010    if hrp and (hrp.Position - WIZARD).Magnitude > 6 then\010        D.status = \"Full Draco V3: no Terrorshark around, trying the Dragon Wizard\"\010        flyTo(CFrame.new(WIZARD))\010        return true\010    end\010    D.status = \"Full Draco V3: asking the Dragon Wizard (\" .. (v3Submits + 1) .. \"/6)\"\010    if os.clock() - fullSubmitAt >= 3 then v3Submits += 1 end\010    submitToWizard()\010    return true\010end\010-- V4: so checa os pre-requisitos que a gente consegue ler/fazer de verdade (mastria 500 e o Coracao do Leviathan via toggles existentes);\010-- nao tenta a parte da Hydra congelada / Vault Room (sem remote verificado).\010local function v4Step()\010    local heart = findToolByName(\"Dragonheart\")\010    local storm = findToolByName(\"Dragonstorm\")\010    local mHeart = heart and AFL.Mast and AFL.Mast.readMast(heart)\010    local mStorm = storm and AFL.Mast and AFL.Mast.readMast(storm)\010    if not (heart and storm and mHeart and mStorm and mHeart >= 500 and mStorm >= 500) then\010        D.status = string.format(\"Full Draco V4: need 