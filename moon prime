            return "local __E = ...\010local AFL = __E.AFL\010local Config, Connections, Core, Diag, Fluent, Player, State = __E.Config, __E.Connections, __E.Core, __E.Diag, __E.Fluent, __E.Player, __E.State\010local Tabs, activeQuestTitle, fightEnemy, findEnemy, findSpawn, flyTo, getChar = __E.Tabs, __E.activeQuestTitle, __E.fightEnemy, __E.findEnemy, __E.findSpawn, __E.flyTo, __E.getChar\010local getPlayerLevel, getSea, hasItem, invCount, invoke, persist, questVisible = __E.getPlayerLevel, __E.getSea, __E.hasItem, __E.invCount, __E.invoke, __E.persist, __E.questVisible\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ---------- Auto Fully (v24): rotinas \"faz tudo sozinho\" ----------\010-- Fluxos e remotes portados dos hubs de referencia: bomba (Saber, Darkbeard, Cursed Captain, Rip Indra, Law Raid), Quantum Onyx (Rengoku, Law Raid,\010-- Rainbow Haki, Observation V2, Soul Guitar) e Banana (pads de Haki do Rip Indra). Nada disto foi testado no jogo real, so no simulador.\010-- Uma rotina por vez, na ordem de F.list. Cada rotina: { key, cfg, title, sea, done(), step(r) -> true se ocupou o turno }.\010AFL.Fully = { list = {}, by = {}, at = {}, cool = {}, status = \"Idle\", cur = nil, started = os.clock() }\010do\010    local F = AFL.Fully\010    local RS = ReplicatedStorage\010    local V3 = Vector3.new\010    local SEACMD = { \"TravelMain\", \"TravelDressrosa\", \"TravelZou\" }\010    local SEALV = { 0, 700, 1500 }\010    F.R = {}\010\010    -- ---------- helpers ----------\010    local function every(key, sec)\010        if os.clock() - (F.at[key] or -1e9) < sec then return false end\010        F.at[key] = os.clock()\010        return true\010    end\010    F.every = every\010    local function inv(...)\010        local ok, res = invoke(...)\010        if ok then return res end\010        return nil\010    end\010    F.inv = inv\010    local function dval(n)\010        local d = Player:FindFirstChild(\"Data\")\010        local v = d and d:FindFirstChild(n)\010        return v and tonumber(v.Value) or 0\010    end\010    F.dval = dval\010    local function raceName()\010        local d = Player:FindFirstChild(\"Data\")\010        local r = d and d:FindFirstChild(\"Race\")\010        return r and tostring(r.Value) or \"?\"\010    end\010    F.raceName = raceName\010    local function tool(name)\010        for _, c in ipairs({ Player.Character, Player.Backpack }) do\010            local t = c and c:FindFirstChild(name)\010            if t and t:IsA(\"Tool\") then return t end\010        end\010    end\010    F.tool = tool\010    local function equip(name)\010        local t = tool(name)\010        if t and t.Parent ~= Player.Character then\010            local _, _, hum = getChar()\010            if hum then hum:EquipTool(t) end\010        end\010        return t\010    end\010    F.equip = equip\010    local function owns(name)\010        return tool(name) ~= nil or hasItem(name)\010    end\010    F.owns = owns\010    -- itens que ja estao no inventario mas fora da mao (espadas) voltam para a mochila com LoadItem\010    local function loadItem(name)\010        if owns(name) and not tool(name) and every(\"load\" .. name, 3) then invoke(\"LoadItem\", name) end\010        return tool(name)\010    end\010    F.loadItem = loadItem\010    local function goTo(cf, r, up)\010        local _, hrp = getChar()\010        if not hrp then return false end\010        if (hrp.Position - cf.Position).Magnitude <= (r or 8) then return true end\010        flyTo(up and (cf * CFrame.new(0, up, 0)) or cf)\010        return false\010    end\010    F.goTo = goTo\010    local function near(v, r)\010        local _, hrp = getChar()\010        return hrp ~= nil and (hrp.Position - v).Magnitude <= (r or 8)\010    end\010    local function touch(part)\010        local _, hrp = getChar()\010        if hrp and part and firetouchinterest then\010            pcall(function() firetouchinterest(hrp, part, 0); firetouchinterest(hrp, part, 1) end)\010        end\010    end\010    local function click(cd) if cd and fireclickdetector then pcall(fireclickdetector, cd) end end\010    local function press(pp) if pp and fireproximityprompt then pcall(fireproximityprompt, pp, 1) end end\010    local function shut(p) return p ~= nil and p.Transparency < 0.5 and p.CanCollide ~= false end   -- parede/porta ainda fechada\010    local function rsHas(name) return RS:FindFirstChild(name) ~= nil end\010    -- inimigo vivo no servidor (ou carregado) -> luta. Retorna true se ocupou o turno\010    local function fightNamed(names, canPull, r, label)\010        local e = findEnemy(names)\010        if not e then return false end\010        if r then r.S(\"run\", (label or \"Fighting\") .. \" \" .. e.Name) end\010        fightEnemy(e, { e.Name }, canPull and true or false)\010        return true\010    end\010    F.fightNamed = fightNamed\010    F.near, F.touch, F.click, F.press, F.shut = near, touch, click, press, shut\010\010    -- ---------- viagem entre mares ----------\010    -- Retorna (errado, ocupado). errado = nao esta no mar certo; ocupado = o script esta viajando (o passo devolve \"ocupado\")\010    local function wrongSea(r, want0)\010        local want = want0 or r.sea\010        if not want then return false, false end\010        local seas = type(want) == \"table\" and want or { want }\010        local cur = getSea()\010        for _, s in ipairs(seas) do if s == cur then return false, false end end\010        local target = seas[1]\010        if getPlayerLevel() < SEALV[target] then\010            r.S(\"wait\", string.format(\"Needs level %d for Sea %d\", SEALV[target], target)); return true, false\010        end\010        if not Config.FullTravel then r.S(\"wait\", \"Go to Sea \" .. target .. \" (Auto travel is off)\"); return true, false end\010        if (F.cool.travel or 0) > os.clock() then r.S(\"wait\", \"Sea travel failed repeatedly - paused for a few minutes\"); return true, false end\010        if every(\"travel\", 25) then\010            F.travelN = (F.travelN or 0) + 1\010            if F.travelN > 4 then F.travelN, F.cool.travel = 0, os.clock() + 300; return true, false end\010            invoke(SEACMD[target])\010        end\010        r.S(\"run\", \"Travelling to Sea \" .. target)\010        return true, true\010    end\010    table.insert(Connections, Player.CharacterAdded:Connect(function() F.travelN = 0 end))\010\010    -- ---------- registro de rotinas ----------\010    -- o = { key, cfg, title, sea, level, done = function() end, step = function(r) end, icon }\010    local function define(o)\010        local r = o\010        r.state, r.msg, r.pct, r.t = \"idle\", \"Idle\", nil, os.clock()\010        r.errN = 0\010        function r.S(state, msg, pct)\010            r.state, r.msg, r.pct, r.t = state, msg, pct, os.clock()\010            if state == \"run\" then\010                F.status = r.title .. \": \" .. msg\010                State.Mode, State.Text = \"Auto Fully\", F.status\010                Diag.fully = F.status\010            end\010        end\010        F.list[#F.list + 1] = r\010        F.by[r.key] = r\010        F.R[r.key] = r\010        return r\010    end\010    F.define = define\010    F.wrongSea = wrongSea\010\010    -- ---------- passo principal ----------\010    function F.enabled(r) return Config[r.cfg] and true or false end\010    function F.step()\010        if getChar() == nil then return false end\010        for _, r in ipairs(F.list) do\010            if F.enabled(r) then\010                if (r.cool or 0) > os.clock() then\010                    -- em pausa por erros seguidos: segue para a proxima rotina\010                elseif r.done and r.done() then\010                    r.S(\"done\", r.doneMsg or \"Done\")\010                else\010                    local wrong, busy = wrongSea(r)\010                    if wrong then\010                        if busy then F.cur = r; return true end\010                    elseif r.level and getPlayerLevel() < r.level then\010                        r.S(\"wait\", string.format(\"Needs level %d (you are %d)\", r.level, getPlayerLevel()))\010                    else\010                        local ok, res = pcall(r.step, r)\010                        if not ok then\010                            r.errN += 1\010                            AFL.logErr(\"Fully \" .. r.key, res)\010                            r.S(\"err\", \"Error: \" .. tostring(res):sub(1, 60))\010                            if r.errN >= 3 then r.errN, r.cool = 0, os.clock() + 30; r.S(\"err\", \"Paused 30s after 3 errors\") end\010                        else\010                            r.errN = 0\010                            if res then F.cur = r; return true end\010                            if r.state == \"run\" then r.S(\"wait\", r.msg, r.pct) end\010                        end\010                    end\010                end\010            else\010                if r.state ~= \"off\" then r.state, r.msg, r.pct = \"off\", \"Off\", nil end\010            end\010        end\010        F.cur = nil\010        return false\010    end\010    function F.listed()\010        for _, r in ipairs(F.list) do if Config[r.cfg] then return true end end\010        return false\010    end\010    function F.counts()\010        local on, done, run = 0, 0, 0\010        for _, r in ipairs(F.list) do\010            if Config[r.cfg] then\010                on += 1\010                if r.state == \"done\" then done += 1 elseif r.state == \"run\" then run += 1 end\010            end\010        end\010        return on, done, run\010    end\010\010    -- ---------- baus (God's Chalice / Fist of Darkness) ----------\010    local function chests(r, why)\010        r.S(\"run\", why)\010        local opts = { hop = Config.FullHop and true or false, count = tonumber(Config.FullChestCount) or 20 }\010        local ok, busy = pcall(AFL.chestStep, opts)\010        if not ok then AFL.logErr(\"Fully chests\", busy) return false end\010        return busy and true or false\010    end\010    F.chests = chests\010\010    -- =====================================================================================================\010    -- SABER (Mar 1, level 200)  [bomba: AutoSaber | Quantum: AutoUnlockSaber]\010    -- placas da Jungle -> Torch -> queimar a barreira do Desert -> Cup + Sick Man -> Mob Leader -> Relic -> Saber Expert -> PlaceRelic\010    -- =====================================================================================================\010    do\010        local PLATES = V3(-1612.559, 36.977, 148.720)\010        local TORCH_AT = V3(-1610.008, 11.505, 164.002)\010        local FIRE_AT = V3(1114.615, 5.047, 4350.228)\010        local CUP_AT = V3(1112, 5, 4365)\010        local MOBLEADER_AT = V3(-2967.595, -4.911, 5328.707)\010        local ALTAR_AT = V3(-1404.915, 29.977, 3.806)\010        local EXPERT_AT = V3(-1401.850, 29.977, 8.819)\010        local function pq(...) return inv(\"ProQuestProgress\", ...) end\010        local function pqCached(sub, sec)\010            local c = F.pq or {}\010            F.pq = c\010            if not c[sub] or os.clock() - c[sub].t > sec then c[sub] = { v = pq(sub), t = os.clock() } end\010            return c[sub].v\010        end\010        local r = define({ key = \"saber\", cfg = \"FullSaber\", title = \"Auto Saber\", sea = 1, level = 200, doneMsg = \"You have the Saber\" })\010        r.done = function() return owns(\"Saber\") end\010        local seenExpert = false\010        r.step = function(self)\010            local map = workspace:FindFirstChild(\"Map\")\010            local jungle, desert = map and map:FindFirstChild(\"Jungle\"), map and map:FindFirstChild(\"Desert\")\010            if not (jungle and desert) then\010                self.S(\"run\", \"Flying to the Jungle (map not loaded)\", 0)\010                flyTo(CFrame.new(PLATES)); return true\010            end\010            local final = jungle:FindFirstChild(\"Final\"); final = final and final:FindFirstChild(\"Part\")\010            local qp = jungle:FindFirstChild(\"QuestPlates\")\010            local door = qp and qp:FindFirstChild(\"Door\")\010            local burn = desert:FindFirstChild(\"Burn\")\010            local burnPart = burn and burn:FindFirstChild(\"Part\")\010            -- porta final aberta: Saber Expert\010            if final and not shut(final) then\010                local e = findEnemy({ \"Saber Expert\" })\010                if e then\010                    seenExpert = true\010                    self.S(\"run\", \"Fighting the Saber Expert\", 5 / 6)\010                    fightEnemy(e, { e.Name }, false); return true\010                end\010                if seenExpert and every(\"placerelic\", 2) then pq(\"PlaceRelic\"); seenExpert = false end\010                self.S(\"run\", \"Waiting for the Saber Expert\", 5 / 6)\010                if every(\"placerelic2\", 5) then pq(\"PlaceRelic\") end\010                if not goTo(CFrame.new(EXPERT_AT), 10) then return true end\010                return true\010            end\010            -- 1) placas\010            if shut(door) then\010                self.S(\"run\", \"Pressing the 5 plates in the Jungle\", 0)\010                if not near(PLATES, 100) then flyTo(CFrame.new(PLATES)); return true end\010                if every(\"plates\", 6) then\010                    local list, all = {}, {}\010                    for i = 1, 5 do\010                        local pl = qp and qp:FindFirstChild(\"Plate\" .. i)\010                        local b = pl and pl:FindFirstChild(\"Button\")\010                        if b then\010                            all[#all + 1] = b\010                            if b:FindFirstChild(\"TouchInterest\") then list[#list + 1] = b end\010                        end\010                    end\010                    if #list == 0 then list = all end\010                    for _, b in ipairs(list) do\010                        local _, hrp = getChar()\010                        if not hrp then break end\010                        hrp.CFrame = b.CFrame\010                        touch(b)\010                        task.wait(0.5)\010                    end\010                end\010                return true\010            end\010            -- 2) Torch + barreira do Desert\010            if shut(burnPart) then\010                local tt = tool(\"Torch\")\010                if tt then\010                    equip(\"Torch\")\010                    local fire = burn and burn:FindFirstChild(\"Fire\")\010                    self.S(\"run\", \"Burning the Desert barrier with the Torch\", 1 / 6)\010                    if not near(FIRE_AT, 8) then flyTo(CFrame.new(FIRE_AT)); return true end\010                    local h = tt:FindFirstChild(\"Handle\")\010                    if fire and h and firetouchinterest then pcall(function() firetouchinterest(h, fire, 0); firetouchinterest(h, fire, 1) end) end\010                    return true\010                end\010                local tp = jungle:FindFirstChild(\"Torch\")\010                local tpart = tp and (tp:IsA(\"BasePart\") and tp or tp:FindFirstChildWhichIsA(\"BasePart\", true))\010                self.S(\"run\", \"Picking up the Torch\", 1 / 6)\010                local at = tpart and tpart.CFrame or CFrame.new(TORCH_AT)\010                if not goTo(at, 6) then return true end\010                if tpart then touch(tpart) end\010                return true\010            end\010            -- 3) Cup / Sick Man / Mob Leader / Relic\010            local sick = pqCached(\"SickMan\", 1.5)\010            if sick ~= 0 then\010                if not tool(\"Cup\") then\010                    self.S(\"run\", \"Getting the Cup\", 2 / 6)\010                    if every(\"getcup\", 2) then pq(\"GetCup\") end\010                    local cup = desert:FindFirstChild(\"Cup\")\010                    if cup and not tool(\"Cup\") then\010                        if not goTo(CFrame.new(CUP_AT), 6) then return true end\010                        local cp = cup:IsA(\"BasePart\") and cup or cup:FindFirstChildWhichIsA(\"BasePart\", true)\010                        if cp then touch(cp) end\010                    end\010                    return true\010                end\010                equip(\"Cup\")\010                self.S(\"run\", \"Giving water to the Sick Man\", 2 / 6)\010                if every(\"fillcup\", 3) then\010                    local ch = Player.Character\010                    pq(\"FillCup\", ch and ch:FindFirstChild(\"Cup\"))\010                    task.wait(0.5)\010                    F.pq = nil\010                    pq(\"SickMan\")\010                end\010                return true\010            end\010            local rich = pqCached(\"RichSon\", 1.5)\010            if rich == 0 then\010                self.S(\"run\", \"Killing Mob Leader\", 3 / 6)\010                local e = findEnemy({ \"Mob Leader\" })\010                if e then fightEnemy(e, { e.Name }, false); return true end\010                self.S(\"run\", \"Waiting for the Mob Leader to spawn\", 3 / 6)\010                flyTo(CFrame.new(MOBLEADER_AT)); return true\010            elseif rich == 1 or tool(\"Relic\") then\010                self.S(\"run\", \"Taking the Relic to the altar\", 4 / 6)\010                if not tool(\"Relic\") and every(\"relic\", 2) then pq(\"RichSon\"); F.pq = nil end\010                equip(\"Relic\")\010                flyTo(CFrame.new(ALTAR_AT)); return true\010            end\010            -- primeira conversa com o Sick Man / RichSon ainda sem resposta\010            if every(\"richstart\", 2) then pq(\"RichSon\"); F.pq = nil end\010            self.S(\"run\", \"Talking to the Sick Man\", 2 / 6)\010            return true\010        end\010    end\010\010    -- =====================================================================================================\010    -- RENGOKU (Mar 2)  [Quantum: AutoRengoku]  Hidden Key -> porta do Ice Castle\010    -- =====================================================================================================\010    do\010        local DOOR = V3(6571, 299, -6968)\010        local r = define({ key = \"rengoku\", cfg = \"FullRengoku\", title = \"Auto Rengoku\", sea = 2, doneMsg = \"You have the Rengoku\" })\010        r.done = function() return owns(\"Rengoku\") end\010        local MOBS = { \"Arctic Warrior\", \"Snow Lurker\" }\010        r.step = function(self)\010            if fightNamed({ \"Awakened Ice Admiral\" }, false, self, \"Fighting\") then return true end\010            local key = tool(\"Hidden Key\")\010            if key then\010                equip(\"Hidden Key\")\010                self.S(\"run\", \"Using the Hidden Key at the Ice Castle door\", 0.8)\010                if not near(DOOR, 3) then flyTo(CFrame.new(DOOR)); return true end\010                return true\010            end\010            self.S(\"run\", \"Farming Arctic Warriors / Snow Lurkers for the Hidden Key\", 0.2)\010            local e = findEnemy(MOBS)\010            if e then fightEnemy(e, { e.Name }, true); return true end\010            local sp = findSpawn(MOBS)\010            if sp then flyTo(sp.CFrame * CFrame.new(0, 25, 0)); return true end\010            self.S(\"wait\", \"No Arctic Warrior / Snow Lurker found\")\010            return false\010        end\010    end\010\010    -- =====================================================================================================\010    -- DARKBEARD (Mar 2)  [bomba: AutoDarkbeard | Banana: DarkbeardArena.Summoner]\010    -- baus -> Fist of Darkness -> altar da arena -> mata o Darkbeard\010    -- =====================================================================================================\010    do\010        local ALTAR = V3(3677.082, 62.752, -3144.833)\010        local r = define({ key = \"darkbeard\", cfg = \"FullDarkbeard\", title = \"Auto Darkbeard\", sea = 2 })\010        local function altarCF()\010            local m = workspace:FindFirstChild(\"Map\")\010            local a = m and m:FindFirstChild(\"DarkbeardArena\")\010            local s = a and a:FindFirstChild(\"Summoner\")\010            local d = s and s:FindFirstChild(\"Detection\")\010            if d and d:IsA(\"BasePart\") then return d.CFrame end\010            return CFrame.new(ALTAR)\010        end\010        local fistAt, seenBoss = 0, false\010        r.step = function(self)\010            if fightNamed({ \"Darkbeard\" }, false, self, \"Fighting\") then seenBoss = true; return true end\010            if seenBoss then seenBoss, fistAt = false, 0 end        -- ele morreu: ja pode juntar baus para o proximo\010            if tool(\"Fist of Darkness\") then\010                fistAt = os.clock()\010                equip(\"Fist of Darkness\")\010                self.S(\"run\", \"Placing the Fist of Darkness at the altar\", 0.6)\010                goTo(altarCF(), 6)\010                return true\010            end\010            if os.clock() - fistAt < 12 then\010                self.S(\"run\", \"Waiting for Darkbeard to spawn\", 0.8)\010                goTo(altarCF(), 20)\010                return true\010            end\010            return chests(self, \"Collecting chests for the Fist of Darkness\")\010        end\010    end\010\010    -- =====================================================================================================\010    -- CURSED CAPTAIN (Mar 2, Ghost Ship)  [bomba: AutoCursedCaptain | Conte_do_colado: join API]\010    -- =====================================================================================================\010    do\010        local SHIP = V3(923.213, 125.398, 32852.832)\010        local CAP_AT = V3(921.484, 181.469, 33306.668)\010        local r = define({ key = \"cursed\", cfg = \"FullCursed\", title = \"Auto Cursed Captain\", sea = 2 })\010        local function inside() local _, hrp = getChar(); return hrp and (hrp.Position - SHIP).Magnitude <= 1000 end\010        r.step = function(self)\010            local e = findEnemy({ \"Cursed Captain\" })\010            if e then\010                if not inside() then\010                    self.S(\"run\", \"Entering the Ghost Ship\")\010                    if every(\"shipin\", 4) then invoke(\"requestEntrance\", SHIP) end\010                    return true\010                end\010                self.S(\"run\", \"Fighting the Cursed Captain\")\010                fightEnemy(e, { e.Name }, false); return true\010            end\010            if Config.FullHop and AFL.Race and AFL.Race.joinBoss then\010                self.S(\"run\", \"No Cursed Captain here: looking for a server that has one\")\010                if not inside() and every(\"shipin\", 4) then invoke(\"requestEntrance\", SHIP) end\010                AFL.Race.joinBoss(\"CursedCaptain\")\010                return true\010            end\010            self.S(\"run\", \"Waiting at the Ghost Ship for the Cursed Captain\")\010            if not inside() then\010                if every(\"shipin\", 4) then invoke(\"requestEntrance\", SHIP) end\010                return true\010            end\010            goTo(CFrame.new(CAP_AT), 30)\010            return true\010        end\010    end\010\010    -- =====================================================================================================\010    -- RIP INDRA (Mar 3)  [bomba: AutoRipIndra | Banana: pads de Haki | Quantum: AutoRipIndra]\010    -- God's Chalice (Elite Hunter / baus) -> pads de Haki lendario do Boat Castle -> Chalice no Summoner -> mata o rip_indra True Form\010    -- =====================================================================================================\010    do\010        local CASTLE_AT = V3(-5500, 314, -2855)\010        local ALTAR = V3(-5561, 314, -2663)\010        local PADS = { [\"Hot pink\"] = \"Winter Sky\", [\"Really red\"] = \"Pure Red\", [\"Oyster\"] = \"Snow White\" }\010        local LEG = { \"Winter Sky\", \"Pure Red\", \"Snow White\" }\010        local r = define({ key = \"ripindra\", cfg = \"FullRip\", title = \"Auto Rip Indra\", sea = 3 })\010        local function summoner()\010            local m = workspace:FindFirstChild(\"Map\")\010            local c = m and m:FindFirstChild(\"Boat Castle\")\010            return c and c:FindFirstChild(\"Summoner\")\010        end\010        local function pad()\010            local s = summoner()\010            local circ = s and s:FindFirstChild(\"Circle\")\010            if not circ then return nil, nil end\010            local first\010            for _, ch in ipairs(circ:GetChildren()) do\010                first = first or ch\010                local inner = ch:FindFirstChild(\"Part\")\010                local bc = (inner and inner.BrickColor) or ch.BrickColor\010                if bc and bc.Name ~= \"Lime green\" then return ch, bc.Name end\010            end\010            return nil, first and \"ok\" or nil\010        end\010        local function missingColors()\010            local res = inv(\"getColors\")\010            local miss = {}\010            if type(res) == \"table\" then\010                for _, c in pairs(res) do\010                    if type(c) == \"table\" and table.find(LEG, c.HiddenName) and not c.Unlocked then miss[#miss + 1] = c.HiddenName end\010                end\010            end\010            return miss\010        end\010        local function useColor(name)\010            pcall(function()\010                local net = RS:FindFirstChild(\"Modules\") and RS.Modules:FindFirstChild(\"Net\")\010                local rf = net and net:FindFirstChild(\"RF/FruitCustomizerRF\")\010                if rf then rf:InvokeServer({ StorageName = name, Type = \"AuraSkin\", Context = \"Equip\" }) end\010            end)\010            if name ~= \"Winter Sky\" then invoke(\"activateColor\", name) end\010        end\010        F.padColors = PADS\010        local missText\010        r.step = function(self)\010            local boss = findEnemy({ \"rip_indra True Form\" })\010            if boss then\010                self.S(\"run\", \"Fighting rip_indra True Form\", 1)\010                fightEnemy(boss, { boss.Name }, false); return true\010            end\010            if not (owns(\"God's Chalice\")) then\010                self.S(\"run\", \"Getting a God's Chalice (Elite Hunter / chests)\", 0.1)\010                local ok, busy = pcall(AFL.eliteStep, true)\010                if ok and busy then return true end\010                return chests(self, \"Collecting chests for the God's Chalice\")\010            end\010            local s = summoner()\010            if not s then\010                self.S(\"run\", \"Flying to the Castle on the Sea\", 0.3)\010                flyTo(CFrame.new(CASTLE_AT)); return true\010            end\010            local p, colorName = pad()\010            if p then\010                local want = PADS[colorName]\010                if not want then\010                    self.S(\"wait\", \"Unknown pad colour: \" .. tostring(colorName))\010                else\010                    self.S(\"run\", \"Haki pad (\" .. want .. \")\", 0.4)\010                    local pcf = (p:IsA(\"BasePart\") and p.CFrame) or p:GetPivot()\010                    if not near(pcf.Position, 6) then flyTo(pcf * CFrame.new(0, 3, 0)); return true end\010                    if every(\"padcolor\" .. want, 4) then useColor(want); task.wait(2) end\010                    return true\010                end\010                return false\010            end\010            equip(\"God's Chalice\")\010            local d = s:FindFirstChild(\"Detection\")\010            local cf = (d and d:IsA(\"BasePart\") and d.CFrame) or CFrame.new(ALTAR)\010            goTo(cf, 6)\010            if near(cf.Position, 6) then\010  