        DV.src.esp = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Player, Tabs, getChar, persist = __E.Config, __E.Player, __E.Tabs, __E.getChar, __E.persist\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ---------- ESP ----------\010do\010    local T = Tabs.ESP\010    local CS = game:GetService(\"CollectionService\")\010    local marks = { Player = {}, Fruit = {}, Berry = {}, Island = {} }\010    local COLORS = { Player = Color3.fromRGB(255, 80, 80), Fruit = Color3.fromRGB(255, 210, 60), Berry = Color3.fromRGB(120, 255, 120), Island = Color3.fromRGB(120, 200, 255) }\010    local function myPos()\010        local _, hrp = getChar()\010        return hrp and hrp.Position\010    end\010    -- draws (or updates) the label above `adornee`\010    local function mark(kind, key, adornee, text, model)\010        if not (adornee and adornee.Parent) then return end\010        local m = marks[kind][key]\010        if not (m and m.gui and m.gui.Parent) then\010            local gui = Instance.new(\"BillboardGui\")\010            gui.Name = \"MHEsp\"\010            gui.AlwaysOnTop = true\010            gui.Size = UDim2.fromOffset(180, 28)\010            gui.StudsOffset = Vector3.new(0, 3, 0)\010            gui.Adornee = adornee\010            local lb = Instance.new(\"TextLabel\")\010            lb.Size = UDim2.fromScale(1, 1)\010            lb.BackgroundTransparency = 1\010            lb.Font = Enum.Font.GothamBold\010            lb.TextSize = 14\010            lb.TextColor3 = COLORS[kind]\010            lb.TextStrokeTransparency = 0.3\010            lb.Parent = gui\010            gui.Parent = adornee\010            m = { gui = gui, lb = lb }\010            if model then\010                local ok, h = pcall(function()\010                    local hl = Instance.new(\"Highlight\")\010                    hl.FillColor, hl.OutlineColor, hl.FillTransparency, hl.Adornee = COLORS[kind], COLORS[kind], 0.75, model\010                    hl.Parent = model\010                    return hl\010                end)\010                if ok then m.hl = h end\010            end\010            marks[kind][key] = m\010        end\010        if m.txt ~= text then m.txt = text; m.lb.Text = text end\010    end\010    local function sweep(kind, seen)\010        for key, m in pairs(marks[kind]) do\010            if not (seen and seen[key]) then\010                pcall(function() m.gui:Destroy() end)\010                pcall(function() if m.hl then m.hl:Destroy() end end)\010                marks[kind][key] = nil\010            end\010        end\010    end\010    local function dist(p)\010        local mp = myPos()\010        return mp and math.floor((mp - p).Magnitude) or 0\010    end\010    local function firstPart(inst)\010        if not inst then return end\010        if inst:IsA(\"BasePart\") then return inst end\010        return inst:FindFirstChildWhichIsA(\"BasePart\", true)\010    end\010\010    local scans = {\010        Player = function()\010            local seen = {}\010            for _, pl in ipairs(game:GetService(\"Players\"):GetPlayers()) do\010                local ch = pl.Character\010                local hrp = ch and ch:FindFirstChild(\"HumanoidRootPart\")\010                local hum = ch and ch:FindFirstChildOfClass(\"Humanoid\")\010                if pl ~= Player and hrp then\010                    seen[pl] = true\010                    mark(\"Player\", pl, hrp, string.format(\"%s [%dm] HP %d\", pl.DisplayName ~= \"\" and pl.DisplayName or pl.Name, dist(hrp.Position), hum and math.floor(hum.Health) or 0), ch)\010                end\010            end\010            return seen\010        end,\010        Fruit = function()\010            local seen = {}\010            for _, t in ipairs(workspace:GetChildren()) do\010                if t:IsA(\"Tool\") and string.find(t.Name, \"Fruit\") then\010                    local h = t:FindFirstChild(\"Handle\")\010                    if h then\010                        seen[t] = true\010                        mark(\"Fruit\", t, h, string.format(\"%s [%dm]\", t.Name, dist(h.Position)))\010                    end\010                end\010            end\010            return seen\010        end,\010        Berry = function()\010            local seen = {}\010            for _, b in ipairs(CS:GetTagged(\"BerryBush\")) do\010                local p = firstPart(b.Parent and b.Parent:IsA(\"Model\") and b.Parent or b)\010                if p then\010                    seen[b] = true\010                    mark(\"Berry\", b, p, string.format(\"%s [%dm]\", b.Name, dist(p.Position)))\010                end\010            end\010            return seen\010        end,\010        Island = function()\010            local seen = {}\010            local wo = workspace:FindFirstChild(\"_WorldOrigin\")\010            local loc = wo and wo:FindFirstChild(\"Locations\")\010            for _, isl in ipairs(loc and loc:GetChildren() or {}) do\010                local p = firstPart(isl)\010                if p then\010                    seen[isl] = true\010                    mark(\"Island\", isl, p, string.format(\"%s [%dm]\", isl.Name, dist(p.Position)))\010                end\010            end\010            return seen\010        end,\010    }\010    local cfgKey = { Player = \"EspPlayer\", Fruit = \"EspFruit\", Berry = \"EspBerry\", Island = \"EspIsland\" }\010    task.spawn(function()\010        while Alive do\010            for kind, scan in pairs(scans) do\010                if Config[cfgKey[kind]] then\010                    local ok, seen = pcall(scan)\010                    sweep(kind, ok and seen or nil)\010                else\010                    sweep(kind, nil)\010                end\010            end\010            task.wait(0.4)\010        end\010        for kind in pairs(marks) do sweep(kind, nil) end\010    end)\010\010    local function tg(id, title, desc)\010        T:AddToggle(id, { Title = title, Description = desc, Default = Config[id] and true or false }):OnChanged(function(v) Config[id] = v; persist() end)\010    end\010    T:AddSection(\"ESP Configs\")\010    tg(\"EspPlayer\", \"ESP Player\", \"Name, distance and health of every player (red)\")\010    tg(\"EspFruit\", \"ESP Fruit\", \"Shows the fruits lying on the map (yellow)\")\010    tg(\"EspBerry\", \"ESP Berry\", \"Shows the berry bushes (green)\")\010    tg(\"EspIsland\", \"ESP Island\", \"Shows the islands with the distance (blue)\")\010    T:AddSection(\"ESP Status\")\010    local info = T:AddParagraph({ Title = \"ESP\", Content = \"Checking...\" })\010    task.spawn(function()\010        while Alive do\010            pcall(function()\010                local function n(k) local c = 0; for _ in pairs(marks[k]) do c += 1 end; return c end\010                info:SetDesc(table.concat({\010                    \"Players: \" .. (Config.EspPlayer and n(\"Player\") or \"off\"),\010                    \"Fruits: \" .. (Config.EspFruit and n(\"Fruit\") or \"off\"),\010                    \"Berries: \" .. (Config.EspBerry and n(\"Berry\") or \"off\"),\010                    \"Islands: \" .. (Config.EspIsland and n(\"Island\") or \"off\"),\010                }, \"\\n\"))\010            end)\010            task.wait(1.5)\010        end\010    end)\010end\010\010\010\010";
        end;
        DV.src.pvp = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Connections, Player, Tabs, flyTo, getChar, persist = __E.Config, __E.Connections, __E.Player, __E.Tabs, __E.flyTo, __E.getChar, __E.persist\010local RunService = game:GetService(\"RunService\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ---------- PVP ----------\010do\010    local T = Tabs.PVP\010    local Players = game:GetService(\"Players\")\010    local selected\010    local function names()\010        local l = {}\010        for _, p in ipairs(Players:GetPlayers()) do if p ~= Player then l[#l + 1] = p.Name end end\010        table.sort(l)\010        if #l == 0 then l[1] = \"(no players)\" end\010        return l\010    end\010    T:AddSection(\"Select Player\")\010    local dd = T:AddDropdown(\"PvpPlayer\", { Title = \"Select Player PVP\", Values = names(), Default = 1 })\010    dd:OnChanged(function(v) selected = v end)\010    selected = names()[1]\010    T:AddButton({ Title = \"Refresh Player\", Description = \"Updates the player list\", Callback = function()\010        pcall(function() dd:SetValues(names()) end)\010    end })\010    local function target()\010        local p = selected and Players:FindFirstChild(selected)\010        local ch = p and p.Character\010        return ch and ch:FindFirstChild(\"HumanoidRootPart\")\010    end\010    T:AddSection(\"PVP Configs\")\010    T:AddButton({ Title = \"Teleport To Player\", Description = \"Flies to the selected player once\", Callback = function()\010        local h = target()\010        if h then\010            AFL.tpTravel(function()\010                local t = target()\010                return t and (t.CFrame * CFrame.new(0, 0, 4)).Position or nil\010            end, selected or \"player\")\010        end\010    end })\010    local follow = false\010    T:AddToggle(\"PvpFollow\", { Title = \"Follow Player\", Description = \"Keeps flying to the selected player\", Default = false }):OnChanged(function(v)\010        follow = v\010        if v then\010            task.spawn(function()\010                while Alive and follow do\010                    local h = target()\010                    if h then pcall(flyTo, h.CFrame * CFrame.new(0, 0, 4)) end\010                    task.wait(0.3)\010                end\010            end)\010        end\010    end)\010\010    T:AddSection(\"Movement\")\010    local ws, jp = tonumber(Config.PvpWS) or 16, tonumber(Config.PvpJP) or 50\010    local wsOn, jpOn = false, false\010    -- Input sem \"Finished\": aplica enquanto digita (antes s\195\179 valia depois do Enter). A cada frame + sinal de mudan\195\167a, porque o jogo reescreve o WalkSpeed o tempo todo.\010    T:AddInput(\"PvpWalkSpeed\", { Title = \"Input WalkSpeed\", Default = tostring(ws), Numeric = true, Placeholder = \"16\" }):OnChanged(function(v) ws = tonumber(v) or 16; Config.PvpWS = ws end)\010    T:AddToggle(\"PvpWalkSpeedOn\", { Title = \"Change WalkSpeed\", Default = false }):OnChanged(function(v)\010        wsOn = v\010        if not v then local _, _, hum = getChar(); if hum then pcall(function() hum.WalkSpeed = 16 end) end end\010    end)\010    T:AddInput(\"PvpJumpPower\", { Title = \"Input JumpPower\", Default = tostring(jp), Numeric = true, Placeholder = \"50\" }):OnChanged(function(v) jp = tonumber(v) or 50; Config.PvpJP = jp end)\010    T:AddToggle(\"PvpJumpPowerOn\", { Title = \"Change JumpPower\", Default = false }):OnChanged(function(v)\010        jpOn = v\010        if not v then local _, _, hum = getChar(); if hum then pcall(function() hum.JumpPower = 50 end) end end\010    end)\010    local hooked = setmetatable({}, { __mode = \"k\" })\010    local function applyMove(hum)\010        if wsOn and hum.WalkSpeed ~= ws then hum.WalkSpeed = ws end\010        if jpOn then\010            if not hum.UseJumpPower then hum.UseJumpPower = true end\010            if hum.JumpPower ~= jp then hum.JumpPower = jp end\010        end\010    end\010    table.insert(Connections, RunService.Heartbeat:Connect(function()\010        if not Alive or not (wsOn or jpOn) then return end\010        local c = Player.Character\010        local hum = c and c:FindFirstChildOfClass(\"Humanoid\")\010        if not hum then return end\010        pcall(applyMove, hum)\010        if not hooked[hum] then\010            hooked[hum] = true\010            for _, prop in ipairs({ \"WalkSpeed\", \"JumpPower\", \"UseJumpPower\" }) do\010                pcall(function() hum:GetPropertyChangedSignal(prop):Connect(function() pcall(applyMove, hum) end) end)\010            end\010        end\010    end))\010\010    -- Walk On Water (igual ao Banana): plataforma invis\195\173vel sob os p\195\169s em Y = -5 enquanto voc\195\170 est\195\161 na faixa do mar (Y de -120 a 0)\010    local plat\010    local water = false\010    T:AddToggle(\"WalkWater\", { Title = \"Walk On Water\", Description = \"You walk on top of the sea\", Default = Config.WalkWater and true or false }):OnChanged(function(v)\010        water = v; Config.WalkWater = v; persist()\010        if not v and plat then pcall(function() plat:Destroy() end); plat = nil end\010    end)\010    water = Config.WalkWater and true or false\010    table.insert(Connections, RunService.Heartbeat:Connect(function()\010        if not (Alive and water) then return end\010        local _, hrp, hum = getChar()\010        if not hrp then return end\010        if not (plat and plat.Parent) then\010            plat = Instance.new(\"Part\")\010            plat.Name = \"MHWaterWalk\"\010            plat.Size = Vector3.new(2048, 1, 2048)\010            plat.Transparency = 1\010            plat.Anchored = true\010            plat.CanCollide = false\010            plat.Parent = workspace\010        end\010        local y = hrp.Position.Y\010        local sitting = hum and hum.Sit\010        if sitting or y > 0 or y < -120 then\010            plat.CanCollide = false\010        else\010            plat.CanCollide = true\010            plat.CFrame = CFrame.new(hrp.Position.X, -5, hrp.Position.Z)\010        end\010    end))\010    T:AddSection(\"PVP Status\")\010    local pinfo = T:AddParagraph({ Title = \"PVP\", Content = \"Checking...\" })\010    task.spawn(function()\010        while Alive do\010            pcall(function()\010                local h = target()\010                pinfo:SetDesc(table.concat({\010                    \"Selected: \" .. tostring(selected),\010                    \"Distance: \" .. (h and (math.floor((h.Position - (select(2, getChar())).Position).Magnitude) .. \"m\") or \"player not found\"),\010                    \"Follow: \" .. (follow and \"ON\" or \"off\") .. \" | Walk On Water: \" .. (water and \"ON\" or \"off\"),\010                }, \"\\n\"))\010            end)\010            task.wait(1)\010        end\010    end)\010end\010\010\010\010";
        end;
        DV.src.aimbot = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Connections, Fluent, Player, Tabs, persist = __E.Config, __E.Connections, __E.Fluent, __E.Player, __E.Tabs, __E.persist\010local Players = game:GetService(\"Players\")\010local RunService = game:GetService(\"RunService\")\010local UserInputService = game:GetService(\"UserInputService\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ---------- Aimbot nativo (v30, reescrito do zero) ----------\010-- Silent Aim (Mouse.Hit / Target / UnitRay / X / Y + GetMouseLocation + ScreenPointToRay), Camera Lock suave e independente do FPS,\010-- previs\195\163o de movimento por velocidade medida + ping, escolha de alvo est\195\161vel (sticky), FOV, wall check pregui\195\167oso, team/ForceField/amigos.\010-- O silent s\195\179 altera a mira ENQUANTO voc\195\170 usa uma skill / clica (gate), ent\195\163o bot\195\181es e menus do jogo nunca ficam desalinhados.\010(function()\010    local A = Tabs.Aimbot\010    local AB = {}\010    AFL.Aim = AB\010    local UIS = UserInputService\010    local touchOnly = UIS.TouchEnabled and not UIS.KeyboardEnabled\010    local function d(k, v) if Config[k] == nil then Config[k] = v end end\010    d(\"AimOn\", false); d(\"AimMode\", \"Silent\"); d(\"AimTargets\", \"Players\"); d(\"AimPriority\", \"Closest to Crosshair\"); d(\"AimPart\", \"HumanoidRootPart\")\010    d(\"AimFOV\", 160); d(\"AimShowFOV\", true); d(\"AimFOVColor\", \"Cyan\"); d(\"AimFOVOrigin\", touchOnly and \"Center\" or \"Mouse\")\010    d(\"AimSmooth\", 0.35); d(\"AimPredict\", 0.1); d(\"AimPredictOn\", true); d(\"AimAutoPing\", true); d(\"AimHitChance\", 100); d(\"AimGuarantee\", true)\010    d(\"AimMaxDist\", 1500); d(\"AimVisible\", false); d(\"AimTeam\", true); d(\"AimFF\", true); d(\"AimFriends\", false); d(\"AimSticky\", true)\010    d(\"AimTrigger\", \"Always On\"); d(\"AimKey\", \"Q\"); d(\"AimGate\", \"On Skill / Click\")\010    d(\"AimHighlight\", true); d(\"AimLine\", false); d(\"AimInfo\", true); d(\"AimMinHP\", 0)\010    d(\"AimGateKeys\", { Z = true, X = true, C = true, V = true, F = true }); d(\"AimIgnoreNames\", \"\")\010    d(\"AimLowHPFinisher\", false); d(\"AimLowHPThreshold\", 25); d(\"AimOffsetY\", 0)\010\010    local COLORS = {\010        White = Color3.fromRGB(255, 255, 255), Cyan = Color3.fromRGB(0, 230, 255), Red = Color3.fromRGB(255, 60, 60),\010        Green = Color3.fromRGB(70, 255, 110), Purple = Color3.fromRGB(180, 110, 255), Yellow = Color3.fromRGB(255, 225, 60),\010        Pink = Color3.fromRGB(255, 105, 200), Orange = Color3.fromRGB(255, 150, 40),\010    }\010    -- v104: pedido do usuario - mais configuravel. Antes a tecla que \"abre\" o Silent Aim (gatilho) era fixa em Z/X/C/V/F -\010    -- quem remapeia as skills do Blox Fruits (bem comum) ficava sem o redirect funcionar nas teclas certas. Agora e\010    -- escolhido na UI (multi-select) e reconstruido na hora quando o usuario muda a selecao.\010    local GATE_KEY_NAMES = { \"Z\", \"X\", \"C\", \"V\", \"F\", \"Q\", \"E\", \"R\", \"T\", \"G\", \"B\" }\010    local SKILL_KEYS = {}\010    local function rebuildGateKeys()\010        table.clear(SKILL_KEYS)\010        local set = Config.AimGateKeys\010        if type(set) == \"table\" then\010            for _, n in ipairs(GATE_KEY_NAMES) do\010                if set[n] then\010                    local ok, kc = pcall(function() return Enum.KeyCode[n] end)\010                    if ok then SKILL_KEYS[#SKILL_KEYS + 1] = kc end\010                end\010            end\010        end\010        if #SKILL_KEYS == 0 then SKILL_KEYS[1] = Enum.KeyCode.Z end -- nunca fica sem nenhuma tecla de gatilho\010    end\010    rebuildGateKeys()\010    -- v104: lista de nomes ignorados (comma-separated) - pra quando Team Check/Friends nao cobrem (ex: duo fora do\010    -- sistema de time do jogo). Recalculada so quando o texto muda (nao a cada frame).\010    local ignoreSet, ignoreRaw = {}, nil\010    local function ignoredNames()\010        local raw = Config.AimIgnoreNames or \"\"\010        if raw ~= ignoreRaw then\010            ignoreRaw = raw\010            table.clear(ignoreSet)\010            for name in string.gmatch(raw, \"[^,]+\") do\010                name = string.gsub(string.gsub(name, \"^%s+\", \"\"), \"%s+$\", \"\")\010                if name ~= \"\" then ignoreSet[string.lower(name)] = true end\010            end\010        end\010        return ignoreSet\010    end\010    local R15_PARTS = { \"Head\", \"UpperTorso\", \"HumanoidRootPart\", \"LowerTorso\", \"Torso\" }\010\010    -- ===== estado =====\010    local held, toggled = false, false\010    local cur = nil                         -- registro do alvo atual { char, part, hum, dist, sd, key }\010    local SA = { pos = nil, part = nil, sx = 0, sy = 0, roll = true, rollAt = 0, releaseAt = 0 } -- dados do silent (lidos pelos hooks)\010    local active = false\010    local Track = setmetatable({}, { __mode = \"k\" }) -- parte -> velocidade medida\010    local friendCache = {}\010    local pickAt, randAt, randIdx = 0, 0, 1\010    AB.status = \"idle\"\010\010    -- ===== helpers de UI =====\010    local function idx(list, v) for i, x in ipairs(list) do if x == v then return i end end return 1 end\010    local function dd(id, title, desc, list, key)\010        A:AddDropdown(id, { Title = title, Description = desc, Values = list, Default = idx(list, Config[key]) }):OnChanged(function(v) Config[key] = v; persist() end)\010    end\010    local function tg(id, title, desc, key)\010        A:AddToggle(id, { Title = title, Description = desc, Default = Config[key] and true or false }):OnChanged(function(v) Config[key] = v; persist() end)\010    end\010    local function setOf(v)\010        local o = {}\010        if type(v) == \"table\" then\010            for k, val in pairs(v) do\010                if val == true then o[k] = true elseif type(val) == \"string\" then o[val] = true end\010            end\010        end\010        return o\010    end\010    local function multiDD(id, title, desc, list, key, after)\010        A:AddDropdown(id, { Title = title, Description = desc, Values = list, Multi = true, Default = setOf(Config[key]) }):OnChanged(function(v)\010            Config[key] = setOf(v); persist()\010            if after then after() end\010        end)\010    end\010    local function sl(id, title, desc, key, mn, mx, rnd)\010        A:AddSlider(id, { Title = title, Description = desc, Min = mn, Max = mx, Default = math.clamp(tonumber(Config[key]) or mn, mn, mx), Rounding = rnd or 0 }):OnChanged(function(v) Config[key] = v; persist() end)\010    end\010\010    -- ===== desenhos =====\010    local circle, line, label, hasDrawing\010    pcall(function()\010        if Drawing and Drawing.new then\010            circle = Drawing.new(\"Circle\"); circle.Thickness = 1.5; circle.NumSides = 72; circle.Filled = false; circle.Visible = false\010            line = Drawing.new(\"Line\"); line.Thickness = 1.5; line.Visible = false\010            label = Drawing.new(\"Text\"); label.Size = 14; label.Center = true; label.Outline = true; label.Visible = false\010            hasDrawing = true\010        end\010    end)\010    local fgui, fframe\010    if not hasDrawing then\010        pcall(function()\010            fgui = Instance.new(\"ScreenGui\"); fgui.Name = \"MoonAimFOV\"; fgui.IgnoreGuiInset = true; fgui.ResetOnSpawn = false\010            fgui.Parent = (type(gethui) == \"function\" and gethui()) or game:GetService(\"CoreGui\")\010            fframe = Instance.new(\"Frame\"); fframe.BackgroundTransparency = 1; fframe.AnchorPoint = Vector2.new(0.5, 0.5); fframe.Visible = false; fframe.Parent = fgui\010            Instance.new(\"UICorner\", fframe).CornerRadius = UDim.new(1, 0)\010            Instance.new(\"UIStroke\", fframe).Thickness = 1.5\010        end)\010    end\010    local hl\010    pcall(function()\010        hl = Instance.new(\"Highlight\"); hl.FillTransparency = 0.75; hl.OutlineTransparency = 0; hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop\010        hl.Enabled = false; hl.Parent = workspace\010    end)\010\010    -- ===== velocidade medida do alvo (jogadores do Blox Fruits voam/d\195\163o dash por CFrame, a velocidade da f\195\173sica n\195\163o serve) =====\010    local function velocityOf(part, now)\010        local p = part.Position\010        local tr = Track[part]\010        if not tr or now - tr.t > 0.4 then\010            Track[part] = { p = p, t = now, v = Vector3.zero }\010            return part.AssemblyLinearVelocity\010        end\010        local dt = now - tr.t\010        if dt > 0.0005 then\010            local inst = (p - tr.p) / dt\010            if inst.Magnitude > 450 then inst = tr.v end -- teletransporte / glitch: ignora\010            tr.v = tr.v:Lerp(inst, math.clamp(dt * 16, 0.12, 1))\010            tr.p, tr.t = p, now\010        end\010        local pv = part.AssemblyLinearVelocity\010        return (pv.Magnitude > tr.v.Magnitude) and pv or tr.v\010    end\010    local function leadPos(part, now)\010        local pos = part.Position\010        if not Config.AimPredictOn then return pos end\010        local t = tonumber(Config.AimPredict) or 0\010        if Config.AimAutoPing then\010            local ok, ping = pcall(function() return Player:GetNetworkPing() end)\010            if ok and ping then t += math.clamp(ping, 0, 0.4) end\010        end\010        local off = velocityOf(part, now) * math.clamp(t, 0, 0.7)\010        if off.Magnitude > 70 then off = off.Unit * 70 end\010        return pos + off\010    end\010\010    -- ===== candidatos =====\010    local function isFriend(p)\010        local c = friendCache[p.UserId]\010        if c == nil then\010            friendCache[p.UserId] = false\010            task.spawn(function()\010                local ok, r = pcall(function() return Player:IsFriendsWith(p.UserId) end)\010                friendCache[p.UserId] = ok and r == true\010            end)\010            return false\010        end\010        return c\010    end\010    local function allowedPlayer(p)\010        if p == Player or not p.Character then return false end\010        if Config.AimTeam and p.Team ~= nil and p.Team == Player.Team then return false end\010        if Config.AimFriends and isFriend(p) then return false end\010        if Config.AimFF and p.Character:FindFirstChildOfClass(\"ForceField\") then return false end\010        if ignoredNames()[string.lower(p.Name)] or ignoredNames()[string.lower(p.DisplayName or \"\")] then return false end\010        return true\010    end\010    local list = {}\010    local function gather()\010        table.clear(list)\010        local want = Config.AimTargets\010        if want == \"Players\" or want == \"Both\" then\010            for _, p in ipairs(Players:GetPlayers()) do\010                if allowedPlayer(p) then list[#list + 1] = p.Character end\010            end\010        end\010        if want == \"NPCs\" or want == \"Both\" then\010            local f = workspace:FindFirstChild(\"Enemies\")\010            if f then\010                for _, m in ipairs(f:GetChildren()) do\010                    if not m:GetAttribute(\"IsBoat\") then list[#list + 1] = m end\010                end\010            end\010        end\010    end\010\010    -- ===== escolha da parte do corpo =====\010    local function partOf(char, origin, cam)\010        local w = Config.AimPart\010        if w == \"Closest Part\" then\010            local best, bd\010            for _, n in ipairs(R15_PARTS) do\010                local p = char:FindFirstChild(n)\010                if p then\010                    local v, on = cam:WorldToViewportPoint(p.Position)\010                    if on then\010                        local dist = (Vector2.new(v.X, v.Y) - origin).Magnitude\010                        if not bd or dist < bd then best, bd = p, dist end\010                    end\010                end\010            end\010            return best or char:FindFirstChild(\"HumanoidRootPart\")\010        elseif w == \"Random\" then\010            return char:FindFirstChild(R15_PARTS[randIdx]) or char:FindFirstChild(\"HumanoidRootPart\")\010        elseif w == \"Torso\" then\010            return char:FindFirstChild(\"UpperTorso\") or char:FindFirstChild(\"Torso\") or char:FindFirstChild(\"HumanoidRootPart\")\010        end\010        return char:FindFirstChild(w) or char:FindFirstChild(\"HumanoidRootPart\")\010    end\010\010    local rayParams = RaycastParams.new()\010    rayParams.FilterType = Enum.RaycastFilterType.Exclude\010    rayParams.RespectCanCollide = true\010    local function visible(cam, char, part)\010        local mine = Player.Character\010        rayParams.FilterDescendantsInstances = { mine or cam, char }\010        local o = cam.CFrame.Position\010        return workspace:Raycast(o, part.Position - o, rayParams) == nil\010    end\010\010    -- avalia 1 modelo: devolve registro ou nil (sem raycast; a visibilidade \195\169 testada s\195\179 nos melhores)\010    local function evaluate(cam, char, mult, origin)\010        local hum, hrp = char:FindFirstChildOfClass(\"Humanoid\"), char:FindFirstChild(\"HumanoidRootPart\")\010        if not (hum and hrp) or hum.Health <= 0 then return end\010        if (tonumber(Config.AimMinHP) or 0) > 0 and hum.MaxHealth > 0 and hum.Health / hum.MaxHealth * 100 < Config.AimMinHP then return end\010        local dist = (hrp.Position - cam.CFrame.Position).Magnitude\010        if dist > (Config.AimGuarantee and math.max(tonumber(Config.AimMaxDist) or 1500, 3000) or (tonumber(Config.AimMaxDist) or 1500)) * (mult > 1 and 1.2 or 1) then return end\010        local part = partOf(char, origin, cam) or hrp\010        local v, on = cam:WorldToViewportPoint(part.Position)\010        -- v103: pedido do usuario - \"100% garantido\" tinha um furo: um alvo atras da camera (fora da tela) tinha\010        -- \"on\" false e era descartado ANTES de chegar no bypass do FOV, mesmo com Guaranteed Hit ligado - contra\010        -- alguem batendo pelas costas o aimbot simplesmente nao via o alvo. Guaranteed Hit nao precisa do ponto na\010        -- tela pra nada (o redirect do Silent Aim usa so a posicao 3D) - so segue descartando \"atras de voce\" quando\010        -- Guaranteed Hit esta DESLIGADO (onde a FOV na tela ainda faz sentido pros outros modos manuais).\010        if not on and not Config.AimGuarantee then return end\010        local sd = on and (Vector2.new(v.X, v.Y) - origin).Magnitude or math.huge\010        if not Config.AimGuarantee and sd > (tonumber(Config.AimFOV) or 160) * mult then return end\010        local pr = Config.AimPriority\010        -- v106: \"Lowest/Highest Health\" comparava vida ABSOLUTA - contra alvos com Max HP bem diferentes (ex: um\010        -- boss com 50k de vida e um NPC comum com 500) isso quase sempre escolhia o tipo de alvo errado em vez do\010        -- que realmente esta mais perto de morrer. Agora usa HP% (Health / MaxHealth), que e justo entre alvos\010        -- de qualquer tamanho - pedido do usuario: \"focar em quem ta com menos vida\".\010        local hpPct = hum.MaxHealth > 0 and (hum.Health / hum.MaxHealth * 100) or 100\010        local key\010        if pr == \"Closest Distance\" then key = dist\010        elseif pr == \"Lowest Health\" then key = hpPct\010        elseif pr == \"Highest Health\" then key = -hpPct\010        else key = on and sd or dist end -- fora da tela: \"mais perto da mira\" nao existe, usa distancia\010        return { char = char, part = part, hum = hum, dist = dist, sd = sd, hpPct = hpPct, key = key }\010    end\010\010    -- v106: \"Low HP Finisher\" - pedido do usuario (\"muito mais configuracao\" em cima do foco por vida). Quando\010    -- ligado, isso ANULA a prioridade escolhida acima sempre que existir um alvo valido com HP% <= limite: garante\010    -- que voce sempre termina quem esta quase morrendo em vez de ficar preso num alvo mais distante/mais forte so\010    -- porque a prioridade normal (ex: Closest to Crosshair) mandava assim. So roda a varredura extra quando o\010    -- toggle esta ligado, pra nao pesar nada em quem nao usa.\010    local function findFinisher(recs, cam)\010        local th = tonumber(Config.AimLowHPThreshold) or 25\010        local best, bestHp\010        for _, r in ipairs(recs) do\010            if r.hpPct <= th and (not bestHp or r.hpPct < bestHp) then\010                if Config.AimGuarantee or not Config.AimVisible or visible(cam, r.char, r.part) then best, bestHp = r, r.hpPct end\010            end\010        end\010        return best\010    end\010    local function pick(cam, origin)\010        if Config.AimLowHPFinisher then\010            gather()\010            local recs = {}\010            for _, c in ipairs(list) do\010                local r = evaluate(cam, c, 1, origin)\010                if r then recs[#recs + 1] = r end\010            end\010            local fin = findFinisher(recs, cam)\010            if fin then return fin end\010            if Config.AimSticky and cur and cur.char.Parent then\010                local r = evaluate(cam, cur.char, 1.5, origin)\010                if r and (Config.AimGuarantee or not Config.AimVisible or visible(cam, r.char, r.part)) then return r end\010            end\010            table.sort(recs, function(a, b) return a.key < b.key end)\010            if Config.AimGuarantee or not Config.AimVisible then return recs[1] end\010            for i = 1, math.min(#recs, 6) do\010                if visible(cam, recs[i].char, recs[i].part) then return recs[i] end\010            end\010            return\010        end\010        -- alvo atual continua enquanto ficar na FOV ampliada (evita pular entre alvos)\010        if Config.AimSticky and cur and cur.char.Parent then\010            local r = evaluate(cam, cur.char, 1.5, origin)\010            if r and (Config.AimGuarantee or not Config.AimVisible or visible(cam, r.char, r.part)) then return r end\010        end\010        gather()\010        local recs = {}\010        for _, c in ipairs(list) do\010            local r = evaluate(cam, c, 1, origin)\010            if r then recs[#recs + 1] = r end\010        end\010        table.sort(recs, function(a, b) return a.key < b.key end)\010        if Config.AimGuarantee or not Config.AimVisible then return recs[1] end\010        for i = 1, math.min(#recs, 6) do\010            if visible(cam, recs[i].char, recs[i].part) then return recs[i] end\010        end\010    end\010\010    -- ===== ativa\195\167\195\163o =====\010    local function isKey(i)\010        local k = Config.AimKey\010        if k == \"MouseButton2\" then return i.UserInputType == Enum.UserInputType.MouseButton2 end\010        local ok, kc = pcall(function() return Enum.KeyCode[k] end)\010        return ok and i.KeyCode == kc\010    end\010    table.insert(Connections, UIS.InputBegan:Connect(function(i, gp)\010        if gp and Config.AimKey ~= \"MouseButton2\" then return end\010        if isKey(i) then held = true; toggled = not toggled end\010    end))\010    table.insert(Connections, UIS.InputEnded:Connect(function(i)\010        if isKey(i) then held = false end\010        SA.releaseAt = os.clock()\010    end))\010    local function isActive()\010        if not Config.AimOn then return false end\010        if Config.AimTrigger == \"Hold Key\" then return held or (touchOnly and toggled) end\010        if Config.AimTrigger == \"Toggle Key\" then return toggled end\010        return true\010    end\010\010    -- bot\195\163o flutuante \"AIM\" (celular)\010    local abtn, agui\010    if UIS.TouchEnabled then\010        pcall(function()\010            agui = Instance.new(\"ScreenGui\")\010            agui.Name, agui.ResetOnSpawn, agui.IgnoreGuiInset, agui.DisplayOrder = \"MoonAimBtn\", false, true, 998\010            agui.Parent = (type(gethui) == \"function\" and gethui()) or game:GetService(\"CoreGui\")\010            abtn = Instance.new(\"TextButton\")\010            abtn.Size, abtn.Position, abtn.AnchorPoint = UDim2.fromOffset(58, 58), UDim2.new(1, -90, 0.5, 0), Vector2.new(0, 0.5)\010            abtn.Text, abtn.Font, abtn.TextSize, abtn.TextColor3 = \"AIM\", Enum.Font.GothamBold, 16, Color3.fromRGB(255, 255, 255)\010            abtn.BackgroundColor3, abtn.BackgroundTransparency, abtn.Visible = Color3.fromRGB(20, 30, 40), 0.25, false\010            abtn.Parent = agui\010            Instance.new(\"UICorner\", abtn).CornerRadius = UDim.new(1, 0)\010            local st = Instance.new(\"UIStroke\", abtn); st.Color, st.Thickness = Color3.fromRGB(0, 230, 255), 2\010            abtn.MouseButton1Click:Connect(function() toggled = not toggled end)\010        end)\010    end\010\010    -- ===== Silent Aim (hooks) =====\010    -- gate: s\195\179 mexe na mira enquanto voc\195\170 usa uma skill (Z X C V F), segura o clique, ou at\195\169 0,35s depois de soltar\010    local function gateOpen()\010        if not SA.pos or not SA.roll then return false end\010        if Config.AimGate == \"Always\" or touchOnly then return true end\010        if UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then return true end\010        for _, k in ipairs(SKILL_KEYS) do\010            if UIS:IsKeyDown(k) then return true end\010        end\010        return os.clock() - SA.releaseAt < 0.35\010    end\010    local function effMode()\010        local m = Config.AimMode\010        if (m == \"Silent\" or m == \"Both\") and not hookmetamethod then return \"Camera Lock\" end\010        return m\010    end\010    local hooked = false\010    local function installHooks()\010        if hooked or not hookmetamethod then return end\010        hooked = true\010        local mouse = Player:GetMouse()\010        local wrap = newcclosure or function(f) return f end\010        local isCaller = checkcaller or function() return false end\010        local ok1 = pcall(function()\010            local old\010            old = hookmetamethod(game, \"__index\", wrap(function(self, key)\010                if self == mouse and (key == \"Hit\" or key == \"Target\" or key == \"X\" or key == \"Y\" or key == \"UnitRay\")\010                    and Alive and effMode() ~= \"Camera Lock\" and gateOpen() and not isCaller() and not (AFL.TV and AFL.TV.aimPos) then\010                    if key == \"Hit\" then return CFrame.new(SA.pos)\010                    elseif key == \"Target\" then return SA.part\010                    elseif key == \"X\" then return SA.sx\010                    elseif key == \"Y\" then return SA.sy\010                    else\010                        local cam = workspace.CurrentCamera\010                        local o = cam and cam.CFrame.Position or Vector3.zero\010                        return Ray.new(o, (SA.pos - o).Unit)\010                    end\010                end\010                return old(self, key)\010            end))\010        end)\010        if not ok1 then hooked = false; return end\010        pcall(function()\010            if not getnamecallmethod then return end\010            local oldNc\010            oldNc = hookmetamethod(game, \"__namecall\", wrap(function(self, ...)\010                local m = getnamecallmethod()\010                if (m == \"GetMouseLocation\" or m == \"ScreenPointToRay\" or m == \"ViewportPointToRay\")\010                    and Alive and SA.pos and effMode() ~= \"Camera Lock\" and not isCaller() and gateOpen() then\010                    if m == \"GetMouseLocation\" then\010                        if self == UIS then return Vector2.new(SA.sx, SA.sy) end\010                    elseif self == workspace.CurrentCamera then\010                        local o = self.CFrame.Position\010                        return Ray.new(o, (SA.pos - o).Unit)\010                    end\010                end\010                if (m == \"FireServer\" or m == \"InvokeServer\") and Alive and SA.pos and effMode() ~= \"Camera Lock\"\010                    and typeof(self) == \"Instance\" and not isCaller() and not (AFL.TV and AFL.TV.aimPos) then\010                    local tool = Player.Character and Player.Character:FindFirstChildOfClass(\"Tool\")\010                    if tool and self:IsDescendantOf(tool) and self.Name ~= \"LeftClickRemote\" and gateOpen() then\010                        local args = table.pack(...)\010                        local changed = false\010                        for i = 1, args.n do\010                            local a = args[i]\010                            if typeof(a) == \"Vector3\" and a.Magnitude > 3 and not changed then\010                                args[i] = SA.pos; changed = true\010                            end\010                        end\010                        if changed then\010                            setnamecallmethod(m)\010                            return oldNc(self, table.unpack(args, 1, args.n))\010                        end\010                    end\010                end\010                -- as chamadas aninhadas acima mudam o \"m\195\169todo atual\": restaura antes de chamar o original\010                if setnamecallmethod then setnamecallmethod(m) end\010                return oldNc(self, ...)\010            end))\010        end)\010    end\010\010    -- ===== loop principal =====\010    local hiddenAll, offDone = false, false -- v43: esconder s\195\179 escreve nas propriedades uma vez (e de novo depois de mostrar)\010    local function hideAll()\010        cur = nil\010        SA.pos, SA.part = nil, nil\010        if hiddenAll then return end\010        hiddenAll = true\010        if hl then hl.Enabled = false end\010        if line then line.Visible = false end\010        if label then label.Visible = false end\010    end\010    pcall(function() RunService:UnbindFromRenderStep(\"MoonHubAimbot\") end)\010    RunService:BindToRenderStep(\"MoonHubAimbot\", Enum.RenderPriority.Camera.Value + 1, function(dt)\010        if not Alive then\010            pcall(function() RunService:UnbindFromRenderStep(\"MoonHubAimbot\") end)\010            SA.pos, SA.part = nil, nil\010            pcall(function() if circle then circle:Remove() end end)\010            pcall(function() if line then line:Remove() end end)\010            pcall(function() if label then label:Remove() end end)\010            pcall(function() if hl then hl:Destroy() end end)\010            pcall(function() if fgui then fgui:Destroy() end end)\010            pcall(function() if agui then agui:Destroy() end end)\010            return\010        end\010        if not Config.AimOn then\010            -- v43: Aimbot desligado: uma passada para esconder tudo e depois nenhum custo por frame\010            if offDone then return end\010            offDone, active = true, false\010            if abtn then abtn.Visible = false end\010            if circle then circle.Visible = false elseif fframe then fframe.Visible = false end\010            hideAll()\010            AB.status = \"off\"\010            return\010        end\010        offDone = false\010        local cam = workspace.CurrentCamera\010        if not cam then return end\010        if abtn then\010            abtn.Visible = Config.AimOn and Config.AimTrigger ~= \"Always On\"\010            abtn.BackgroundColor3 = toggled and Color3.fromRGB(0, 120, 150) or Color3.fromRGB(20, 30, 40)\010        end\010        local color = COLORS[Config.AimFOVColor] or COLORS.Cyan\010        local origin = (Config.AimFOVOrigin == \"Center\" or touchOnly) and (cam.ViewportSize / 2) or UIS:GetMouseLocation()\010        local fov = tonumber(Config.AimFOV) or 160\010        local showFov = Config.AimOn and Config.AimShowFOV\010        if circle then\010            circle.Visible = showFov and true or false\010            if showFov then circle.Position = origin; circle.Radius = fov; circle.Color = color end\010        elseif fframe then\010            fframe.Visible = showFov and true or false\010            if showFov then\010                fframe.Size = UDim2.fromOffset(fov * 2, fov * 2)\010                fframe.Position = UDim2.fromOffset(origin.X, origin.Y)\010                local st = fframe:FindFirstChildOfClass(\"UIStroke\"); if st then st.Color = color end\010            end\010        end\010\010        active = isActive()\010        if not active then\010            hideAll()\010            AB.status = Config.AimOn and \"waiting for the key\" or \"off\"\010            return\010        end\010\010        local now = os.clock()\010        if now - randAt > 0.5 then randAt = now; randIdx = math.random(1, #R15_PARTS) end\010        if now - SA.rollAt > 0.3 then\010            SA.rollAt = now\010            SA.roll = Config.AimGuarantee or math.random(1, 100) <= (tonumber(Config.AimHitChance) or 100)\010        end\010        -- procura alvo a ~33 Hz (o movimento da mira roda todo frame)\010        if now - pickAt >= 0.03 or not cur then\010            pickAt = now\010            cur = pick(cam, origin)\010        end\010        -- v86: tentativa de deixar a mira mais resistente ao \"solta o alvo depois de um golpe\" - quando o personagem\010        -- do alvo continua valido mas a PARTE que a mira usava (ex: HumanoidRootPart) sumiu por um instante (comum\010        -- durante o \"flinch\"/ragdoll/animacao de dano de um hit), em vez de descartar o alvo inteiro ele tenta achar\010        -- de novo a parte/Humanoid no MESMO personagem antes de desistir. Nao achei com certeza absoluta a causa\010        -- exata sem testar ao vivo, mas isso cobre o padrao mais comum desse tipo de bug em jogos Roblox.\010        if cur and cur.char and cur.char.Parent and not (cur.part and cur.part.Parent) then\010            local hum2 = cur.char:FindFirstChildOfClass(\"Humanoid\")\010            local hrp2 = (cur.part and cur.char:FindFirstChild(cur.part.Name)) or cur.char:FindFirstChild(\"HumanoidRootPart\")\010            if hum2 and hrp2 and hum2.Health > 0 then cur.hum, cur.part = hum2, hrp2 else cur = nil end\010        end\010        if not (cur and cur.part and cur.part.Parent and cur.hum.Health > 0) then\010            hideAll()\010            AB.status = \"no target in FOV\"\010            AB.cur = nil\010            return\010        end\010        hiddenAll = false\010        -- atualiza dist\195\162ncia / parte (ela se mexe entre as buscas)\010        cur.dist = (cur.part.Position - cam.CFrame.Position).Magnitude\010        AB.cur = cur\010        local pos = leadPos(cur.part, now)\010        local offY = tonumber(Config.AimOffsetY) or 0\010        if offY ~= 0 then pos = pos + Vector3.new(0, offY, 0) end\010        local sv, son = cam:WorldToViewportPoint(pos)\010        SA.pos, SA.part, SA.sx, SA.sy = pos, cur.part, sv.X, sv.Y\010\010        local mode = effMode()\010        if mode == \"Silent\" or mode == \"Both\" then installHooks() end\010        if mode == \"Camera Lock\" or mode == \"Both\" then\010            local goal = CFrame.lookAt(cam.CFrame.Position, pos)\010            local s = Config.AimGuarantee and 1 or math.clamp(tonumber(Config.AimSmooth) or 0.35, 0.02, 1)\010            local a = (s >= 1) and 1 or (1 - (1 - s) ^ (math.min(dt, 0.1) * 60))\010            cam.CFrame = cam.CFrame:Lerp(goal, a)\010        end\010        if hl then\010            hl.Enabled = Config.AimHighlight and true or false\010            if hl.Adornee ~= cur.char then hl.Adornee = cur.char end\010            hl.FillColor, hl.OutlineColor = color, color\010        end\010        if line then\010            line.Visible = Config.AimLine and son and true or false\010            if Config.AimLine then line.From, line.To, line.Color = origin, Vector2.new(sv.X, sv.Y), color end\010        end\010        local who = Players:GetPlayerFromCharacter(cur.char)\010        local nm = who and who.Name or cur.char.Name\010        local hp = cur.hum.MaxHealth > 0 and math.floor(cur.hum.Health / cur.hum.MaxHealth * 100) or 0\010        if label then\010      