        DV.src.extras = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Connections, Fight, Fluent, Player, StartTime, State = __E.Config, __E.Connections, __E.Fight, __E.Fluent, __E.Player, __E.StartTime, __E.State\010local Tabs, flyTo, getChar, getPlayerLevel, getSea, persist = __E.Tabs, __E.flyTo, __E.getChar, __E.getPlayerLevel, __E.getSea, __E.persist\010local Players = game:GetService(\"Players\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ---------- Extras (v32): Safe Mode, Time Hop, re-run after a hop, personal Discord webhook ----------\010(function()\010    local HttpSvc = game:GetService(\"HttpService\")\010    local function d(k, v) if Config[k] == nil then Config[k] = v end end\010    d(\"SafeMode\", false); d(\"SafeLow\", 30); d(\"SafeHigh\", 80)\010    d(\"TimeHop\", false); d(\"TimeHopMin\", 20); d(\"HopReexec\", true)\010    d(\"UwUrl\", \"\"); d(\"UwDeath\", true); d(\"UwHop\", true); d(\"UwEvents\", true); d(\"UwErrors\", false); d(\"UwEvery\", 0); d(\"UwPing\", \"\")\010    d(\"MobileUI\", false)\010\010    -- text boxes: the value is applied right away (pasting works) and the file is saved 1.2s after the last key\010    local persistSeq = 0\010    local function persistSoon()\010        persistSeq += 1\010        local mine = persistSeq\010        task.delay(1.2, function() if Alive and persistSeq == mine then persist() end end)\010    end\010    local function fmt(n)\010        n = tonumber(n)\010        if not n then return \"-\" end\010        local s = tostring(math.floor(n))\010        return (s:reverse():gsub(\"(%d%d%d)\", \"%1,\"):reverse():gsub(\"^,\", \"\"))\010    end\010    local function dataVal(name)\010        local ok, v = pcall(function() return Player.Data[name].Value end)\010        return ok and v or nil\010    end\010\010    -- ===== Safe Mode: low HP = fly straight up out of reach, rest, then go back to farming =====\010    local S = { on = false, since = 0, upY = 0 }\010    AFL.Safe = S\010    local function controlling()\010        if Config.Mode ~= nil or Config.KillTyrant then return true end\010        for k, f in pairs(AFL.feat) do\010            if k ~= \"Safe\" and not f.hidden and AFL.featOn(k, f) then return true end\010        end\010        return false\010    end\010    function S.step()\010        local _, hrp, hum = getChar()\010        if not (Config.SafeMode and hum and hrp) then S.on = false return false end\010        local pct = hum.Health / math.max(1, hum.MaxHealth) * 100\010        local low = math.clamp(tonumber(Config.SafeLow) or 30, 5, 90)\010        local high = math.clamp(tonumber(Config.SafeHigh) or 80, low + 5, 100)\010        if not S.on then\010            -- only when the script is the one controlling the character (never yanks you around while you play by hand), and not on a boat\010            if pct >= low or hum.SeatPart or not controlling() then return false end\010            S.on, S.since, S.upY = true, os.clock(), hrp.Position.Y + 500\010            pcall(function() Fluent:Notify({ Title = \"Safe Mode\", Content = string.format(\"HP at %d%%: flying up to recover\", math.floor(pct)), Duration = 4 }) end)\010        elseif pct >= high or os.clock() - S.since > 180 or not controlling() then\010            S.on = false\010            return false\010        end\010        State.Mode, State.Text = \"Safe Mode\", string.format(\"recovering HP: %d%% (back at %d%%)\", math.floor(pct), math.floor(high))\010        State.atkAt = os.clock() -- the supervisor must not think the farm is stuck while we rest\010        Fight.active, Fight.inPos = false, false\010        Config.AttackUntil = 0\010        flyTo(CFrame.new(hrp.Position.X, math.max(S.upY, hrp.Position.Y), hrp.Position.Z))\010        return true\010    end\010    AFL.feat.Safe = { label = \"Safe Mode\", hidden = true, listed = function() return false end, on = function() return Config.SafeMode == true end,\010        run = function() return S.step() end }\010\010\010    -- ===== Time Hop: change server every N minutes =====\010    task.spawn(function()\010        while Alive do\010            task.wait(5)\010            pcall(function()\010                if not Config.TimeHop then return end\010                local H = AFL.Hop\010                local mins = math.clamp(tonumber(Config.TimeHopMin) or 20, 3, 120)\010                if H.active or os.clock() - H.serverAt < mins * 60 or os.clock() - H.failAt < 30 then return end\010                -- never in the middle of a boss fight, a raid or a dungeon\010                if os.clock() - (State.bossAt or 0) < 15 then return end\010                if AFL.Raid and AFL.Raid.active and AFL.Raid.active() then return end\010                if AFL.Dun and AFL.Dun.active then return end\010                AFL.hopRequest(string.format(\"timer (%d min)\", mins), function() return not Config.TimeHop end)\010            end)\010        end\010    end)\010\010    -- ===== personal Discord webhook (each player uses THEIR OWN url) =====\010    local UW = {}\010    AFL.UW = UW\010    UW.last = \"-\"\010    local requestFn = (syn and syn.request) or http_request or (http and http.request) or request or httprequest\010    local queue, pumping, lastSend = {}, false, 0\010    local HOSTS = { \"discord.com\", \"discordapp.com\", \"canary.discord.com\", \"ptb.discord.com\" }\010    function UW.valid()\010        local u = Config.UwUrl\010        if type(u) ~= \"string\" or #u < 45 then return false end\010        for _, h in ipairs(HOSTS) do\010            if string.sub(u, 1, #h + 22) == \"https://\" .. h .. \"/api/web\" .. \"hooks/\" then return true end\010        end\010        return false\010    end\010    local function pingInfo()\010        local p = string.gsub(tostring(Config.UwPing or \"\"), \"%s\", \"\")\010        local pl = string.lower(p)\010        if pl == \"everyone\" or pl == \"@everyone\" then return \"@everyone\", { parse = { \"everyone\" } } end\010        if pl == \"here\" or pl == \"@here\" then return \"@here\", { parse = { \"everyone\" } } end\010        local id = string.match(p, \"^<@!?(%d+)>$\") or string.match(p, \"^(%d+)$\")\010        if id and #id >= 15 then return \"<@\" .. id .. \">\", { users = { id } } end\010        return nil\010    end\010    local function post(payload)\010        if not requestFn then return nil, \"your executor has no request/http_request\" end\010        local ok, res = pcall(requestFn, {\010            Url = Config.UwUrl, Method = \"POST\",\010            Headers = { [\"Content-Type\"] = \"application/json\" },\010            Body = HttpSvc:JSONEncode(payload),\010        })\010        if not ok then return nil, tostring(res) end\010        local code = type(res) == \"table\" and (res.StatusCode or res.status_code) or nil\010        return tonumber(code), res\010    end\010    function UW.pump()\010        while Alive and #queue > 0 do\010            local gap = 2.2 - (os.clock() - lastSend)\010            if gap > 0 then task.wait(gap) end\010            local p = table.remove(queue, 1)\010            lastSend = os.clock()\010            local code, res = post(p)\010            if code == 429 then\010                local ra = 3\010                pcall(function() ra = tonumber(HttpSvc:JSONDecode(res.Body).retry_after) or 3 end)\010                table.insert(queue, 1, p)\010                UW.last = \"rate limited by Discord, waiting \" .. math.ceil(ra) .. \"s\"\010                task.wait(math.clamp(ra, 1, 30))\010            elseif code == 401 or code == 404 then\010                queue = {}\010                UW.last = \"error \" .. code .. \" (invalid or deleted webhook)\"\010            elseif code and code < 300 then\010                UW.last = \"ok \" .. os.date(\"%H:%M:%S\")\010            else\010                UW.last = \"error \" .. tostring(code or res)\010            end\010        end\010        pumping = false\010    end\010    -- v92: avatar da conta (so busca 1x - nao muda durante a sessao), pra entrar como thumbnail/autor do embed e o\010    -- webhook parar de parecer uma mensagem de texto crua e ficar com cara de \"card\" de verdade, igual o resto do hub\010    local AVATAR_URL\010    pcall(function() AVATAR_URL = Players:GetUserThumbnailAsync(Player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size180x180) end)\010    function UW.send(title, desc, color, fields, ping, noAvatar)\010        if not UW.valid() then return false end\010        if #queue >= 12 then table.remove(queue, 1) end\010        local embed = {\010            title = title, description = desc, color = color or 0x7A5CFF, fields = fields,\010            author = { name = Player.Name .. \" | Moon Decompiled Hub Premium\", icon_url = (not noAvatar) and AVATAR_URL or nil },\010            thumbnail = (not noAvatar) and AVATAR_URL and { url = AVATAR_URL } or nil,\010            footer = { text = \"Moon Decompiled Hub Premium  \226\128\162  Blox Fruits\" },\010            timestamp = os.date(\"!%Y-%m-%dT%H:%M:%SZ\"),\010        }\010        local payload = { username = \"Moon Decompiled Hub\", embeds = { embed } }\010        if ping then\010            local txt, allowed = pingInfo()\010            if txt then payload.content, payload.allowed_mentions = txt, allowed end\010        end\010        queue[#queue + 1] = payload\010        if not pumping then pumping = true; task.spawn(UW.pump) end\010        return true\010    end\010    local function hms(s) s = math.max(0, math.floor(s)); return string.format(\"%dh%02dm\", math.floor(s / 3600), math.floor((s % 3600) / 60)) end\010    local function stateFields()\010        local f = {\010            { name = \"\240\159\143\183\239\184\143 Level\", value = fmt(getPlayerLevel()), inline = true },\010            { name = \"\240\159\146\176 Beli\", value = fmt(dataVal(\"Beli\")), inline = true },\010            { name = \"\240\159\167\169 Fragments\", value = fmt(dataVal(\"Fragments\")), inline = true },\010      