0        if p then\010            Diag.awk = \"Auto Awaken (Sky Warlord): at the arena the server sent; black clouds not found by name - destroy them by hand\"\010            near(p, 60, 25)\010            return true\010        end\010        Diag.awk = \"Auto Awaken (Sky Warlord): waiting for the server event with the arena position\"\010        return false\010    end\010    -- Thunder God: vai ao Golden Bell e aperta os prompts perto. A parte do ritmo e manual.\010    local function thunderRun(h)\010        local bell = mapChild(\"Map\", \"SkyArea2\", \"Golden Bell\")\010        local pos = posOf(bell)\010        if not pos then\010            local cf = AFL.Awk.spot and AFL.Awk.spot(h)\010            pos = cf and cf.Position\010        end\010        if not pos then Diag.awk = \"Auto Awaken (Thunder God): bell not found\"; return false end\010        if not near(pos, 25, 8) then Diag.awk = \"Auto Awaken (Thunder God): flying to the Golden Bell\"; return true end\010        if fireproximityprompt and every(\"bell\", 3) then\010            for _, pr in ipairs(scanPrompts(pos, { \"\" })) do pcall(fireproximityprompt, pr[1], 1) end\010        end\010        Diag.awk = \"Auto Awaken (Thunder God): at the Golden Bell, prompts pressed - the rhythm sequence is MANUAL (hit the shown attack type 6 times)\"\010        return true\010    end\010    -- Vice Admiral: canhoes MarineBusterCannon (Seat). Palpite: sentar e clicar. Sem mira automatica.\010    local function viceRun()\010        if every(\"cannonscan\", 8) or not S.cannons then\010            S.cannons = {}\010            local m = workspace:FindFirstChild(\"Map\")\010            for _, d in ipairs(m and m:GetDescendants() or {}) do\010                if d.Name == \"BonusMoment_Locations\" then\010                    for _, c in ipairs(d:GetChildren()) do\010                        local seat = c.Name == \"MarineBusterCannon\" and c:FindFirstChild(\"Seat\")\010                        if seat and seat:IsA(\"BasePart\") then S.cannons[#S.cannons + 1] = seat end\010                    end\010                end\010            end\010        end\010        local _, hrp = getChar()\010        local best\010        for _, st in ipairs(S.cannons) do\010            if st.Parent and hrp and (not best or (st.Position - hrp.Position).Magnitude < (best.Position - hrp.Position).Magnitude) then best = st end\010        end\010        if not best then Diag.awk = \"Auto Awaken (Vice Admiral): cannons not loaded - go to the Marine Fortress docks\"; near(V(-4630, 74, 4037), 40, 10); return true end\010        if not near(best.Position, 10, 4) then Diag.awk = \"Auto Awaken (Vice Admiral): flying to the cannon\"; return true end\010        local hum = Player.Character and Player.Character:FindFirstChildOfClass(\"Humanoid\")\010        if hum and hum.SeatPart ~= best and every(\"sit\", 3) then pcall(function() best:Sit(hum) end) end\010        if hum and hum.SeatPart == best and mouse1click and every(\"fire\", 1.3) then pcall(mouse1click) end\010        Diag.awk = \"Auto Awaken (Vice Admiral): on the cannon, clicking (GUESS - aim at the 3 marked parts by hand if nothing happens)\"\010        return true\010    end\010    S.routines = {\010        { key = \"chef\", run = chefRun }, { key = \"fishman\", run = fishRun }, { key = \"warden\", run = wardenRun },\010        { key = \"yeti\", run = yetiRun }, { key = \"magma\", run = magmaRun }, { key = \"gorilla\", run = gorillaRun },\010        { key = \"cyborg\", run = cyborgRun }, { key = \"sky warlord\", run = warlordRun }, { key = \"thunder\", alt = \"lightning\", run = thunderRun }, { key = \"vice\", alt = \"admiral\", run = viceRun },\010    }\010    function S.trigger(onlySel)\010        if AFL.Awk.find() or AFL.Awk.findFar() then return false end   -- v53: boss ja acordado (perto ou longe): agora e so matar\010        local okS, sea = pcall(__E.getSea)\010        if okS and sea and sea ~= 1 then return false end\010        local h = AFL.Awk.hint()\010        if not (h and h.Boss) then return false end\010        local st = tostring(h.State)\010        if not (st ~= \"Dormant\" or (tonumber(h.Seconds) or 9999) <= 150) then return false end\010        local boss, now = string.lower(tostring(h.Boss)), os.clock()\010        if onlySel and not S.bossSelected(boss) then return false end\010        for _, r in ipairs(S.routines) do\010            if string.find(boss, r.key, 1, true) or (r.alt and string.find(boss, r.alt, 1, true)) then\010                if (S.cool[r.key] or 0) > now then return false end\010                S.began[r.key] = S.began[r.key] or now\010                if now - S.began[r.key] > 420 then S.cool[r.key], S.began[r.key] = now + 300, nil; return false end\010                State.Mode, State.Text = \"Auto Awk Boss\", \"Awakening \" .. tostring(h.Boss)\010                local ok, res = pcall(r.run, h)\010                if not ok then Diag.awk = \"Auto Awaken error: \" .. tostring(res); return false end\010                return res and true or false\010            end\010        end\010        Diag.awk = \"Auto Awaken: no automatic trigger for \" .. tostring(h.Boss) .. \" yet - do it by hand (see the guide), the script kills it afterwards\"\010        return false\010    end\010    local origAwk = AFL.Awk.step\010    AFL.Awk.step = function()\010        if Config.AwkOn and Config.AwkTrigger then\010            local ok, r = pcall(S.trigger)\010            if ok and r then return true end\010        end\010        return origAwk()\010    end\010\010    -- ---------- Auto Secret Steps (SecretAuto): mata os inimigos da missao, aperta prompts no mapa todo, chama os verbos seguros ----------\010    S.fightNames = {\010        [\"Sea1/Jungle/The Thieving Monkey\"] = { \"thieving monkey\" },\010        [\"Sea1/Pirate Village/Tavern Brawl\"] = { \"tavern pirate\" },\010        [\"Sea1/Fountain/Sewer Gangs\"] = { \"megalo brute\" },\010        [\"Sea1/Sky/Unexpected Guest\"] = { \"fallen angel\" },\010        [\"Sea1/Prison/Don Megalo\"] = { \"megalo\", \"bouncer\" },\010        [\"Sea1/Magma Village/Evil Slimes\"] = { \"magma elemental\" },\010        [\"Sea1/Underwater City/Beyond the Bubble\"] = { \"wraith\" },\010    }\010    -- verbos que o servidor valida sozinho (estado/posicao): chamar fora de hora so devolve false\010    S.pokes = {\010        [\"Sea1/Jungle/The Thieving Monkey\"] = { \"ClaimHat\" },\010        [\"Sea1/Marine Fortress/Fortress Flagpole\"] = { \"TakeRope\" },\010        [\"Sea1/Sky/Unexpected Guest\"] = { \"BreakDoor\", \"ReadLetter\" },\010        [\"Sea1/Sky/The Clown's Jewels\"] = { \"Collect\" },\010        [\"Sea1/Underwater City/Beyond the Bubble\"] = { \"OpenChest\" },\010        [\"Sea1/Fountain/Sewer Gangs\"] = { \"ClaimTreasure\" },\010        [\"Sea1/Colosseum/King's Apprentice\"] = { \"StartMatch\" },\010    }\010    local function enemyByNames(names, center, r)\010        for _, e in ipairs(enemiesList()) do\010            local n = string.lower(e.Name)\010            for _, w in ipairs(names) do\010                if string.find(n, w, 1, true) then\010                    local eh, er = aliveParts(e)\010                    if eh and (not center or (er.Position - center).Magnitude <= r) then return e end\010                    break\010                end\010            end\010        end\010    end\010    local function findPrompts(words)\010        local key = table.concat(words, \"|\")\010        S.pcache = S.pcache or {}\010        local c = S.pcache[key]\010        if not c or os.clock() - c.at > 3 then\010            c = { at = os.clock(), list = {} }\010            S.pcache[key] = c\010            local map = workspace:FindFirstChild(\"Map\") or workspace\010            for _, o in ipairs(map:GetDescendants()) do\010                if o:IsA(\"ProximityPrompt\") then\010                    local txt = string.lower((o.ActionText or \"\") .. \" \" .. (o.ObjectText or \"\"))\010                    for _, w in ipairs(words) do\010                        if string.find(txt, w, 1, true) then c.list[#c.list + 1] = o; break end\010                    end\010                end\010            end\010        end\010        return c.list\010    end\010    function S.autoStep(d)\010        local now = os.clock()\010        local _, hrp = getChar()\010        if not hrp then return false end\010        -- 1) inimigos da missao\010        local names = S.fightNames[d[3]]\010        local e = names and enemyByNames(names, d[5], 900)\010        if e then\010            State.Mode, State.Text = \"Auto Secret Quest\", d[2] .. \": fighting \" .. e.Name\010            Diag.secret = \"auto: fighting \" .. e.Name\010            fightEnemy(e, { e.Name }, false)\010            return true\010        end\010        -- 2) prompts do mapa todo (inclusive os criados pelo modulo no cliente, ex: Don Megalo)\010        if #d[7] > 0 and fireproximityprompt then\010            local best, bd\010            for _, o in ipairs(findPrompts(d[7])) do\010                if o.Parent and o.Enabled then\010                    local par = o.Parent\010                    local pos = par:IsA(\"BasePart\") and par.Position or (par:IsA(\"Attachment\") and par.WorldPosition)\010                    -- v53: so prompts da ilha deste secret (antes podia voar ate um \"pick up\" de outra ilha)\010                    if pos and (pos - d[5]).Magnitude <= 1500 then\010                        local dist = (pos - hrp.Position).Magnitude\010                        if not bd or dist < bd then best, bd = o, dist end\010                    end\010                end\010            end\010            if best then\010                local par = best.Parent\010                local pos = par:IsA(\"BasePart\") and par.Position or par.WorldPosition\010                Diag.secret = \"auto: prompt '\" .. tostring(best.ActionText) .. \" \" .. tostring(best.ObjectText) .. \"'\"\010                if not near(pos, math.max(6, math.min(best.MaxActivationDistance - 3, 10)), 3) then return true end\010                if best.HoldDuration > 0.5 then\010                    if now - (S.holdAt or 0) > best.HoldDuration + 1.5 then\010                        S.holdAt = now\010                        task.spawn(function()\010                            pcall(function() best:InputHoldBegin() end)\010                            task.wait(best.HoldDuration + 0.4)\010                            pcall(function() best:InputHoldEnd() end)\010                        end)\010                    end\010                elseif every(\"autoprompt\", 1) then\010                    pcall(fireproximityprompt, best, 1)\010                end\010                return true\010            end\010        end\010        -- 3) verbos seguros\010        local pk = S.pokes[d[3]]\010        if pk and every(\"poke\" .. d[3], 10) then\010            local rf, re = rem(\"BonusMomentsRemoteFunction\"), rem(\"BonusMomentsRemoteEvent\")\010            local mod = string.match(d[3], \"([^/]+)$\")\010            for _, v in ipairs(pk) do\010                if rf then pcall(rf.InvokeServer, rf, mod, v) end\010                if re then pcall(re.FireServer, re, mod, v) end\010            end\010        end\010        return false\010    end\010\010    -- ---------- UI ----------\010    local sel = { label = nil }\010    local token = nil\010    local function travel(pos, label)\010        local mine = {}\010        token = mine\010        Fluent:Notify({ Title = \"Moon Decompiled Hub - Secrets\", Content = \"Flying to \" .. tostring(label), Duration = 3 })\010        task.spawn(function()\010            local t0, lastClip = os.clock(), 0\010            while Alive and token == mine and os.clock() - t0 < 150 do\010                local char, hrp = getChar()\010                if not hrp then break end\010                if os.clock() - lastClip > 0.25 then\010                    lastClip = os.clock()\010                    for _, p in ipairs(char:GetDescendants()) do\010                        if p:IsA(\"BasePart\") then p.CanCollide = false end\010                    end\010                end\010                if (hrp.Position - pos).Magnitude < 6 then break end\010                flyTo(CFrame.new(pos))\010                task.wait(0.2)\010            end\010            if token == mine then token = nil end\010            if currentTween then currentTween:Cancel() end\010        end)\010    end\010\010    T:AddSection(\"Progress\")\010    local info = T:AddParagraph({ Title = \"Secrets done (from the server)\", Content = \"Loading...\" })\010    task.spawn(function()\010        while Alive do\010            local txt = \"?\"\010            pcall(function() txt = S.summary() end)\010            pcall(function() info:SetDesc(txt) end)\010            task.wait(5)\010        end\010    end)\010    T:AddButton({ Title = \"Refresh Progress\", Description = \"Asks the server which secrets you already finished\", Callback = function() S.refresh(true) end })\010\010    T:AddParagraph({ Title = \"Awakened bosses\", Content = \"The Auto Awk Boss / Auto Awaken options are in the Bosses tab. This tab is for the Sea 1 secret missions.\" })\010    T:AddSection(\"Secret Assist\")\010    T:AddToggle(\"SecretAssist\", { Title = \"Secret Assist\",\010        Description = \"Flies to the NPC of the next PENDING secret (uses the Auto Select Secret Quest list in Normal Farm; empty = all) and presses only the known prompts (pick up, read, break, claim...). The puzzles themselves are still yours; the Awakened bosses are killed by Auto Secret Quest / Auto Awk Boss.\",\010        Default = Config.SecretAssist and true or false })\010        :OnChanged(function(v) Config.SecretAssist = v; persist() end)\010    T:AddToggle(\"SecretAuto\", { Title = \"Auto Secret Steps (beta)\",\010        Description = \"On top of Secret Assist: kills the mission's enemies (Thieving Monkey, Tavern Pirates, Megalo Brute, Fallen Angels, Don Megalo, Magma Elemental, Wraiths), presses the mission prompts anywhere on the map (Don Megalo: key, gate, coat) and calls the safe remotes (ClaimHat, TakeRope, BreakDoor, ReadLetter, OpenChest, ClaimTreasure, StartMatch...). Puzzles (pipes, crystals, statues, lookout...) are still yours. Not tested in-game.\",\010        Default = Config.SecretAuto and true or false })\010        :OnChanged(function(v)\010            Config.SecretAuto = v; persist()\010            if v and not Config.SecretAssist then\010                Config.SecretAssist = true; persist()\010                pcall(function() Fluent.Options.SecretAssist:SetValue(true) end)\010            end\010        end)\010\010    local B = Tabs.Bosses\010    B:AddSection(\"Auto Awaken (trigger the Awakened boss)\")\010    B:AddToggle(\"AwkTrigger\", { Title = \"Auto Awaken Bosses\",\010        Description = \"When the Secrets Master hint says an Awakened boss is about to stir, flies there and does the trigger: Chef (cauldron), Fishman Lord (clams + pearl), Warden (levers, tries the orders), Yeti / Magma General / Gorilla King (hits the objects with your Vulcan 'rocks' item). Vice Admiral, Cyborg, Sky Warlord and Thunder God are still manual. Needs Auto Awk Boss ON (it is turned on for you); the boss is killed afterwards.\",\010        Default = Config.AwkTrigger and true or false })\010        :OnChanged(function(v)\010            Config.AwkTrigger = v; persist()\010            if v and not Config.AwkOn then\010                Config.AwkOn = true; persist()\010                pcall(function() Fluent.Options.AwkOn:SetValue(true) end)\010            end\010        end)\010    local awkInfo = B:AddParagraph({ Title = \"Auto Awaken status\", Content = \"...\" })\010    task.spawn(function()\010        while Alive do\010            local txt = tostring(Diag.awk or \"idle\")\010            local n = #S.log\010            if n > 0 then txt = txt .. \"\\nLast server event: \" .. S.log[n] end\010            pcall(function() awkInfo:SetDesc(txt) end)\010            task.wait(3)\010        end\010    end)\010    B:AddButton({ Title = \"Copy Secret Event Log\", Description = \"Copies the last server events of the secrets (send it to me if a trigger fails)\", Callback = function()\010        local ok = pcall(function() setclipboard(table.concat(S.log, \"\\n\")) end)\010        Fluent:Notify({ Title = \"Moon Decompiled Hub - Secrets\", Content = ok and \"Copied.\" or \"Your executor has no setclipboard.\", Duration = 3 })\010    end })\010\010    T:AddSection(\"Go to\")\010    local dd = T:AddDropdown(\"SecretGoto\", { Title = \"Select Secret\", Values = AFL.SecretList, Default = 1 })\010    dd:OnChanged(function(v) sel.label = v end)\010    T:AddButton({ Title = \"Fly To The Secret's NPC\", Callback = function()\010        local d = sel.label and S.byLabel[labelKey(sel.label)]\010        if d then travel(d[5] + Vector3.new(0, 3, 4), d[4]) else Fluent:Notify({ Title = \"Moon Decompiled Hub - Secrets\", Content = \"Select a secret first.\", Duration = 4 }) end\010    end })\010    T:AddButton({ Title = \"Fly To The Secrets Master\", Description = \"Ask him which Awakened boss comes next\", Callback = function()\010        local f = workspace:FindFirstChild(\"NPCs\")\010        local n = f and f:FindFirstChild(\"Secrets Master\")\010        local ok, p = pcall(function() return n and n:GetPivot().Position end)\010        travel((ok and p) or V(-839, 28, 1603), \"Secrets Master\")\010    end })\010    T:AddButton({ Title = \"Stop\", Callback = function() token = nil; if currentTween then currentTween:Cancel() end end })\010    T:AddButton({ Title = \"Copy Remote List\", Description = \"Copies the remotes used by the secrets to the clipboard\", Callback = function()\010        local ok = pcall(function() setclipboard(S.remotesTxt) end)\010        Fluent:Notify({ Title = \"Moon Decompiled Hub - Secrets\", Content = ok and \"Copied.\" or \"Your executor has no setclipboard.\", Duration = 3 })\010    end })\010\010    T:AddSection(\"Guide per island (Sea 1)\")\010    for _, isl in ipairs(islands) do\010        T:AddParagraph({ Title = isl, Content = guideFor(isl) })\010    end\010    T:AddParagraph({ Title = \"Awakened bosses\", Content = \"They spawn about once an hour on the island announced by the Secrets Master (RF/RequestNextRaidHint). The 2 secrets of that island must be done first. Auto Awk Boss flies there a few minutes before and kills it. Names: Gorilla King, Chef, Yeti, Vice Admiral, Warden, Magma General, Fishman Lord, Cyborg, Sky Warlord, Thunder God.\" })\010end)()\010\010\010\010\010";
