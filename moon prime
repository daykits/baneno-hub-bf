lse end\010        if inv(\"Wenlocktoad\") ~= nil then note(\"V3: already unlocked\"); return false end\010        if dval(\"Level\") < 1000 then note(\"V3: need level 1000\"); return false end\010        if dval(\"Beli\") < 2000000 then note(\"V3: need 2,000,000 Beli\"); return false end\010        if not toSea2() then return true end\010        local w = inv(\"Wenlocktoad\", \"1\")\010        if w == 0 or w == 2 then\010            if near(WEN, 6) then note(\"V3: talking to Wenlocktoad\"); inv(\"Wenlocktoad\", w == 0 and \"2\" or \"3\"); task.wait(1)\010            else note(\"V3: going to Wenlocktoad\"); goTo(WEN) end\010            return true\010        elseif w == 1 then\010            local race = raceVal()\010            if race == \"Mink\" then\010                local e = AFL.feat and AFL.feat.Chest\010                if e then\010                    note(\"V3 (Mink): opening chests\")\010                    local ok, busy = pcall(e.run)\010                    return (ok and busy) and true or false\010                end\010            elseif race == \"Human\" then\010                if fightNames({ \"Diamond\", \"Orbitus\", \"Jeremy\" }, \"V3 (Human)\") then return true end\010                note(\"V3 (Human): Diamond / Orbitus / Jeremy not spawned\"); goTo(pos3(-382, 73, 290)); return true\010            elseif race == \"Ghoul\" or race == \"Skypiea\" then\010                if not Config.RaceV3Pvp then note(\"V3 (\" .. race .. \"): needs PvP, turn on 'Allow PvP for V3'\"); return false end\010                local c = pvpTarget()\010                if c then note(\"V3 (\" .. race .. \"): hunting \" .. c.Name); fightEnemy(c, { c.Name }, false); return true end\010                note(\"V3 (\" .. race .. \"): no valid player found\"); return false\010            else\010                note(\"V3 (\" .. race .. \"): no automation for this race yet\"); return false\010            end\010        end\010        return false\010    end\010\010    -- ===== V4: