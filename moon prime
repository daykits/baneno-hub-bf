, \"Keeps the same target until it leaves the FOV\", \"AimSticky\")\010    A:AddInput(\"AimIgnoreNames\", { Title = \"Ignore Usernames\", Description = \"Comma-separated usernames to never target (duo partners outside Team/Friends, your alt account...)\", Default = tostring(Config.AimIgnoreNames or \"\"), Placeholder = \"name1, name2\", Numeric = false, Finished = true })\010        :OnChanged(function(v) Config.AimIgnoreNames = tostring(v or \"\"); persist() end)\010\010    A:AddSection(\"Visuals\")\010    dd(\"AimFOVColor\", \"Color\", \"Color of the circle / highlight / line / label\", { \"Cyan\", \"White\", \"Red\", \"Green\", \"Purple\", \"Yellow\", \"Pink\", \"Orange\" }, \"AimFOVColor\")\010    tg(\"AimHighlight\", \"Highlight Target\", \"Outlines the locked target\", \"AimHighlight\")\010    tg(\"AimInfo\", \"Target Info\", \"Shows name, distance and HP above the target (needs Drawing support)\", \"AimInfo\")\010    tg(\"AimLine\", \"Target Line\", \"Line from the FOV center to the target (needs Drawing support)\", \"AimLine\")\010\010    A:AddSection(\"Aimbot Status\")\010    local ainfo = A:AddParagraph({ Title = \"Aimbot\", Content = \"Checking...\" })\010    task.spawn(function()\010        while Alive do\010            pcall(function()\010                ainfo:SetDesc(table.concat({\010                    \"Aimbot: \" .. (Config.AimOn and \"ON\" or \"off\") .. \" | \" .. tostring(Config.AimMode) .. \" | \" .. tostring(Config.AimTargets),\010                    \"Now: \" .. tostring(AB.status),\010                    \"Silent hooks: \" .. (hookmetamethod and (hooked and \"active\" or \"ready\") or \"NOT supported by your executor (use Camera Lock)\"),\010                    \"Drawing: \" .. (hasDrawing and \"yes\" or \"no (using a frame, no label/line)\"),\010                }, \"\\n\"))\010            end)\010            task.wait(1)\010        end\010    end)\010end)()\010\010\010\010\010";
