end\010    task.spawn(function()\010        local wo = workspace:WaitForChild(\"_WorldOrigin\", 60)\010        if not wo then return end\010        local function onPart(p)\010            if p.Name ~= \"ChargeUp\" or not Config.SeaOpt.DodgeShark then return end\010            local c = Player.Character\010            local hrp = c and c:FindFirstChild(\"HumanoidRootPart\")\010            if not (hrp and p:IsA(\"BasePart\")) or (p.Position - hrp.Position).Magnitude > 250 then return end\010            local born = os.clock()\010            st.dodgeUntil = os.clock() + 14\010            local conn\010            conn = p.AncestryChanged:Connect(function()\010                if p.Parent then return end\010                conn:Disconnect()\010                st.dodgeUntil = (os.clock() - born < 1) and (os.clock() + 2.5) or os.clock()\010            end)\010        end\010        table.insert(Connections, wo.ChildAdded:Connect(function(p) pcall(onPart, p) end))\010    end)\010    local function hpOf(m)\010        local h = m:FindFirstChildOfClass(\"Humanoid\")\010        if h then return h.Health end\010        local hv = m:FindFirstChild(\"Health\")\010        if hv and hv:IsA(\"ValueBase\") then return tonumber(hv.Value) end\010    end\010    -- conta a kill quando o alvo acompanhado some ou morre\010    local function settleTrack()\010        local tr = st.track\010        if tr and tr.m and (not tr.m.Parent or not aliveM(tr.m)) and not ((st.bad[tr.m] or 0) > os.clock()) then\010            st.kills.total = st.kills.total + 1\010            st.kills[tr.ty] = (st.kills[tr.ty] or 0) + 1\010            st.track = nil\010        end\010    end\010    -- Anti-travamento: perto do alvo ha 25s sem ele perder vida (inalcancavel / invulneravel) -> pula por 90s\010    local function stallCheck(t)\010        local now = os.clock()\010        local hp = hpOf(t.m)\010        local tr = st.track\010        if not tr or tr.m ~= t.m then settleTrack(); tr = { m = t.m, ty = t.type, hp = hp, since = now }; st.track = tr end\010        if hp and tr.hp and hp < tr.hp - 0.01 then tr.hp, tr.since = hp, now\010        elseif hp and (not tr.hp or hp > tr.hp) then tr.hp = hp end\010        if t.dist >= 150 then tr.since = now end\010        if now - tr.since > 25 then\010            st.bad[t.m] = now + 90; st.skipped = st.skipped + 1; st.track = nil\010            Diag.sea = \"skipping \" .. t.type .. \" (it does not lose health for 25s)\"\010            return true\010        end\010        return false\010    end\010    local function combat(t, hrp, hum)\010        local o = Config.SeaOpt\010        if stallCheck(t) then return end\010        st.tgt, st.tgtAt, st.tgtDist = t.type, os.clock(), t.dist\010        st.patrol, st.idleAt = nil, nil\010        pcall(function() Core.force = { NPC = true, BOSS = true }; Core.forceUntil = os.clock() + 1.5 end)   -- bate no alvo do mar mesmo que o Farm Settings so tenha NPC\010        -- v28: alvo forcado com prioridade MAXIMA no motor de ataque (antes dependia da lista de NPCs estar vazia -> golpes nao acertavam com NPC perto)\010        pcall(function() Core.seaTarget = { m = t.m, part = t.part }; Core.seaTargetUntil = os.clock() + 1.5 end)\010        if t.type == \"Sea Beast\" then st.hookBeast(t.part) end\010        Config.SeaUntil = os.clock() + 1.2\010        st.cruise = nil\010        if hum.Sit then hum.Sit = false end\010        local h = 20\010        local mw = m1Weapon(t.type)\010        if mw and (mw.tip == \"Blox Fruit\" or mw.name) then h = 14 end -- M1: mais perto, acerta mais\010        if t.type == \"Ship\" then h = 2 end -- barco: bem perto, o M1 de fruta acerta\010        if t.type == \"Sea Beast\" then h = h + 40 end -- +40 studs s\195\179 no Sea Beast\010        -- v42: o Terrorshark pode disparar um novo ChargeUp antes do anterior ser detectado como \"removido\" (ver o hook\010        -- em workspace._WorldOrigin.ChildAdded), e cada um rearma o teto de seguranca do dodge (14s). Se os ataque