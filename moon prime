kened Cyborg\", \"Sea1/Fountain/Fountain Wire Repair\", \"Freezeburg Quest Giver\", V(5263, 75, 4088),\010            \"When the scrapyard is magnetized by lightning: go to the Cyborg area, hit the broken wires to repair them -> kill the Awakened Cyborg -> Freezeburg.\", {} },\010        { \"Middle Town\", \"The Gamer\", \"Sea1/Middle Town/Early Access\", \"Experienced Captain\", V(-1130, 8, 1717),\010            \"Break the central window of the building behind the Experienced Captain with a FRUIT skill -> Janus sits at the table, accept his mission -> Robotmega's office: pick up the Rear Door Key behind the Aura Editor (-1043,9,1792) and open the back door -> back to Janus.\", { \"pick up\", \"open\" } },\010        { \"Middle Town\", \"Lookout Duty\", \"Sea1/Middle Town/Lookout\", \"Experienced Captain\", V(-1130, 8, 1717),\010            \"Experienced Captain -> 'Ask about lookout duty' -> 'Keep lookout' -> watch the boats and answer what passed on screen; 4 correct in a row. Remote: FinishFinale.\", {} },\010        { \"Middle Town\", \"The Treasure Hunt\", \"Sea1/Middle Town/X Marks The Spot\", \"Experienced Captain\", V(-1130, 8, 1717),\010            \"Hit trees and barrels until something shakes and drops a Treasure Map (prompt 'Pick Up') -> follow the clues, collect the 6 map fragments (remote CollectCheckpoint) -> dig the Buried Treasure -> Experienced Captain.\", { \"pick up\" } },\010    }\010    S.byLabel = {}\010    for _, d in ipairs(S.defs) do S.byLabel[d[1] .. \" - \" .. d[2]] = d end\010\010    local function labelKey(l) return (string.gsub(tostring(l), \" %[manual%]$\", \"\")) end\010\010    -- progresso real do servidor (RF/RequestBonusMomentReplication {Type=\"GetMomentProgress\"} -> {Data = {[id]=true}})\010    function S.refresh(force)\010        -- v53: o servidor nao respondeu em 15 s: libera para perguntar de novo (antes o \"busy\" ficava preso e o progresso parava)\010        if S.busy and os.clock() - S.at > 15 then S.busy = false end\010        if S.busy or (not force and os.clock() - S.at < 20) then return S.done end\010        S.busy, S.at = true, os.clock()\010        task.spawn(function()\010            pcall(function()\010                local m = ReplicatedStorage:FindFirstChild(\"Modules\")\010                local net = m and m:FindFirstChild(\"Net\")\010                local rf = net and net:FindFirstChild(\"RF/RequestBonusMomentReplication\")\010                if rf then\010                    local r = rf:InvokeServer({ Type = \"GetMomentProgress\" })\010                    if typeof(r) == \"table\" and typeof(r.Data) == \"table\" then S.done = r.Data end\010                end\010            end)\010            S.busy = false\010        end)\010        return S.done\010    end\010    function S.isDone(d) return S.done ~= nil and S.done[d[3]] == true end\010    function S.summary()\010        local done = S.refresh(false)\010        if not done then return \"Progress not loaded yet (press Refresh Progress).\" end\010        local n, pend = 0, {}\010        for _, d in ipairs(S.defs) do\010            if S.isDone(d) then n = n + 1 else pend[#pend + 1] = d[1] .. \" - \" .. d[2] end\010        end\010        if #pend == 0 then return \"All \" .. n .. \"/\" .. #S.defs .. \" secrets done.\" end\010        local shown = {}\010        for i = 1, math.min(#pend, 8) do shown[i] = pend[i] end\010        return n .. \"/\" .. #S.defs .. \" done. Pending: \" .. table.concat(shown, \"; \") .. (#pend > 8 and (\" ... +\" .. (#pend - 8)) or \"\")\010    end\010\010    -- ---------- ajudante (Secret Assist): voa ate o NPC/local do proximo secret pendente e aperta so os prompts conhecidos ----------\010    local function selected(d)\010        local sel, any = Config.SecretSel or {}, false\010        for _ in pairs(sel) do any = true break end\010        if not any or Config.SubC2 then return true end\010        if sel[d[1] .. \" - \" .. d[2]] or sel[d[1] .. \" - \" .. d[2] .. \" [manual]\"] then return true end\010        -- escolheu o Awakened de uma ilha: os 2 secrets dela sao pre-requisito, entram na lista sozinhos\010        for _, x in ipairs(S.defs) do\010            if x[1] == d[1] and string.find(x[2], \"Awakened\", 1, true) and sel[x[1] .. \" - \" .. x[2]] then return true end\010        end\010        return false\010    end\010    -- o Awakened (por chave) esta na selecao? (vazia = todos)\010    function S.bossSelected(bossName)\010        local sel, any = Config.SecretSel or {}, false\010        for _ in pairs(sel) do any = true break end\010        local nm = string.lower(tostring(bossName))\010        if Config.SubC2 then return true end\010        for _, label in ipairs(AFL.SecretList) do\010            local key = AFL.SecretKey[label]\010            if key and string.find(nm, key, 1, true) then\010                return (not any) or sel[label] == true\010            end\010        end\010        return not any\010    end\010    local function scanPrompts(center, want)\010        local out = {}\010        local map = workspace:FindFirstChild(\"Map\") or workspace\010        for _, o in ipairs(map:GetDescendants()) do\010            if o:IsA(\"ProximityPrompt\") and o.Enabled then\010                local txt = string.lower((o.ActionText or \"\") .. \" \" .. (o.ObjectText or \"\"))\010                for _, w in ipairs(want) do\010                    if string.find(txt, w, 1, true) then\010                        local par = o.Parent\010                        local pos = par and (par:IsA(\"BasePart\") and par.Position or (par:IsA(\"Attachment\") and par.WorldPosition))\010                        if pos and (pos - center).Magnitude < 160 then out[#out + 1] = { o, pos } end\010                        break\010                    end\010                end\010            end\010        end\010        return out\010    end\010    function S.assist()\010        if not assistOn() then return false end\010        -- v53: os Island Secrets sao do Mar 1\010        local okSea, sea = pcall(__E.getSea)\010        if okSea and sea and sea ~= 1 then Diag.secret = \"assist: Island Secrets are in the First Sea (you are in Sea \" .. tostring(sea) .. \")\"; return false end\010        S.refresh(false)\010        if not S.done then Diag.secret = \"assist: waiting for the secret progress\"; return false end\010        local now = os.clock()\010        local d = S.cur\010        if d and (S.isDone(d) or not selected(d) or now - S.curSince > (autoOn() and 300 or 90)) then\010            if not S.isDone(d) and selected(d) then S.skip[d[3]] = now + 180 end\010            d, S.cur, S.arrived = nil, nil, nil\010        end\010        local _, hrp = getChar()\010        if not hrp then return false end\010        if not d then\010            -- v53: pega o secret pendente MAIS PERTO (antes ia sempre no primeiro da lista, atravessando o mapa)\010            local bd\010            for _, x in ipairs(S.defs) do\010                if selected(x) and not S.isDone(x) and (S.skip[x[3]] or 0) < now and not string.find(x[2], \"Awakened\", 1, true) then\010                    local dd = (hrp.Position - x[5]).Magnitude\010                    if not bd or dd < bd then d, bd = x, dd end\010                end\010            end\010            if not d then Diag.secret = \"assist: nothing pending in the selection\"; return false end\010            S.cur, S.curSince, S.arrived = d, now, nil\010        end\010        State.Mode, State.Text = \"Auto Secret Quest\", d[1] .. \" - \" .. d[2]\010        local pos = d[5] + Vector3.new(0, 3, 0)\010        local dist = (hrp.Position - pos).Magnitude\010        -- v53: depois de chegar no NPC, a missao pode levar o personagem ate ~1200 studs dali (inimigos, prompts, objetos).\010        -- Antes, a cada passo (>30 studs do NPC) ele voava de volta para o NPC e largava a missao: vai-e-volta sem fim.\010        if dist <= 30 then S.arrived = d end\010        if S.arrived ~= d or dist > 1200 then\010            if dist > 1200 then S.arrived = nil end\010            Diag.secret = \"assist: flying to \" .. d[4] .. \" (\" .. d[1] .. \")\"\010            flyTo(CFrame.new(pos))\010            return true\010        end\010        Diag.secret = \"assist: at \" .. d[4] .. \" - \" .. d[2] .. \" (do the steps; known prompts are pressed)\"\010        if autoOn() and S.autoStep then\010            local okA, handled = pcall(S.autoStep, d)\010            if okA and handled then return true end\010            if not okA then Diag.secret = \"auto error: \" .. tostring(handled) end\010        end\010        if #d[7] > 0 and fireproximityprompt and now - (S.lastScan or 0) > 4 then\010            S.lastScan = now\010            for _, pr in ipairs(scanPrompts(d[5], d[7])) do\010                local p, at = pr[1], pr[2]\010                if (hrp.Position - at).Magnitude > 12 then\010                    flyTo(CFrame.new(at + Vector3.new(0, 3, 0)))\010                    return true\010                end\010                pcall(fireproximityprompt, p, 1)\010            end\010        end\010        -- nada para fazer longe do NPC: volta para perto dele (espera a mensagem / o evento do secret)\010        if dist > 30 then flyTo(CFrame.new(pos)) end\010        return true\010    end\010    local origStep = AFL.secretStep\010    AFL.secretStep = function()\010        local ok, r = pcall(origStep)\010        if ok and r then return true end\010        if Config.SecretOn then\010            local okT, rT = pcall(S.trigger, true)\010            if okT and rT then return true end\010        end\010        local ok2, r2 = pcall(S.assist)\010        return ok2 and r2 or false\010    end\010\010    -- ---------- catalogo de texto ----------\010    S.remotesTxt = [[\010SECRETS - REMOTES (all verified in the dumps)\010ReplicatedStorage.Remotes.BonusMomentsRemoteEvent:FireServer(<ModuleName>, ...)   -- every secret uses this\010ReplicatedStorage.Remotes.BonusMomentsRemoteFunction:InvokeServer(<ModuleName>, ...)\010  per-secret verbs: ClaimHat, TakeRope, Hoist, Start, BreakDoor, ReadLetter, CutsceneDone, GuardsOut, Provoke, BeginFight, IsBruteActive, Collect,\010  OpenChest, Initialize, Complete, OpenClam, ClaimPearl, OpenCauldron, Insert, Cook, CloseCauldron, GetState, GrabSnowball, BallLost, Pull, Release,\010  BouncerReady, TakeKey, Unlock, TakeCape, StartMatch, State, Struck, PickupMap, CollectCheckpoint, ClaimTreasure, FinishFinale\010Net (ReplicatedStorage.Modules.Net):\010  RF/RequestBonusMomentReplication({Type=\"GetMomentProgress\"}) -> {Data={[\"Sea1/<Island>/<Moment>\"]=true,...}}\010  RF/RequestSecretStories({Type=\"GetPhase\"}) -> {Phase=\"Repair\"|\"Locked\"|...}\010  RF/RequestNextRaidHint() -> {State=\"Dormant|Arming|Armed|Triggered|Deferred\", Boss, Island, Seconds, Rumor={...}}   -- next Awakened boss\010  RF/BonusMomentsGuide(\"InteractQuestGiver\", <name>) / (\"GetRewardTracker\")\010  RF/RequestMomentEventStages, RE/OnBonusMomentReplicatedChange, RE/MomentEventStage, RF/BossCutscene, RF/GetPlayerFlag, RF/GetManyPlayerFlags\010NPC to ask which Awakened boss is next: Secrets Master (-839, 28, 1603)\010]]\010    local function guideFor(island)\010        local lines, npcs = {}, {}\010        for _, d in ipairs(S.defs) do\010            if d[1] == island then\010                if not npcs[d[4]] then\010                    npcs[d[4]] = true\010                    lines[#lines + 1] = \"NPC: \" .. d[4] .. \" (\" .. math.floor(d[5].X) .. \", \" .. math.floor(d[5].Y) .. \", \" .. math.floor(d[5].Z) .. \")\"\010                end\010            end\010        end\010        for _, d in ipairs(S.defs) do\010            if d[1] == island then\010                lines[#lines + 1] = \"* \" .. d[2] .. \" [\" .. string.match(d[3], \"([^/]+)$\") .. \"]: \" .. d[6]\010            end\010        end\010        return table.concat(lines, \"\\n\")\010    end\010    local islands, seenIsl = {}, {}\010    for _, d in ipairs(S.defs) do if not seenIsl[d[1]] then seenIsl[d[1]] = true; islands[#islands + 1] = d[1] end end\010\010    -- ---------- Auto Awaken: faz o gatilho de cada Awakened boss ----------\010    -- Alta confianca (codigo lido): Chef (OpenCauldron/Insert/Cook), Fishman Lord (OpenClam/ClaimPearl), Warden (Pull nas 4 alavancas, testa as ordens).\010    -- Media/baixa (acerta o objeto com o item/skills escolhidos em Vulcan \"rocks\"): Yeti (iceRock), Magma General (geiseres), Gorilla King (arvore).\010    -- Novos: Cyborg (fios Broken, M1), Sky Warlord (voa ate a arena do evento; nuvens por nome = palpite), Thunder God (so vai ao sino), Vice Admiral (sentar no canhao + clicar = palpite).\010    S.log, S.evInst, S.t, S.cool, S.began, S.hitN = {}, {}, {}, {}, {}, setmetatable({}, { __mode = \"k\" })\010    S.evPos, S.evAt = {}, {}\010    function S.ser(x, depth)\010        local t = typeof(x)\010        if t == \"Instance\" then return x:GetFullName() end\010        if t == \"Vector3\" then return string.format(\"V3(%.0f,%.0f,%.0f)\", x.X, x.Y, x.Z) end\010        if t == \"table\" then\010            if depth > 0 then return \"{...}\" end\010            local out, n = {}, 0\010            for k, v in pairs(x) do\010                n = n + 1\010                if n > 6 then out[#out + 1] = \"...\"; break end\010                out[#out + 1] = tostring(k) .. \"=\" .. S.ser(v, 1)\010            end\010            return \"{\" .. table.concat(out, \",\") .. \"}\"\010        end\010        return tostring(x)\010    end\010    local function rem(name)\010        local f = ReplicatedStorage:FindFirstChild(\"Remotes\")\010        return f and f:FindFirstChild(name)\010    end\010    task.spawn(function()\010        local f = ReplicatedStorage:WaitForChild(\"Remotes\", 10)\010        local re = f and f:WaitForChild(\"BonusMomentsRemoteEvent\", 10)\010        if not re then return end\010        re.OnClientEvent:Connect(function(...)\010            local a, parts, insts = { ... }, {}, {}\010            for i = 1, math.min(#a, 6) do\010                local x = a[i]\010                if typeof(x) == \"Instance\" then insts[#insts + 1] = x\010                elseif typeof(x) == \"Vector3\" and type(a[1]) == \"string\" then S.evPos[a[1]], S.evAt[a[1]] = x, os.clock()\010                elseif typeof(x) == \"CFrame\" and type(a[1]) == \"string\" then S.evPos[a[1]], S.evAt[a[1]] = x.Position, os.clock()\010                elseif typeof(x) == \"table\" and type(a[1]) == \"string\" and a[2] == \"Setup\" then\010                    -- One Last Eruption: Setup(moment, {[i]=CFrame}) = lugares das fissuras\010                    local pts = {}\010                    for _, v in pairs(x) do if typeof(v) == \"CFrame\" then pts[#pts + 1] = v.Position end end\010                    if #pts > 0 then S.evPts = S.evPts or {}; S.evPts[a[1]] = pts end\010                end\010                parts[i] = S.ser(x, 0)\010            end\010            S.log[#S.log + 1] = os.date(\"%H:%M:%S\") .. \" \" .. table.concat(parts, \" | \")\010            if #S.log > 80 then table.remove(S.log, 1) end\010            if #insts > 0 and type(a[1]) == \"string\" then S.evInst[a[1]] = insts end\010        end)\010    end)\010    local function posOf(inst)\010        if not inst then return end\010        if inst:IsA(\"BasePart\") then return inst.Position end\010        local ok, p = pcall(function() return inst:GetPivot().Position end)\010        if ok then return p end\010    end\010    local function near(pos, r, up)\010        local _, hrp = getChar()\010        if not hrp then return false end\010        if (hrp.Position - pos).Magnitude > r then\010            flyTo(CFrame.new(pos + Vector3.new(0, up or 3, 0)))\010            return false\010        end\010        return true\010    end\010    local function every(key, sec)\010        if os.clock() - (S.t[key] or 0) < sec then return false end\010        S.t[key] = os.clock()\010        return true\010    end\010    local function mapChild(...)\010        local c = workspace\010        for _, n in ipairs({ ... }) do\010            c = c and c:FindFirstChild(n)\010        end\010        return c\010    end\010\010    -- Chef: workspace.Map.Pirate.Cauldron_Moment.Cauldron ; remote \"Chef's Kiss\"\010    local function chefRun()\010        local c = mapChild(\"Map\", \"Pirate\", \"Cauldron_Moment\", \"Cauldron\")\010        local pos = posOf(c) or V(-1136, 54, 4185)\010        if not near(pos, 11, 5) then Diag.awk = \"Auto Awaken (Chef): flying to the cauldron\"; return true end\010        if not every(\"chef\", 4) then return true end\010        local rf = rem(\"BonusMomentsRemoteFunction\")\010        if not rf then Diag.awk = \"Auto Awaken (Chef): remote not found\"; return false end\010        local ok, st = pcall(rf.InvokeServer, rf, \"Chef's Kiss\", \"OpenCauldron\")\010        if not ok or typeof(st) ~= \"table\" then Diag.awk = \"Auto Awaken (Chef): cauldron not open yet (\" .. tostring(st) .. \")\"; return true end\010        local placed = {}\010        for _, m in ipairs(st.Placed or {}) do placed[m] = true end\010        local missing = {}\010        for _, m in ipairs(st.Recipe or {}) do\010            if not placed[m] then\010                local ok2, r = pcall(rf.InvokeServer, rf, \"Chef's Kiss\", \"Insert\", m)\010                if ok2 and r then placed[m] = true else missing[#missing + 1] = m .. \" (owned \" .. tostring((st.Owned or {})[m] or 0) .. \")\" end\010            end\010        end\010        if #missing > 0 then\010            Diag.awk = \"Auto Awaken (Chef): missing ingredients: \" .. table.concat(missing, \", \")\010            pcall(function() rem(\"BonusMomentsRemoteEvent\"):FireServer(\"Chef's Kiss\", \"CloseCauldron\") end)\010            return true\010        end\010        local ok3, r3 = pcall(rf.InvokeServer, rf, \"Chef's Kiss\", \"Cook\")\010        Diag.awk = \"Auto Awaken (Chef): cooked -> \" .. tostring(r3)\010        pcall(function() rem(\"BonusMomentsRemoteEvent\"):FireServer(\"Chef's Kiss\", \"CloseCauldron\") end)\010        return true\010    end\010\010    -- Fishman Lord: Map.Fishmen.Clams.Clam1..12 -> OpenClam(clam) (\"Black\" = the pearl clam) -> ClaimPearl\010    S.fish = { done = {}, tries = {}, pearl = nil, pearlAt = 0 }\010    local function fishRun()\010        local clams = mapChild(\"Map\", \"Fishmen\", \"Clams\")\010        if not clams then Diag.awk = \"Auto Awaken (Fishman): Clams folder not found\"; return false end\010        local F = S.fish\010        local rf = rem(\"BonusMomentsRemoteFunction\")\010        if not rf then return false end\010        if F.pearl then\010            local pos = posOf(F.pearl) or V(61300, 20, 1600)\010            if not near(pos, 9, 3) then return true end\010            if os.clock() - F.pearlAt < 1.3 or not every(\"fishclaim\", 1.5) then return true end\010            local ok, r = pcall(rf.InvokeServer, rf, \"Pearl of the Deep\", \"ClaimPearl\")\010            Diag.awk = \"Auto Awaken (Fishman): ClaimPearl -> \" .. tostring(r)\010            if ok and r == true then F.pearl = nil end\010            return true\010        end\010        for _, c in ipairs(clams:GetChildren()) do\010            if not F.done[c] and (F.tries[c] or 0) < 3 then\010                local pos = posOf(c)\010                if pos then\010                    Diag.awk = \"Auto Awaken (Fishman): opening \" .. c.Name\010                    if not near(pos, 9, 3) then return true end\010                    if not every(\"fishopen\", 1.2) then return true end\010                    F.tries[c] = (F.tries[c] or 0) + 1\010                    local ok, r = pcall(rf.InvokeServer, rf, \"Pearl of the Deep\", \"OpenClam\", c)\010                    if ok and r == \"Black\" then F.pearl, F.pearlAt = c, os.clock(); F.done[c] = true\010                    elseif ok and r then F.done[c] = true end\010                    return true\010                end\010            end\010        end\010        Diag.awk = \"Auto Awaken (Fishman):