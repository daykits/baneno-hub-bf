to Farm Observation\", \"Stays next to a mob so you dodge and level up Observation\")\010    tg(\"FullGuitar\", \"Auto Soul Guitar\", \"Sea 3, level 2300, full moon: Haunted Castle puzzles, then buys it\")\010\010    -- ------------------------------------------------------------------- eventos ----\010    T:AddSection(\"Events\")\010    tg(\"VulcFull\", \"Auto Fully Vulcan\", \"Magnet items > sail > find the island > start it > eggs & bones\")\010    T:AddSubSection(\"Kitsune Island\")\010    tg(\"FullKitsune\", \"Auto Fully Kitsune Island\", \"\")\010    do\010        local boatValues = { \"Guardian\", \"Lantern\", \"Beast Hunter\", \"Sleigh\", \"Brigade\", \"Grand Brigade\" }\010        local bi = 1\010        for i, n in ipairs(boatValues) do if n == Config.KitBoat then bi = i end end\010        T:AddDropdown(\"KitBoat\", { Title = \"Kitsune: Boat To Buy\", Values = boatValues, Default = bi,\010            Description = \"\" })\010            :OnChanged(function(v) Config.KitBoat = tostring(v); persist() end)\010    end\010    T:AddSlider(\"KitSpeed\", { Title = \"Kitsune: Tween Speed (Boat)\", Description = \"Boat speed to zone 6 and to the island (100-500)\", Min = 100, Max = 500, Default = math.clamp(tonumber(Config.KitSpeed) or 200, 100, 500), Rounding = 0 })\010        :OnChanged(function(v) Config.KitSpeed = math.floor(v); persist() end)\010    T:AddSlider(\"KitAzure\", { Title = \"Kitsune: Azure Ember Amount To Trade\", Description = \"   \", Min = 1, Max = 50, Default = math.clamp(tonumber(Config.KitAzure) or 10, 1, 50), Rounding = 0 })\010        :OnChanged(function(v) Config.KitAzure = math.floor(v); persist() end)\010    AFL.kiPara = T:AddParagraph({ Title = \"Kitsune Status\", Content = \"...\" })\010\010    -- ------------------------------------------------------------------- atalhos ----\010    T:AddSection(\"Shortcuts\")\010    T:AddButton({ Title = \"Turn Everything Off\", Description = \"Switches off every Auto Fully function listed here\", Label = \"Stop\", Callback = function()\010        local n = 0\010        for _, id in ipairs(ALLKEYS) do\010            if Config[id] then\010                n += 1\010                local o = Fluent.Options[id]\010                if o and o.SetValue then o:SetValue(false) else Config[id] = false end\010            end\010        end\010        persist()\010        AFL.goStop()\010        note(n > 0 and (n .. \" function(s) turned off\") or \"Nothing was on\", 3)\010    end })\010    T:AddButton({ Title = \"Forget Observation V2 Progress\", Description = \"Use it if the script thinks Observation V2 is done and it is not\", Label = \"Reset\", Callback = function()\010        Config.FullKenDone = false; persist()\010        note(\"Observation V2 progress forgotten\", 3)\010    end })\010    T:AddButton({ Title = \"Fly To The Horned Man\", Description = \"Hydra Island (Rainbow Haki)\", Label = \"Go\", Callback = function()\010        AFL.goDo(\"Horned Man\", Vector3.new(-11892, 931, -8761), function() task.wait(0.3) end, 12)\010    end })\010    T:AddButton({ Title = \"Fly To The Citizen\", Description = \"Floating Turtle (Observation V2 quest)\", Label = \"Go\", Callback = function()\010        AFL.goDo(\"Citizen\", Vector3.new(-12445, 332, -7676), function() task.wait(0.3) end, 12)\010    end })\010    T:AddButton({ Title = \"Fly To The Haunted Castle\", Description = \"Soul Guitar puzzles (Sea 3)\", Label = \"Go\", Callback = function()\010        AFL.goDo(\"Haunted Castle\", Vector3.new(-9500, 100, 6100), function() task.wait(0.3) end, 40)\010    end })\010    T:AddButton({ Title = \"Stop Flying\", Description = \"Cancels a shortcut that is still flying\", Label = \"Stop\", Callback = function() AFL.goStop() end })\010\010    -- ------------------------------------------------------------ atualizacao ao vivo ----\010    local STATE = { run = \"ok\", done = \"ok\", wait = \"warn\", err = \"bad\", idle = \"info\", off = \"off\" }\010    local function liveText(r)\010        if not Config[r.cfg] then return nil end\010        if r.state == \"done\" then return \"Done: \" .. (r.doneMsg or \"finished\") end\010        if r.state == \"idle\" then return \"Waiting for its turn\" end\010        if r.state == \"off\" then return nil end\010        return r.msg\010    end\010    local function raceCard(card, key, label)\010        local R = rawget(AFL, \"Race\")\010        local st = R and R.st and R.st[key]\010        local on = Config[key == \"ghoul\" and \"RaceGhoul\" or \"RaceCyborg\"]\010        if not on then\010            card:Set(\"off\", nil, \"Off. Turn it on below and it does everything by itself\", \"OFF\")\010        elseif not st then\010            card:Set(\"info\", nil, \"Waiting for its turn\", \"READY\")\010        else\010            card:Set(st.state or \"info\", nil, st.msg or \"...\", st.pill or \"WORKING\")\010        end\010    end\010    local function refresh()\010        -- cartao principal\010        local on, done, run = F.counts()\010        local waiting = 0\010        for _, r in ipairs(F.list) do if Config[r.cfg] and (r.state == \"wait\" or r.state == \"idle\") then waiting += 1 end end\010        local extra = 0\010        for _, id in ipairs({ \"RaceGhoul\", \"RaceCyborg\", \"RaceV2\", \"RaceV3\", \"RaceLever\", \"SubYama\", \"SubTushita\", \"SubCDK\", \"SubFullTTK\", \"VulcFull\", \"FullKitsune\" }) do\010            if Config[id] then extra += 1 end\010        end\010        local total = on + extra\010        if total == 0 then\010            sNow:Set(\"off\", \"Auto Fully Engine\", \"Turn on any function below. Each one does the whole job by itself\", \"IDLE\")\010        elseif Core.owner == \"Auto Fully\" and F.cur then\010            sNow:Set(\"ok\", \"Auto Fully Engine\", F.cur.title .. \": \" .. tostring(F.cur.msg), \"RUNNING\")\010        elseif Core.owner then\010            sNow:Set(\"info\", \"Auto Fully Engine\", tostring(Core.owner) .. \" has the character right now. Auto Fully takes over when it has something to do\", \"STANDBY\")\010        elseif on > 0 then\010            local firstWait\010            for _, r in ipairs(F.list) do if Config[r.cfg] and r.state == \"wait\" then firstWait = r break end end\010            sNow:Set(firstWait and \"warn\" or \"info\", \"Auto Fully Engine\", firstWait and (firstWait.title .. \": \" .. tostring(firstWait.msg)) or \"Ready\", firstWait and \"WAITING\" or \"READY\")\010        else\010            sNow:Set(\"info\", \"Auto Fully Engine\", \"Ready: the races / swords / events you turned on run from their own tabs\", \"READY\")\010        end\010        sStats:Set({ total, run, done, waiting })\010        -- linha ao vivo de cada interruptor\010        for _, r in ipairs(F.list) do\010            local o = TG[r.cfg]\010            if o then o:SetLive(liveText(r)) end\010        end\010        local R = rawget(AFL, \"Race\")\010        raceCard(sGhoul, \"ghoul\")\010        raceCard(sCyborg, \"cyborg\")\010        if TG.RaceGhoul then TG.RaceGhoul:SetLive(Config.RaceGhoul and R and R.st and R.st.ghoul and R.st.ghoul.msg or nil) end\010        if TG.RaceCyborg then TG.RaceCyborg:SetLive(Config.RaceCyborg and R and R.st and R.st.cyborg and R.st.cyborg.msg or nil) end\010        if TG.VulcFull then TG.VulcFull:SetLive(Config.VulcFull and tostring(Diag.vulc or \"\") ~= \"\" and tostring(Diag.vulc) or nil) end\010        -- CDKfix: mostra na aba Fully o que o Sub Farm (Yama / Tushita / CDK / TTK) esta fazendo agora\010        for _, id in ipairs({ \"SubYama\", \"SubTushita\", \"SubCDK\", \"SubFullTTK\" }) do\010            local o = TG[id]\010            if o then\010                pcall(function()\010                    local sf = rawget(AFL, \"Sub\")\010                    local s = sf and sf.status\010                    o:SetLive((Config[id] and s and tostring(s) ~= \"\") and tostring(s) or nil)\010                end)\010            end\010        end\010    end\010    local warned = false\010    task.spa