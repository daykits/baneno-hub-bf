ot near(at, 10) then flyTo(CFrame.new(at)); return true end\010            if every(\"pipes\", 4) then pipes(hc); F.guitarCache = nil end\010            return true\010        end\010    end\010\010    -- =====================================================================================================\010    -- FULLY MIRROR FRACTAL (Mar 3)  [v26]: entra direto num servidor com Dough King pela API do Quantum e mata ele. Sempre.\010    -- =====================================================================================================\010    do\010        local r = define({ key = \"mirror\", cfg = \"FullMirror\", title = \"Auto Fully Mirror Fractal\", sea = 3 })\010        local FALLBACK = V3(-2077, 252, -12373)\010        local function mirrorPos()\010            local m = workspace:FindFirstChild(\"Map\")\010            local cl = m and m:FindFirstChild(\"CakeLoaf\")\010            local bm = cl and cl:FindFirstChild(\"BigMirror\")\010            local mn = bm and bm:FindFirstChild(\"Main\")\010            return mn and mn:IsA(\"BasePart\") and mn.Position or FALLBACK\010        end\010        local function king() return findEnemy({ \"Dough King\" }) end\010        r.step = function(self)\010            local boss = king()\010            if boss then\010                self.S(\"run\", \"Killing the Dough King\", 0.8)\010                F.mirrorKills = F.mirrorKills or 0\010                fightEnemy(boss, { boss.Name }, false)\010                F.mirrorSeen = true\010                return true\010            end\010            if F.mirrorSeen then F.mirrorSeen = nil; F.mirrorKills = (F.mirrorKills or 0) + 1 end\010            -- vai ate o espelho antes de procurar (chega perto do boss quando ele carrega)\010            local at = mirrorPos()\010            if not near(at, 60) and not (AFL.Hop and AFL.Hop.active) and not (AFL.QApi and AFL.QApi.joining) then\010                self.S(\"run\", \"Flying to the Mirror Fractal\", 0.4)\010                flyTo(C