        DV.src.macro = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Connections, Fluent, Player, Tabs, persist = __E.Config, __E.Connections, __E.Fluent, __E.Player, __E.Tabs, __E.persist\010local UserInputService = game:GetService(\"UserInputService\")\010local VirtualInputManager = game:GetService(\"VirtualInputManager\")\010local Alive = true\010AFL.onUnload(function() Alive = false end)\010-- ---------- Macro: combo configuravel disparado por uma tecla (v105, pedido do usuario) ----------\010-- Cada passo tem: item (nome exato do Tool, equipado se precisar), acao (M1 ou tecla de skill Z/X/C/V/F) e um\010-- delay antes do proximo passo. Reaproveita o MESMO jeito de clicar/apertar tecla que o resto do hub ja usa\010-- (LeftClickRemote \"as cegas\" pra M1, VirtualInputManager:SendKeyEvent pra skill) - nada novo/arriscado.\010;(function()\010    local T = Tabs.Macro\010    local UIS = UserInputService\010    local M = {}\010    AFL.Macro = M\010    local function d(k, v) if Config[k] == nil then Config[k] = v end end\010    d(\"MacroOn\", false); d(\"MacroKey\", \"G\"); d(\"MacroCooldown\", 1)\010    local SLOTS = 6\010    local ACTIONS = { \"M1 (Click)\", \"Z\", \"X\", \"C\", \"V\", \"F\" }\010    local KEY_LIST = { \"G\", \"H\", \"T\", \"B\", \"N\", \"M\", \"Tab\", \"CapsLock\", \"LeftAlt\", \"LeftControl\", \"MouseButton2\" }\010    if type(Config.MacroSteps) ~= \"table\" then Config.MacroSteps = {} end\010    for i = 1, SLOTS do\010        local s = Config.MacroSteps[i]\010        if type(s) ~= \"table\" then s = {}; Config.MacroSteps[i] = s end\010        if s.on == nil then s.on = false end\010        s.item = s.item or \"\"\010        s.action = s.action or \"M1 (Click)\"\010        s.delay = tonumber(s.delay) or 150\010    end\010\010    -- ===== execucao =====\010    local running, lastRun = false, 0\010    local function findTool(name)\010        name = tostring(name or \"\")\010        name = string.gsub(string.gsub(name, \"^%s+\", \"\"), \"%s+$\", \"\")\010        if name == \"\" then return nil end\010        local char, bp = Player.Character, Player.Backpack\010        local t = (char and char:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))\010        return (t and t:IsA(\"Tool\")) and t or nil\010    end\010    local function pressSkill(name)\010        local kc = Enum.KeyCode[name]\010        if not kc then return end\010        pcall(function()\010            VirtualInputManager:SendKeyEvent(true, kc, false, game)\010            task.wait(0.1)\010            VirtualInputManager:SendKeyEvent(false, kc, false, game)\010        end)\010    end\010    local function fireM1(t)\010        pcall(function() t:Activate() end)\010        local remote = t:FindFirstChild(\"LeftClickRemote\")\010        if remote then pcall(remote.FireServer, remote, Vector3.new(0.01, -500, 0.01), 1, true) end\010    end\010    local function runStep(s)\010        local t = findTool(s.item)\010        if not t then M.status = \"Macro: '\" .. tostring(s.item) .. \"' not found (backpack/equipped)\"; return end\010        local hum = Player.Character and Player.Character:FindFirstChildOfClass(\"Humanoid\")\010        if hum and t.Parent ~= Player.Character then\010            pcall(function() hum:EquipTool(t) end)\010            task.wait(0.15) -- tempo pro equip replicar antes de atacar (igual ao Double Attack)\010        end\010        if s.action == \"M1 (Click)\" then fireM1(t) else pressSkill(s.action) end\010    end\010    function M.run()\010        if running then return end\010        running = true\010        M.status = \"Macro: running\"\010        for i = 1, SLOTS do\010            if not Alive then break end\010            local s = Config.MacroSteps[i]\010            if s and s.on and s.item ~= \"\" then\010                runStep(s)\010                task.wait(math.clamp((tonumber(s.delay) or 150) / 1000, 0.03, 5))\010            end\010        end\010        M.status = \"Macro: idle\"\010        running = false\010    end\010\010    -- ===== gatilho =====\010    local function isMacroKey(i)\010        local k = Config.MacroKey\010        if k == \"MouseButton2\" then return i.UserInputType == Enum.UserInputType.MouseButton2 end\010        local ok, kc = pcall(function() return Enum.KeyCode[k] end)\010        return ok and i.KeyCode == kc\010    end\010    table.insert(Connections, UIS.InputBegan:Connect(function(i, gp)\010        if gp then return end\010        if not Config.MacroOn then return end\010        if not isMacroKey(i) then return end\010        local now = os.clock()\010        if now - lastRun < (tonumber(Config.MacroCooldown) or 1) then return end\010        lastRun = now\010        task.spawn(M.run)\010    end))\010\010    -- ===== UI =====\010    T:AddSection(\"Macro\")\010    T:AddToggle(\"MacroOn\", { Title = \"Enable Macro\", Description = \"Turns the key below into your combo trigger\", Default = Config.MacroOn and true or false })\010        :OnChanged(function(v) Config.MacroOn = v; persist() end)\010    do\010        local function idx(list, v) for i, x in ipairs(list) do if x == v then return i end end return 1 end\010        T:AddDropdown(\"MacroKeyDD\", { Title = \"Macro Key\", Description = \"Key that fires the whole combo below\", Values = KEY_LIST, Default = idx(KEY_LIST, Config.MacroKey) })\010            :OnChanged(function(v) Config.MacroKey = v; persist() end)\010    end\010    T:AddSlider(\"MacroCooldown\", { Title = \"Cooldown Between Runs (s)\", Description = \"Minimum time before the key can fire the combo again (avoids restarting mid-combo if you hold/mash it)\", Min = 0.2, Max = 5, Default = math.clamp(tonumber(Config.MacroCooldown) or 1, 0.2, 5), Rounding = 1 })\010        :OnChanged(function(v) Config.MacroCooldown = v; persist() end)\010    T:AddButton({ Title = \"Run Once (Test)\", Description = \"Runs the combo right now, without needing the key - useful to check the order while not in a fight\", Label = \"Run\", Callback = function() task.spawn(M.run) end })\010\010    for i = 1, SLOTS do\010        T:AddSubSection(\"Step \" .. i)\010        local s = Config.MacroSteps[i]\010        T:AddToggle(\"MacroStepOn\" .. i, { Title = \"Enabled\", Description = \"Off = this step is skipped entirely\", Default = s.on and true or false })\010            :OnChanged(function(v) Config.MacroSteps[i].on = v; persist() end)\010        T:AddInput(\"MacroStepItem\" .. i, { Title = \"Item (exact name)\", Description = \"Exact Tool name - a sword, gun or Blox Fruit, equipped or in your backpack\", Default = tostring(s.item or \"\"), Placeholder = \"e.g. Dark Blade, Dragon Breath\", Numeric = false, Finished = true })\010            :OnChanged(function(v) Config.MacroSteps[i].item = tostring(v or \"\"); persist() end)\010        do\010            local function idx(list, v) for j, x in ipairs(list) do if x == v then return j end end return 1 end\010            T:AddDropdown(\"MacroStepAction\" .. i, { Title = \"Attack\", Description = \"M1 = basic click. Z/X/C/V/F = that skill key (pressed while the item above is equipped)\", Values = ACTIONS, Default = idx(ACTIONS, s.action) })\010                :OnChanged(function(v) Config.MacroSteps[i].action = v; persist() end)\010        end\010        T:AddSlider(\"MacroStepDelay\" .. i, { Title = \"Delay After (ms)\", Description = \"Wait time before the next step runs\", Min = 30, Max = 1000, Default = math.clamp(tonumber(s.delay) or 150, 30, 1000), Rounding = 0 })\010            :OnChanged(function(v) Config.MacroSteps[i].delay = v; persist() end)\010    end\010\010    T:AddSection(\"Status\")\010    M.status = \"Macro: idle\"\010    local para = T:AddParagraph({ Title = \"Macro\", Content = \"Idle\" })\010    task.spawn(function()\010        while Alive do\010            pcall(function() para:SetDesc(M.status or \"Idle\") end)\010            task.wait(0.3)\010        end\010    end)\010end)()\010";
