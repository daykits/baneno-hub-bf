g\" } })\010\010    -- ---------------------------------------------------------------------- opcoes ----\010    T:AddSection(\"General Settings\")\010    tg(\"FullTravel\", \"Auto Travel Between Seas\", \"Goes to the right sea by itself (Main / Dressrosa / Zou)\")\010    tg(\"FullHop\", \"Server Hop When Needed\", \"Changes server when a boss, ship mobs or chests are not here\")\010    T:AddSlider(\"FullChestCount\", { Title = \"Chests Before Hop\", Description = \"Chests collected in a server before it hops (Fist of Darkness, Chalice)\",\010        Min = 5, Max = 60, Default = math.clamp(tonumber(Config.FullChestCount) or 20, 5, 60), Rounding = 0 })\010        :OnChanged(function(v) Config.FullChestCount = v; persist() end)\010\010    -- ---------------------------------------------------------------------- racas ----\010    T:AddSection(\"Races\")\010    local sGhoul = T:AddStatus({ Title = \"Ghoul Progress\", Content = \"Checking...\", Height = 58 })\010    tg(\"RaceGhoul\", \"Auto Fully Ghoul\", \"Ectoplasm > Cursed Captain > Hellfire Torch > buys Ghoul\")\010    tg(\"RaceGhoulHop\", \"Ghoul: Server Hop\", \"Sea 2 only: hops (Auto Bounty system) when there are no ship mobs. Captain server: Quantum API\")\010    local sCyborg = T:AddStatus({ Title = \"Cyborg Progress\", Content = \"Checking...\", Height = 58 })\010    tg(\"RaceCyborg\", \"Auto Fully Cyborg\", \"20 chests on every Sea 2 island > Fist of Darkness > Law raid > Core Brain > buys\")\010    tg(\"RaceCyborgHop\", \"Cyborg: Chest Server Hop\", \"Hops to servers with 4h+ uptime (more chests) and keeps hopping on empty chests, until the Fist of Darkness drops\")\010    T:AddSubSection(\"Upgrades\")\010    tg(\"RaceV2\", \"Auto Upgrade Race V2\", \"Alchemist quest: 3 flowers (night), needs 500k Beli. Sea 2\")\010    tg(\"RaceV3\", \"Auto Upgrade Race V3\", \"Wenlocktoad quest (level 1000, 2M Beli)\")\010    tg(\"RaceLever\", \"Auto Fully V4 (Pull Lever)\", \"Finds the Blue Gear on Mirage, opens the temple,