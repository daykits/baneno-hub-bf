        DV.src.chest = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, State, currentTween, findToolByName, flyTo, getChar = __E.Config, __E.State, __E.currentTween, __E.findToolByName, __E.flyTo, __E.getChar;\010AFL.Chest = { n = 0, bl = setmetatable({}, { __mode = \"k\" }), cur = nil, since = 0, noneSince = nil, tour = nil, tourI = 1, tourAt = 0, dwell = nil, restUntil = 0 }\010function AFL.chestList()\010    local out, seen = {}, {}\010    local function add(inst)\010        if seen[inst] or (AFL.Chest.bl[inst] or 0) > os.clock() then return end\010        local part = inst:IsA(\"BasePart\") and inst or (inst:IsA(\"Model\") and (inst.PrimaryPart or inst:FindFirstChildWhichIsA(\"BasePart\", true)))\010        if part and part:IsDescendantOf(workspace) then\010            seen[inst] = true\010            out[#out + 1] = { inst = inst, part = part }\010        end\010    end\010    pcall(function()\010        for _, c in ipairs(game:GetService(\"CollectionService\"):GetTagged(\"_ChestTagged\")) do add(c) end\010    end)\010    local folder = workspace:FindFirstChild(\"ChestModels\")\010    if folder then\010        for _, c in ipairs(folder:GetChildren()) do add(c) end\010    end\010    pcall(function()\010        for _, c in ipairs(workspace:GetChildren()) do\010            if string.match(c.Name, \"^Chest%d\") then add(c) end\010        end\010    end)\010    return out\010end\010-- Island tour: chests only exist near the player, so with none loaded he flies over every island of the map\010function AFL.chestTourBuild(from)\010    local list = {}\010    local map = workspace:FindFirstChild(\"Map\")\010    if map then\010        for _, m in ipairs(map:GetChildren()) do\010            if m:IsA(\"Model\") then\010                local ok, sz = pcall(function() return m:GetExtentsSize() end)\010                if ok and sz.Magnitude > 150 then\010                    local ok2, cf = pcall(function() return m:GetPivot() end)\010                    if ok2 then list[#list + 1] = cf.Position end\010                end\010            end\010        end\010    end\010    local out, cur = {}, from\010    while #list > 0 do\010        local bi, bd = 1, math.huge\010        for i, p in ipairs(list) do\010            local d = (p - cur).Magnitude\010            if d < bd then bi, bd = i, d end\010        end\010        cur = table.remove(list, bi)\010        out[#out + 1] = cur\010    end\010    return out\010end\010-- opts (v24, usado pelo Auto Fully): { hop = bool, count = n } troca as opcoes Chest Hop / Chest Count so nesta chamada\010function AFL.chestStep(opts)\010    local C = AFL.Chest\010    local _, hrp = getChar()\010    if not hrp then return false end\010    local hop, count = Config.ChestHop, Config.ChestCount or 10\010    if type(opts) == \"table\" then\010        if opts.hop ~= nil then hop = opts.hop and true or false end\010        if opts.count then count = tonumber(opts.count) or count end\010    end\010    -- reached the chosen amount: stop collecting and (with Chest Hop) change server\010    if hop and C.n >= count then\010        State.Mode, State.Text = \"Auto Farm Chest\", string.format(\"%d/%d chests: changing server\", C.n, count)\010        AFL.hopRequest(\"chests collected (\" .. C.n .. \")\", function() return findToolByName and findToolByName(\"fist of darkness\") ~= nil end)\010        return false\010    end\010    if C.cur then\010        local gone = (not C.cur.inst.Parent) or (not C.cur.part.Parent) or (not C.cur.part:IsDescendantOf(workspace))\010        if gone then\010            C.n += 1\010            C.cur = nil\010        elseif C.touchAt and os.clock() - C.touchAt > 1.2 then\010            C.n += 1\010            C.bl[C.cur.inst] = os.clock() + 600\010            C.cur = nil\010        elseif os.clock() - C.since > 25 then\010            C.bl[C.cur.inst] = os.clock() + 120\010            C.cur = nil\010        end\010    end\010    if not C.cur then\010        C.touchAt = nil\010        local best, bd = nil, math.huge\010        for _, ch in ipairs(AFL.chestList()) do\010            local d = (ch.part.Position - hrp.Position).Magnitude\010            if d < bd then best, bd = ch, d end\010        end\010        if best then\010            C.cur, C.since, C.noneSince, C.dwell = best, os.clock(), nil, nil\010        else\010            -- no chest loaded: visit the islands one by one (hover above each for a moment so its chests load)\010            if os.clock() >= C.restUntil then\010                if not C.tour then C.tour, C.tourI, C.tourAt, C.dwell = AFL.chestTourBuild(hrp.Position), 1, os.clock(), nil end\010                local tgt = C.tour[C.tourI]\010                if tgt then\010                    C.noneSince = nil\010                    State.Mode = \"Auto Farm Chest\"\010                    State.Text = string.format(\"Searching chests: island %d/%d (%d collected)\", C.tourI, #C.tour, C.n)\010                    local goal = tgt + Vector3.new(0, 90, 0)\010                    if (hrp.Position - goal).Magnitude > 60 and os.clock() - C.tourAt < 40 then\010                        flyTo(CFrame.new(goal))\010                        return true\010                    end\010                    C.dwell = C.dwell or (os.clock() + 1.5)\010                    if os.clock() < C.dwell then return true end\010                    C.tourI, C.tourAt, C.dwell = C.tourI + 1, os.clock(), nil\010                    return true\010                end\010                C.tour, C.restUntil = nil, os.clock() + 30 -- tour finished: rest 30s before the next one\010            end\010            C.noneSince = C.noneSince or os.clock()\010            State.Mode, State.Text = \"Auto Farm Chest\", \"no chests left (\" .. C.n .. \" collected)\"\010            if hop and os.clock() - C.noneSince > 60 then AFL.hopRequest(\"no chests in this server\") end\010            return false\010        end\010    end\010    State.Mode = \"Auto Farm Chest\"\010    State.Text = string.format(\"Collecting chest (%d collected%s)\", C.n, hop and (\"/\" .. tostring(count)) or \"\")\010    local part = C.cur.part\010    if (hrp.Position - part.Position).Magnitude > 12 then\010        C.touchAt = nil\010        flyTo(part.CFrame)\010    else\010        if currentTween then currentTween:Cancel() end\010        pcall(function()\010            hrp.CFrame = part.CFrame\010            hrp.AssemblyLinearVelocity = Vector3.zero\010            if firetouchinterest then\010                firetouchinterest(hrp, part, 0)\010                firetouchinterest(hrp, part, 1)\010            end\010        end)\010        C.touchAt = C.touchAt or os.clock()\010    end\010    return true\010end\010\010\010\010\010";
        end;
        DV.src.stack = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Diag, EliteNames, EliteS, Fluent, State, Tabs = __E.Config, __E.Diag, __E.EliteNames, __E.EliteS, __E.Fluent, __E.State, __E.Tabs\010local Window, activeQuestTitle, aliveParts, distanceTo, enemiesList, fightEnemy, findEnemy = __E.Window, __E.activeQuestTitle, __E.aliveParts, __E.distanceTo, __E.enemiesList, __E.fightEnemy, __E.findEnemy\010local flyTo, getChar, getSea, invoke, isEliteTitle, persist, questVisible = __E.flyTo, __E.getChar, __E.getSea, __E.invoke, __E.isEliteTitle, __E.persist, __E.questVisible\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local E = __E;\010-- ============ STACK FARM: Pirate Raid (Mar 3), Elite Hunter (Mar 3), Factory (Mar 2) ============\010-- Mobs dos Mares 1 e 2 (nomes exatos) - no Mar 3 so aparecem durante o Pirate Raid. Lidos da tabela do Level Farm do Premium.\010local RaidSet = {}\010do\010    local D = E.LV and E.LV.DATA or {}\010    local sea3 = {}\010    for _, q in ipairs(D[3] or {}) do sea3[q.mob] = true end\010    for _, sea in ipairs({ 1, 2 }) do\010        for _, q in ipairs(D[sea] or {}) do\010            if not sea3[q.mob] then RaidSet[q.mob] = true end\010        end\010    end\010end\010-- v28: anti-fantasma comum aos 3 farms do Stack - se o alvo nao perde vida por 15s (preso/rede), ignora por 45s e troca\010-- (antes de so ir matar quando spawnar, as vezes ficava \"preso\" no mesmo mob que nao morria)\010local StackBad = setmetatable({}, { __mode = \"k\" })\010local StackTrack = nil\010local function stackHp(m)\010    local h = m:FindFirstChildOfClass(\"Humanoid\")\010    return h and h.Health\010end\010local function stackStall(target)\010    local now = os.clock()\010    local hp = stackHp(target)\010    local tr = StackTrack\010    if not tr or tr.m ~= target then tr = { m = target, hp = hp, since = now }; StackTrack = tr end\010    if hp and tr.hp and hp < tr.hp - 0.01 then tr.hp, tr.since = hp, now\010    elseif hp and (not tr.hp or hp > tr.hp) then tr.hp = hp end\010    if now - tr.since > 15 then\010        StackBad[target] = now + 45\010        StackTrack = nil\010        return true\010    end\010    return false\010end\010-- ============ STACK FARM (sempre na frente do Normal Farm) ============\010-- Mar 3: Pirate Raid - mobs dos Mares 1/2 aparecem perto do Castle on the Sea (a cada ~1h15)\010local PR = { lastSeen = 0, lastProbe = 0, probeUntil = 0 }\010local PIRATE_POINT = CFrame.new(-5539, 313, -2972) -- Castle on the Sea (posi\195\167\195\163o aproximada)\010-- v100: pedido do usuario - o NPC \"Tank\" (dropa fruta) tem prioridade de morte sobre qualquer outro mob da raid,\010-- mesmo que esteja mais longe. Ele NAO entra no RaidSet (que so cobre os mobs normais dos Mares 1/2 usados nas\010-- quests do Level Farm) - por isso o match e por nome (contem \"tank\", sem diferenciar maiusculas), igual outras\010-- listas de nome parcial do script (BEAST etc), e tratado como alvo valido por fora do filtro RaidSet.\010local function isTankMob(name)\010    return type(name) == \"string\" and string.find(string.lower(name), \"tank\", 1, true) ~= nil\010end\010local function pirateRaidStep()\010    local _, hrp = getChar()\010    if not hrp then return false end\010    local tankOn = Config.PirateTankPriority ~= false\010    local best, bestDist, bestIsTank = nil, math.huge, false\010    for _, e in ipairs(enemiesList()) do\010        local isTank = tankOn and isTankMob(e.Name)\010        if (isTank or RaidSet[e.Name]) and not ((StackBad[e] or 0) > os.clock()) then\010            local eh, er = aliveParts(e)\010            if eh then\010                local d = (hrp.Position - er.Position).Magnitude\010                if isTank and not bestIsTank then\010                    best, bestDist, bestIsTank = e, d, true           -- primeiro Tank visto: assume na hora, mesmo que mais longe\010                elseif isTank == bestIsTank and d < bestDist then\010                    best, bestDist = e, d                              -- mesma \"classe\" (os dois Tank ou os dois normais): o mais perto\010                end\010            end\010        end\010    end\010    local now = os.clock()\010    if best then\010        PR.lastSeen = now\010        if stackStall(best) then return true end\010        State.Mode = \"Auto Pirate Raid\"\010        State.Text = (bestIsTank and \"Killing TANK (fruit drop) \" or \"Killing \") .. best.Name\010        fightEnemy(best, { best.Name }, true)\010        return true\010    end\010    -- v61 fix: \"esperando a proxima onda\" e \"indo olhar o castelo\" devolviam true mesmo sem nenhum mob pra matar -\010    -- isso \"travava\" a prioridade (nada de prioridade mais baixa rodava enquanto o Pirate Raid so ficava parado\010    -- esperando). Agora so devolve true quando REALMENTE tem o que fazer (matando ou de fato indo pra uma raid que\010    -- ja comecou); esperar/checar o castelo continua rodando em segundo plano mas deixa o resto da prioridade livre.\010    -- Os mobs da raid s\195\179 carregam perto do Castle on the Sea. Entre uma onda e outra, fica por l\195\161.\010    if now - PR.lastSeen < 25 then\010        State.Mode, State.Text = \"Auto Pirate Raid\", \"Waiting for the next wave\"\010        if distanceTo(PIRATE_POINT) > 150 then flyTo(PIRATE_POINT * CFrame.new(0, 40, 0)) end\010        return false\010    end\010    -- v100: pedido do usuario - \"se ele tiver longe do castelo ele vai voando ate la pra fazer a raid pirata\".\010    -- Antes, com \"Events Only When They Spawn\" ligado (Farm Settings - vem ligado por padrao), o Pirate Raid NUNCA\010    -- ia olhar o castelo (so matava se um mob da raid ja estivesse carregado por acaso perto de voce) - o castelo e\010    -- um unico ponto fixo onde a raid inteira acontece, bem diferente de \"rodar o mapa atras de fruta\" (que e o que\010    -- esse toggle foi feito pra evitar), entao o Pirate Raid passa a ignorar esse toggle e sempre ir conferir.\010    -- Sem raid \195\160 vista: a cada 90s vai ao Castle olhar se ela come\195\167ou (tempo da viagem + 6s)\010    if now >= PR.probeUntil and now - PR.lastProbe > 90 then\010        PR.lastProbe = now\010        PR.probeUntil = now + distanceTo(PIRATE_POINT) / math.max(Config.TweenSpeed, 50) + 6\010    end\010    if now < PR.probeUntil then\010        State.Mode, State.Text = \"Auto Pirate Raid\", \"Flying to the Castle on the Sea\"\010        flyTo(PIRATE_POINT * CFrame.new(0, 40, 0))\010        return false\010    end\010    return false\010end\010\010-- Mar 3: Elite Hunter - pega a quest e mata o Deandre / Urban / Diablo\010local EliteAsk = 0\010-- NPC Elite Hunter (procura no workspace.NPCs; sen\195\163o usa a posi\195\167\195\163o conhecida perto do Castle on the Sea)\010local function eliteNpcCF()\010    local npcs = workspace:FindFirstChild(\"NPCs\")\010    local m = npcs and npcs:FindFirstChild(\"Elite Hunter\")\010    local part = m and (m:FindFirstChild(\"HumanoidRootPart\") or m.PrimaryPart or m:FindFirstChildWhichIsA(\"BasePart\"))\010    return part and part.CFrame or CFrame.new(-5418, 314, -2825)\010end\010local function eliteStep(askQuest)\010    local boss = findEnemy(EliteNames)\010    if boss and not ((StackBad[boss] or 0) > os.clock()) then\010        if stackStall(boss) then return true end\010        State.Mode = \"Auto Elite Hunter\"\010        State.Text = \"Killing \" .. boss.Name\010        fightEnemy(boss, EliteNames, false)\010        return true\010    end\010    -- o elite ainda n\195\163o carregou: o modelo fica em ReplicatedStorage, voa at\195\169 a posi\195\167\195\163o dele\010    for _, n in ipairs(EliteNames) do\010        local m = ReplicatedStorage:FindFirstChild(n)\010        local part = m and (m:FindFirstChild(\"HumanoidRootPart\") or m.PrimaryPart)\010        if part then\010            State.Mode = \"Auto Elite Hunter\"\010            State.Text = \"Going to \" .. n\010            flyTo(part.CFrame * CFrame.new(0, 20, 0))\010            return true\010        end\010    end\010    -- sem elite ativo: vai at\195\169 o NPC Elite Hunter e pede a quest (s\195\179 se \"Auto Quest Elite Hunter\" estiver ligado)\010    if askQuest and os.clock() >= EliteS.pauseUntil then\010        local visible, known = questVisible()\010        local hasEliteQuest = known and visible and isEliteTitle(activeQuestTitle())\010        if not hasEliteQuest then\010            local cf = eliteNpcCF()\010            if distanceTo(cf) > 25 then\010                if EliteS.travelSince == 0 then EliteS.travelSince = os.clock() end\010                if os.clock() - EliteS.travelSince > 45 then\010                    EliteS.travelSince, EliteS.pauseUntil = 0, os.clock() + 60\010                    Diag.elite = \"trip to the Elite Hunter took too long; trying again in 60s\"\010                    return false\010                end\010                State.Mode, State.Text = \"Auto Elite Hunter\", \"Going to the Elite Hunter NPC\"\010                flyTo(cf * CFrame.new(0, 3, 4))\010                return true\010            end\010            EliteS.travelSince = 0\010            State.Mode, State.Text = \"Auto Elite Hunter\", \"Asking the Elite Hunter for the quest\"\010            if os.clock() - EliteAsk > 12 then\010                EliteAsk = os.clock()\010                if known and visible then -- tem outra quest ativa: abandona antes\010                    invoke(\"AbandonQuest\")\010                    task.wait(0.4)\010                end\010                local ok, r = invoke(\"EliteHunter\")\010                Diag.elite = (ok and \"EliteHunter -> \" or \"error -> \") .. tostring(r)\010                local low = string.lower(tostring(r))\010                if string.find(low, \"later\", 1, true) or string.find(low, \"don't have\", 1, true)\010                    or string.find(low, \"come back\", 1, true) then\010                    EliteS.pauseUntil = os.clock() + 120 -- sem elite dispon\195\173vel agora: volta ao farm e tenta depois\010                    EliteS.unavailAt = EliteS.unavailAt or os.clock()\010                    local mins, secs = tonumber(string.match(low, \"(%d+)%s*min\")), tonumber(string.match(low, \"(%d+)%s*sec\"))\010                    local mm, ss = string.match(low, \"(%d+):(%d+)\")\010                    EliteS.remain = mins and (mins * 60 + (secs or 0)) or (mm and (tonumber(mm) * 60 + tonumber(ss))) or secs\010                    return false\010                else\010                    -- v46: o texto da resposta varia; confere se a quest abriu mesmo. Se nao abriu e nao ha Elite, nao tem Elite agora\010                    task.wait(1.2)\010                    local v2, k2 = questVisible()\010                    local got = (k2 and v2 and isEliteTitle(activeQuestTitle())) or findEnemy(EliteNames) ~= nil\010                    if got then\010                        EliteS.unavailAt, EliteS.remain = nil, nil\010                    else\010                        EliteS.pauseUntil = os.clock() + 120\010                        EliteS.unavailAt = EliteS.unavailAt or os.clock()\010                        EliteS.remain = EliteS.remain\010                        return false\010                    end\010                end\010            end\010            return true\010        end\010    end\010    return false\010end\010\010-- Mar 2: Factory Raid - o boss \"Core\" aparece na Factory a cada ~1h30 (5 min para matar)\010local function factoryStep()\010    local core = findEnemy({ \"Core\" })\010    if core and (StackBad[core] or 0) > os.clock() then core = nil end\010    if not core then\010        local cm = ReplicatedStorage:FindFirstChild(\"Core\")\010        local chrp = cm and cm:FindFirstChild(\"HumanoidRootPart\")\010        local chum = cm and cm:FindFirstChildOfClass(\"Humanoid\")\010        if chrp and chum and chum.Health > 0 then\010            State.Mode, State.Text = \"Auto Factory\", \"Going to the Core\"\010            flyTo(chrp.CFrame * CFrame.new(0, 20, 0))\010            return true\010        end\010        return false\010    end\010    if stackStall(core) then return true end\010    State.Mode = \"Auto Factory\"\010    State.Text = \"Killing the Core\"\010    fightEnemy(core, { \"Core\" }, false)\010    return true\010end\010AFL.pirateRaidStep, AFL.eliteStep, AFL.factoryStep = pirateRaidStep, eliteStep, factoryStep\010\010do\010    local function sub(tab, text)\010        local seen = {}\010        local scanRoot = tab.Container or Window.Root\010        for _, d in ipairs(scanRoot:GetDescendants()) do\010            if d:IsA(\"TextLabel\") then seen[d] = true end\010        end\010        pcall(function() tab:AddSection(text) end)\010        for _, d in ipairs(scanRoot:GetDescendants()) do\010            if d:IsA(\"TextLabel\") and not seen[d] and d.Text == text then\010                pcall(function() d.TextSize = 12; d.TextTransparency = 0.15 end)\010                break\010            end\010        end\010    end\010    local function seaToggle(tab, id, title, key, sea, desc)\010        local t = tab:AddToggle(id, { Title = title, Description = desc, Default = Config[key] and true or false })\010        t:OnChanged(function(v)\010            if v and sea and getSea() ~= sea then\010                Fluent:Notify({ Title = \"Moon Decompiled Hub\", Content = title .. \" only works in Sea \" .. sea .. \".\", Duration = 5 })\010                t:SetValue(false)\010                return\010            end\010            Config[key] = v\010            persist()\010        end)\010    end\010    Tabs.Stack:AddSection(\"Stack Farm\")\010    sub(Tabs.Stack, \"Third Sea\")\010    seaToggle(Tabs.Stack, \"PirateRaid\", \"Auto Pirate Raid\", \"PirateRaid\", 3)\010    do\010        local t = Tabs.Stack:AddToggle(\"PirateTankPriority\", { Title = \"TANK Priority Kill\", Description = \"When the TANK npc (fruit drop) shows up, kill it first - even if farther than other raid mobs\", Default = Config.PirateTankPriority ~= false })\010        t:OnChanged(function(v) Config.PirateTankPriority = v; persist() end)\010    end\010    sub(Tabs.Stack, \"Second Sea\")\010    seaToggle(Tabs.Stack, \"Factory\", \"Auto Factory\", \"Factory\", 2)\010    sub(Tabs.Stack, \"Elite Hunter\")\010    seaToggle(Tabs.Stack, \"Elite\", \"Auto Elite Hunter\", \"Elite\", 3, \"Takes the Elite Hunter mission at the Castle on the Sea and kills the Elite\")\010    seaToggle(Tabs.Stack, \"EliteHop\", \"Auto Farm Elite Hunter Server Hop\", \"EliteHop\", 3,\010        \"Only works with Auto Elite Hunter on. Changes server when the Elite has not spawned (does not change if 2 min or less are left for it to spawn, nor before killing). Shows Hop in 10 seconds in red.\")\010    sub(Tabs.Stack, \"Chest\")\010    seaToggle(Tabs.Stack, \"ChestFarm\", \"Auto Farm Chest\", \"ChestFarm\", nil, \"Flies to the map chests and collects them one by one\")\010    seaToggle(Tabs.Stack, \"ChestHop\", \"Auto Farm Chest Hop\", \"ChestHop\", nil,\010        \"Changes server only after collecting the number of chests chosen below (shows Hop in 10 seconds in red)\")\010    Tabs.Stack:AddSlider(\"ChestCount\", {\010        Title = \"How many chests to collect\", Description = \"Exact number of chests per server before the hop\",\010        Min = 1, Max = 100, Default = math.clamp(tonumber(Config.ChestCount) or 10, 1, 100), Rounding = 0,\010        Callback = function(v) Config.ChestCount = v; persist() end,\010    })\010end\010\010\010\010";
        end;
        DV.src.subfarm = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Connections, Diag, Fluent, Player, State, Tabs = __E.Config, __E.Connections, __E.Diag, __E.Fluent, __E.Player, __E.State, __E.Tabs\010local Window, aliveParts, enemiesList, fightEnemy, findEnemy, findSpawn, flyTo = __E.Window, __E.aliveParts, __E.enemiesList, __E.fightEnemy, __E.findEnemy, __E.findSpawn, __E.flyTo\010local getChar, getSea, invoke, matchName, persist, questVisible = __E.getChar, __E.getSea, __E.invoke, __E.matchName, __E.persist, __E.questVisible\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local eliteStep = AFL.eliteStep\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ---------- Sub Farm: Unlock Melees / Swords (CDK, TTK) ----------\010-- Remotes e fluxos tirados dos hubs de referencia (QuantumOnyx): Buy<Nome sem espacos> no CommF_, BlackbeardReward (Dragon Claw),\010-- LegendarySwordDealer 1/2, CDKQuest, TushitaProgress, EliteHunter Progress. Nada disto foi testado no jogo.\010(function()\010    local T = Tabs.SubFarm\010    local RS = ReplicatedStorage\010    local V3 = Vector3.new\010    local SF = { status = \"idle\", at = {}, fail = {}, cool = {} }\010    AFL.Sub = SF\010    local function d(k, v) if Config[k] == nil then Config[k] = v end end\010    for _, k in ipairs({ \"SubGod\", \"SubC2\", \"SubV2\", \"SubTTK\", \"SubDT\", \"SubBL\", \"SubEl\", \"SubFK\", \"SubDC\", \"SubDS\", \"SubSK\", \"SubEC\", \"SubSan\",\010        \"SubYama\", \"SubTushita\", \"SubCDK\", \"SubLegSword\", \"SubLegHop\", \"SubFullTTK\", \"SubSea2\", \"SubSea3\" }) do d(k, false) end\010    d(\"SubTravel\", true)\010\010    -- ---------- helpers ----------\010    local function every(key, sec)\010        if os.clock() - (SF.at[key] or 0) < sec then return false end\010        SF.at[key] = os.clock()\010        return true\010    end\010    local function note(txt) SF.status = txt; Diag.sub = txt end\010    local function set(txt)\010        SF.status = txt; Diag.sub = txt\010        State.Mode, State.Text = \"Auto Sub Farm\", txt\010    end\010    local ALIAS = { [\"Dragon Claw\"] = \"Dragon Breath\" } -- o estilo mudou de nome no jogo\010    local function tool(name)\010        for _, c in ipairs({ Player.Character, Player.Backpack }) do\010            local t = c and (c:FindFirstChild(name) or (ALIAS[name] and c:FindFirstChild(ALIAS[name])))\010            if t and t:IsA(\"Tool\") then return t end\010        end\010    end\010    local function lvl(name)\010        local t = tool(name)\010        local l = t and t:FindFirstChild(\"Level\")\010        return l and tonumber(l.Value) or 0\010    end\010    local function owns(name)\010        if tool(name) then return true end\010        local ok, n = pcall(function() return AFL.Inv.count(name) + (ALIAS[name] and AFL.Inv.count(ALIAS[name]) or 0) end)\010        return ok and (tonumber(n) or 0) > 0\010    end\010    local function loadItem(name)\010        if owns(name) and not tool(name) and every(\"load\" .. name, 3) then invoke(\"LoadItem\", name) end\010        return tool(name)\010    end\010    local function findNpc(pats)\010        for _, root in ipairs({ workspace:FindFirstChild(\"NPCs\"), RS:FindFirstChild(\"NPCs\") }) do\010            for _, n in ipairs(root and root:GetChildren() or {}) do\010                local low = string.lower(n.Name)\010                for _, p in ipairs(pats) do\010                    if string.find(low, p, 1, true) then\010                        local ok, cf = pcall(function() return n:GetPivot() end)\010                        if ok and cf and cf.Position.Magnitude > 5 then return cf end\010                    end\010                end\010            end\010        end\010    end\010    local function goTo(cf, r, label)\010        local _, hrp = getChar()\010        if not hrp then return false end\010        if (hrp.Position - cf.Position).Magnitude <= (r or 10) then return true end\010        set(\"Flying to \" .. label)\010        flyTo(cf * CFrame.new(0, 3, 0))\010        return false\010    end\010\010    -- viagem entre mares. Retorna (errado, ocupado): se errado, o passo deve devolver \"ocupado\"\010    local SEACMD = { \"TravelMain\", \"TravelDressrosa\", \"TravelZou\" }\010    local function wrongSea(seas)\010        local want = type(seas) == \"table\" and seas or { seas }\010        local cur = getSea()\010        for _, s in ipairs(want) do if s == cur then return false end end\010        local target = want[1]\010        if not Config.SubTravel then note(\"Go to Sea \" .. target .. \" (Auto travel between seas is off)\"); return true, false end\010        if (SF.cool.travel or 0) > os.clock() then note(\"Sea travel to \" .. target .. \" failed repeatedly - paused\"); return true, false end\010        if every(\"travel\", 25) then\010            SF.travelN = (SF.travelN or 0) + 1\010            if SF.travelN > 4 then SF.travelN, SF.cool.travel = 0, os.clock() + 300; return true, false end\010            invoke(SEACMD[target])\010        end\010        set(\"Travelling to Sea \" .. target)\010        return true, true\010    end\010    table.insert(Connections, Player.CharacterAdded:Connect(function() SF.travelN = 0 end))\010\010    -- ---------- treino de mastery ----------\010    local MOBS = {\010        [\"Black Leg\"] = { \"Arctic Warrior\", \"Snow Lurker\" }, [\"Death Step\"] = { \"Arctic Warrior\", \"Snow Lurker\" }, [\"Superhuman\"] = { \"Arctic Warrior\", \"Snow Lurker\" },\010        [\"Fishman Karate\"] = { \"Water Fighter\" }, [\"Sharkman Karate\"] = { \"Water Fighter\" },\010        [\"Electro\"] = { \"Fishman Raider\" }, [\"Electric Claw\"] = { \"Fishman Raider\" },\010        [\"Dragon Claw\"] = { \"Reborn Skeleton\" }, [\"Dragon Talon\"] = { \"Reborn Skeleton\" },\010    }\010    local function nearestAny()\010        local _, hrp = getChar()\010        if not hrp then return end\010        local best, bd\010        for _, e in ipairs(enemiesList()) do\010            local eh, er = aliveParts(e)\010            if eh and not matchName(e.Name, Config.KillAllSkip or {}) then\010                local dd = (er.Position - hrp.Position).Magnitude\010                if not bd or dd < bd then best, bd = e, dd end\010            end\010        end\010        return best\010    end\010    local function anySpawn()\010        local _, hrp = getChar()\010        if not hrp then return end\010        local origin = workspace:FindFirstChild(\"_WorldOrigin\")\010        local folders = {}\010        if origin and origin:FindFirstChild(\"EnemySpawns\") then folders[#folders + 1] = origin.EnemySpawns end\010        if workspace:FindFirstChild(\"EnemySpawns\") then folders[#folders + 1] = workspace.EnemySpawns end\010        local best, bd\010        for _, f in ipairs(folders) do\010            for _, sp in ipairs(f:GetChildren()) do\010                if sp:IsA(\"BasePart\") then\010                    local dd = (sp.Position - hrp.Position).Magnitude\010                    if not bd or dd < bd then best, bd = sp, dd end\010                end\010            end\010        end\010        return best\010    end\010    -- v77: STY/def precisam existir ANTES de train() pra ele conseguir checar o mar certo de cada estilo (ver\010    -- comentario completo dentro de train() abaixo) - movido pra cima do que estava antes (depois de train()).\010    local STY = {}\010    local function def(s) STY[s.tool] = s; return s end\010\010    -- bate em mobs com o item escolhido ate chegar na mastery. Retorna true enquanto estiver treinando\010    local function train(name, target)\010        local l = lvl(name)\010        if l >= target then return false end\010        -- v77 fix: \"Auto Combate V2\" (Auto Superhuman e as outras masteries em cadeia: Godhuman, Dragon Talon,\010        -- Death Step, Sharkman Karate) so ficava dando TP entre os mares sem nunca treinar de fato. A causa: esse\010        -- train() nunca checava se o mar atual tinha os mobs certos pra aquele estilo - se o personagem estava no\010        -- mar errado, findEnemy/findSpawn nao achavam nada e a funcao caia no \"No mobs found to train\" devolvendo\010        -- FALSE, exatamente o MESMO valor que devolve quando a mastery ja esta completa (l >= target). O ensure()\010        -- la em cima nao sabe diferenciar os dois casos e trata \"sem mobs aqui\" como \"treino concluido\", entao\010        -- segue direto pra COMPRAR o proximo estilo/mar, que te leva pra outro mar sem mob certo de novo - um ciclo\010        -- infinito de compra+viagem sem nenhum treino real. Agora: antes de procurar mob, viaja pro mar certo do\010        -- estilo (STY[name].seas, o mesmo mar onde ele e comprado/usado) quando o auto-travel estiver ligado, igual\010        -- farmMat() ja faz pros materiais - so procura/luta mob depois de estar no mar certo.\010        local sty = STY[name]\010        if sty and sty.seas then\010            local w, b = wrongSea(sty.seas)\010            if w then return b end\010        end\010        local tl = tool(name)\010        Config.ForceTool, Config.ForceUntil = string.lower(tl and tl.Name or name), os.clock() + 3\010        set(string.format(\"Training %s mastery %d/%d\", name, l, target))\010        local mobs = MOBS[name]\010        local e = (mobs and findEnemy(mobs)) or nearestAny()\010        if e then fightEnemy(e, { e.Name }, true); return true end\010        local sp = (mobs and findSpawn(mobs)) or anySpawn()\010        if sp then flyTo(sp.CFrame * CFrame.new(0, 25, 0)); return true end\010        note(\"No mobs found to train \" .. name)\010        return false\010    end\010    -- fisica de materiais de quest\010    local function farmMat(m)\010        local have = 0\010        pcall(function() have = AFL.Inv.count(m.name) end)\010        if have >= m.n then return false end\010        if m.manual then note(\"Missing \" .. m.name .. \": beat the Leviathan in Sea Events (it drops it)\"); return false end\010        local w, b = wrongSea(m.seas)\010        if w then return b end\010        set(string.format(\"Farming %s %d/%d\", m.name, have, m.n))\010        local e = findEnemy(m.mobs)\010        if e then fightEnemy(e, m.mobs, true); return true end\010        local sp = findSpawn(m.mobs)\010        if sp then flyTo(sp.CFrame * CFrame.new(0, 25, 0)); return true end\010        note(\"No \" .. m.mobs[1] .. \" found for \" .. m.name)\010        return false\010    end\010\010    -- ---------- melees ----------\010    -- (STY/def agora declarados mais acima, antes de train() - v77)\010\010    -- Death Step: porta da biblioteca fechada => precisa da Library Key (Awakened Ice Admiral)\010    local function dsExtra()\010        local ok, door = pcall(function() return workspace.Map.IceCastle.Hall.LibraryDoor.PhoeyuDoor end)\010        if ok and door and door.Transparency == 0 and not tool(\"Library Key\") then\010            local e = findEnemy({ \"Awakened Ice Admiral\" })\010            if e then set(\"Death Step: fighting the Awakened Ice Admiral (Library Key)\"); fightEnemy(e, { e.Name }, false); return \"busy\" end\010            set(\"Death Step: waiting at the Ice Castle for the Awakened Ice Admiral\")\010            flyTo(CFrame.new(5669, 29, -6483))\010            return \"busy\"\010        end\010    end\010    -- Sharkman: a propria compra responde \"keys\" quando falta a Water Key (Tide Keeper)\010    local function skKeyStep()\010        if not SF.sharkKey then return end\010        if tool(\"Water Key\") then\010            if goTo(CFrame.new(-2605, 239, -10315), 8, \"the Water Key door\") and every(\"sharkdoor\", 3) then invoke(\"BuySharkmanKarate\") end\010            return \"busy\"\010        end\010        local e = findEnemy({ \"Tide Keeper\" })\010        if e then set(\"Sharkman: fighting the Tide Keeper (Water Key)\"); fightEnemy(e, { e.Name }, false); return \"busy\" end\010        set(\"Sharkman: going to the Tide Keeper\")\010        flyTo(CFrame.new(-3054, 237, -10145))\010        return \"busy\"\010    end\010    -- Dragon Talon: Fire Essence vem da recompensa de Bones\010    local function dtExtra()\010        if tool(\"Fire Essence\") then return end\010        local dk = findNpc({ \"death king\" })\010        if dk and not goTo(dk, 12, \"the Death King\") then return \"busy\" end\010        if every(\"bones\", 3) then invoke(\"Bones\", \"Buy\", 1, 1) end\010        note(\"Dragon Talon: spending Bones at the Death King until a Fire Essence drops (50 Bones per try) - farm Bones\")\010        return \"block\"\010    end\010\010    local function skExtra()\010        if every(\"shark\", 3) then\010            local _, r = invoke(\"BuySharkmanKarate\")\010            SF.sharkKey = type(r) == \"string\" and string.find(r, \"keys\", 1, true) ~= nil\010        end\010        return skKeyStep()\010    end\010\010    -- Electric Claw: Previous Hero manda correr ate a Mansion em menos de 30s\010    local function ecExtra()\010        local run = SF.ecRun\010        if run and os.clock() - run < 40 then\010            if goTo(CFrame.new(-12468, 376, -7536), 14, \"the Mansion (timed run)\") then\010                if every(\"ecbuy\", 1.5) then\010                    local _, r = invoke(\"BuyElectricClaw\")\010                    note(\"Electric Claw: run finished -> \" .. tostring(r))\010                    SF.ecRun = nil\010                end\010            end\010            return \"busy\"\010        end\010    end\010\010    local BL = def({ tool = \"Black Leg\", label = \"Black Leg\", npc = { \"dark step\" }, seas = { 1, 2 }, buy = { { \"BuyBlackLeg\" } } })\010    local EL = def({ tool = \"Electro\", label = \"Electro\", npc = { \"mad scientist\" }, seas = { 1, 2 }, buy = { { \"BuyElectro\" } } })\010    local FK = def({ tool = \"Fishman Karate\", label = \"Fishman Karate\", npc = { \"water kung\" }, seas = { 1, 2 }, buy = { { \"BuyFishmanKarate\" } } })\010    local DC = def({ tool = \"Dragon Claw\", label = \"Dragon Breath\", npc = { \"sabi\" }, noNpc = true, seas = { 2 }, buy = { { \"BlackbeardReward\", \"DragonClaw\", \"1\" }, { \"BlackbeardReward\", \"DragonClaw\", \"2\" } } })\010    local SUP = def({ tool = \"Superhuman\", label = \"Superhuman\", npc = { \"martial arts\" }, seas = { 1, 2 }, buy = { { \"BuySuperhuman\" } },\010        pre = { { \"Black Leg\", 300 }, { \"Electro\", 300 }, { \"Fishman Karate\", 300 }, { \"Dragon Claw\", 300 } } })\010    local DS = def({ tool = \"Death Step\", label = \"Death Step\", npc = { \"phoeyu\" }, pos = V3(6371, 297, -6841), seas = { 2 }, buy = { { \"BuyDeathStep\" } },\010        pre = { { \"Black Leg\", 400 } }, extra = dsExtra })\010    local SK = def({ tool = \"Sharkman Karate\", label = \"Sharkman Karate\", npc = { \"sharkman\" }, seas = { 2 }, buy = { { \"BuySharkmanKarate\" } },\010        pre = { { \"Fishman Karate\", 400 } }, extra = skExtra })\010    local EC = def({ tool = \"Electric Claw\", label = \"Electric Claw\", npc = { \"previous hero\" }, pos = V3(-12548, 337, -7481), seas = { 3 },\010        buy = { { \"BuyElectricClaw\", \"Start\" } }, pre = { { \"Electro\", 400 } }, extra = ecExtra,\010        after = function() SF.ecRun = os.clock() end })\010    local DT = def({ tool = \"Dragon Talon\", label = \"Dragon Talon\", npc = { \"uzoth\" }, seas = { 3 }, buy = { { \"BuyDragonTalon\" } },\010        pre = { { \"Dragon Claw\", 400 } }, extra = dtExtra })\010    local GOD = def({ tool = \"Godhuman\", label = \"Godhuman\", npc = { \"ancient monk\" }, seas = { 3 }, buy = { { \"BuyGodhuman\" } },\010        pre = { { \"Superhuman\", 400 }, { \"Death Step\", 400 }, { \"Sharkman Karate\", 400 }, { \"Electric Claw\", 400 }, { \"Dragon Talon\", 400 } },\010        mats = { { name = \"Fish Tail\", n = 20, mobs = { \"Fishman Warrior\", \"Fishman Commando\" }, seas = { 1 } },\010            { name = \"Magma Ore\", n = 20, mobs = { \"Military Soldier\", \"Military Spy\", \"Lava Pirate\" }, seas = { 1, 2 } },\010            { name = \"Mystic Droplet\", n = 10, mobs = { \"Sea Soldier\", \"Water Fighter\" }, seas = { 2 } },\010            { name = \"Dragon Scale\", n = 10, mobs = { \"Dragon Crew Warrior\", \"Dragon Crew Archer\" }, seas = { 3 } } } })\010    local SAN = def({ tool = \"Sanguine Art\", label = \"Sanguine Art\", npc = { \"shafi\" }, seas = { 3 }, buy = { { \"BuySanguineArt\" } },\010        mats = { { name = \"Vampire Fang\", n = 20, mobs = { \"Vampire\" }, seas = { 2 } },\010            { name = \"Demonic Wisp\", n = 20, mobs = { \"Demonic Soul\" }, seas = { 3 } },\010            { name = \"Leviathan Heart\", n = 1, mobs = { \"Leviathan\" }, seas = { 3 }, manual = true } } })\010\010    local ensure\010    function ensure(s)\010        if tool(s.tool) then return false end\010        if (SF.cool[s.tool] or 0) > os.clock() then return false end\010        -- 1) estilos pre-requisito: primeiro compra os que faltam, depois treina\010        for _, p in ipairs(s.pre or {}) do\010            if not tool(p[1]) then\010                if ensure(STY[p[1]]) then return true end\010                note(s.label .. \": could not get \" .. p[1] .. \" yet\")\010                return false\010            end\010        end\010        for _, p in ipairs(s.pre or {}) do\010            if train(p[1], p[2]) then return true end\010        end\010        -- 2) materiais\010        for _, m in ipairs(s.mats or {}) do\010            if farmMat(m) then return true end\010            local have = 0\010            pcall(function() have = AFL.Inv.count(m.name) end)\010            if have < m.n then note(s.label .. \": missing \" .. m.name .. \" \" .. have .. \"/\" .. m.n); return false end\010        end\010        -- 3) mar certo\010        if s.seas then\010            local w, b = wrongSea(s.seas)\010            if w then return b end\010        end\010        -- 4) passos especiais\010        if s.extra then\010            local r = s.extra(s)\010            if r == \"busy\" then return true end\010            if r == \"block\" then return false end\010        end\010        -- 5) compra\010        local cf = (s.npc and findNpc(s.npc)) or (s.pos and CFrame.new(s.pos))\010        if not cf and not s.noNpc then note(s.label .. \": teacher NPC not found in this sea\"); return false end\010        if cf and not goTo(cf, 10, s.label .. \" teacher\") then return true end\010        if not every(\"buy\" .. s.tool, 4) then\010            set(\"Buying \" .. s.label)\010            return true\010        end\010        local last\010        for _, a in ipairs(s.buy) do\010            local _, r = invoke(table.unpack(a))\010            last = r\010        end\010        set(s.label .. \": server replied \" .. tostring(last))\010        if s.after then s.after() end\010        SF.fail[s.tool] = (SF.fail[s.tool] or 0) + 1\010        if SF.fail[s.tool] >= 6 then\010            SF.fail[s.tool] = 0\010            SF.cool[s.tool] = os.clock() + 180\010            note(s.label .. \": purchase keeps failing (\" .. tostring(last) .. \") - retrying in 3 min\")\010            return false\010        end\010        return true\010    end\010\010    -- ---------- CDK ----------\010    local function eliteCount()\010        local _, r = invoke(\"EliteHunter\", \"Progress\")\010        return tonumber(r) or 0\010    end\010    local function yamaStep()\010        if owns(\"Yama\") then return false end\010        local w, b = wrongSea(3)\010        if w then return b end\010        if not SF.eliteN or every(\"elitecnt\", 4) then SF.eliteN = eliteCount() end\010        local n = SF.eliteN\010        if n < 30 then\010            note(string.format(\"Yama: Elite Hunter %d/30\", n))\010            if eliteStep(true) then return true end\010            -- v26: sem Elite neste servidor -> troca de servidor ate completar os 30 (mesmo sistema do Auto Bounty)\010            if AFL.eliteHopTick then pcall(AFL.eliteHopTick, true) end\010            return AFL.Hop and AFL.Hop.active or false\010        end\010        local m = workspace:FindFirstChild(\"Map\")\010        local wf = m and m:FindFirstChild(\"Waterfall\")\010        local hit = wf and wf:FindFirstChild(\"SealedKatana\")\010        hit = hit and hit:FindFirstChild(\"Hitbox\")\010        if not hit then\010            set(\"Yama: flying to the waterfall (Sealed Katana)\")\010            flyTo(CFrame.new(5289, 1005, 393))\010            return true\010        end\010        if not goTo(hit.CFrame * CFrame.new(0, 3, 0), 10, \"the Sealed Katana\") then return true end\010        local cd = hit:FindFirstChildWhichIsA(\"ClickDetector\", true)\010        if cd and fireclickdetector and every(\"katana\", 1.5) then pcall(fireclickdetector, cd) end\010        set(\"Yama: pulling the Sealed Katana\")\010        return true\010    end\010    local function tushitaStep()\010        if owns(\"Tushita\") then return false end\010        local w, b = wrongSea(3)\010        if w then return b end\010        if not SF.tush or every(\"tushprog\", 2) then\010            local _, pr = invoke(\"TushitaProgress\")\010            SF.tush = type(pr) == \"table\" and pr or { Torches = { false, false, false, false, false } }\010        end\010        local prog = SF.tush\010        if prog.OpenedDoor then\010            local e = findEnemy({ \"Longma\" })\010            if e then set(\"Tushita: fighting Longma\"); fightEnemy(e, { e.Name }, false); return true end\010            set(\"Tushita: going to Longma\")\010            flyTo(CFrame.new(-10237, 339, 8758))\010            return true\010        end\010        if findEnemy({ \"rip_indra True Form\" }) or tool(\"Holy Torch\") then\010            if not tool(\"Holy Torch\") then\010                set(\"Tushita: waiting for the Holy Torch (kill rip_indra True Form)\")\010                flyTo(CFrame.new(5713, 19, 255))\010                local e = findEnemy({ \"rip_indra True Form\" })\010                if e then fightEnemy(e, { e.Name }, false) end\010                return true\010            end\010            local _, _, hum = getChar()\010            local ht = tool(\"Holy Torch\")\010            if hum and ht and ht.Parent ~= Player.Character then hum:EquipTool(ht) end\010            for i, lit in ipairs(prog.Torches or {}) do\010                if not lit then invoke(\"TushitaProgress\", \"Torch\", i) end\010            end\010            set(\"Tushita: lighting the torches\")\010            return true\010        end\010        -- v26: antes de trocar de servidor vai para a Ilha da Hydra e entra num servidor que ja tem o Rip_Indra (API do Quantum). So depois faz o puzzle.\010        if Config.SubRipApi ~= false and not tool(\"God's Chalice\") then\010            local hydra = Vector3.new(5228, 603, 345)\010            local _, hrp = getChar()\010            if hrp and (hrp.Position - hydra).Magnitude > 400 and not (AFL.Hop and AFL.Hop.active) and not (AFL.QApi and AFL.QApi.joining) then\010                set(\"Tushita: flying to Hydra Island before changing server\")\010                flyTo(CFrame.new(hydra)); return true\010            end\010            set(\"Tushita: joining a server that has Rip_Indra\")\010            AFL.apiJoin(\"Ripindra\", function() return findEnemy({ \"rip_indra True Form\" }) ~= nil end, \"Rip_Indra\")\010            return true\010        end\010        local chalice = tool(\"God's Chalice\")\010        if chalice then\010            local _, _, hum = getChar()\010            if hum and chalice.Parent ~= Player.Character then hum:EquipTool(chalice) end\010            set(\"Tushita: placing the God's Chalice\")\010            flyTo(CFrame.new(-5561, 314, -2663))\010            return true\010        end\010        note(\"Tushita: getting a God's Chalice (Elites / chests)\")\010        if eliteStep(true) then return true end\010        if AFL.chestStep and AFL.chestStep() then return true end\010        return false\010    end\010\010    local CDKPOS = { V3(-4602, 16, -2881), V3(-6126, 16, -2250), V3(3911, 7, -2582), V3(-426, 11, 5301) }\010    local function cursed() local m = workspace:FindFirstChild(\"Map\"); local t = m and m:FindFirstChild(\"Turtle\"); return t and t:FindFirstChild(\"Cursed\") end\010    local function press(p) if p and fireproximityprompt then pcall(fireproximityprompt, p, 1) end end\010    local function touch(part)\010        local _, hrp = getChar()\010        if hrp and part and firetouchinterest then\010            pcall(function() firetouchinterest(hrp, part, 0); firetouchinterest(hrp, part, 1) end)\010        end\010    end\010    -- CDKfix: maestria lida tambem pelo inventario (a espada pode nao estar na mochila ainda)\010    local function mastOf(name)\010        local v = lvl(name)\010        local ok, m = pcall(function() return AFL.Inv.mastery and AFL.Inv.mastery(name) end)\010        m = ok and tonumber(m) or nil\010        if m and m > v then v = m end\010        return v\010    end\010    -- CDKfix: leitura robusta do progresso (tabela, numero ou chamada por lado) e guarda o valor cru para mostrar no status\010    local function cdkProgress()\010        local q, how\010        local ok, r = invoke(\"CDKQuest\", \"Progress\")\010        if ok and type(r) == \"table\" then q, how = r, \"table\" end\010        if not q then\010            local function num(v)\010                if type(v) == \"table\" then v = v.Progress or v.Stage or v.Value or v[1] end\010                return tonumber(v)\010            end\010            local ok1, g = invoke(\"CDKQuest\", \"Progress\", \"Good\")\010            local ok2, e = invoke(\"CDKQuest\", \"Progress\", \"Evil\")\010            if (ok1 and num(g)) or (ok2 and num(e)) then\010                q, how = { Good = (ok1 and num(g)) or -2, Evil = (ok2 and num(e)) or -2 }, \"sides\"\010            end\010        end\010        if not q then\010            SF.cdkRaw = \"no answer from the server (\" .. tostring(r) .. \")\"\010            return \"None\"\010        end\010        local evil, good = tonumber(q.Evil) or -2, tonumber(q.Good) or -2\010        SF.cdkRaw = string.format(\"%s Good=%s Evil=%s\", tostring(how), tostring(q.Good), tostring(q.Evil))\010        if q.Finished == true or (evil == 4 and good == 4) then return \"Alucard Boss\" end\010        if good == 0 or good == -3 then return \"Boat Quest\" end\010        if good == 1 or good == -4 then return \"Raid Quest\" end\010        if good == 2 or good == -5 then return \"Heavenly Quest\" end\010        if good == 3 then return \"Burn Tushita Scroll\" end\010        if evil == 0 or evil == -3 then return \"Pain Quest\" end\010        if evil == 1 or evil == -4 then return \"Haze Quest\" end\010        if evil == 2 or evil == -5 then return \"Hell Quest\" end\010        if evil == 3 then return \"Burn Yama Scroll\" end\010        if good == -2 and evil == -2 then return owns(\"Tushita\") and \"Start Tushita\" or \"Start Yama\" end\010        if good == -2 then return \"Start Tushita\" end\010        if evil == -2 then return \"Start Yama\" end\010        return \"None\"\010    end\010    -- CDKfix: pedestal pode ser Part ou Model; segura a espada certa na mao e aperta o prompt mesmo se vier desativado\010    local function posOf(o)\010        if not o then return nil end\010        if o:IsA(\"BasePart\") then return o.CFrame end\010        local ok, cf = pcall(function() return o:GetPivot() end)\010        return ok and cf or nil\010    end\010    local function holdSword(kind)\010        local nm = (kind == \"Evil\") and \"Yama\" or \"Tushita\"\010        local t = tool(nm)\010        local _, _, hum = getChar()\010        if hum and t and t.Parent ~= Player.Character then pcall(function() hum:EquipTool(t) end) end\010    end\010    local function pedestal(name, kind)\010        local c = cursed()\010        local p = c and c:FindFirstChild(name)\010        local cf = posOf(p)\010        if p and cf then\010            holdSword(kind)\010            if not goTo(cf, 11, \"the \