 (not m.Parent) or (st ~= nil and st ~= \"Idle\") then\010            P.n += 1; P.cur = nil; P.noneSince = nil\010        elseif os.clock() - P.since > 20 then\010            P.bl[m] = os.clock() + 120; P.cur = nil\010        else\010            local h = tonumber(m:GetAttribute(\"PumpkinHits\")) or 0\010            if h ~= P.hitsSeen then P.hitsSeen, P.hitsAt = h, os.clock()\010            elseif os.clock() - P.hitsAt > 7 then P.bl[m] = os.clock() + 90; P.cur = nil end    -- nao esta levando dano: deixa pra la\010        end\010    end\010    if not P.cur then\010        local best, bd = nil, math.huge\010        for _, it in ipairs(P.list()) do\010            local dist = (it.p.Position - hrp.Position).Magnitude\010            if dist < bd then best, bd = it, dist end\010        end\010        if best then\010            P.cur, P.since, P.hitsSeen, P.hitsAt, P.noneSince, P.tour, P.dwell = best, os.clock(), tonumber(best.m:GetAttribute(\"PumpkinHits\")) or 0, os.clock(), nil, nil, nil\010        else\010            -- nenhuma abobora carregada: visita as ilhas (elas so aparecem perto) e, no fim, troca de servidor (se Hop estiver ligado)\010            if os.clock() >= P.restUntil then\010                if not P.tour then P.tour, P.tourI, P.tourAt, P.dwell = AFL.chestTourBuild(hrp.Position), 1, os.clock(), nil end\010                local tgt = P.tour[P.tourI]\010                if tgt then\010                    P.noneSince = nil\010                    State.Mode = \"Break Pumpkins\"\010                    say(string.format(\"Searching pumpkins: island %d/%d (%d broken)\", P.tourI, #P.tour, P.n))\010                    State.Text = P.status\010                    local goal = tgt + Vector3.new(0, 90, 0)\010                    if (hrp.Position - goal).Magnitude > 60 and os.clock() - P.tourAt < 40 then flyTo(CFrame.new(goal)); return true end\010                    P.dwell = P.dwell or (os.clock() + 1.5)\010                    if os.clock() < P.dwell then return true end\010                    P.tourI, P.tourAt, P.dwell = P.tourI + 1, os.clock(), nil\010                    return true\010                end\010                P.tour, P.restUntil = nil, os.clock() + (hop and 4 or 30)\010            end\010            P.noneSince = P.noneSince or os.clock()\010            State.Mode = \"Break Pumpkins\"\010            say(\"No pumpkins left here (\" .. P.n .. \" broken)\")\010            State.Text = P.status\010            if hop and os.clock() - P.noneSince > 3 then\010                AFL.hopRequest(\"no pumpkins left\", function() return #P.list() > 0 end)\010            end\010            return false\010        end\010    end\010    local part = P.cur.p\010    State.Mode = \"Break Pumpkins\"\010    say(string.format(\"Breaking pumpkin (%d broken%s)\", P.n, hop and \", hop on\" or \"\"))\010    State.Text = P.status\010    local goal = part.Position + Vector3.new(0, 4, 0)\010    if (hrp.Position - goal).Magnitude > 9 then\010        flyTo(CFrame.new(goal))\010        return true\010    end\010    pcall(function()\010        Config.SeaTool, Config.SeaUntil = { tip = \"Melee\" }, os.clock() + 1.5\010        equipWeapon()\010    end)\010    pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)\010    shoot(part)\010    return true\010end\010\010-- ============ Auto Roll Gacha Event (Spooky Halloween Gacha, Zioles) ============\010-- Confirmado no codigo do jogo (GachaClient): consulta = GachaNetworkRF:InvokeServer({Context=\"Check\", BoxName=...}) e giro =\010-- GachaNetworkRF:InvokeServer({Context=\"Purchase\", BoxName=...}) (o Random Fruit do hub ja gira assim, de longe, com \"ZiolesGacha\").\010-- O Check devolve Cooldown.RequirementMet / Cooldown.RollTotal / Cooldown.RollCount e Price.RequirementMet (500 Candy Corn);\010-- o hub so gira quando os dois estao OK (ate 2 giros por hora). O giro nao mexe no personagem, entao roda em segundo plano.\010local G = { box = \"Halloween26Gacha\", status = \"Off\", rolls = 0, nextAt = 0, last = \"\" }\010AFL.HalGacha = G\010local function gcallMulti(tbl)\010    local rf = net(\"RF/GachaNetworkRF\")\010    if not rf then return false, \"remote not found\" end\010    local done, res = false, nil\010    task.spawn(function()\010        res = table.pack(pcall(function() return rf:InvokeServer(tbl) end))\010        done = true\010    end)\010    local t0 = os.clock()\010    while not done and os.clock() - t0 < 8 do task.wait(0.05) end\010    if not done then return false, \"no response (8s)\" end\010    return res[1], res[2], res[3]\010end\010local function gsay(t) G.status = t; Diag.halgacha = t end\010function G.check()\010    local ok, r = gcallMulti({ Context = \"Check\", BoxName = G.box })\010    if ok and type(r) == \"table\" then return r end\010    return nil, r\010end\010local function met(x) return type(x) == \"table\" and x.RequirementMet == true end\010function G.cycle()\010    local info, why = G.check()\010    if not info then\010        gsay(\"Check failed: \" .. tostring(why))\010        G.nextAt = os.clock() + 90\010        return\010    end\010    local restricted = type(info.PaidRandomItemsRestricted) == \"table\" and info.PaidRandomItemsRestricted.Value == true\010    local left\010    if type(info.Cooldown) == \"table\" and info.Cooldown.RollTotal then left = info.Cooldown.RollTotal - (info.Cooldown.RollCount or 0) end\010    if restricted then gsay(\"Paid random items are restricted on this account\"); G.nextAt = os.clock() + 600; return end\010    local known = type(info.Price) == \"table\" and type(info.Cooldown) == \"table\"      -- formato do Check nao reconhecido: tenta girar mesmo assim\010    if known and not met(info.Price) then gsay(\"Not enough Candy Corn (500 needed)\"); G.nextAt = os.clock() + 60; return end\010    if known and not met(info.Cooldown) then\010        gsay(\"Waiting for the next roll window\" .. (left and (\" (rolls left: \" .. left .. \")\") or \"\"))\010        G.nextAt = os.clock() + 60\010        return\010    end\010    local ok, a, b = gcallMulti({ Context = \"Purchase\", BoxName = G.box })\010    if ok and a then\010        G.rolls += 1\010        G.last = \"rolled\"\010        gsay(string.format(\"Rolled the Spooky Gacha (%d this session)\", G.rolls))\010        G.nextAt = os.clock() + 5      -- confere de novo: pode ter o segundo giro\010    else\010        local msg = type(b) == \"table\" and tostring(b.ErrorMessage) or tostring(a or b)\010        G.last = msg\010        gsay(\"Roll refused: \" .. msg)\010        G.nextAt = os.clock() + 120\010    end\010end\010task.spawn(function()\010    while Alive do\010        task.wait(1)\010        if Config.HalGacha and os.clock() >= G.nextAt then\010            local ok, err = pcall(G.cycle)\010            if not ok then gsay(\"error: \" .. tostring(err)); G.nextAt = os.clock() + 60 end\010        elseif not Config.HalGacha then\010            G.status = \"Off\"\010        end\010    end\010end)\010\010-- ============ Auto Halloween Event (portas da cidade, Sea 1) ============\010-- Fluxo conferido no codigo do jogo (HalloweenLocal):\010--   * portas: Model \"HalloweenDoor\" (workspace.Map.Town.HalloweenDecor) com Proximity.ProximityPrompt (\"E\"); o toque chama\010--     Remotes.HalloweenFunction:InvokeServer(porta). Atributos da porta: CooldownUntil (tempo do servidor), DoorOpen, EventId.\010--   * o servidor responde por Remotes.HalloweenEvent: \"DoorOpened\"(porta, jogador, {Event, Scene, Boss}) e \"EventFinished\"(porta).\010--   * portas \"treat\" (maioria, lista em TreatDoors): o servidor espera HalloweenEvent:FireServer(\"AcceptReward\") (paga os Candy Corn)\010--     e depois \"TreatDialogueClosed\". Cenas especiais usam um RemoteEvent proprio em ReplicatedStorage[EventId][nome] (abaixo).\010--   * cenas de luta: os inimigos nascem em workspace.Enemies - o hub mata os que aparecem perto da porta.\010-- Cenas especiais (Gravedigger, Sweet Ride, Magma Recipe, Don't Be Greedy, Mystery Hall, Ghost Chase, Zer0 Slap, Tarot) tem protocolo proprio (tabela SP abaixo).\010local H = { status = \"Off\", n = 0, restUntil = 0, door = nil, doorAt = 0, info = nil, finished = false, handled = false, pressAt = 0, snap = nil,\010    bl = setmetatable({}, { __mode = \"k\" }), cache = {}, cacheAt = 0, last = \"\" }\010AFL.HalEvent = H\010local function hsay(t) H.status = t; Diag.halevent = t end\010local function hremote()\010    local r = ReplicatedStorage:FindFirstChild(\"Remotes\")\010    return r and r:FindFirstChild(\"HalloweenEvent\")\010end\010task.spawn(function()\010    local r = ReplicatedStorage:WaitForChild(\"Remotes\", 15)\010    local he = r and r:WaitForChild(\"HalloweenEvent\", 15)\010    if not he then return end\010    he.OnClientEvent:Connect(function(cmd, door, plr, info)\010        if cmd == \"DoorOpened\" and type(info) == \"table\" and (info.Boss == true or info.Event == \"Boss Fight\" or info.Event == \"Hellfire Boss\") then\010            -- porta de boss (Lobisomen / Hellfire): vale para qualquer jogador que abriu, o portal aparece para todos\010            H.boss = { door = door, ev = info.Event, t = os.clock(), stage = 0 }\010        elseif cmd == \"HellfireBossExit\" or cmd == \"HellfireBossDeath\" then\010            H.bossOver = os.clock()\010        end\010        if cmd == \"DoorOpened\" and door == H.door and (plr == nil or plr == Player) then\010            H.info = type(info) == \"table\" and info or {}\010            H.openedAt = os.clock()\010        elseif cmd == \"EventFinished\" and door == H.door then\010            H.finished = true\010        end\010    end)\010end)\010-- cenas com remote proprio: { remote = nome, steps = { cmd | numero (espera em s) ... } }\010local SCENES = {\010    [\"Fruit Dealer\"] = { remote = \"FruitDealer\", steps = { \"Beg\", 9, \"Done\" } },                      -- 10 Candy Corn\010    [\"Cute Zer0\"] = { remote = \"ZeroLab\", steps = { \"Accept\" } },                                      -- 30 Candy Corn\010    [\"Turtle Island Encounter\"] = { remote = \"TurtleTale\", steps = { 32, \"Listened\", 8, \"Done\" } },   -- 30 Candy Corn\010    [\"parlus Scam\"] = { treatArg = \"None\" },                                                           -- \"dar\" o candy e golpe: recusa\010}\010local SKIP = {}\010local function waitUntil(t, cond)\010    local t0 = os.clock()\010    while Alive and os.clock() - t0 < t and not (cond and cond()) do task.wait(0.1) end\010end\010local function sceneRemote(door, name)\010    local id = door:GetAttribute(\"EventId\")\010    if id == nil then return nil end\010    local f = ReplicatedStorage:WaitForChild(tostring(id), 10)\010    return f and f:WaitForChild(name, 10)\010end\010\010-- ---- cenas especiais (protocolo conferido no codigo do jogo; cada uma roda na sua propria thread) ----\010local SP = {}\010local function sfire(r, ...)\010    local a = table.pack(...)\010    pcall(function()\010        if r:IsA(\"RemoteFunction\") then r:InvokeServer(table.unpack(a, 1, a.n)) else r:FireServer(table.unpack(a, 1, a.n)) end\010    end)\010end\010local function sinv(r, ...)\010    local a = table.pack(...)\010    local ok, res = pcall(function() return r:InvokeServer(table.unpack(a, 1, a.n)) end)\010    if ok then return res end\010    return nil\010end\010local function live(door) return Alive and H.door == door and not H.finished end\010local function sleep(door, t) waitUntil(t, function() return not live(door) end) end\010local function swing()\010    pcall(function() if Core and Core.meleeSwordClick then Core.meleeSwordClick(\"Melee\") end end)\010    pcall(function() local ra = net(\"RE/RegisterAttack\"); if ra then ra:FireServer() end end)\010end\010\010-- Gravedigger: Choose(1-4) -> mensagem \"Outcome\" -> (Stubborn: Focus) -> Ready (o servidor so aceita depois de um tempo minimo de cada resultado)\010SP[\"Gravedigger\"] = function(door)\010    local r = sceneRemote(door, \"Gravedigger\"); if not r then return end\010    local outcome\010    local c = r.OnClientEvent:Connect(function(m, a, b) if m == \"Outcome\" then outcome = b end end)\010    sleep(door, 1.5)\010    local t0 = os.clock()\010    while live(door) and not outcome and os.clock() - t0 < 14 do\010        sfire(r, \"Choose\", math.random(1, 4)); sleep(door, 4)\010    end\010    c:Disconnect()\010    local min = ({ Ghosts = 3, Pumpkin = 4, Brother = 6, Stubborn = 4 })[outcome] or 5\010    if outcome == \"Stubborn\" then sleep(door, 3.5); sfire(r, \"Focus\") end\010    sleep(door, min + 0.5)\010    for _ = 1, 6 do\010        if not live(door) then break end\010        sfire(r, \"Ready\"); sleep(door, 3)\010    end\010end\010-- Sweet Ride: Fix -> (empurrar a roda) -> Returned ate chegar a mensagem \"Fixed\" (60 Candy Corn); se nao rolar, Rob e mata os ladroes\010SP[\"Sweet Ride\"] = function(door)\010    local r = sceneRemote(door, \"SweetRide\"); if not r then return end\010    local fixed = false\010    local c = r.OnClientEvent:Connect(function(m) if m == \"Fixed\" then fixed = true end end)\010    sleep(door, 2)\010    sfire(r, \"Fix\"); sleep(door, 3)\010    for _ = 1, 14 do\010        if fixed or not live(door) then break end\010        sfire(r, \"Returned\"); sleep(door, 1.5)\010    end\010    if not fixed and live(door) then sfire(r, \"Rob\") end\010    c:Disconnect()\010end\010-- Don't Be Greedy: pega 4 punhados (a chance de ele ficar bravo e tomar tudo so sobe depois disso) e sai com \"Leave\"\010SP[\"Don't Be Greedy\"] = function(door)\010    local r = sceneRemote(door, \"GreedyBasket\"); if not r then return end\010    sleep(door, 3)\010    for i = 1, 6 do\010        if not live(door) then return end\010        local res = sinv(r, \"Grab\")\010        if type(res) ~= \"table\" then break end\010        if res.Result == \"Angry\" or res.Result == \"Empty\" then return end\010        if (res.Grabs or i) >= 4 then break end\010        sleep(door, 1.6)\010    end\010    sinv(r, \"Leave\")\010end\010-- Magma Recipe: depois da animacao o cliente manda \"Spill\"; os slimes de magma que nascem sao mortos pelo loop normal da porta\010SP[\"Magma Recipe\"] = function(door)\010    local r = sceneRemote(door, \"MagmaRecipe\"); if not r then return end\010    local spilled = false\010    local c = r.OnClientEvent:Connect(function(m) if m == \"Spill\" then spilled = true end end)\010    sleep(door, math.max(0, 13 - (os.clock() - (H.openedAt or os.clock()))))\010    for _ = 1, 4 do\010        if spilled or not live(door) then break end\010        sfire(r, \"Spill\"); sleep(door, 4)\010    end\010    c:Disconnect()\010end\010\010-- ---- clique na interface do jogo (dialogos e minigame das cartas) ----\010local GuiService = game:GetService(\"GuiService\")\010local VIM\010pcall(function() VIM = game:GetService(\"VirtualInputManager\") end)\010local function shown(g)\010    local o = g\010    while o and o ~= game do\010        if o:IsA(\"GuiObject\") and not o.Visible then return false end\010        if o:IsA(\"ScreenGui\") and not o.Enabled then return false end\010        o = o.Parent\010    end\010    return true\010end\010local function clickGui(g)\010    if VIM then\010        local pos, size = g.AbsolutePosition, g.AbsoluteSize\010        local sg = g:FindFirstAncestorOfClass(\"ScreenGui\")\010        local ins = (sg and sg.IgnoreGuiInset) and Vector2.new(0, 0) or GuiService:GetGuiInset()\010        local x, y = pos.X + size.X / 2 + ins.X, pos.Y + size.Y / 2 + ins.Y\010        pcall(function()\010            VIM:SendMouseMoveEvent(x, y, game)\010            task.wait(0.05)\010            VIM:SendMouseButtonEvent(x, y, 0, true, game, 1)\010            task.wait(0.06)\010            VIM:SendMouseButtonEvent(x, y, 0, false, game, 1)\010        end)\010    elseif firesignal and g:IsA(\"GuiButton\") then\010        pcall(function() firesignal(g.Activated); firesignal(g.MouseButton1Click) end)\010    end\010end\010-- acha a opcao de dialogo pelo texto (o menor texto que contem o padrao = o botao, nao a fala) e clica\010local function pickOption(pats, timeout)\010    local t0 = os.clock()\010    while Alive and os.clock() - t0 < timeout do\010        local pg = Player:FindFirstChild(\"PlayerGui\")\010        local best, bl\010        for _, d in ipairs(pg and pg:GetDescendants() or {}) do\010            if (d:IsA(\"TextLabel\") or d:IsA(\"TextButton\")) and d.Text ~= \"\" and d.AbsoluteSize.X > 0 and shown(d) then\010                local t = (d.Text:lower():gsub(\"<[^>]+>\", \"\"))\010                for _, pt in ipairs(pats) do\010                    if t:find(pt, 1, true) and (not bl or #t < bl) then best, bl = d, #t end\010                end\010            end\010        end\010        if best and bl <= 60 then\010            local tgt = best\010            while tgt and not tgt:IsA(\"GuiButton\") and not tgt:IsA(\"ScreenGui\") do tgt = tgt.Parent end\010            if not (tgt and tgt:IsA(\"GuiButton\")) then tgt = best end\010            task.wait(0.4)\010            clickGui(tgt)\010            return true\010        end\010        task.wait(0.3)\010    end\010    return false\010end\010local function closeDlg()\010    pcall(function() require(ReplicatedStorage.DialogueController).close() end)\010end\010-- ---- Tarot: jogo da memoria (10 cartas, 5 pares) ----\010local function content(c)\010    local t = {}\010    local function add(d)\010        if d:IsA(\"ImageLabel\") or d:IsA(\"ImageButton\") then t[#t + 1] = d.Image .. \"|\" .. tostring(d.ImageRectOffset) .. \"|\" .. tostring(d.ImageRectSize)\010        elseif d:IsA(\"TextLabel\") then t[#t + 1] = d.Text end\010    end\010    add(c)\010    for _, d in ipairs(c:GetDescendants()) do add(d) end\010    return table.concat(t, \";\")\010end\010local function cstate(c)\010    local t = {}\010    local function add(d)\010        if d:IsA(\"GuiObject\") then t[#t + 1] = tostring(d.Visible) end\010        if d:IsA(\"ImageLabel\") or d:IsA(\"ImageButton\") then t[#t + 1] = string.format(\"%.1f\", d.ImageTransparency) end\010    end\010    add(c)\010    for _, d in ipairs(c:GetDescendants()) do add(d) end\010    return table.concat(t, \",\")\010end\010local function findCards()\010    local pg = Player:FindFirstChild(\"PlayerGui\")\010    if not pg then return nil end\010    local buckets = {}\010    for _, d in ipairs(pg:GetDescendants()) do\010        if d:IsA(\"GuiObject\") and d.AbsoluteSize.X > 40 and d.AbsoluteSize.X < 420 and d.AbsoluteSize.Y > d.AbsoluteSize.X * 1.1 and shown(d) then\010            local par = d.Parent\010            if par then\010                local key = math.floor(d.AbsoluteSize.X / 3) .. \"x\" .. math.floor(d.AbsoluteSize.Y / 3)\010                buckets[par] = buckets[par] or {}\010                buckets[par][key] = buckets[par][key] or {}\010                table.insert(buckets[par][key], d)\010            end\010        end\010    end\010    local best\010    for _, byKey in pairs(buckets) do\010        for _, list in pairs(byKey) do\010            local n = #list\010            if n >= 6 and n <= 20 and n % 2 == 0 then\010                local score = (n == 10 and 100 or 0) + n\010                if not best or score > best.score then best = { score = score, list = list } end\010            end\010        end\010    end\010    if not best then return nil end\010    table.sort(best.list, function(a, b)\010        local ra, rb = math.floor(a.AbsolutePosition.Y / (a.AbsoluteSize.Y * 0.5)), math.floor(b.AbsolutePosition.Y / (b.AbsoluteSize.Y * 0.5))\010        if ra ~= rb then return ra < rb end\010        return a.AbsolutePosition.X < b.AbsolutePosition.X\010    end)\010    return best.list\010end\010local function gameOpen(cg, cards)\010    if cg then\010        local ok, v = pcall(function() return cg:IsOpen() end)\010        if ok then return v and true or false end\010    end\010    return cards and cards[1] and cards[1].Parent ~= nil and shown(cards[1]) or false\010end\010local function playCards(door, cg)\010    local t0 = os.clock()\010    local cards\010    while live(door) and os.clock() - t0 < 40 and not cards do\010        cards = findCards()\010        if not cards then task.wait(0.5) end\010    end\010    if not cards then hsay(\"Tarot: cards not found\"); return false end\010    local n = #cards\010    local base, baseS = {}, {}\010    for i, c in ipairs(cards) do base[i], baseS[i] = content(c), cstate(c) end\010    local function flip(i)\010        clickGui(cards[i])\010        local t = os.clock()\010        while os.clock() - t < 1.6 do\010            task.wait(0.1)\010            if content(cards[i]) ~= base[i] or cstate(cards[i]) ~= baseS[i] then task.wait(0.55); return true end\010        end\010        return false\010    end\010    local function waitBack(a, b)\010        local t = os.clock()\010        while os.clock() - t < 3.5 do\010            if cstate(cards[a]) == baseS[a] and cstate(cards[b]) == baseS[b] then break end\010            task.wait(0.15)\010        end\010        task.wait(0.35)\010    end\010    local matched, count = {}, 0\010    -- 1) as faces ja aparecem no baseline (imagem escondida)? entao os pares ja estao dados\010    local groups = {}\010    for i = 1, n do groups[base[i]] = groups[base[i]] or {}; table.insert(groups[base[i]], i) end\010    local revealed = true\010    local ng = 0\010    for _, g in pairs(groups) do ng += 1; if #g ~= 2 then revealed = false end end\010    if revealed and ng == n / 2 then\010        for _, g in pairs(groups) do\010            if not (live(door) and gameOpen(cg, cards)) then break end\010            flip(g[1]); flip(g[2]); task.wait(0.7)\010        end\010        return true\010    end\010    -- 2) vira e memoriza\010    local face = {}\010    local guard = 0\010    while live(door) and gameOpen(cg, cards) and count < n and guard < 80 do\010        guard += 1\010        hsay(string.format(\"Tarot: %d/%d cards matched\", count, n))\010        local a, b\010        for i = 1, n do\010            if not matched[i] and face[i] then\010                for j = i + 1, n do\010                    if not matched[j] and face[j] == face[i] then a, b = i, j; break end\010                end\010            end\010            if a then break end\010        end\010        if a then\010            flip(a); flip(b)\010            matched[a], matched[b] = true, true; count += 2\010            task.wait(0.6)\010        else\010            local x\010            for i = 1, n do if not matched[i] and not face[i] then x = i; break end end\010            if not x then break end\010            if not flip(x) then task.wait(0.5) else\010                face[x] = content(cards[x])\010                local partner\010                for j = 1, n do if j ~= x and not matched[j] and face[j] == face[x] then partner = j; break end end\010                if partner then\010                    flip(partner); matched[x], matched[partner] = true, true; count += 2; task.wait(0.6)\010                else\010                    local y\010                    for i = 1, n do if i ~= x and not matched[i] and not face[i] then y = i; break end end\010                    if y and flip(y) then\010                        face[y] = content(cards[y])\010                        if face[y] == face[x] then matched[x], matched[y] = true, true; count += 2; task.wait(0.6)\010                        else waitBack(x, y) end\010                    end\010                end\010            end\010        end\010    end\010    return count >= n\010end\010-- Tarot: escolhe \"Play matching!\" na tela, resolve o jogo da memoria; o proprio jogo manda o Done quando termina\010SP[\"Tarot\"] = function(door)\010    local viaUI = pickOption({ \"play matching\" }, 20)\010    local r = sceneRemote(door, \"TarotReading\")\010    if not viaUI then\010        if not r then return end\010        sleep(door, 3); sfire(r, \"Read\")\010    end\010    local cg\010    pcall(function()\010        local m = require(ReplicatedStorage.Controllers.UI.ConcentrationGame)\010        if m.IsInitialized then cg = m end\010    end)\010    local ok = playCards(door, cg)\010    sleep(door, 4)\010    if not viaUI and r and live(door) then sfire(r, \"Done\") end\010    if ok then hsay(\"Tarot: solved\") end\010end\010-- Zer0 Slap (rip_return pescando): clica \"TRICK OR TREAT!\" na tela; sem tela, usa a RemoteFunction (workspace._WorldOrigin[EventId]._storagePtr)\010SP[\"Zer0 Slap\"] = function(door)\010    if pickOption({ \"trick or treat\" }, 14) then sleep(door, 3); closeDlg(); return end\010    local wo = workspace:FindFirstChild(\"_WorldOrigin\")\010    local box = wo and wo:WaitForChild(tostring(door:GetAttribute(\"EventId\")), 20)\010    local ptr = box and box:WaitForChild(\"_storagePtr\", 20)\010    if not ptr then return end\010    local t0 = os.clock()\010    while live(door) and not ptr.Value and os.clock() - t0 < 10 do task.wait(0.2) end\010    local rf = ptr.Value and ptr.Value:WaitForChild(\"RemoteFunction\", 10)\010    if not rf then return end\010    sinv(rf, \"activate\", \"candy\")\010    sleep(door, 2); closeDlg()\010end\010-- One Free Roll (Zioles): escolhe \"One free roll!\" (o jogo faz Roll/Revealed/Done sozinho); sem tela, manda os remotes\010SP[\"One Free Roll\"] = function(door)\010    if pickOption({ \"one free roll\" }, 15) then sleep(door, 20); return end\010    local r = sceneRemote(door, \"FreeRoll\"); if not r then return end\010    sfire(r, \"Roll\"); sleep(door, 7)\010    sfire(r, \"Revealed\"); sleep(door, 4)\010    sfire(r, \"Done\")\010end\010-- Mystery Hall: Accept -> por rodada Watch, Question (espera ficar pronta), Answer. O jogo de memoria nao e resolvido: resposta aleatoria\010-- (errar so encerra a cena, nao tira nada); acertando, segue as rodadas e ganha Candy Corn.\010SP[\"Mystery Hall\"] = function(door)\010    local r = sceneRemote(door, \"MysteryHall\"); if not r then return end\010    sleep(door, 4)\010    local round = sinv(r, \"Accept\")\010    local rounds = 0\010    while live(door) and type(round) == \"table\" and rounds < 6 do\010        rounds += 1\010        sleep(door, 6)\010        if sinv(r, \"Watch\") ~= true then break end\010        local q\010        for _ = 1, 40 do\010            if not live(door) then return end\010            local res = sinv(r, \"Question\")\010            if type(res) ~= \"table\" then break end\010            if res.Ready then q = res.Question; break end\010            sleep(door, math.max(res.RetryAfter or 0, 0.25))\010        end\010        if not q or type(q.Choices) ~= \"table\" then break end\010        sleep(door, 1.5)\010        local res = sinv(r, \"Answer\", math.random(1, math.max(1, #q.Choices)))\010        if type(res) ~= \"table\" or res.Scare or res.Finished or not res.Correct then break end\010        round = res.Next\010    end\010    sinv(r, \"Leave\")\010end\010-- Ghost Chase: AcceptReward, o fantasma foge com o saco (posicao em door:GetAttribute(\"GhostLeg\")); bate nele e depois pega os docinhos\010-- que caem (atributos GhostCandy_<id> com a posicao) mandando HalloweenEvent:FireServer(\"GhostCandy\", id)\010local function ghostPos(door)\010    local a = door:GetAttribute(\"GhostLeg\")\010    if type(a) ~= \"string\" then return nil end\010    local t = {}\010    for n in a:gmatch(\"[^,]+\") do t[#t + 1] = tonumber(n) end\010    if #t ~= 8 then return nil end\010    local span = t[8] - t[7]\010    local k = span <= 0 and 1 or math.clamp((workspace:GetServerTimeNow() - t[7]) / span, 0, 1)\010    return Vector3.new(t[1], t[2], t[3]):Lerp(Vector3.new(t[4], t[5], t[6]), math.sin(k * math.pi / 2))\010end\010SP[\"Ghost Chase\"] = function(door)\010    local he = hremote()\010    sleep(door, 1.5)\010    if he then pcall(function() he:FireServer(\"AcceptReward\") end) end\010    local t0 = os.clock()\010    while live(door) and door:GetAttribute(\"GhostState\") ~= \"Fleeing\" and os.clock() - t0 < 10 do task.wait(0.2) end\010    local t1 = os.clock()\010    while live(door) and door:GetAttribute(\"GhostState\") == \"Fleeing\" and os.clock() - t1 < 45 do\010        H.holdUntil = os.clock() + 2\010        local _, hrp = getChar()\010        local gp = ghostPos(door)\010        if hrp and gp then\010            if (hrp.Position - gp).Magnitude > 4 then hrp.CFrame = CFrame.new(gp + Vector3.new(0, 1, 3)) end\010            swing()\010        end\010        task.wait(0.12)\010    end\010    -- docinhos que ficaram\010    local t2 = os.clock()\010    local got = {}\010    while live(door) and os.clock() - t2 < 14 do\010        H.holdUntil = os.clock() + 2\010        local any = false\010        for name, v in pairs(door:GetAttributes()) do\010            if type(name) == \"string\" and name:sub(1, 11) == \"GhostCandy_\" and typeof(v) == \"Vector3\" and not got[name] then\010                any = true\010                local id = tonumber(name:sub(12))\010                local _, hrp = getChar()\010                if hrp and id then\010                    hrp.CFrame = CFrame.new(v + Vector3.new(0, 2, 0))\010                    task.wait(0.15)\010                    if he then pcall(function() he:FireServer(\"GhostCandy\", id) end) end\010                    got[name] = true\010                end\010            end\010        end\010        if not any then\010            local st = door:GetAttribute(\"GhostState\")\010            if st == \"Caught\" or st == \"Escaped\" or os.clock() - t2 > 5 then break end\010        end\010        task.wait(0.2)\010    end\010end\010function H.handle(door, info)\010    local ev = info and info.Event\010    H.last = tostring(ev)\010    if info and (info.Boss == true or ev == \"Boss Fight\" or ev == \"Hellfire Boss\") then return end\010    if ev and SKIP[ev] then return end\010    if ev and SP[ev] then SP[ev](door, info); return end\010    local he = hremote()\010    local sc = ev and SCENES[ev]\010    if sc and sc.remote then\010        local r = sceneRemote(door, sc.remote)\010        if not r then return end\010        for _, st in ipairs(sc.steps) do\010            if H.door ~= door or not Alive then return end\010            if type(st) == \"number\" then waitUntil(st, function() return H.finished end)\010            else pcall(function() r:FireServer(st) end) end\010        end\010        return\010    end\010    -- porta \"treat\": aceita o doce e fecha o dialogo\010    if not he then return end\010    pcall(function() if sc and sc.treatArg then he:FireServer(\"AcceptReward\", sc.treatArg) else he:FireServer(\"AcceptReward\") end end)\010    waitUntil(3.5, function() return H.finished end)\010    pcall(function() he:FireServer(\"TreatDialogueClosed\") end)\010end\010local function doorParts(door)\010    local prox = door:FindFirstChild(\"Proximity\")\010    local prompt = prox and prox:FindFirstChild(\"ProximityPrompt\")\010    local pos\010    if prox and prox:IsA(\"BasePart\") then pos = prox.Position\010    else\010        local part = door:FindFirstChild(\"Part\")\010        if part and part:IsA(\"BasePart\") then pos = part.Position end\010    end\010    return prompt, pos\010end\010local function doorReady(door)\010    if not door.Parent or (H.bl[door] or 0) > os.clock() then return false end\010    if door:GetAttribute(\"DoorOpen\") then return false end\010    local cd = door:GetAttribute(\"CooldownUntil\")\010    if type(cd) == \"number\" and workspace:GetServerTimeNow() < cd then return false end\010    local prompt, pos = doorParts(door)\010    return prompt ~= nil and pos ~= nil and prompt.Enabled\010end\010H.set = {}\010task.spawn(function()\010    local map = workspace:WaitForChild(\"Map\", 30)\010    if not map then return end\010    local function adopt(d) if d.Name == \"HalloweenDoor\" and d:IsA(\"Model\") then H.set[d] = true end end\010    map.DescendantAdded:Connect(adopt)\010    for _, d in ipairs(map:GetDescendants()) do adopt(d) end\010end)\010function H.active() return workspace:GetAttribute(\"HalloweenEventActive\") == true end\010function H.doors()\010    if os.clock() - H.cacheAt > 1 then\010        H.cacheAt = os.clock()\010        H.cache = {}\010        for d in pairs(H.set) do\010            if d.Parent then H.cache[#H.cache + 1] = d else H.set[d] = nil end\010        end\010    end\010    return H.cache\010end\010local function enemySet()\010    local set = setmetatable({}, { __mode = \"k\" })\010    local en = workspace:FindFirstChild(\"Enemies\")\010    for _, e in ipairs(en and en:GetChildren() or {}) do set[e] = true end\010    return set\010end\010local function newFoe(hrp, center)\010    local en = workspace:FindFirstChild(\"Enemies\")\010    local best, bd, deep, dd\010    for _, e in ipairs(en and en:GetChildren() or {}) do\010        if not (H.snap and H.snap[e]) then\010            local hum, root = aliveParts(e)\010            if hum and root and (root.Position - center).Magnitude < 300 then\010                local dist = (root.Position - hrp.Position).Magnitude\010                if root.Position.Y < center.Y - 5 then\010                    if not dd or dist < dd then deep, dd = e, dist end      -- debaixo da agua: espera subir\010                elseif not bd or dist < bd then best, bd = e, dist end\010            end\010        end\010    end\010    return best, deep\010end\010local function give_up(why, secs)\010    H.bl[H.door] = os.clock() + (secs or 120)\010    hsay(\"Skipping door: \" .. why)\010    H.door, H.info, H.finished, H.handled, H.snap = nil, nil, false, false, nil\010end\010-- ---- Auto Kill Halloween Bosses (Lobisomen \"Boss Fight\" e \"Hellfire Boss\") ----\010-- O portal (parte \"comm\") aparece em door.Part; o servidor leva quem estiver na porta para o dominio do boss\010-- (evento \"BossTeleportSound\"; o dominio fica bem longe/abaixo do mapa) e o boss nasce em workspace.Enemies\010-- (\"Unbound Werewolf\"; o Hellfire e achado por nome com \"Hell\"/\"Fire\" ou por ser o inimigo vivo mais perto no dominio).\010local function bossPos(door)\010    local part = door and door:FindFirstChild(\"Part\")\010    if part and part:IsA(\"BasePart\") then return (part.CFrame * CFrame.new(0, 0, -0.5)).Position end\010    local _, pos = doorParts(door)\010    return pos\010end\010local function bossFoe(hrp)\010    local en = workspace:FindFirstChild(\"Enemies\")\010    local best, bd, pref\010    for _, e in ipairs(en and en:GetChildren() or {}) do\010        local hum, root = aliveParts(e)\010        if hum and root then\010            local dist = (root.Position - hrp.Position).Magnitude\010            local nm = e.Name:lower()\010            local p = nm:find(\"werewolf\", 1, true) or nm:find(\"hell\", 1, true) or nm:find(\"inferno\", 1, true) or nm:find(\"boss\", 1, true)\010            if p and not pref then best, bd, pref = e, dist, true\010            elseif (p and pref or (not p and not pref)) and (not bd or dist < bd) and dist < 400 then best, bd = e, dist end\010        end\010    end\010    return best\010end\010function H.wants()\010    if H.boss and Config.HalBoss and os.clock() - H.boss.t < 240 then return true end\010    if not Config.HalEvent then return false end\010    if H.door then return true end\010    if not H.active() then return false end\010    for _, d in ipairs(H.doors()) do if doorReady(d) then return true end end\010    return os.clock() >= (H.restUntil or 0)\010end\010function H.bossStep(hrp)\010    local b = H.boss\010    if not b or not Config.HalBoss then return false end\010    local age = os.clock() - b.t\010    if age > 240 or not b.door or not b.door.Parent then H.boss = nil; return false end\010    local tag = (b.ev == \"Hellfire Boss\") and \"Hellfire\" or \"Werewolf\"\010    local foe = bossFoe(hrp)\010    if b.stage == 0 then\010        -- ainda na cidade: vai ate o portal e espera o teleporte\010        local pos = bossPos(b.door)\010        if not pos then H.boss = nil; return false end\010        b.home = b.home or hrp.Position\010        if (hrp.Position - b.home).Magnitude > 600 or hrp.Position.Y < -1500 or (foe and (foe.Name:lower():find(\"werewolf\", 1, true) or foe.Name:lower():find(\"hell\", 1, true)) and (foe:GetPivot().Position - hrp.Position).Magnitude < 250) then\010            b.stage, b.inAt = 1, os.clock()\010            return true\010        end\010        hsay(string.format(\"%s boss: going into the portal\", tag))\010        State.Text = H.status\010        if (hrp.Position - pos).Magnitude > 3 then flyTo(CFrame.new(pos)); return true end\010        b.near = b.near or os.clock()\010        -- encostar no portal teleporta: for\195\167a o toque na parte do portal/porta\010        if os.clock() - (b.touch or 0) > 1.5 then\010            b.touch = os.clock()\010            local pp = b.door:FindFirstChild(\"Part\")\010            if pp and pp:IsA(\"BasePart\") and firetouchinterest then\010                pcall(function() firetouchinterest(hrp, pp, 0); task.wait(); firetouchinterest(hrp, pp, 1) end)\010            end\010            pcall(function() hrp.CFrame = CFrame.new(pos) end)\010        end\010        local hf = ReplicatedStorage:FindFirstChild(\"Remotes\") and ReplicatedStorage.Remotes:FindFirstChild(\"HalloweenFunction\")\010        if os.clock() - b.near > 4 and os.clock() - (b.poke or 0) > 5 then\010            b.poke = os.clock()\010            local prompt = doorParts(b.door)\010            pcall(function() if prompt then fireproximityprompt(prompt) end end)\010            if hf and hf:IsA(\"RemoteFunction\") then task.spawn(function() pcall(function() hf:InvokeServer(b.door) end) end) end\010        end\010        if age > 90 and not foe then H.boss = nil; return false end\010        return true\010    end\010    -- dentro do dominio do boss\010    if foe then\010        b.lastFoe = os.clock()\010        hsay(string.format(\"%s boss: killing %s\", tag, foe.Name))\010        State.Text = H.status\010        fightEnemy(foe, { foe.Name }, false)\010        return true\010    end\010    -- sem inimigo: acabou (ou ainda esta carregando)\010    local idle = os.clock() - (b.lastFoe or b.inAt)\010    if idle < 12 and not H.bossOver then\010        hsay(string.format(\"%s boss: waiting for the boss\", tag))\010        State.Text = H.status\010        return true\010    end\010    H.n += 1\010    hsay(string.format(\"%s boss done (%d done)\", tag, H.n))\010    -- se o jogo nao devolveu o jogador, volta para onde estava\010    if b.home and (hrp.Position - b.home).Magnitude > 600 then\010        task.wait(4)\010        local _, h2 = getChar()\010        if h2 and (h2.Position - b.home).Magnitude > 600 then pcall(function() h2.CFrame = CFrame.new(b.home + Vector3.new(0, 5, 0)) end) end\010    end\010    H.bossOver = nil\010    H.bossDone = b.door\010    H.boss = nil\010    return true\010end\010function H.step()\010    local char, hrp = getChar()\010    if not (char and hrp) then return false end\010    State.Mode = \"Halloween Event\"\010    if H.boss and Config.HalBoss then\010        if H.bossStep(hrp) then return true end\010    end\010    if not Config.HalEvent then return false end\010    -- ---- porta em andamento ----\010    local door = H.door\010    if door then\010        if not door.Parent then give_up(\"door gone\", 30); return true end\010        local prompt, dpos = doorParts(door)\010        if not dpos then give_up(\"door has no position\", 60); return true end\010        if not H.info then\010            -- ainda nao abriu: chega perto e aperta o \"E\"\010            hsay(string.format(\"Going to a door (%d done)\", H.n))\010            State.Text = H.status\010            if (hrp.Position - dpos).Magnitude > 7 then flyTo(CFrame.new(dpos + Vector3.new(0, 3, 0))); return true end\010            if os.clock() - H.doorAt > 25 then give_up(\"door did not open\", 90); return true end\010            if os.clock() - H.pressAt > 3 then\010                H.pressAt = os.clock()\010                pcall(function() if prompt then fireproximityprompt(prompt) end end)\010            end\010            return true\010        end\010        -- ---- cena em andamento ----\010        if not H.handled then\010            H.handled = true\010            local info = H.info\010            task.spawn(function() pcall(H.handle, door, info) end)\010        end\010        if H.finished then\010            H.n += 1\010            hsay(string.format(\"Door done: %s (%d done)\", H.last, H.n))\010            H.bl[door] = os.clock() + 20\010            H.door, H.info, H.finished, H.handled, H.snap = nil, nil, false, false, nil\010            task.spawn(closeDlg)\010            return true\010        end\010        if os.clock() - (H.openedAt or os.clock()) > ((H.last == \"Mystery Hall\" or H.last == \"Tarot\") and 240 or 130) then give_up(\"scene timed out (\" .. H.last .. \")\", 150); return true end\010        State.Text = H.status\010        if hrp.Position.Y < dpos.Y - 12 then hrp.CFrame = CFrame.new(dpos + Vector3.new(0, 6, 0)) end   -- nunca fica debaixo da agua\010        local foe, deepFoe = newFoe(hrp, dpos)\010        if foe then\010            H.deepSince = nil\010            hsay(\"Killing \" .. foe.Name .. \" (\" .. H.last .. \")\")\010            State.Text = H.status\010            fightEnemy(foe, { foe.Name }, false)\010            return true\010        end\010        if deepFoe then\010            -- inimigo ainda debaixo da agua: fica em cima, perto da porta, e espera ele subir (so mergulha depois de 35 s)\010            if H.deepDoor ~= door or not H.deepSince then H.deepDoor, H.deepSince = door, os.clock() end\010            if os.clock() - H.deepSince < 35 then\010                hsay(\"Waiting for \" .. deepFoe.Name .. \" to come up (\" .. H.last .. \")\")\010                State.Text = H.status\010                if (hrp.Position - (dpos + Vector3.new(0, 4, 0))).Magnitude > 8 then flyTo(CFrame.new(dpos + Vector3.new(0, 4, 0))) end\010                return true\010            end\010            fightEnemy(deepFoe, { deepFoe.Name }, false)\010            return true\010        end\010        hsay(\"Scene: \" .. H.last)\010        State.Text = H.status\010        if (hrp.Position - dpos).Magnitude > 40 and os.clock() >= (H.holdUntil or 0) then flyTo(CFrame.new(dpos + Vector3.new(0, 3, 0))) end\010        return true\010    end\010    -- ---- escolher a proxima porta ----\010    local best, bd\010    for _, d in ipairs(H.doors()) do\010        if doorReady(d) then\010            local _, pos = doorParts(d)\010            local dist = (pos - hrp.Position).Magnitude\010            if not bd or dist < bd then best, bd = d, dist end\010        end\010    end\010    if not best then\010        local n = #H.doors()\010        if not H.active() then\010            hsay(string.format(\"Waiting for the event (starts at every XX:00) - %d done\", H.n))\010            State.Text = H.status\010            H.tour = nil\010            return false\010        end\010        -- evento ativo mas nenhuma porta pronta carregada: as portas ficam espalhadas pelo mapa e so carregam perto,\010        -- entao visita as ilhas uma a uma (igual ao Chest Farm) ate achar uma\010        if os.clock() >= (H.restUntil or 0) then\010            if not H.tour then H.tour, H.tourI, H.tourAt, H.dwell = AFL.chestTourBuild(hrp.Position), 1, os.clock(), nil end\010            local tgt = H.tour[H.tourI]\010            if tgt then\010                hsay(string.format(\"Looking for doors: island %d/%d (%d doors known, %d done)\", H.tourI, #H.tour, n, H.n))\010                State.Text = H.status\010                local goal = tgt + Vector3.new(0, 90, 0)\010                if (hrp.Position - goal).Magnitude > 60 and os.clock() - H.tourAt < 40 then flyTo(CFrame.new(goal)); return true end\010                H.dwell = H.dwell or (os.clock() + 1.5)\010                if os.clock() < H.dwell then return true end\010                H.tourI, H.tourAt, H.dwell = H.tourI + 1, os.clock(), nil\010                return true\010            end\010            H.tour, H.restUntil = nil, os.clock() + 10\010        end\010        hsay(string.format(\"Event is on, but no ready door found (%d done, %d doors known)\", H.n, n))\010        State.Text = H.status\010        return false\010    end\010    H.door, H.doorAt, H.info, H.finished, H.handled, H.pressAt, H.snap = best, os.clock(), nil, false, false, 0, enemySet()\010    return true\010end\010\010-- Sea 2 (cafe): se o personagem sentar numa cadeira/banco no meio do farm, levanta sozinho (pula)\010task.spawn(function()\010    while Alive do\010        task.wait(0.4)\010        if Config.HalEvent or Config.HalBoss or Config.PumpOn or Config.PumpHop then\010            pcall(function()\010                local c = getChar()\010                local hum = c and c:FindFirstChildOfClass(\"Humanoid\")\010                if hum and hum.Sit then\010                    hum.Sit = false\010                    hum:ChangeState(Enum.HumanoidStateType.Jumping)\010                    hum.Jump = true\010                end\010            end)\010        end\010    end\010end)\010\010-- ----------------------------------------------------------------------- UI ----\010do\010    local T = Tabs.Halloween\010    T:AddSection(\"Farm Event\")\010    T:AddToggle(\"HalEvent\", { Title = \"Auto Halloween Event\", Description = \"Knocks on the Halloween doors (Sea 1, 2 and 3) and plays what each door gives: takes the candy, kills the enemies that show up, and goes to the next door. Goes before Break Pumpkins.\", Default = Config.HalEvent and true or false })\010        :OnChanged(function(v) Config.HalEvent = v; persist() end)\010    T:AddToggle(\"HalBoss\", { Title = \"Auto Kill Halloween Bosses\", Description = \"When a door opens a boss (Werewolf or Hellfire), it flies to the portal, goes in and kills the boss. Works on its own, and goes before everything else in this tab. Works in Sea 1, 2 and 3.\", Default = Config.HalBoss and true or false })\010        :OnChanged(function(v) Config.HalBoss = v; persist() end)\010    T:AddSection(\"Pumpkin Hunt\")\010    T:AddToggle(\"PumpOn\", { Title = \"Break Pumpkins\", Description = \"Flies to the pumpkins spread over the map and breaks them (3 hits each) with your Melee. It is part of the priority list.\", Default = Config.PumpOn and true or false })\010        :OnChanged(function(v) Config.PumpOn = v; persist() end)\010    T:AddToggle(\"PumpHop\", { Title = \"Break Pumpkins Hop\", Description = \"Breaks every pumpkin in the server, then changes server and does it again, forever. Works on its own (you do not need Break Pumpkins on).\", Default = Config.PumpHop and true or false })\010        :OnChanged(function(v) Config.PumpHop = v; persist() end)\010    T:AddToggle(\"PumpRare\", { Title = \"Include Rare Pumpkins\", Description = \"Also hits the rare pumpkins (they summon a snowman)\", Default = Config.PumpRare ~= false })\010        :OnChanged(function(v) Config.PumpRare = v; persist() end)\010    T:AddSection(\"Gacha\")\010    T:AddToggle(\"HalGacha\", { Title = \"Auto Roll Gacha Event\", Description = \"Rolls the Spooky Halloween Gacha (Zioles, 500 Candy Corn) from anywhere, up to 2 rolls per hour, as soon as the game allows it. Needs the Candy Corn.\", Default = Config.HalGacha and true or false })\010        :OnChanged(function(v) Config.HalGacha = v; if v then G.nextAt = 0 end; persist() end)\010    T:AddSection(\"Info\")\010    local info = T:AddParagraph({ Title = \"Status\", Content = \"Off\" })\010    task.spawn(function()\010        while Alive do\010            task.wait(1.5)\010            pcall(function() info:SetDesc(string.format(\"Event: %s\\nPumpkins: %s\\nBroken in this session: %d\\nGacha: %s\", H.status, P.status, P.n, G.status)) end)\010        end\010    end)\010end\010";
