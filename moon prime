        DV.src.halloween = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Aim, Config, Core, Diag, Fluent, Player, State, Tabs = __E.Aim, __E.Config, __E.Core, __E.Diag, __E.Fluent, __E.Player, __E.State, __E.Tabs\010local aliveParts, equipWeapon, fightEnemy, flyTo, getChar, persist = __E.aliveParts, __E.equipWeapon, __E.fightEnemy, __E.flyTo, __E.getChar, __E.persist\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ============ HALLOWEEN 2026 (Sea 1) ============\010-- Break Pumpkins: as aboboras ficam em workspace.PumpkinHunt (um Model por abobora). O codigo do jogo (HalloweenLocal.PumpkinHunt) diz:\010--   * atributos do Model: PumpkinState (\"Idle\" -> \"Shaking\" -> \"Burst\"/\"Awakening\"; a rara usa \"Summoning\"), PumpkinHits (0..3),\010--     PumpkinRare, PumpkinCrackedBy (UserId de quem quebrou); HITS_TO_BREAK = 3\010--   * o golpe sai pelo combate normal: RE/RegisterAttack:FireServer() e RE/RegisterHit:FireServer(<parte da abobora>)\010--     (formas conferidas no dump pos-update: 5980x FireServer() e 143x FireServer(MeshPart de PumpkinHunt.Pumpkin.pumpkinv2))\010-- Hop: sem abobora no servidor depois de rodar o mapa, troca de servidor (mesmo AFL.hopRequest dos outros farms).\010local function d(k, v) if Config[k] == nil then Config[k] = v end end\010d(\"PumpOn\", false); d(\"PumpHop\", false); d(\"PumpRare\", true); d(\"HalGacha\", false); d(\"HalEvent\", false); d(\"HalBoss\", false)\010\010local P = { n = 0, cur = nil, since = 0, hitsSeen = 0, hitsAt = 0, bl = setmetatable({}, { __mode = \"k\" }), tour = nil, tourI = 1, tourAt = 0,\010    dwell = nil, restUntil = 0, noneSince = nil, status = \"Off\", lastShot = 0 }\010AFL.Pump = P\010\010local function say(t) P.status = t; Diag.pump = t end\010local function net(name)\010    local m = ReplicatedStorage:FindFirstChild(\"Modules\")\010    local n = m and m:FindFirstChild(\"Net\")\010    return n and n:FindFirstChild(name)\010end\010local function pumpFolder() return workspace:FindFirstChild(\"PumpkinHunt\") end\010local function partOf(m)\010    if not m then return nil end\010    if m:IsA(\"BasePart\") then return m end\010    if m:IsA(\"Model\") and m.PrimaryPart then return m.PrimaryPart end\010    local best\010    for _, x in ipairs(m:GetDescendants()) do\010        if x:IsA(\"MeshPart\") then return x end\010        if x:IsA(\"BasePart\") and not best then best = x end\010    end\010    return best\010end\010-- aboboras que ainda podem ser quebradas (Idle ou sem estado ainda)\010function P.list()\010    local out = {}\010    local f = pumpFolder()\010    if not f then return out end\010    for _, m in ipairs(f:GetChildren()) do\010        if m:IsA(\"Model\") and m.Parent then\010            local st = m:GetAttribute(\"PumpkinState\")\010            local rare = m:GetAttribute(\"PumpkinRare\") == true\010            if (st == nil or st == \"Idle\") and (Config.PumpRare ~= false or not rare) and (P.bl[m] or 0) < os.clock() then\010                local p = partOf(m)\010                if p then out[#out + 1] = { m = m, p = p } end\010            end\010        end\010    end\010    return out\010end\010local function shoot(part)\010    -- 1 golpe por chamada: o do proprio jogo (CombatFramework) + os remotes de registro com os argumentos reais\010    Aim.part = part\010    pcall(function() if Core and Core.meleeSwordClick then Core.meleeSwordClick(\"Melee\") end end)\010    local now = os.clock()\010    if now - P.lastShot >= 0.12 then\010        P.lastShot = now\010        pcall(function()\010            local ra, rh = net(\"RE/RegisterAttack\"), net(\"RE/RegisterHit\")\010            if ra then ra:FireServer() end\010            if rh then rh:FireServer(part) end\010        end)\010    end\010end\010\010-- Quando uma abobora \"acorda\" (PumpkinState = \"Awakening\") o jogo cria o NPC \"Jack o' Lantern\" (PumpkinHunt.JACK_NAME) em workspace.Enemies;\010-- a abobora rara vira