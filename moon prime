rn h and h.Health > 0 and m:FindFirstChild(\"HumanoidRootPart\") ~= nil\010    end\010    local ALLYATTR = { \"Ally\", \"IsAlly\", \"Friendly\", \"IsFriendly\", \"Summoned\", \"IsSummon\", \"IsSummoned\", \"PlayerOwned\", \"IsPlayerOwned\", \"Minion\", \"IsMinion\", \"IsShadow\" }\010    local OWNKEYS = { \"Owner\", \"OwnerId\", \"OwnerUserId\", \"OwnerName\", \"Master\", \"Summoner\", \"SummonedBy\" }\010    -- aliado do jogador (ex.: o Shadow que a carta da dungeon invoca): nunca e alvo nem e puxado\010    -- v60 fix: so comparava com o NOME DO JOGADOR LOCAL (me) - a sombra de um ALIADO (outro player na sala) tinha nome\010    -- diferente do seu e passava reto por essas checagens (so os padroes genericos \"shadow\"/\"ally\"/\"summon\" pegavam ela\010    -- as vezes). Agora compara contra TODOS os jogadores da sala, nao so voce.\010    local function isAllyModel(m, me)\010        local n = string.lower(m.Name)\010        if n == \"shadow\" or string.find(n, \"^shadow ?ally\") or string.find(n, \"^shadow ?clone\") or string.find(n, \"shadowally\", 1, true)\010            or string.find(n, \"%f[%a]ally%f[%A]\") or string.find(n, \"%f[%a]summon\") then return true end\010        for _, p in ipairs(PlayersSvc:GetPlayers()) do\010            local ln = string.lower(p.Name)\010            if n == ln or (#ln >= 5 and string.find(n, ln, 1, true)) then return true end\010            local ldn = p.DisplayName ~= \"\" and string.lower(p.DisplayName) or nil\010            if ldn and (#ldn >= 5 and string.find(n, ldn, 1, true)) then return true end\010        end\010        for _, a in ipairs(ALLYATTR) do if m:GetAttribute(a) == true then return true end end\010        for _, a in ipairs(OWNKEYS) do\010            local v = m:GetAttribute(a)\010            if v ~= nil then\010                for _, p in ipairs(PlayersSvc:GetPlayers()) do\010                    if v == p.UserId or v == p.Name or v == p.DisplayName then return true end\010                end\010            end\010            local o = m:FindFirstChild(a)\010            if o and o:IsA(\"ObjectValue\") then\010                for _, p in ipairs(PlayersSvc:GetPlayers()) do\010                    if o.Value == p or (p.Character ~= nil and o.Value == p.Character) then return true end\010                end\010            end\010        end\010        return false\010    end\010    local mobCache, mobAt = {}, 0\010    local function mobs()\010        if os.clock() - mobAt < 0.3 then return mobCache end\010        mobAt = os.clock()\010        scanFolders()\010        local out, seen = {}, {}\010        for _, f in ipairs(folders) do\010            if f.Parent then\010                for _, m in ipairs(f:GetChildren()) do\010                    if m:IsA(\"Model\") and not seen[m] and alive(m) and not PlayersSvc:GetPlayerFromCharacter(m) and not isAllyModel(m, Player) then seen[m] = true; out[#out + 1] = m end\010                end\010            end\010        end\010        mobCache = out\010        return out\010    end\010    local function isBoss(m)\010        if m:GetAttribute(\"IsBoss\") or m:GetAttribute(\"Boss\") or m.Name:find(\"Boss\") or m.Name:find(\"Zero\") then return true end\010        local h = m:FindFirstChild(\"Humanoid\")\010        return h ~= nil and h.MaxHealth >= 250000\010    end\010    local function isProp(m)\010        if m.Name == \"PropHitboxPlaceholder\" then return true end\010        local hd, rt = m:FindFirstChild(\"Head\"), m:FindFirstChild(\"HumanoidRootPart\")\010        if hd and rt and hd:IsA(\"BasePart\") and rt:IsA(\"BasePart\") and hd.Size.Y <= 0.5 and rt.Size.X >= 6 then\010            local h = m:FindFirstChild(\"Humanoid\")\010            return h ~= nil and h.MaxHealth > 0 and h.MaxHealth <= CFG.propHP\010        end\010        return false\010    end\010    local stuckM, stuckHP, stuckAt = nil, 0, 0\010    local function stalled(m)\010        local h = m and m.Parent and m:FindFirstChild(\"Humanoid\")\010        if not h then stuckM = nil; return false end\010        if m ~= stuckM then stuckM, stuckHP, stuckAt = m, h.Health, os.clock(); return false end\010        if h.Health < stuckHP - 1 then stuckHP, stuckAt = h.Health, os.clock(); return false end\010        return os.clock() - stuckAt > CFG.stall\010    end\010    -- v63: antes, quando \"stalled(bn)\" dava true (5s tentando sem tirar vida dele - sombra/clone de aliado que o\010    -- jogo nao deixa morrer, prop travado, mob fantasma puxado etc.) e nao tinha PROP por perto pra trocar, a funcao\010    -- simplesmente devolvia o MESMO bn de novo (nunca soltava). Era por isso que a Dungeon \"ficava so tentando matar\010    -- esse NPC\" (pedido do usuario: carta Shadow) e nao soltava NPC fantasma. Agora: apos 5s sem dano, o alvo entra\010    -- numa lista negra temporaria (8s) e e ignorado na proxima varredura, liberando a farm pra ir em outro mob/prop\010    -- ou seguir pra porta do andar.\010    local DGH = setmetatable({}, { __mode = \"k\" })   -- modelo -> at\195\169 quando ignorar (lista negra de \"travado\")\010    local function pickTarget()\010        local hrp = hrpf(); if not hrp then return end\010        local list = mobs()\010        local now = os.clock()\010        local bp, bpd, bb, bbd, bn, bnd = nil, math.huge, nil, math.huge, nil, math.huge\010        for _, m in ipairs(list) do\010            if not (DGH[m] and DGH[m] > now) then\010                local r = m.Parent and m:FindFirstChild(\"HumanoidRootPart\")\010                if r then\010                    local d = (r.Position - hrp.Position).Magnitude\010                    if isProp(m) then if d < bpd then bpd, bp = d, m end\010                    elseif isBoss(m) then if d < bbd then bbd, bb = d, m end\010                    elseif d < bnd then bnd, bn = d, m end\010                end\010            end\010        end\010        local isB = false\010        if not (bn and bnd <= CFG.hit) and bb then isB = true; bn = bb end\010        if bn and not isB and stalled(bn) then\010            DGH[bn] = now + 8\010            bn = nil\010        end\010        if bp and bpd <= CFG.propR and bn == nil then return bp, false, true end\010        return bn, isB, false\010    end\010\010    -- ===== arma / ataque =====\010    local function toolByTip(tip)\010        for _, c in ipairs({ Player.Backpack, char() }) do\010            if c then for _, t in ipairs(c:GetChildren()) do if t:IsA(\"Tool\") and t.ToolTip == tip then return t.Name end end end\010        end\010    end\010    local function wantedTool()\010        local n = toolByTip(Config.DunWeapon)\010        if n then return n, Config.DunWeapon end\010        for _, tip in ipairs({ \"Melee\", \"Sword\", \"Blox Fruit\", \"Gun\" }) do\010            n = toolByTip(tip); if n then return n, tip end\010        end\010    end\010    local function equip()\010        local c, hum = char(), humf()\010        if not c or not hum then return end\010        local name = wantedTool(); if not name then return end\010        local cur = c:FindFirstChildOfClass(\"Tool\")\010        if cur and cur.Name == name then return end\010        local t = Player.Backpack:FindFirstChild(name)\010        if t then hum:EquipTool(t) end\010    end\010    local busoAt = 0\010    local function buso()\010        local c = char()\010        if not c or c:FindFirstChild(\"HasBuso\") or os.clock() - busoAt < 4 then return end\010        busoAt = os.clock()\010        pcall(function() RS.Remotes.CommF_:InvokeServer(\"Buso\") end)\010    end\010    local atkFlag, atkAt = false, 0\010    local function attackOnce()\010        local c = char(); if not c then return end\010        local tool = c:FindFirstChildOfClass(\"Tool\"); if not tool then return end\010        local hrp = c:FindFirstChild(\"HumanoidRootPart\"); if not hrp then return end\010        local stun = c:FindFirstChild(\"Stun\")\010        if stun and stun.Value ~= 0 then return end\010        local hits = {}\010        for _, m in ipairs(mobs()) do\010            local r = m.Parent and m:FindFirstChild(\"HumanoidRootPart\")\010            if r and (r.Position - hrp.Position).Magnitude <= CFG.hit then hits[#hits + 1] = { m, r } end\010        end\010        if #hits == 0 then return end\010        -- v111: tool.ToolTip -> Core.wtip (ToolTip com fallback pra GetAttribute(\"WeaponType\")), mesmo motivo do\010        -- fix no engine principal (click normal de espada/estilo de luta parando de ser reconhecido)\010        local wt = (Core.wtip and Core.wtip(tool)) or tool.ToolTip\010        if wt == \"Blox Fruit\" then\010            local rem = tool:FindFirstChild(\"LeftClickRemote\")\010            if rem and rem:IsA(\"RemoteEvent\") then\010                rem:FireServer(Vector3.new(0, -500, 0), math.random(1, 4), true)\010                task.wait(0.01)\010                rem:FireServer(false)\010            end\010            return\010        end\010        if wt == \"Melee\" or wt == \"Sword\" then\010            -- v61 fix: a Dungeon tinha seu PROPRIO click de Melee/Sword, mais simples que o do resto do hub (Farm\010            -- normal/Sea/Vulcan/Mastery) - sem o reforco do golpe do proprio jogo (CombatFramework). Agora usa o\010            -- MESMO reforco (Core.cfAttack) que faz o golpe de verdade do jogo acontecer junto com o RegisterHit.\010            if Core.cfAttack and os.clock() - (D.cfAt or 0) > 0.2 then D.cfAt = os.clock(); pcall(Core.cfAttack) end\010            local net = RS:FindFirstChild(\"Modules\") and RS.Modules:FindFirstChild(\"Net\")\010            local ra, rh = net and net:FindFirstChild(\"RE/RegisterAttack\"), net and net:FindFirstChild(\"RE/RegisterHit\")\010            if ra and rh then\010                -- v26: formato do script do usuario: UM pacote com todas as partes de todos os alvos no alcance\010                local list, head = {}, nil\010                for i = 1, #hits do\010                    local mm = hits[i][1]\010                    local n0 = #list\010                    for _, pt in ipairs(mm:GetChildren()) do\010                        if pt:IsA(\"BasePart\") then list[#list + 1] = { mm, pt } end\010                    end\010                    if #list == n0 then list[#list + 1] = { mm, hits[i][2] } end\010                    head = head or mm:FindFirstChild(\"Head\") or hits[i][2]\010                    if #list >= 160 then break end\010                end\010                local hash = tostring(Player.UserId):sub(2, 4) .. tostring(coroutine.running()):sub(11, 15)\010                ra:FireServer()\010                rh:FireServer(head, list, {}, hash)\010                pcall(function() Core.secureHit(head, list) end)\010            end\010        end\010    end\010    task.spawn(function()\010        while Alive do\010            if atkFlag and D.active then\010                if os.clock() - atkAt > 1.2 then atkFlag = false; task.wait(0.25)\010                else pcall(attackOnce); task.wait(CFG.atkDelay) end\010            else task.wait(0.25) end\010        end\010    end)\010    local hooked = setmetatable({}, { __mode = \"k\" })\010    local function watchKill(m)\010        if hooked[m] then return end\010        hooked[m] = true\010        local h = m:FindFirstChild(\"Humanoid\")\010        if h then local c; c = h.Died:Connect(function() S.kills += 1; c:Disconnect() end) end\010    end\010    local bringAt = 0\010    -- Bring Mob Dungeons: junta os outros inimigos (sem chefe/prop/aliado) em cima do alvo para bater em todos de uma vez.\010    -- v97: Bring Mob refeito do zero, de um jeito so (sem nenhum \"V2\" junto). Antes existiam DOIS caminhos aqui: um\010    -- \"V1\" que so fazia um CFrame pontual a cada 0,25s SEM nenhuma trava (o mob conseguia andar/fugir entre um puxao\010    -- e outro) e um \"V2\" (BodyPosition fisica + CollectionService) que nunca rodava de verdade (Config.BringMobV2\010    -- sempre devolvia false - ve o GET/SET em pcompat, so existe pra nao quebrar quem le essa prop por fora) e so\010    -- ficava morto, confuso, no meio do codigo. Agora usa o MESMO motor forte do Bring Mob principal\010    -- (Core.pullMob/freeMob): colisao desligada em TODA parte do corpo, Animator apagado, ChangeState(Physics),\010    -- BodyVelocity \"BatmanLock\" com forca infinita e CFrame todo frame (dead-zone de 5 studs) - o mob fica\010    -- realmente travado no lugar, nao so teleportado de vez em quando. (Core ja vem do ambiente do modulo, __E.Core -\010    -- mesma tabela que getgenv().MoonPremiumCore - nao precisa buscar de novo.)\010    local bringHeld = setmetatable({}, { __mode = \"k\" })   -- mob -> true enquanto estiver preso no grupo atual\010    local function bringClear()\010        for m in pairs(bringHeld) do\010            bringHeld[m] = nil\010            if Core then pcall(Core.freeMob, m) end\010        end\010    end\010    local function bringMobs(target)\010        if not Config.DunBring then bringClear(); return end\010        if os.clock() - bringAt < 0.25 then return end\010        bringAt = os.clock()\010        local tr = target.Parent and target:FindFirstChild(\"HumanoidRootPart\"); if not tr then return end\010        local center = tr.Position\010        local lim = math.clamp(tonumber(Config.DunBringN) or 6, 2, 12)\010        local now = os.clock()\010        local list = {}\010        for _, o in ipairs(mobs()) do\010            -- v63: nao puxa quem ja foi marcado como \"travado\"/fantasma (pickTarget/DGH) - evita ficar puxando\010            -- NPC fantasma (ou a sombra/aliado que nunca morre) de novo pro grupo\010            if o ~= target and not isBoss(o) and not isProp(o) and not (DGH[o] and DGH[o] > now) then\010                local r = o:FindFirstChild(\"HumanoidRootPart\")\010                local h = o:FindFirstChildOfClass(\"Humanoid\")\010                if r and h and h.Health > 0 then\010                    local d = (r.Position - center).Magnitude\010                    if d <= 120 then list[#list + 1] = { r, d, h, o } end\010                end\010            end\010        end\010        table.sort(list, function(a, b) return a[2] < b[2] end)\010        local cf, keep = CFrame.new(center), {}\010        for i = 1, math.min(lim, #list) do\010            local r, h, o = list[i][1], list[i][3], list[i][4]\010            keep[o] = true\010            if Core then pcall(Core.pullMob, o, r, h, cf) else pcall(function() r.CFrame = cf; r.CanCollide = false end) end\010        end\010        for m in pairs(bringHeld) do\010            if not keep[m] then bringHeld[m] = nil; if Core then pcall(Core.freeMob, m) end end\010        end\010        for m in pairs(keep) do bringHeld[m] = true end\010        pcall(function() sethiddenproperty(Player, \"SimulationRadius\", math.huge) end)\010    end\010    local function fight(m, boss)\010        if not alive(m) then return false end\010        watchKill(m)\010        local hum = humf(); if not hum then return false end\010        if hum.Sit then hum.Sit = false end\010        local h = boss and CFG.bossKill or CFG.kill\010        local c = char()\010        local tool = c and c:FindFirstChildOfClass(\"Tool\")\010        if tool and tool.ToolTip == \"Blox Fruit\" then h = 15 end\010        if h > 30 then h = 20 end\010        goto_(m.HumanoidRootPart.CFrame * CFrame.new(-3, h, 0))\010        if not boss and not isProp(m) then\010            bringMobs(m)\010        end\010        equip(); buso()\010        atkFlag, atkAt = true, os.clock()\010        return true\010    end\010\010    -- ===== cartas (buffs) =====\010    local BUFFS = { \"AttackSpeedMultiplier\", \"Overflow\", \"Lifesteal\", \"AllCooldown\", \"Unbreakable\", \"Fortress\", \"Shadow\", \"FruitTAPCooldown\", \"Armor\", \"Defense\", \"Skyjumps\", \"RageGain\", \"RaceEnergy\", \"Sniper\", \"Size\" }\010    local WBUFF = { Melee = { \"Melee\", \"MeleeCooldown\", \"MeleeZCooldown\", \"MeleeXCooldown\", \"MeleeCCooldown\" }, Sword = { \"Sword\", \"SwordCooldown\", \"SwordZCooldown\", \"SwordXCooldown\" },\010        [\"Blox Fruit\"] = { \"Fruit\", \"FruitCooldown\", \"FruitZCooldown\", \"FruitXCooldown\", \"FruitVCooldown\", \"FruitCCooldown\" }, Gun = { \"Gun\", \"GunCooldown\", \"GunZCooldown\", \"GunXCooldown\" } }\010    local function rank(name)\010        -- v64: carta que o usuario marcou pra nunca escolher (ex.: \"Shadow\", que causava o bug de ficar preso\010        -- tentando matar o aliado/clone) vira a PIOR prioridade - so e escolhida se for a UNICA opcao na tela.\010        if type(Config.DunCardBlock) == \"table\" then\010            for _, b in ipairs(Config.DunCardBlock) do if b == name then return 1000 end end\010        end\010        for i, b in ipairs(BUFFS) do if b == name then return i end end\010        local _, tip = wantedTool()\010        for i, b in ipairs(WBUFF[tip or Config.DunWeapon] or {}) do if b == name then return #BUFFS + i end end\010        return 999\010    end\010    local cardAt = 0\010    local function hookCards()\010        if os.clock() - cardAt < 1 then return end\010        cardAt = os.clock()\010        local sh = RS:FindFirstChild(\"DungeonShared\")\010        local sel = sh and sh:FindFirstChild(\"BuffSelector\")\010        if sel and sel:IsA(\"RemoteFunction\") then\010            sel.OnClientInvoke = function(list)\010                if not Config.DunCard or type(list) ~= \"table\" then return nil end\010                local best, br = nil, math.huge\010                for _, c in ipairs(list) do\010                    local n = type(c) == \"table\" and c.buffName\010                    if n then local r = rank(n); if r < br then br, best = r, n end end\010                end\010                best = best or (list[1] and list[1].buffName)\010                if not best then return nil end\010                task.wait(CFG.buffDelay)\010                return best\010            end\010        end\010        local rep = sh and sh:FindFirstChild(\"BuffReplicator\")\010        if rep and rep:IsA(\"RemoteEvent\") and not D.repConn then\010            D.repConn = rep.OnClientEvent:Connect(function(b) if type(b) == \"table\" then S.buffs = b end end)\010        end\010        for _, nm in ipairs({ \"ResultsScreen\", \"ReturnToHub\" }) do\010            local ev = sh and sh:FindFirstChild(nm)\010            if ev and ev:IsA(\"RemoteEvent\") and not (D.endConn and D.endConn[nm]) then\010                D.endConn = D.endConn or {}\010                D.endConn[nm] = ev.OnClientEvent:Connect(function() D.finished = true; atkFlag = false end)\010            end\010        end\010    end\010\010    -- ===== andares =====\010    local function dungeonFolder() local m = workspace:FindFirstChild(\"Map\"); return m and m:FindFirstChild(\"Dungeon\") end\010    local function floorModel(n) local d = dungeonFolder(); return d and n and d:FindFirstChild(tostring(n)) end\010    local function floorCF(m)\010        if not m then return nil end\010        local at = m:GetAttribute(\"BoundingCF\")\010        local p = at and at.Position\010        if not p then local ok, pv = pcall(function() return m:GetPivot().Position end); if not ok then return nil end; p = pv end\010        return CFrame.new(p.X, p.Y + CFG.floorH, p.Z)\010    end\010    local function inside(m, pos)\010        local cf, sz = m:GetAttribute(\"BoundingCF\"), m:GetAttribute(\"BoundingSize\")\010        if not cf or not sz then return false end\010        local o = cf:PointToObjectSpace(pos)\010        return math.abs(o.X) <= sz.X * 0.5 and math.abs(o.Y) <= sz.Y * 0.5 and math.abs(o.Z) <= sz.Z * 0.5\010    end\010    local function currentFloor()\010        local hrp, d = hrpf(), dungeonFolder()\010        if not hrp or not d then return nil end\010        local near, nd\010        for _, f in ipairs(d:GetChildren()) do\010            local n = tonumber(f.Name)\010            if n then\010                if inside(f, hrp.Position) then return n end\010                local at = f:GetAttribute(\"BoundingCF\")\010                if at then local m = (at.Position - hrp.Position).Magnitude; if not nd or m < nd then nd, near = m, n end end\010            end\010        end\010        return near\010    end\010    local function highestFloor()\010        local d, hi = dungeonFolder(), nil\010        if not d then return nil end\010        for _, f in ipairs(d:GetChildren()) do local n = tonumber(f.Name); if n and (not hi or n > hi) then hi = n end end\010        return hi\010    end\010    local function rootOf(fl, nm)\010        local m = floorModel(fl); m = m and m:FindFirstChild(nm)\010        return m and m:FindFirstChild(\"Root\")\010    end\010    local lastTouch = 0\010    local function touch(part)\010        if os.clock() - lastTouch < 0.6 then return end\010        lastTouch = os.clock()\010        local hrp = hrpf()\010        if hrp and part and type(firetouchinterest) == \"function\" then\010            pcall(firetouchinterest, hrp, part, 0); task.wait(); pcall(firetouchinterest, hrp, part, 1)\010        end\010    end\010    local runInfo, runAt = nil, 0\010    local function findRun()\010        if runInfo and runInfo.Parent and runInfo:GetAttribute(\"CurrentExploredLevel\") ~= nil then return runInfo end\010        runInfo = nil\010        if not inRun() or os.clock() - runAt < 3 then return nil end\010        runAt = os.clock()\010        local function look(root, depth)\010            for _, c in ipairs(root:GetChildren()) do if c:GetAttribute(\"CurrentExploredLevel\") ~= nil then return c end end\010            if depth <= 0 then return nil end\010            for _, c in ipairs(root:GetChildren()) do\010                if (c:IsA(\"Folder\") or c:IsA(\"Configuration\")) and not ({ Map = 1, Camera = 1, Terrain = 1, Enemies = 1, Characters = 1, Debris = 1, Effect = 1, Sounds = 1 })[c.Name] then\010                    local r = look(c, depth - 1); if r then return r end\010                end\010            end\010        end\010        runInfo = look(workspace, 2) or look(RS, 2)\010        return runInfo\010    end\010    local function runStep()\010        local info = findRun()\010        hookCards()\010        if info then\010            S.floor = info:GetAttribute(\"CurrentExploredLevel\") or 0\010            S.dead, S.total, S.left = info:GetAttribute(\"DeadEnemies\") or 0, info:GetAttribute(\"TotalEnemies\") or 0, info:GetAttribute(\"TimeLeft\") or 0\010            local fl = info:FindFirstChild(\"Floors\")\010            if fl then local hi = 0; for _, c in ipairs(fl:GetChildren()) do local n = tonumber(c.Name); if n and n > hi then hi = n end end; S.maxFloor = hi end\010        end\010        if D.finished then stage(\"Finished: waiting to return to the hub\"); hoverHigh(); return end\010        local hum = humf()\010        if not hum or hum.Health <= 0 then stage(\"Waiting to respawn\"); return end\010        local m, boss, prop = pickTarget()\010        if m then\010            local hrp, rt = hrpf(), m:FindFirstChild(\"HumanoidRootPart\")\010            S.target = (prop and \"PROP \" or boss and \"BOSS \" or \"\") .. m.Name\010            stage((prop and \"Breaking blocking prop: \" or boss and \"Fighting boss \" or \"Fighting \") .. m.Name)\010            if fight(m, boss) then return end\010        end\010        atkFlag, S.target = false, \"-\"\010        local here = currentFloor()\010        if here then\010            local ex = rootOf(here, \"ExitTeleporter\")\010            if ex and ex.Parent and ex:FindFirstChild(\"TouchInterest\") then\010                local hrp = hrpf()\010                local d = hrp and (ex.Position - hrp.Position).Magnitude or 9999\010                stage(\"Going through the door of floor \" .. here .. \" -> \" .. (here + 1))\010                if d <= CFG.door then touch(ex) end\010                goto_(ex.CFrame)\010                return\010            end\010            if S.floor > here then\010                local en = rootOf(here + 1, \"EntranceTeleporter\")\010                if en then stage(\"Following the door to floor \" .. (here + 1)); goto_(en.CFrame * CFrame.new(0, 10, 0)); return end\010            end\010        end\010        local fm = floorModel(here) or floorModel(S.floor) or floorModel(highestFloor())\010        local cf = floorCF(fm)\010        if cf then stage(\"Scanning floor \" .. tostring(here or S.floor)); goto_(cf); return end\010        stage(\"Waiting for the new floor to load\")\010        hoverHigh()\010    end\010\010    -- ===== lobby (pads) =====\010    local function pads()\010        local f = D.padsFolder(); local out = {}\010        if f then for _, c in ipairs(f:GetChildren()) do if c:FindFirstChild(\"DungeonSettingsChanged\") and c:FindFirstChild(\"Pad\") then out[#out + 1] = c end end end\010        table.sort(out, function(a, b) return a.Name < b.Name end)\010        return out\010    end\010    local function energy()\010        local ok, r = pcall(function() return require(RS.DungeonClient.ReplicatedPlayerData).get() end)\010        if ok and type(r) == \"table\" and tonumber(r.CurrentEnergy) then return math.floor(tonumber(r.CurrentEnergy)) end\010        return nil -- v43: nao conseguiu ler: nao bloqueia o Start\010    end\010    local chosen, setAt, startAt = nil, 0, 0\010    local function pickPad()\010        local list = pads(); if #list == 0 then return nil end\010        local best, bs\010        for _, p in ipairs(list) do\010            local n, mx, who = p:GetAttribute(\"NumPlayersOnPad\") or 0, p:GetAttribute(\"MaxPlayers\") or 4, p:GetAttribute(\"Initiator\")\010            if n < mx then\010                local sc = n * 4 + ((who == Player.UserId) and 2 or (who == nil and 1 or 0))\010                if not bs or sc > bs then bs, best = sc, p end\010            end\010        end\010        if chosen and chosen.Parent then\010            local n, mx = chosen:GetAttribute(\"NumPlayersOnPad\") or 0, chosen:GetAttribute(\"MaxPlayers\") or 4\010            if n < mx then return chosen end\010        end\010        chosen = best or list[1]\010        return chosen\010    end\010    -- v93: Moon Sync - toca a animacao de sincronia (a mesma do Multi Account) so UMA vez por \"ida\" ao pad, quando a\010    -- conta que esta seguindo e uma conta sincronizada - reseta sozinho quando o alvo de follow muda ou some\010    local animedWith, animedAt\010    local function lobbyStep()\010        S.energy = energy() or S.energy or 0\010        local hrp = hrpf(); if not hrp then return end\010        local follow = Config.DunFollow\010        local followName = followPlayerName()\010        if follow ~= animedAt then animedWith, animedAt = nil, follow end\010        if not Config.DunStart and follow and follow ~= \"\" and follow ~= \"None\" then\010            local pl = PlayersSvc:FindFirstChild(followName)\010            local tr = pl and pl.Character and pl.Character:FindFirstChild(\"HumanoidRootPart\")\010            if tr then\010                stage(\"Joining \" .. followName)\010                pcall(function()\010                    local MS = getgenv().MoonHubSync\010                    if MS and MS.playAnim and MS.synced and MS.synced[pl.UserId] and animedWith ~= pl.UserId then\010                        animedWith = pl.UserId\010                        MS.playAnim(pl.UserId, pl.Name)\010                    end\010                end)\010                goto_(tr.CFrame * CFrame.new(0, 3, 0)); return\010            end\010            stage(\"Waiting for \" .. followName .. \" to appear\"); hoverHigh(); return\010        end\010        local padM = pickPad()\010        if not padM then stage(\"No pad found\"); hoverHigh(); return end\010        local pad = padM:FindFirstChild(\"Pad\")\010        if not Player:FindFirstChild(\"TeleporterPadObjectReference\") then\010            stage(\"Going to pad \" .. padM.Name .. \" (\" .. (padM:GetAttribute(\"NumPlayersOnPad\") or 0) .. \"/\" .. (padM:GetAttribute(\"MaxPlayers\") or 4) .. \")\")\010            goto_(pad.CFrame * CFrame.new(0, 4, 0))\010            return\010        end\010        goto_(pad.CFrame * CFrame.new(0, 4, 0))\010        if Player:GetAttribute(\"IsTeleporting\") or padM:GetAttribute(\"PreparingToTeleport\") then stage(\"Entering the dungeon...\"); return end\010        if not Config.DunStart then stage(\"On the pad: waiting for the other account to start\"); return end\010        local dsc = padM:FindFirstChild(\"DungeonSettingsChanged\")\010        local who = padM:GetAttribute(\"Initiator\")\010        if (who == Player.UserId or who == nil) and padM:GetAttribute(\"Difficulty\") ~= Config.DunDiff then\010            if os.clock() - setAt > 2 then setAt = os.clock(); dsc:FireServer(\"Difficulty\", Config.DunDiff) end\010            if who == Player.UserId then return end\010        end\010        -- v43: estando em cima do pad voce conta como 1 jogador (o atributo pode demorar/faltar)\010        local n = math.max(padM:GetAttribute(\"NumPlayersOnPad\") or 0, 1)\010        local need = math.max(Config.DunMin or 1, padM:GetAttribute(\"MinPlayers\") or 1)\010        if n < need then stage(string.format(\"Waiting for players %d/%d\", n, need)); return end\010        -- v93: pad completo e a conta configurada pra se juntar e uma conta sincronizada -> toca a animacao do Moon\010        -- Sync (uma vez so, por pad) pra confirmar visualmente que o grupo tah pronto\010        pcall(function()\010            local MS = getgenv().MoonHubSync\010            local pl = followName ~= \"\" and followName ~= \"None\" and PlayersSvc:FindFirstChild(followName)\010            if MS and MS.playAnim and pl and MS.synced and MS.synced[pl.UserId] and animedWith ~= pl.UserId then\010                animedWith = pl.UserId\010                MS.playAnim(pl.UserId, pl.Name)\010            end\010        end)\010        local cost = tonumber(Config.DunCost) or 0\010        local en = energy()\010        if cost > 0 and en and en < cost then stage(\"No energy \" .. en .. \"/\" .. cost); return end\010        if who ~= nil and who ~= Player.UserId then stage(\"Another player is the starter of this pad\"); return end\010        if os.clock() - startAt > 3 then startAt = os.clock(); stage(\"Starting the dungeon\"); dsc:FireServer(\"Start\") end\010    end\010\010    -- ===== passo principal (chamado pelo loop de prioridades) =====\010    local wasRun = false\010    function D.step()\010        if not (Config.DunFarm or Config.DunJoin) then\010            if D.active then D.halt() end\010            return false\010        end\010        local hrp = hrpf()\010        if hrp and hrp.Position.Y > -100 then D.lastGood = hrp.Position end\010        if inRun() then\010            if not Config.DunFarm then return false end\010            D.active = true\010            if not wasRun then wasRun, D.finished = true, false; S.runs += 1; S.dead = 0; cardAt = 0 end\010            pcall(runStep)\010            return true\010        end\010        if wasRun then\010            wasRun, D.finished, S.buffs = false, false, {}\010            atkFlag = false\010            bringClear()\010        end\010        if inHub() and Config.DunJoin then\010            D.active = true\010            pcall(lobbyStep)\010            return true\010        end\010        -- v42: Auto Join ligado mas fora do Hub: voa ate o Hub (carrega os pads) em vez de ignorar\010        if Config.DunJoin and hrp then\010            local hub = D.hubTarget()\010            local cf = hubPos(hub)\010            if cf then\010                D.active = true\010                local dist = (cf.Position - hrp.Position).Magnitude\010                stage(\"Flying to the Dungeon Hub (\" .. math.floor(dist) .. \" studs)\")\010                if goto_(cf * CFrame.new(0, 60, 0)) or dist < 120 then\010                    pcall(function()\010                        for _, d in ipairs(hub:GetDescendants()) do\010                            if d:IsA(\"ProximityPrompt\") and fireproximityprompt then fireproximityprompt(d) end\010                        end\010                    end)\010                end\010                return true\010            end\010            if D.active then D.halt() end\010            Diag.dungeon = \"Dungeon Hub not found in this sea/place. Go to the Dungeon Hub once (Auto Join then takes over)\"\010            return false\010        end\010        if D.active then D.halt() end\010        Diag.dungeon = \"Not in the Dungeon Hub or a dungeon (go to the Dungeon Hub to start)\"\010        return false\010    end\010    table.insert(Connections, Player.CharacterAdded:Connect(function() atkFlag = false; cancelTween(); lastPos = nil end))\010\010    -- ===== UI =====\010    local function tg(id, title, desc)\010        T:AddToggle(id, { Title = title, Description = desc, Default = Config[id] and true or false }):OnChanged(function(v) Config[id] = v; persist() end)\010    end\010    T:AddSection(\"Join Dungeon\")\010    local DIFFS = { \"Normal\", \"Hard\", \"Challenge\" }\010    local di = 1\010    for i, n in ipairs(DIFFS) do if n == Config.DunDiff then di = i end end\010    T:AddDropdown(\"DunDiff\", { Title = \"Select Difficulty\", Description = \"Difficulty set on the pad (Hard/Challenge must be unlocked)\", Values = DIFFS, Default = di })\010        :OnChanged(function(v) Config.DunDiff = v; persist() end)\010    T:AddSlider(\"DunMin\", { Title = \"Min Player Join Dungeon\", Description = \"The starter waits until the pad has this many players\", Min = 1, Max = 4, Default = tonumber(Config.DunMin) or 1, Rounding = 0 })\010        :OnChanged(function(v) Config.DunMin = math.floor(v); persist() end)\010    tg(\"DunStart\", \"Account Start Dungeon\", \"This account sets the difficulty and presses Start. Leave off on the accounts that only join\")\010    -- v93: contas sincronizadas (Multi Account / Moon Sync) aparecem primeiro na lista, marcadas com \"(Synced)\" -\010    -- assim fica facil de ver quais contas sao suas (ligadas via Moon Sync) e nao so outro jogador qualquer no server\010    local function names()\010        local MS = getgenv().MoonHubSync\010        local synced, other = {}, {}\010        for _, p in ipairs(PlayersSvc:GetPlayers()) do\010            if p ~= Player then\010                if MS and MS.synced and MS.synced[p.UserId] then synced[#synced + 1] = p.Name .. \" (Synced)\"\010                else other[#other + 1] = p.Name end\010            end\010        end\010        local o = { \"None\" }\010        for _, n in ipairs(synced) do o[#o + 1] = n end\010        for _, n in ipairs(other) do o[#o + 1] = n end\010        return o\010    end\010    local function followPlayerName() return (tostring(Config.DunFollow or \"\")):gsub(\" %(Synced%)$\", \"\") end\010    local fd = T:AddDropdown(\"DunFollow\", { Title = \"Select Account Join\", Description = \"Account that does not start: walks to this player's pad. Accounts synced via Multi Account show up marked (Synced) and play the Moon Sync animation when they meet on the pad\", Values = names(), Default = 1 })\010    fd:OnChanged(function(v) Config.DunFollow = v; persist() end)\010    T:AddButton({ Title = \"Refresh Player\", Description = \"Reloads the player list\", Callback = function() pcall(function() fd:SetValues(names()) end) end })\010    tg(\"DunJoin\", \"Auto Join Dungeon\", \"Flies to the Dungeon Hub, goes to a pad, sets the difficulty and starts (needs the energy cost)\")\010    T:AddSection(\"Dungeon\")\010    local WV = { \"Melee\", \"Sword\", \"Blox Fruit\", \"Gun\" }\010    local wi = 1\010    for i, n in ipairs(WV) do if n == Config.DunWeapon then wi = i end end\010    T:AddDropdown(\"DunWeapon\", { Title = \"Select Weapon Dungeon\", Description = \"Weapon type used inside the dungeon (falls back to any weapon you have)\", Values = WV, Default = wi })\010        :OnChanged(function(v) Config.DunWeapon = v; persist() end)\010    tg(\"DunFarm\", \"Auto Attack Dungeon\", \"Inside a dungeon: hovers high, kills every enemy, breaks blocking props, fights bosses and goes through the doors floor by floor\")\010    tg(\"DunBring\", \"Bring Mob Dungeons\", \"Pulls the nearby enemies onto the one you are hitting (never bosses, props or your Shadow ally) so you kill them together\")\010    T:AddSlider(\"DunBringN\", { Title = \"Bring Mob Dungeons (Select Number)\", Description = \"How many enemies are pulled together\", Min = 2, Max = 12, Default = tonumber(Config.DunBringN) or 6, Rounding = 0 })\010        :OnChanged(function(v) Config.DunBringN = math.floor(v); persist() end)\010    tg(\"DunCard\", \"Auto Pick Card Dungeon\", \"Picks the card (buff) automatically: attack speed, lifesteal, cooldowns and your weapon's buffs first\")\010    -- v64: lista pra NUNCA escolher uma carta especifica (ex.: \"Shadow\", que no passado deixava a farm presa\010    -- tentando matar o aliado/clone que ela cria) - so entra se for a unica opcao na tela, senao e sempre a ultima escolha\010    T:AddDropdown(\"DunCardBlock\", { Title = \"Never Pick These Cards\", Description = \"Cards checked here are the LAST choice for Auto Pick Card (only picked if nothing else is on screen)\", Values = BUFFS, Multi = true, Default = Config.DunCardBlock })\010        :OnChanged(function(v)\010            local list = {}\010            for _, n in ipairs(BUFFS) do if type(v) == \"table\" and v[n] then list[#list + 1] = n end end\010            Config.DunCardBlock = list; persist()\010        end)\010    T:AddSection(\"Dungeon Status\")\010    local info = T:AddParagraph({ Title = \"Dungeon\", Content = \"Checking...\" })\010    task.spawn(function()\010        while Alive do\010            pcall(function()\010                local nb = 0\010                for _ in pairs(S.buffs) do nb += 1 end\010                info:SetDesc(table.concat({\010                    \"Where: \" .. (inRun() and \"inside a dungeon\" or (inHub() and \"Dungeon Hub\" or \"other area\")),\010                    \"Stage: \" .. S.stage,\010                    string.format(\"Floor %d/%d | enemies %d/%d | time left %ds\", S.floor, S.maxFloor, S.dead, S.total, math.floor(S.left)),\010                    \"Target: \" .. S.target .. \" | kills: \" .. S.kills .. \" | runs: \" .. S.runs,\010                    \"Energy: \" .. tostring(energy() or \"?\") .. \" (cost \" .. (Config.DunCost or 10) .. \") | cards picked: \" .. nb,\010                    \"Diag: \" .. tostring(Diag.dungeon or \"idle\"),\010                }, \"\\n\"))\010            end)\010            task.wait(1)\010        end\010    end)\010end)()\010\010\010\010\010\010";
