        DV.src.shop = function()
            return "local __E = ...\010local AFL = __E.AFL\010local Config, Fluent, InvCache, Player, Tabs, getSea, hasItem = __E.Config, __E.Fluent, __E.InvCache, __E.Player, __E.Tabs, __E.getSea, __E.hasItem\010local invoke, persist = __E.invoke, __E.persist\010local ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ============ SHOP (portado do bomba.lua \"Shop\" + QuantumOnyx: Fruit Dealer / janelas do jogo) ============\010-- Tudo aqui e compra por remote. Os remotes (todos do Remotes.CommF_) foram copiados do bomba.lua / Quantum:\010--   (\"BuyHaki\", \"Buso\"|\"Geppo\"|\"Soru\"), (\"KenTalk\", \"Buy\"), (\"ColorsDealer\", \"2\")\010--   (\"BuyBlackLeg\"), (\"BuyElectro\"), (\"BuyFishmanKarate\"), (\"BuySuperhuman\") ... estilos de luta (precisa estar perto do NPC)\010--   (\"BuyItem\", nome) | (\"Ectoplasm\", \"Buy\", 1|2) | (\"BlackbeardReward\", \"Slingshot\", \"2\")      acessorios e armas\010--   (\"CraftItem\", \"Craft\", nome)                                                              itens de eventos do mar\010--   (\"BlackbeardReward\", \"Refund\"|\"Reroll\", \"2\") | (\"Ectoplasm\", \"Change\", 4) | (\"CyborgTrainer\", \"Buy\")   loja de Fragments\010--   (\"GetFruits\"[, true]) e (\"PurchaseRawFruit\", nome[, true])                                  Fruit Dealer (normal / Mirage)\010-- Os estilos de luta (e \"ir ate o NPC\") usam o AFL.goDo do arbitro: o personagem voa ate o NPC, compra e solta o controle.\010local RS = ReplicatedStorage\010local Shop = { status = \"Idle\", bought = 0, armed = {}, busyAt = 0 }\010AFL.Shop = Shop\010local function d(k, v) if Config[k] == nil then Config[k] = v end end\010d(\"SnipeOn\", false); d(\"SnipeFruit\", \"None\"); d(\"SnipeMOn\", false); d(\"SnipeMFruit\", \"None\")\010\010local MAIN = { [2753915549] = true, [85211729168715] = true, [4442272183] = true, [79091703265657] = true, [7449423635] = true, [100117331123089] = true }\010local function inMain() return MAIN[game.PlaceId] == true end\010\010-- ------------------------------------------------------------------ helpers ----\010local function notify(txt, secs)\010    pcall(function() Fluent:Notify({ Title = \"Moon Decompiled Hub - Shop\", Content = txt, Duration = secs or 4 }) end)\010end\010local function reply(r)\010    if type(r) == \"string\" and #r > 0 then return \" (\" .. string.sub(r, 1, 70) .. \")\" end\010    if type(r) == \"number\" then return \" (code \" .. tostring(r) .. \")\" end\010    return \"\"\010end\010local function dataNum(name)\010    local ok, v = pcall(function() return Player.Data[name].Value end)\010    return ok and tonumber(v) or 0\010end\010local function myRace()\010    local ok, v = pcall(function() return Player.Data.Race.Value end)\010    return ok and tostring(v) or \"\"\010end\010local function normFruit(n)\010    n = string.lower(tostring(n))\010    local half = string.match(n, \"^(.+)%-%1$\")\010    if half then n = half end\010    return (string.gsub(n, \"[^%w]\", \"\"))\010end\010-- NPC pelo nome (parte do nome): procura em workspace.NPCs e ReplicatedStorage.NPCs; devolve (modelo, posicao)\010local function findNpc(part)\010    part = string.lower(part)\010    for _, root in ipairs({ workspace:FindFirstChild(\"NPCs\"), RS:FindFirstChild(\"NPCs\") }) do\010        if root then\010            for _, n in ipairs(root:GetChildren()) do\010                if string.find(string.lower(n.Name), part, 1, true) then\010                    local p = n:FindFirstChild(\"HumanoidRootPart\") or n.PrimaryPart or n:FindFirstChildWhichIsA(\"BasePart\", true)\010                    if p then return n, p.Position end\010                end\010            end\010        end\010    end\010end\010-- botoes que gastam Fragments pedem um segundo toque em ate 4s\010local function confirm(key, what)\010    local now = os.clock()\010    if Shop.armed[key] and now - Shop.armed[key] < 4 then Shop.armed[key] = nil return true end\010    Shop.armed[key] = now\010    notify(\"Press it again within 4 seconds to confirm: \" .. what, 4)\010    return false\010end\010\010-- compra por remote (sem andar): label, argumentos do CommF_, checkOwned = nao compra se ja tem\010local function doBuy(label, args, checkOwned)\010    if os.clock() - Shop.busyAt < 1 then return end\010    Shop.busyAt = os.clock()\010    task.spawn(function()\010        local okAll, err = pcall(function()\010            if checkOwned and hasItem(label) then notify(\"You already own \" .. label, 3) return end\010            Shop.status = \"Buying \" .. label\010            local ok, r = invoke(table.unpack(args))\010            InvCache.at = 0\010            if not ok then notify(label .. \": the request failed (\" .. tostring(r) .. \")\", 5) return end\010            if r == false then notify(label .. \": the server refused (not enough Beli/Fragments or level?)\", 5) return end\010            if checkOwned then\010                task.wait(0.8)\010                InvCache.at = 0\010                if hasItem(label) then Shop.bought += 1; notify(label .. \" purchased!\", 4)\010                else notify(label .. \": request sent\" .. reply(r) .. \" - not in your inventory yet\", 5) end\010            else\010                notify(label .. \": request sent\" .. reply(r), 4)\010            end\010        end)\010        Shop.status = \"Idle\"\010        if not okAll then AFL.logErr(\"shop \" .. label, err) end\010    end)\010end\010\010-- ---------------------------------------------------------- ir ate o NPC e comprar ----\010-- AFL.goDo (pcompat2) voa ate o NPC pelo arbitro, chama a acao de compra la e solta o controle\010function Shop.go(name, pos, act) AFL.goDo(name, pos, act) end\010function Shop.stop() AFL.goStop() end\010\010-- --------------------------------------------------------------------- dados ----\010local HAKI = {\010    { \"Buso\", { \"BuyHaki\", \"Buso\" } }, { \"Geppo\", { \"BuyHaki\", \"Geppo\" } }, { \"Soru\", { \"BuyHaki\", \"Soru\" } },\010    { \"Ken\", { \"KenTalk\", \"Buy\" } },\010}\010-- estilos de luta: posicao do NPC em cada mar (1, 2, 3) e o remote de compra\010local STYLE = {\010    [\"Dark Step\"] = { pos = { Vector3.new(-988, 13, 3996), Vector3.new(-4750.61, 35.08, -4846.33), Vector3.new(-5043.64, 371.35, -3183.4) }, args = { \"BuyBlackLeg\" } },\010    [\"Electric\"] = { pos = { Vector3.new(-5382.27, 14.15, -2150.34), Vector3.new(-4863.81, 35.08, -4767.54), Vector3.new(-4993.2, 314.56, -3198.06) }, args = { \"BuyElectro\" } },\010    [\"Water Kung Fu\"] = { pos = { Vector3.new(61584.35, 18.85, 988.89), Vector3.new(-4960.04, 35.08, -4662.67), Vector3.new(-5017.39, 371.35, -3187.53) }, args = { \"BuyFishmanKarate\" } },\010    [\"Dragon Breath\"] = { pos = { nil, Vector3.new(1514, 15, -2982) }, args = { \"BlackbeardReward\", \"DragonClaw\", \"2\" } },\010    [\"Superhuman\"] = { pos = { nil, Vector3.new(1378.05, 247.43, -5189.37), Vector3.new(-4997.53, 371.35, -3197.46) }, args = { \"BuySuperhuman\" } },\010    [\"Death Step\"] = { pos = { nil, Vector3.new(6360.04, 296.67, -6763.93), Vector3.new(-4997.64, 314.56, -3220.37) }, args = { \"BuyDeathStep\" } },\010    [\"Sharkman Karate\"] = { pos = { nil, Vector3.new(-2602.4, 239.22, -10314.75), Vector3.new(-4970.48, 314.56, -3225.04) }, args = { \"BuySharkmanKarate\" } },\010    [\"Electric Claw\"] = { pos = { nil, nil, Vector3.new(-10369.83, 331.69, -10126.49) }, args = { \"BuyElectricClaw\" } },\010    [\"Dragon Talon\"] = { pos = { nil, nil, Vector3.new(5662.03, 1211.32, 858.6) }, args = { \"BuyDragonTalon\" } },\010    [\"Godhuman\"] = { pos = { nil, nil, Vector3.new(-13775.56, 334.66, -9877.67) }, args = { \"BuyGodhuman\" } },\010    [\"Sanguine Art\"] = { pos = { nil, nil, Vector3.new(-16514.86, 23.18, -190.84) }, args = { \"BuySanguineArt\" } },\010}\010local STYLE_ORDER = { \"Dark Step\", \"Electric\", \"Water Kung Fu\", \"Dragon Breath\", \"Superhuman\", \"Death Step\", \"Sharkman Karate\", \"Electric Claw\", \"Dragon Talon\", \"Godhuman\", \"Sanguine Art\" }\010local ACCESSORY = {\010    { \"Tomoe Ring\", { \"BuyItem\", \"Tomoe Ring\" } }, { \"Black Cape\", { \"BuyItem\", \"Black Cape\" } }, { \"Swordsman Hat\", { \"BuyItem\", \"Swordsman Hat\" } },\010    { \"Bizarre Rifle\", { \"Ectoplasm\", \"Buy\", 1 } }, { \"Ghoul Mask\", { \"Ectoplasm\", \"Buy\", 2 } },\010}\010local WEAPON = {}\010for _, n in ipairs({ \"Cutlass\", \"Katana\", \"Iron Mace\", \"Duel Katana\", \"Triple Katana\", \"Pipe\", \"Dual-Headed Blade\", \"Bisento\", \"Soul Cane\",\010    \"Slingshot\", \"Musket\", \"Dual Flintlock\", \"Flintlock\", \"Refined Flintlock\", \"Cannon\" }) do WEAPON[#WEAPON + 1] = { n, { \"BuyItem\", n } } end\010WEAPON[#WEAPON + 1] = { \"Kabucha\", { \"BlackbeardReward\", \"Slingshot\", \"2\" } }\010local CRAFTS = { \"Dragonheart\", \"Dragonstorm\", \"DinoHood\", \"TRexSkull\", \"Volcanic Magnet\", \"SharkTooth\", \"TerrorJaw\", \"SharkAnchor\",\010    \"LeviathanCrown\", \"LeviathanShield\", \"LeviathanBoat\", \"CommonScroll\", \"RareScroll\", \"LegendaryScroll\", \"MythicalScroll\" }\010local FruitList = { \"None\", \"Rocket-Rocket\", \"Spin-Spin\", \"Blade-Blade\", \"Spring-Spring\", \"Bomb-Bomb\", \"Smoke-Smoke\",\010    \"Spike-Spike\", \"Flame-Flame\", \"Falcon-Falcon\", \"Ice-Ice\", \"Sand-Sand\", \"Dark-Dark\", \"Diamond-Diamond\",\010    \"Light-Light\", \"Rubber-Rubber\", \"Ghost-Ghost\", \"Magma-Magma\", \"Quake-Quake\", \"Buddha-Buddha\", \"Love-Love\",\010    \"Creation-Creation\", \"Spider-Spider\", \"Sound-Sound\", \"Phoenix-Phoenix\", \"Portal-Portal\", \"Rumble-Rumble\",\010    \"Pain-Pain\", \"Blizzard-Blizzard\", \"Gravity-Gravity\", \"Mammoth-Mammoth\", \"T-Rex-T-Rex\", \"Dough-Dough\",\010    \"Shadow-Shadow\", \"Venom-Venom\", \"Gas-Gas\", \"Control-Control\", \"Spirit-Spirit\", \"Dragon-Dragon\",\010    \"Leopard-Leopard\", \"Yeti-Yeti\", \"Kitsune-Kitsune\", \"Kilo-Kilo\", \"Chop-Chop\", \"Revive-Revive\", \"Paw-Paw\", \"Magnet-Magnet\",\010    \"Dragon East-Dragon East\", \"Dragon West-Dragon West\" }\010\010-- craft de itens: o remote do bomba (CraftItem) primeiro; se o servidor responder \"false\", tenta o RF/Craft do jogo novo\010local function craft(name)\010    if os.clock() - Shop.busyAt < 1 then return end\010    Shop.busyAt = os.clock()\010    task.spawn(function()\010        local okAll, err = pcall(function()\010            Shop.status = \"Crafting \" .. name\010            local ok, r = invoke(\"CraftItem\", \"Craft\", name)\010            if ok and r == false then\010                local net = RS:FindFirstChild(\"Modules\") and RS.Modules:FindFirstChild(\"Net\")\010                local rf = net and net:FindFirstChild(\"RF/Craft\")\010                if rf then ok, r = pcall(function() return rf:InvokeServer(\"Craft\", name, 1, {}) end) end\010            end\010            InvCache.at = 0\010            if not ok then notify(name .. \": the craft request failed (\" .. tostring(r) .. \")\", 5)\010            elseif r == false then notify(name .. \": the server refused (missing materials?)\", 5)\010            else notify(name .. \": craft requested\" .. reply(r), 4) end\010        end)\010        Shop.status = \"Idle\"\010        if not okAll then AFL.logErr(\"shop craft \" .. name, err) end\010    end)\010end\010\010-- ----------------------------------------------------------------- Fruit Dealer ----\010-- compra a fruta escolhida se ela estiver a venda e voce tiver Beli. mirage = estoque do Advanced Fruit Dealer\010local Snipe = { n = 0, m = 0, noMoney = {} }\010local function stockOf(mirage)\010    local ok, stock\010    if mirage then ok, stock = invoke(\"GetFruits\", true) else ok, stock = invoke(\"GetFruits\") end\010    if ok and type(stock) == \"table\" then return stock end\010end\010local function buyFruit(want, mirage, silent)\010    local stock = stockOf(mirage)\010    if not stock then\010        if not silent then notify(\"Could not read the fruit stock\", 4) end\010        return false\010    end\010    local nk = normFruit(want)\010    for _, v in pairs(stock) do\010        if type(v) == \"table\" and v.Name and normFruit(v.Name) == nk then\010            if v.OnSale ~= true then\010                if not silent then notify(tostring(v.Name) .. \" is not in stock right now\", 4) end\010                return false\010            end\010            local price = tonumber(v.Price) or 0\010            if dataNum(\"Beli\") < price then\010                local k = tostring(v.Name) .. (mirage and \"M\" or \"N\")\010                if not silent or not Snipe.noMoney[k] then notify(\"Not enough Beli for \" .. tostring(v.Name) .. \" ($\" .. tostring(price) .. \")\", 5) end\010                Snipe.noMoney[k] = true\010                return false\010            end\010            local ok, r\010            if mirage then ok, r = invoke(\"PurchaseRawFruit\", v.Name, true) else ok, r = invoke(\"PurchaseRawFruit\", v.Name) end\010            InvCache.at = 0\010            if ok and r ~= false then\010                Shop.bought += 1\010                notify((silent and \"Fruit Sniper: \" or \"\") .. \"bought \" .. tostring(v.Name) .. \" for $\" .. tostring(price) .. reply(r), 6)\010                return true\010            end\010            notify(tostring(v.Name) .. \": the server refused the purchase\" .. reply(r), 5)\010            return false\010        end\010    end\010    if not silent then notify(\"That fruit is not in the \" .. (mirage and \"Advanced\" or \"normal\") .. \" dealer list\", 4) end\010    return false\010end\010task.spawn(function()\010    while Alive do\010        task.wait(3)\010        pcall(function()\010            if not inMain() then return end\010            local now = os.clock()\010            -- depois de uma compra espera 2 minutos antes de tentar a mesma fruta de novo (nao esvazia a carteira se o estoque nao baixar)\010            if Config.SnipeOn and Config.SnipeFruit ~= \"None\" and now - Snipe.n > 10 then\010                Snipe.n = now\010                if buyFruit(Config.SnipeFruit, false, true) then Snipe.n = now + 110 end\010            end\010            if Config.SnipeMOn and Config.SnipeMFruit ~= \"None\" and now - Snipe.m > 10 then\010                Snipe.m = now\010                if buyFruit(Config.SnipeMFruit, true, true) then Snipe.m = now + 110 end\010            end\010        end)\010    end\010end)\010\010-- ----------------------------------------------------------------------- UI ----\010do\010    local T = Tabs.Shop\010    local function idx(list, key, name)\010        for i, v in ipairs(list) do\010            if (type(v) == \"table\" and v[1] or v) == name then return i end\010        end\010        return 1\010    end\010    local function names(list)\010        local out = {}\010        for i, v in ipairs(list) do out[i] = type(v) == \"table\" and v[1] or v end\010        return out\010    end\010    local function dataOf(list, name)\010        for _, v in ipairs(list) do if v[1] == name then return v[2] end end\010    end\010\010    T:AddSection(\"Haki\")\010    local selHaki = HAKI[1][1]\010    T:AddDropdown(\"ShopHaki\", { Title = \"Select Haki\", Description = \"Buso, Geppo, Soru or Ken (Observation)\", Values = names(HAKI), Default = 1 })\010        :OnChanged(function(v) selHaki = v end)\010    T:AddButton({ Title = \"Buy Selected Haki\", Description = \"Buys the selected ability from the Ability Teacher\", Callback = function()\010        local a = dataOf(HAKI, selHaki)\010        if a then doBuy(selHaki, a, false) end\010    end })\010    T:AddButton({ Title = \"Buy Buso Colors\", Description = \"Buys a Haki color from the Barista (Second and Third Sea, uses Fragments)\", Callback = function()\010        local sea = getSea()\010        if sea ~= 2 and sea ~= 3 then notify(\"Buso Colors only work in the Second and Third Sea\", 4) return end\010        if confirm(\"colors\", \"Buy Buso Colors\") then doBuy(\"Buso Colors\", { \"ColorsDealer\", \"2\" }, false) end\010    end })\010    T:AddButton({ Title = \"Go To Haki Dealer (Barista)\", Description = \"Flies to the Barista NPC (Second and Third Sea)\", Callback = function()\010        local sea = getSea()\010        if sea ~= 2 and sea ~= 3 then notify(\"The Barista is only in the Second and Third Sea\", 4) return end\010        Shop.go(\"the Haki Dealer\", function() local _, p = findNpc(\"Barista\"); return p end, function() end)\010    end })\010\010    T:AddSection(\"Fighting Styles\")\010    do\010        local sea = getSea()\010        local avail = {}\010        for _, n in ipairs(STYLE_ORDER) do if STYLE[n].pos[sea] then avail[#avail + 1] = n end end\010        if #avail == 0 then avail = { \"(none in this sea)\" } end\010        local selStyle = avail[1]\010        T:AddDropdown(\"ShopStyle\", { Title = \"Select Style\", Description = \"Fighting styles sold in this sea\", Values = avail, Default = 1 })\010            :OnChanged(function(v) selStyle = v end)\010        T:AddButton({ Title = \"Go And Buy Style\", Description = \"Flies to the style's NPC and buys it (needs the Beli / Fragments / mastery the NPC asks for)\", Callback = function()\010            local st = STYLE[selStyle]\010            if not st or not st.pos[sea] then notify(\"Pick a style that is sold in this sea\", 4) return end\010            Shop.go(selStyle .. \" NPC\", st.pos[sea], function()\010                for try = 1, 3 do\010                    local ok, r = invoke(table.unpack(st.args))\010                    InvCache.at = 0\010                    if ok and r ~= false then notify(selStyle .. \": purchase requested\" .. reply(r) .. \" - check your inventory\", 6) return end\010                    task.wait(1)\010                end\010                notify(selStyle .. \": the server refused the purchase (not enough Beli/Fragments, or you do not meet the requirement)\", 6)\010            end)\010        end })\010        T:AddButton({ Title = \"Stop Flyin