L.prefix + 1] or {}\010            local used = {}\010            for _, i in ipairs(L.prefix) do used[i] = true end\010            for i = 1, #lv do\010                if not used[i] and not L.tried[#L.prefix + 1][i] then idx = i; break end\010            end\010            if not idx then L.prefix, L.tried, L.replay = {}, {}, nil; Diag.awk = \"Auto Awaken (Warden): no order worked, restarting\"; return true end\010        end\010        local ok, r = pcall(rf.InvokeServer, rf, \"Lever Jailbreak\", \"Pull\", idx)\010        local res = ok and typeof(r) == \"table\" and r.Result or nil\010        L.n = L.n + 1\010        Diag.awk = \"Auto Awaken (Warden): pull \" .. idx .. \" -> \" .. tostring(res) .. \" (known order: \" .. table.concat(L.prefix, \",\") .. \")\"\010        if L.replay then\010            if res ~= \"Accepted\" and res ~= \"Solved\" then L.prefix, L.tried, L.replay = {}, {}, nil end\010            return true\010        end\010        if res == \"Accepted\" then L.prefix[#L.prefix + 1] = idx\010        elseif res == \"Solved\" then L.prefix = {}; L.tried = {}\010        elseif res ~= nil then\010            L.tried[#L.prefix + 1][idx] = true\010            if #L.prefix > 0 then L.replay = { table.unpack(L.prefix) } end\010        end\010        return true\010    end\010\010    -- acerta um objeto com o item/skills de \"break rocks\" escolhidos na aba Vulcan (ou M1 se nada escolhido)\010    local function hitObject(obj, label)\010        local pos = posOf(obj)\010        if not pos then return false end\010        Diag.awk = \"Auto Awaken (\" .. label .. \"): hitting \" .. obj.Name\010        if not near(pos, 16, 7) then return true end\010        S.hitN[obj] = (S.hitN[obj] or 0) + 1\010        local part = obj:IsA(\"BasePart\") and obj or obj:FindFirstChildWhichIsA(\"BasePart\", true)\010        local used = false\010        if part and AFL.Vulc and AFL.Vulc.useSet then\010            local ok, u = pcall(AFL.Vulc.useSet, \"VulcRockW\", \"VulcRockK\", part)\010            used = ok and u\010        end\010        if not used then\010            pcall(equipWeapon)\010            if part then Aim.part = part end\010            pcall(cfAttack)\010            pcall(function()\010                local tool = Player.Character and Player.Character:FindFirstChildOfClass(\"Tool\")\010                if tool then tool:Activate() end\010            end)\010        end\010        return true\010    end\010    local function pickHit(list, label)\010        for _, o in ipairs(list) do\010            if o.Parent and (S.hitN[o] or 0) < 30 then return hitObject(o, label) end\010        end\010        Diag.awk = \"Auto Awaken (\" .. label .. \"): nothing left to hit\"\010        return false\010    end\010    local function yetiRun()\010        local ice = mapChild(\"Map\", \"Ice\")\010        local folder = (ice and ice:FindFirstChild(\"BonusMoment_Locations\", true)) or (workspace:FindFirstChild(\"Map\") and workspace.Map:FindFirstChild(\"BonusMoment_Locations\", true))\010        local list = {}\010        for _, c in ipairs(folder and folder:GetChildren() or {}) do\010            if c.Name == \"iceRock\" and c:IsA(\"BasePart\") and c.Transparency < 0.95 and c:GetAttribute(\"FrozenDefenseRockPresent\") ~= false then list[#list + 1] = c end\010        end\010        return pickHit(list, \"Yeti\")\010    end\010    local function magmaRun()\010        local list = {}\010        if every(\"magmascan\", 6) or not S.magma then\010            S.magma = {}\010            -- as fissuras (Model \"MagmaFissure\") sao criadas pelo cliente direto em workspace; o \"Vent\" fica dentro delas\010            for _, d in ipairs(workspace:GetChildren()) do\010                if d.Name == \"MagmaFissure\" and d:IsA(\"Model\") then S.magma[#S.magma + 1] = d end\010            end\010            for _, root in ipairs({ workspace:FindFirstChild(\"Map\"), workspace:FindFirstChild(\"_WorldOrigin\"), workspace.Terrain }) do\010                for _, d in ipairs(root:GetDescendants()) do\010                    if (d.Name == \"LavaGeyser\" or d.Name == \"MagmaFissure\") and (d:IsA(\"Model\") or d:IsA(\"BasePart\")) then\010                        S.magma[#S.magma + 1] = d\010                    end\010                end\010            end\010        end\010        for _, d in ipairs(S.magma) do if d.Parent then list[#list + 1] = d end end\010        if #list == 0 then\010            -- fissuras ainda nao abertas: vai ate o primeiro ponto que o servidor mandou em Setup\010            local pts = S.evPts and S.evPts[\"One Last Eruption\"]\010            if pts and #pts > 0 then\010                Diag.awk = \"Auto Awaken (Magma General): flying to the fissure spots the server sent\"\010                near(pts[1], 40, 15)\010                return true\010            end\010        end\010        return pickHit(list, \"Magma General\")\010    end\010    local function gorillaRun()\010        local list = {}\010        for _, x in ipairs(S.evInst[\"Banana Tree\"] or {}) do if x.Parent and (x:IsA(\"Model\") or x:IsA(\"BasePart\")) then list[#list + 1] = x end end\010        if #list == 0 then\010            local jungle = mapChild(\"Map\", \"Jungle\")\010            for _, d in ipairs(jungle and jungle:GetDescendants() or {}) do\010                if d.Name == \"JungleTree\" and d:IsA(\"Model\") and d:FindFirstChild(\"BananaLeaf\", true) then list[#list + 1] = d end\010            end\010            local _, hrp = getChar()\010            if hrp then table.sort(list, function(a, b) return (posOf(a) - hrp.Position).Magnitude < (posOf(b) - hrp.Position).Magnitude end) end\010        end\010        return pickHit(list, \"Gorilla King\")\010    end\010    -- Cyborg: partes com atributo FountainWireRole == \"Broken\" (reparadas com M1; o modulo marca \"Repaired\" quando acerta)\010    local function cyborgRun()\010        if every(\"wirescan\", 4) or not S.wires then\010            S.wires = {}\010            for _, root 