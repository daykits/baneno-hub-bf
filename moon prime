            return "local __E = ...\010local AFL = __E.AFL\010local Config, Connections, Core, Diag, Player, State, Tabs = __E.Config, __E.Connections, __E.Core, __E.Diag, __E.Player, __E.State, __E.Tabs\010local persist = __E.persist\010local Players = game:GetService(\"Players\")\010local Alive = true\010AFL.onUnload(function() Alive = false end);\010-- ---------- Dungeons ----------\010-- Base: NightDungeon (andar/lutar/escolher cartas dentro da dungeon) + Banana Hub (entrar no pad, dificuldade, min. de jogadores, conta que inicia).\010(function()\010    local T = Tabs.Dungeons\010    local RS = game:GetService(\"ReplicatedStorage\")\010    local TweenSvc = game:GetService(\"TweenService\")\010    local PlayersSvc = game:GetService(\"Players\")\010    local RunSvc = game:GetService(\"RunService\")\010    local D = {}\010    AFL.Dun = D\010    local S = { stage = \"Idle\", floor = 0, maxFloor = 0, dead = 0, total = 0, left = 0, runs = 0, kills = 0, energy = 0, target = \"-\", buffs = {} }\010    D.s = S\010    local CFG = { hover = 60, kill = 20, bossKill = 24, speed = 200, arrive = 14, jump = 400, rescue = 6000, hit = 60,\010        atkDelay = 0.07, buffDelay = 0.45, floorH = 90, door = 30, propHP = 5000, propR = 700, stall = 5 }\010    local function cfgv(k, d) if Config[k] == nil then Config[k] = d end end\010    cfgv(\"DunDiff\", \"Normal\"); cfgv(\"DunMin\", 1); cfgv(\"DunWeapon\", \"Melee\"); cfgv(\"DunCost\", 10); cfgv(\"DunBring\", true); cfgv(\"DunBringN\", 6)\010    cfgv(\"DunCardBlock\", {})   -- v64: cartas que o Auto Pick Card nunca deve escolher\010\010    local function char() local c = Player.Character; return (c and c.Parent and c:FindFirstChild(\"HumanoidRootPart\")) and c or nil end\010    local function hrpf() local c = char(); return c and c:FindFirstChild(\"HumanoidRootPart\") end\010    local function humf() local c = char(); return c and c:FindFirstChildOfClass(\"Humanoid\") end\010    local function inHub() return workspace:GetAttribute(\"