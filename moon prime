ce\", \"Rerolls your race (uses Fragments)\", function() doBuy(\"Reroll Race\", { \"BlackbeardReward\", \"Reroll\", \"2\" }, false) end },\010        { \"Ghoul Race\", \"Turns you into a Ghoul (uses Ectoplasm)\", function()\010            if myRace() == \"Ghoul\" then notify(\"You already are a Ghoul\", 3) return end\010            doBuy(\"Ghoul Race\", { \"Ectoplasm\", \"Change\", 4 }, false)\010        end },\010        { \"Cyborg Race\", \"Turns you into a Cyborg (uses Fragments)\", function()\010            if myRace() == \"Cyborg\" then notify(\"You already are a Cyborg\", 3) return end\010            doBuy(\"Cyborg Race\", { \"CyborgTrainer\", \"Buy\" }, false)\010        end },\010    }\010    local selFrag = FRAG[1][1]\010    T:AddDropdown(\"ShopFragments\", { Title = \"Select Item\", Description = \"These spend Fragments/Ectoplasm: press Buy twice to confirm\", Values = names(FRAG), Default = 1 })\010        :OnChanged(function(v) selFrag = v end)\010    T:AddButton({ Title = \"Buy Fragments Item\", Description = \"Press twice within 4 seconds to confirm\", Callback = function()\010        for _, f in ipairs(FRAG) do\010            if f[1] == selFrag then\010                if confirm(\"frag\" .. f[1], f[1]) then f[3]() end\010                return\010            end\010        end\010    end })\010\010    T:AddSection(\"Fruit Dealer\")\010    local selBuyN = Config.SnipeFruit or \"None\"\010    T:AddDropdown(\"SnipeFruit\", { Title = \"Select Fruit (Normal Dealer)\", Description = \"Fruit for Buy Selected Fruit and Fruit Sniper\", Values = FruitList, Default = idx(FruitList, nil, Config.SnipeFruit) })\010        :OnChanged(function(v) Config.SnipeFruit = v; selBuyN = v; persist() end)\010    T:AddButton({ Title = \"Buy Selected Fruit\", Description = \"Buys the fruit from the normal Fruit Dealer if it is in stock\", Callback = function()\010        if selBuyN == \"None\" then notify(\"Select a fruit first\", 3) return end\010        task.spawn(function() 