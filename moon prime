   local TTK_SWORDS = { \"Shizu\", \"Saishi\", \"Oroshi\" }\010    local function ttkFullStep()\010        if owns(\"True Triple Katana\") then\010            note(\"Fully TTK: you already have the True Triple Katana\")\010            return false\010        end\010        local missing = {}\010        for _, n in ipairs(TTK_SWORDS) do if not owns(n) then missing[#missing + 1] = n end end\010        -- 1) comprar as espadas\010        if #missing > 0 then\010            local w, b = wrongSea(2)\010            if w then return b end\010            set(\"Fully TTK: buying swords (missing \" .. table.concat(missing, \", \") .. \")\")\010            if every(\"ttkdealer\", 3) then\010                local _, a = invoke(\"LegendarySwordDealer\", \"1\")\010                if a then\010                    local _, r = invoke(\"LegendarySwordDealer\", \"2\")\010                    SF.ttkNoBeli = (r == 0)\010                    note(r == 0 and \"Fully TTK: not enough Beli for the next sword (keep another farm on)\" or (\"Fully TTK: dealer answered -> \" .. tostring(r)))\010                else\010                    SF.ttkNoBeli = false\010                    note(\"Fully TTK: the dealer has nothing in this server, hopping\")\010                    if AFL.apiJoin then AFL.apiJoin(\"LegendarySwordDealer\", function() return not Config.SubFullTTK end, \"Legendary Sword Dealer\")\010                    elseif AFL.hopRequest then AFL.hopRequest(\"Legendary Sword Dealer\", function() return not Config.SubFullTTK end) end\010                end\010            end\010            if SF.ttkNoBeli then return false end -- sem Beli: deixa os outros farms rodarem\010            return true\010        end\010        -- 2) masterizar\010        for _, n in ipairs(TTK_SWORDS) do\010            if not loadItem(n) then note(\"Fully TTK: loading \" .. n); return false end\010        end\010        local target = SF.ttkTarget or 300\010        for _, n in ipairs(TTK_SWORDS) do\010            i