GRP_Travel_Travel_NPCs:AddToggle("Auto_Tween_to_NPC", {
	Text = "Auto Tween to NPC",
	Default = false,
	Callback = function(p234)
		_G.TPNpc = p234
		_G.TPNpc_Toggle = p234

		if p234 then
			spawn(function()
				if _G.TPNpc_Toggle then
					local wait_ = wait
					local Sec_ = Sec or 0.1

					while true do
						wait_(Sec_)
						pcall(function()
							local v217, v218, v219 = pairs(replicated.NPCs:GetChildren())
							local v220 = geniter(v217, v218, v219)
							local v221 = table.pack(v220())

							if v221[1] then
								local v222 = v221[3]

								while true do
									if v222.Name ~= (_G.SelectNPC or NPClist) then
										local v223 = table.pack(v220())

										if not v223[1] then
											break
										end

										v222 = v223[3]

										continue
									end

									while v222:FindFirstChild("HumanoidRootPart") do
										_tp(v222.HumanoidRootPart.CFrame)

										while true do
											local v224 = table.pack(v220())

											if v224[1] then
												v222 = v224[3]

												if v222.Name == (_G.SelectNPC or NPClist) then
													break
												end
											else
												return
											end
										end
									end

									local v225 = table.pack(v220())

									if v225[1] then
										v222 = v225[3]

										continue
									end

									break
								end
							end
						end)

						if _G.TPNpc_Toggle then
							wait_ = wait
							Sec_ = Sec or 0.1
						else
							break
						end
					end
				end
			end)
		end
	end
})
