local function getChipSize(labelText, fontSize, maxWidth)
    local bounds = TextService:GetTextSize(labelText, fontSize, Enum.Font.GothamSemibold, Vector2.new(1000, 1000))
    local width = math.clamp(bounds.X + 46, 92, maxWidth)
    local wrapped = bounds.X + 46 > maxWidth
    local height = wrapped and math.clamp(bounds.Y + 18, 30, 48) or 30
    return width, height, wrapped
end

