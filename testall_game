--   * Mọi cài đặt lưu trong Dua2devUI.json
-- Toàn bộ nằm trong 1 hàm nên không tốn biến local cấp cao nhất.
-- ============================================================
UX.InitGlass = function()
    local GCfg = UX.GCfg
    local Reg, GOrig = UX.Reg, UX.GOrig
    local WHITE = Color3.new(1, 1, 1)
    local SURF = Color3.fromRGB(255, 255, 255)
    local DEF_BG = Color3.fromRGB(16, 18, 28)
    local DEF_BG2 = Color3.fromRGB(22, 26, 40)
    local DEF_ACC = Color3.fromRGB(130, 175, 255)
    local RED = Color3.fromRGB(255, 0, 0)
    local KINDS = {"Bg", "Btn"}
    local GS = {on = false, rb = nil, rv = 0.6, mg = nil, prev = nil}

    local old = Lighting:FindFirstChild("Dua2devGlassBlur")
    if old then old:Destroy() end
    local blur = Instance.new("BlurEffect")
    blur.Name = "Dua2devGlassBlur"
    blur.Size = 0
    blur.Parent = Lighting

    local function curBg()
        if GS.rb then return GS.rb end
        if GCfg.c then return Color3.new(GCfg.c[1], GCfg.c[2], GCfg.c[3]) end
        return DEF_BG
    end

    local function accent(c)
        local h, s = c:ToHSV()
        if s > 0.12 then return Color3.fromHSV(h, 0.55, 1) end
        return DEF_ACC
    end

    -- Tô lại khung chính + gradient kính + màu phát sáng
    local function paintMain()
        if not GS.on then return end
        local c = curBg()
        frame.BackgroundColor3 = c
        local custom = (GS.rb ~= nil) or (GCfg.c ~= nil)
        if GS.mg then
            local m1 = custom and c:Lerp(WHITE, 0.55) or c
            local m2 = custom and c:Lerp(WHITE, 0.40) or DEF_BG2
            GS.mg.Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, SURF),
                ColorSequenceKeypoint.new(0.18, m1),
                ColorSequenceKeypoint.new(0.55, m2),
                ColorSequenceKeypoint.new(0.82, m1),
                ColorSequenceKeypoint.new(1, SURF),
            })
        end
        local acc = accent(c)
        for _, gl in ipairs(UX.Glows or {}) do gl.BackgroundColor3 = acc end
    end

    -- Áp kiểu kính lên 1 đối tượng (nền khung / nút)
    UX.GlassNewObj = function(kind, obj)
        if kind ~= "Bg" and kind ~= "Btn" then return end
        local o = GOrig[obj]
        if not o then
            o = {base = Reg[kind][obj], color = obj.BackgroundColor3}
            GOrig[obj] = o
        end
        if obj == frame then
            Reg.Bg[obj] = GCfg.density or 0.58
            obj.BackgroundColor3 = curBg()
        elseif kind == "Bg" then
            if UX.GPanel[obj] then
                Reg.Bg[obj] = 0.90
                obj.BackgroundColor3 = SURF
            end
        else
            Reg.Btn[obj] = 0.88
            obj.BackgroundColor3 = SURF
        end
    end

    -- Gradient: khung chính kiểu kính, khung con / nút phẳng trong
    UX.GlassGrad = function(g, info)
        if info.owner == frame then
            GS.mg = g
            g.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.65),
                NumberSequenceKeypoint.new(0.18, 0.58),
                NumberSequenceKeypoint.new(0.55, 0.52),
                NumberSequenceKeypoint.new(0.82, 0.58),
                NumberSequenceKeypoint.new(1, 0.65),
            })
            paintMain()
        else
            g.Color = ColorSequence.new(WHITE)
            g.Transparency = NumberSequence.new(0)
        end
    end

    -- Vệt sáng đầu mỗi khung (specular) + vệt sáng quét (shine)
    local specs = {}
    for _, p in ipairs({frame, header, leftSidebar, contentPanel}) do
        local s = Instance.new("Frame")
        s.Name = "GlassSpecular"
        s.Size = UDim2.new(1, -20, 0, 1)
        s.Position = UDim2.new(0, 10, 0, 1)
        s.BackgroundColor3 = SURF
        s.BackgroundTransparency = 0.18
        s.BorderSizePixel = 0
        s.ZIndex = 3
        s.Visible = false
        s.Parent = p
        Instance.new("UICorner", s).CornerRadius = UDim.new(1, 0)
        specs[#specs + 1] = s
    end

    local shine = Instance.new("Frame")
    shine.Name = "GlassShine"
    shine.AnchorPoint = Vector2.new(0.5, 0.5)
    shine.Size = UDim2.new(0, 70, 0, MAIN_H * 1.8)
    shine.Rotation = 18
    shine.BackgroundColor3 = SURF
    shine.BackgroundTransparency = 0
    shine.BorderSizePixel = 0
    shine.ZIndex = 8
    shine.Visible = false
    shine.Active = false
    shine.Parent = frame
    local sg = Instance.new("UIGradient", shine)
    sg.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.90),
        NumberSequenceKeypoint.new(1, 1),
    })

    -- Nhịp mỗi ~1/30 giây (gọi từ vòng lặp chung khi menu đang mở)
    UX.GlassTick = function(now)
        if not GS.on then return end
        if GCfg.rainbow then
            GS.rb = Color3.fromHSV((now * 0.07) % 1, 0.65, GS.rv)
            paintMain()
        end
        local ph = (now % 8) / 1.6
        if ph < 1 then
            local k = ph * ph * (3 - 2 * ph)
            shine.Visible = true
            shine.Position = UDim2.new(0, -90 + k * (MAIN_W + 180), 0, MAIN_H / 2)
        else
            shine.Visible = false
        end
    end

    UX.GlassBlur = function(open)
        local target = (GS.on and open) and 24 or 0
        TweenService:Create(blur, TweenInfo.new(0.3), {Size = target}):Play()
    end

    -- Bật / tắt Kính lỏng
    UX.SetGlass = function(on)
        on = on and true or false
        if GS.on == on then return end
        GS.on = on
        GCfg.on = on
        UX.GlassOn = on

        if on then
            -- viền giao diện chuyển trắng (nhớ giá trị cũ để trả lại)
            if not (_G.ThemeMode == "Static" and _G.StaticColor == SURF) then
                GS.prev = {mode = _G.ThemeMode, color = _G.StaticColor}
            end
            _G.ThemeMode = "Static"
            _G.StaticColor = SURF

            for _, kind in ipairs(KINDS) do
                for obj in pairs(Reg[kind]) do
                    if obj.Parent then UX.GlassNewObj(kind, obj) end
                end
            end
            for g, info in pairs(UX.Grads) do
                if g.Parent then UX.GlassGrad(g, info) end
            end
            for _, s in ipairs(specs) do s.Visible = true end
            paintMain()
        else
            for _, kind in ipairs(KINDS) do
                for obj in pairs(Reg[kind]) do
                    local o = GOrig[obj]
                    if o and obj.Parent then
                        Reg[kind][obj] = o.base
                        obj.BackgroundColor3 = o.color
                    end
                end
            end
            for g, info in pairs(UX.Grads) do
                if g.Parent then
                    g.Color = info.c
                    g.Transparency = info.t
                end
            end
            for _, s in ipairs(specs) do s.Visible = false end
            shine.Visible = false
            for _, gl in ipairs(UX.Glows or {}) do gl.BackgroundColor3 = RED end
            if GS.prev and _G.ThemeMode == "Static" and _G.StaticColor == SURF then
                _G.ThemeMode = GS.prev.mode
                _G.StaticColor = GS.prev.color
            end
            GS.prev = nil
        end

        UX.ApplyAlpha()
        UX.GlassBlur(isOpen)
        UX.SaveUI()
    end

    UX.SetGlassColor = function(c)
        GCfg.c = {c.R, c.G, c.B}
        GCfg.rainbow = false
        GS.rb = nil
        paintMain()
        UX.SaveUI()
    end

    UX.SetGlassDensity = function(v)
        GCfg.density = math.clamp(v, 0.1, 0.95)
        if GS.on then
            Reg.Bg[frame] = GCfg.density
            UX.ApplyAlpha()
        end
        UX.SaveUI()
    end

    UX.SetGlassRainbow = function(on)
        GCfg.rainbow = on and true or false
        if GCfg.rainbow then
            local base = GCfg.c and Color3.new(GCfg.c[1], GCfg.c[2], GCfg.c[3]) or DEF_BG
            local _, _, v = base:ToHSV()
            GS.rv = math.clamp(v, 0.28, 1)
        else
            GS.rb = nil
        end
        paintMain()
        UX.SaveUI()
    end

    UX.ResetGlass = function()
        GCfg.c, GCfg.density, GCfg.rainbow = nil, nil, false
        GS.rb = nil
        if GS.on then
            Reg.Bg[frame] = 0.58
            UX.ApplyAlpha()
        end
        paintMain()
        UX.SaveUI()
    end

    -- Bảng màu (xám + dải màu nhiều độ đậm nhạt)
    local PAL = {}
    for i = 0, 11 do
        local v = i / 11
        PAL[#PAL + 1] = Color3.new(v, v, v)
    end
    for _, sv in ipairs({{0.6, 0.18}, {0.5, 0.32}, {0.8, 0.28}, {0.9, 0.55}, {0.75, 1}}) do
        for i = 0, 11 do
            PAL[#PAL + 1] = Color3.fromHSV(i / 12, sv[1], sv[2])
        end
    end
    local PRESETS = {
        {"Midnight", Color3.fromRGB(16, 18, 28)}, {"Ocean", Color3.fromRGB(10, 40, 80)}, {"Sky", Color3.fromRGB(30, 90, 150)},
        {"Violet", Color3.fromRGB(50, 20, 90)}, {"Grape", Color3.fromRGB(80, 25, 95)}, {"Rose", Color3.fromRGB(90, 20, 50)},
        {"Crimson", Color3.fromRGB(95, 15, 25)}, {"Sunset", Color3.fromRGB(110, 50, 25)}, {"Gold", Color3.fromRGB(95, 75, 20)},
        {"Emerald", Color3.fromRGB(12, 70, 45)}, {"Mint", Color3.fromRGB(20, 95, 85)}, {"Mono", Color3.fromRGB(28, 28, 32)},
        {"Ice", Color3.fromRGB(150, 190, 225)}, {"Sakura", Color3.fromRGB(230, 170, 200)},
    }

    local function hexOf(c)
        return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
    end

    -- Dựng phần giao diện trong tag Gui
    UX.BuildGlassUI = function(text)
        local rowW = ScrollList.AbsoluteSize.X
        if rowW < 50 then rowW = MAIN_W - 132 - 12 end
        local W = math.max(150, rowW - 14)

        -- Nút bật/tắt Kính lỏng (ngay đầu tag Gui)
        AddBtn(text.BtnGlass, function(state) UX.SetGlass(state) end, true, GS.on)

        -- Dòng gợi ý + xem trước màu
        local pv = Instance.new("Frame")
        pv.Size = UDim2.new(0, W, 0, 36)
        pv.BackgroundColor3 = PANEL_2
        pv.BorderSizePixel = 0
        pv.Parent = ScrollList
        Track("Btn", pv, 0.02)
        pv:SetAttribute("Label", text.GlassColor)
        round(pv, UDim.new(0, 14))
        themed(addStroke(pv, 1, 0.62, ACCENT))

        local sw = Instance.new("Frame")
        sw.Size = UDim2.new(0, 46, 0, 20)
        sw.Position = UDim2.new(0, 10, 0.5, -10)
        sw.BorderSizePixel = 0
        sw.Parent = pv
        round(sw, UDim.new(0, 6))

        local hexLbl = Instance.new("TextLabel")
        hexLbl.BackgroundTransparency = 1
        hexLbl.Position = UDim2.new(0, 64, 0, 0)
        hexLbl.Size = UDim2.new(1, -72, 1, 0)
        hexLbl.Font = Enum.Font.GothamBold
        hexLbl.TextSize = 11
        hexLbl.TextXAlignment = Enum.TextXAlignment.Left
        hexLbl.TextTruncate = Enum.TextTruncate.AtEnd
        hexLbl.Parent = pv
        styleText(hexLbl)

        local hexBox, clarBox
        local function refresh()
            local c = curBg()
            sw.BackgroundColor3 = c
            hexLbl.Text = text.GlassColor .. "  " .. hexOf(c)
            if hexBox then hexBox.Text = hexOf(c) end
        end

        -- Bảng màu
        local palHolder = Instance.new("Frame")
        palHolder.Size = UDim2.new(0, W, 0, 0)
        palHolder.AutomaticSize = Enum.AutomaticSize.Y
        palHolder.BackgroundTransparency = 1
        palHolder.Parent = ScrollList
        palHolder:SetAttribute("Label", text.GlassColor)
        local grid = Instance.new("UIGridLayout", palHolder)
        grid.CellSize = UDim2.new(0, 22, 0, 22)
        grid.CellPadding = UDim2.new(0, 4, 0, 4)
        grid.SortOrder = Enum.SortOrder.LayoutOrder
        for i, c in ipairs(PAL) do
            local b = Instance.new("TextButton")
            b.LayoutOrder = i
            b.Text = ""
            b.AutoButtonColor = false
            b.BackgroundColor3 = c
            b.BorderSizePixel = 0
            b.Parent = palHolder
            round(b, UDim.new(0, 6))
            b.Activated:Connect(function()
                UX.SetGlassColor(c)
                refresh()
            end)
        end

        -- Ô nhập có nhãn
        local function mkBox(label, placeholder, default, onSubmit)
            local holder = Instance.new("Frame")
            holder.Size = UDim2.new(0, W, 0, 52)
            holder.BackgroundColor3 = PANEL_2
            holder.BorderSizePixel = 0
            holder.Parent = ScrollList
            Track("Btn", holder, 0.02)
            holder:SetAttribute("Label", label)
            round(holder, UDim.new(0, 14))
            themed(addStroke(holder, 1, 0.62, ACCENT))

            local lbl = Instance.new("TextLabel")
            lbl.BackgroundTransparency = 1
            lbl.Position = UDim2.new(0, 12, 0, 4)
            lbl.Size = UDim2.new(1, -24, 0, 16)
            lbl.Text = label
            lbl.Font = Enum.Font.GothamSemibold
            lbl.TextSize = 11
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.TextTruncate = Enum.TextTruncate.AtEnd
            lbl.Parent = holder
            styleText(lbl)

            local box = Instance.new("TextBox")
            box.Position = UDim2.new(0, 12, 0, 22)
            box.Size = UDim2.new(1, -24, 0, 24)
            box.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
            box.BorderSizePixel = 0
            box.PlaceholderText = placeholder
            box.PlaceholderColor3 = Color3.fromRGB(140, 120, 122)
            box.Text = default
            box.ClearTextOnFocus = false
            box.Font = Enum.Font.GothamBold
            box.TextSize = 12
            box.TextColor3 = Color3.new(1, 1, 1)
            box.Parent = holder
            round(box, UDim.new(0, 8))
            UX.RegisterText(box, Color3.new(1, 1, 1))
            box.FocusLost:Connect(function() onSubmit(box) end)
            return box
        end

        hexBox = mkBox(text.GlassHexLabel, "#101A2E", hexOf(curBg()), function(box)
            local h = box.Text:gsub("#", "")
            local n = (#h == 6) and tonumber(h, 16)
            if n then
                UX.SetGlassColor(Color3.fromRGB(math.floor(n / 65536) % 256, math.floor(n / 256) % 256, n % 256))
            end
            refresh()
        end)

        clarBox = mkBox(text.GlassClarityLabel, "0.58", string.format("%.2f", GCfg.density or 0.58), function(box)
            local v = tonumber(box.Text)
            if v then UX.SetGlassDensity(v) end
            box.Text = string.format("%.2f", GCfg.density or 0.58)
        end)

        -- Kính cầu vồng
        AddBtn(text.BtnGlassRainbow, function(state)
            UX.SetGlassRainbow(state)
            refresh()
        end, true, GCfg.rainbow)

        -- Preset màu
        local pg = Instance.new("Frame")
        pg.Size = UDim2.new(0, W, 0, 0)
        pg.AutomaticSize = Enum.AutomaticSize.Y
        pg.BackgroundTransparency = 1
        pg.Parent = ScrollList
        pg:SetAttribute("Label", text.GlassColor)
        local pgl = Instance.new("UIGridLayout", pg)
        pgl.CellSize = UDim2.new(0, 56, 0, 24)
        pgl.CellPadding = UDim2.new(0, 4, 0, 4)
        pgl.SortOrder = Enum.SortOrder.LayoutOrder
        for i, pr in ipairs(PRESETS) do
            local b = Instance.new("TextButton")
            b.LayoutOrder = i
            b.Text = pr[1]
            b.AutoButtonColor = false
            b.BackgroundColor3 = pr[2]
            b.BackgroundTransparency = 0.1
            b.BorderSizePixel = 0
            local _, _, v = pr[2]:ToHSV()
            b.TextColor3 = v > 0.7 and Color3.fromRGB(20, 24, 36) or Color3.new(1, 1, 1)
            b.Font = Enum.Font.GothamBold
            b.TextSize = 9
            b.Parent = pg
            round(b, UDim.new(0, 7))
            b.Activated:Connect(function()
                UX.SetGlassColor(pr[2])
                refresh()
            end)
        end

        -- Đặt lại kính
        AddBtn(text.BtnGlassReset, function()
            UX.ResetGlass()
            LoadTag[15]()
        end, false)

        refresh()
    end

    -- Khởi động: nếu lần trước đang bật Kính lỏng thì bật lại
    if GCfg.rainbow then
        local base = GCfg.c and Color3.new(GCfg.c[1], GCfg.c[2], GCfg.c[3]) or DEF_BG
        local _, _, v = base:ToHSV()
        GS.rv = math.clamp(v, 0.28, 1)
    end
    if GCfg.on then
        GCfg.on = false
        UX.SetGlass(true)
    end
end
UX.InitGlass()
end

