UX.GlassOn = false

-- Danh sách màu chữ (mục 1 = mặc định gốc: trắng - hồng nhạt - trắng)
local TextColorList = {
    {name = "TextDefault",   c = TEXT_DEFAULT},
    {name = "ColorWhite",    c = Color3.fromRGB(255, 255, 255)},
    {name = "ColorRed",      c = Color3.fromRGB(255, 60, 60)},
    {name = "ColorGreenV2",  c = Color3.fromRGB(0, 255, 100)},
    {name = "ColorBlue",     c = Color3.fromRGB(60, 150, 255)},
    {name = "ColorCyan",     c = Color3.fromRGB(0, 255, 255)},
    {name = "ColorPurpleV2", c = Color3.fromRGB(190, 60, 255)},
    {name = "ColorMagenta",  c = Color3.fromRGB(255, 0, 255)},
    {name = "ColorYellow",   c = Color3.fromRGB(255, 255, 0)},
    {name = "ColorOrange",   c = Color3.fromRGB(255, 130, 0)},
    {name = "ColorPink",     c = Color3.fromRGB(255, 120, 180)},
    {name = "ColorGold",     c = Color3.fromRGB(255, 215, 0)},
    {name = "ColorMint",     c = Color3.fromRGB(152, 255, 152)},
    {name = "ColorSkyBlue",  c = Color3.fromRGB(135, 206, 235)},
    {name = "ColorLime",     c = Color3.fromRGB(191, 255, 0)},
    {name = "ColorLavender", c = Color3.fromRGB(230, 230, 250)},
    {name = "ColorGray",     c = Color3.fromRGB(170, 170, 170)},
}
local TextColorIdx = 1

-- Tải cài đặt đã lưu
pcall(function()
    if readfile and isfile and isfile(UIFile) then
        local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(UIFile)) end)
        if ok and type(dec) == "table" then
            if type(dec.alpha) == "table" then
                for k in pairs(UIA) do
                    local v = tonumber(dec.alpha[k])
                    if v then UIA[k] = math.clamp(v, 0, ALPHA_MAX) end
                end
            end
            local idx = tonumber(dec.textIdx)
            if idx and TextColorList[idx] then TextColorIdx = idx end
            if type(dec.glass) == "table" then
                local g, GC = dec.glass, UX.GCfg
                GC.on = g.on == true
                GC.rainbow = g.rainbow == true
                if type(g.c) == "table" and tonumber(g.c[1]) and tonumber(g.c[2]) and tonumber(g.c[3]) then
                    GC.c = {tonumber(g.c[1]), tonumber(g.c[2]), tonumber(g.c[3])}
                end
                if tonumber(g.density) then GC.density = math.clamp(tonumber(g.density), 0.1, 0.95) end
            end
        end
    end
end)

local function SaveUI()
    pcall(function()
        if writefile then
            writefile(UIFile, HttpService:JSONEncode({alpha = UIA, textIdx = TextColorIdx, glass = UX.GCfg}))
        end
    end)
end

-- Alpha thực tế của từng lớp (đã gộp với "Tổng thể")
local A = {Bg = 0, Btn = 0, Stroke = 0, Glow = 0, Text = 0}
local function RecalcAlpha()
    for k in pairs(A) do
        A[k] = math.min(1 - (1 - UIA.Master) * (1 - UIA[k]), ALPHA_MAX)
    end
end
RecalcAlpha()

Tr = function(kind, base)
    return base + (1 - base) * A[kind]
end

local WeakK = {__mode = "k"}
local Reg = {
    Bg = setmetatable({}, WeakK),      -- nền các khung
    Btn = setmetatable({}, WeakK),     -- nút / ô nhập
    Stroke = setmetatable({}, WeakK),  -- viền
    Text = setmetatable({}, WeakK),    -- chữ
}
local PropOf = {Bg = "BackgroundTransparency", Btn = "BackgroundTransparency", Stroke = "Transparency", Text = "TextTransparency"}

-- Sổ đăng ký cho Kính lỏng: màu/độ trong gốc, khung chính, gradient
UX.GOrig = setmetatable({}, WeakK)   -- obj -> {base, color} (gốc trước khi bật kính)
UX.GPanel = setmetatable({}, WeakK)  -- các khung lớn (header / sidebar / content ...)
UX.Grads = setmetatable({}, WeakK)   -- gradient -> {kind, owner, c, t}
UX.RegGrad = function(g, kind, owner)
    local info = {kind = kind, owner = owner, c = g.Color, t = g.Transparency}
    UX.Grads[g] = info
    if UX.GlassOn and UX.GlassGrad then UX.GlassGrad(g, info) end
end

Track = function(kind, obj, base)
    Reg[kind][obj] = base
    if UX.GlassOn and UX.GlassNewObj then UX.GlassNewObj(kind, obj) end
    obj[PropOf[kind]] = Tr(kind, Reg[kind][obj])
end

local function ApplyAlpha()
    RecalcAlpha()
    for kind, prop in pairs(PropOf) do
        local a = A[kind]
        local reg = Reg[kind]
        for obj, base in pairs(reg) do
            if obj.Parent then
                obj[prop] = base + (1 - base) * a
            else
                reg[obj] = nil
            end
        end
    end
end

local function SetStrokeBase(stroke, base)
    Reg.Stroke[stroke] = base
    stroke.Transparency = Tr("Stroke", base)
end

local function TweenStrokeTo(stroke, base, d)
    Reg.Stroke[stroke] = base
    TweenService:Create(stroke, TweenInfo.new(d or 0.14), {Transparency = Tr("Stroke", base)}):Play()
end

-- --- MÀU CHỮ ---
-- Mặc định giữ y hệt bản gốc (TextColor3 + gradient trắng - hồng - trắng).
-- Khi chọn màu: chữ chuyển sang gradient "màu chọn - màu chọn sáng hơn - màu chọn", vẫn có dải shine.
local WHITE = Color3.new(1, 1, 1)
local TEXT_GRAD_DEFAULT = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 120, 120)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255))
})
local TextReg = setmetatable({}, WeakK)   -- obj -> {def = màu gốc, grad = UIGradient hoặc nil}
local TextCustom, TextCustomSeq

local function paintText(obj, info)
    if TextCustom then
        if info.grad then
            obj.TextColor3 = WHITE
            info.grad.Color = TextCustomSeq
        else
            obj.TextColor3 = TextCustom
        end
    else
        obj.TextColor3 = info.def
        if info.grad then info.grad.Color = TEXT_GRAD_DEFAULT end
    end
end

local function TextBaseColor(obj)
    local info = TextReg[obj]
    if not info then return TEXT_DEFAULT end
    if TextCustom then return info.grad and WHITE or TextCustom end
    return info.def
end

local function RegisterText(obj, def, grad)
    local info = {def = def, grad = grad}
    TextReg[obj] = info
    Track("Text", obj, 0)
    paintText(obj, info)
end

local function SetTextColorIdx(idx)
    if not TextColorList[idx] then idx = 1 end
    TextColorIdx = idx
    if idx == 1 then
        TextCustom, TextCustomSeq = nil, nil
    else
        local c = TextColorList[idx].c
        local light = c:Lerp(WHITE, 0.55)
        TextCustom = c
        TextCustomSeq = ColorSequence.new({
            ColorSequenceKeypoint.new(0, c),
            ColorSequenceKeypoint.new(0.5, light),
            ColorSequenceKeypoint.new(1, c)
        })
    end
    for obj, info in pairs(TextReg) do
        if obj.Parent then paintText(obj, info) else TextReg[obj] = nil end
    end
end
SetTextColorIdx(TextColorIdx)

UX.Reg = Reg
UX.UIA = UIA
UX.ALPHA_MAX = ALPHA_MAX
UX.TextColorList = TextColorList
UX.GetTextIdx = function() return TextColorIdx end
UX.SaveUI = SaveUI
UX.ApplyAlpha = ApplyAlpha
UX.SetStrokeBase = SetStrokeBase
UX.TweenStrokeTo = TweenStrokeTo
UX.RegisterText = RegisterText
UX.TextBaseColor = TextBaseColor
UX.SetTextColorIdx = SetTextColorIdx
UX.TEXT_GRAD_DEFAULT = TEXT_GRAD_DEFAULT
end

