    local searchText = string.lower(SearchBox.Text)
    for _, item in pairs(ScrollList:GetChildren()) do
        local label = item:IsA("GuiObject") and item:GetAttribute("Label")
        if not label and item:IsA("Frame") then
            local b = item:FindFirstChildOfClass("TextButton")
