-- HỆ THỐNG RAW NHANH: tải sẵn + biên dịch sẵn, bấm nút là chạy ngay
-- ============================================================
local RawCache = {}   -- url -> mã nguồn đã tải
local RawFn = {}      -- url -> hàm đã biên dịch sẵn
local RawBusy = {}    -- url đang tải (tránh tải trùng)

local function P(id) return "https://pastefy.app/" .. id .. "/raw" end

local function GetRawFn(url)
    if RawFn[url] then return RawFn[url] end
    local src = RawCache[url]
    if not src then
        -- đang có luồng khác tải cùng url thì chờ nó xong
        if RawBusy[url] then
            local t0 = os.clock()
            while RawBusy[url] and os.clock() - t0 < 15 do task.wait() end
            if RawFn[url] then return RawFn[url] end
            src = RawCache[url]
        end
    end
    if not src then
        RawBusy[url] = true
        local ok, res = pcall(function() return game:HttpGet(url, true) end)
        RawBusy[url] = nil
        if ok and type(res) == "string" and #res > 0 then
            src = res
            RawCache[url] = res
        end
    end
    if not src then return nil end
    local fn = loadstring(src)
    if fn then RawFn[url] = fn end
    return fn
end

-- Chạy 1 raw: đã tải sẵn thì chạy NGAY, chưa có thì tải rồi chạy (không làm đứng giao diện)
local function RunRaw(url)
    local fn = RawFn[url]
    if fn then
        task.spawn(fn)
        return
    end
    task.spawn(function()
        local f = GetRawFn(url)
        if f then
            f()
        else
            SendRobloxNotification("Dua2dev Hub", "Không tải được script, thử lại!", 2)
        end
    end)
end

