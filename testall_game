do
    -- Gom Tag 15/16 + thanh trượt + Kính lỏng vào 1 khối để không tốn biến local cấp cao nhất
    local UIA, ALPHA_MAX, ApplyAlpha, SaveUI, TextColorList = UX.UIA, UX.ALPHA_MAX, UX.ApplyAlpha, UX.SaveUI, UX.TextColorList

-- --- THANH TRƯỢT (chỉnh độ trong suốt) ---
-- kind: Master / Bg / Btn / Stroke / Glow / Text. Giá trị 0 -> ALPHA_MAX (90%).
local function AddSlider(labelText, kind)
    local rowW = ScrollList.AbsoluteSize.X
    if rowW < 50 then rowW = MAIN_W - 132 - 12 end
    local width = math.max(150, rowW - 14)

    local holder = Instance.new("Frame")
    holder.Name = "SliderHolder"
    holder.Size = UDim2.new(0, width, 0, 46)
    holder.BackgroundColor3 = PANEL_2
    holder.BorderSizePixel = 0
    holder.Parent = ScrollList
    Track("Btn", holder, 0.02)
    holder:SetAttribute("Label", labelText)
    round(holder, UDim.new(0, 14))
    themed(addStroke(holder, 1, 0.62, ACCENT))

    local lbl = Instance.new("TextLabel")
    lbl.BackgroundTransparency = 1
    lbl.Position = UDim2.new(0, 12, 0, 5)
    lbl.Size = UDim2.new(1, -70, 0, 16)
    lbl.Text = labelText
    lbl.Font = Enum.Font.GothamSemibold
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextTruncate = Enum.TextTruncate.AtEnd
    lbl.Parent = holder
    styleText(lbl)

    local pct = Instance.new("TextLabel")
    pct.BackgroundTransparency = 1
    pct.Position = UDim2.new(1, -58, 0, 5)
    pct.Size = UDim2.new(0, 46, 0, 16)
    pct.Font = Enum.Font.GothamBold
    pct.TextSize = 12
    pct.TextXAlignment = Enum.TextXAlignment.Right
    pct.Parent = holder
    styleText(pct)

    local track = Instance.new("Frame")
    track.Position = UDim2.new(0, 14, 0, 31)
    track.Size = UDim2.new(1, -28, 0, 6)
    track.BackgroundColor3 = Color3.fromRGB(38, 38, 44)
    track.BorderSizePixel = 0
    track.Parent = holder
    round(track, UDim.new(1, 0))

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel = 0
    fill.Parent = track
    round(fill, UDim.new(1, 0))
    RegisterDot(fill) -- đổi màu theo giao diện

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0
    knob.ZIndex = 2
    knob.Parent = track
    round(knob, UDim.new(1, 0))

    local function render()
        local v = UIA[kind] or 0
        local rel = math.clamp(v / ALPHA_MAX, 0, 1)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        knob.Position = UDim2.new(rel, 0, 0.5, 0)
        pct.Text = math.floor(v * 100 + 0.5) .. "%"
    end
    render()

    local function setFromX(x)
        local w = track.AbsoluteSize.X
        if w <= 0 then return end
        local rel = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
        UIA[kind] = math.floor(rel * ALPHA_MAX * 100 + 0.5) / 100
        render()
        ApplyAlpha()
    end

    -- vùng bấm rộng hơn thanh để dễ kéo trên điện thoại
    local hit = Instance.new("TextButton")
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false
    hit.Position = UDim2.new(0, 6, 0, 22)
    hit.Size = UDim2.new(1, -12, 0, 24)
    hit.ZIndex = 3
    hit.Parent = holder

    local dragging = false
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            ScrollList.ScrollingEnabled = false
            setFromX(input.Position.X)
        end
    end)
    local c1 = UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            setFromX(input.Position.X)
        end
    end)
    local c2 = UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            ScrollList.ScrollingEnabled = true
            SaveUI()
        end
    end)
    holder.AncestryChanged:Connect(function()
        if not holder.Parent then
            c1:Disconnect()
            c2:Disconnect()
            ScrollList.ScrollingEnabled = true
        end
    end)

    return holder
end

