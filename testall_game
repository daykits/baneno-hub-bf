local ScriptFile = "Dua2devScript.json"

local function loadScriptData()
    local data = {scripts = {}}
    pcall(function()
        if readfile and isfile and isfile(ScriptFile) then
            local ok, dec = pcall(function() return HttpService:JSONDecode(readfile(ScriptFile)) end)
            if ok and type(dec) == "table" then
                data = dec
                if type(data.scripts) ~= "table" then data.scripts = {} end
            end
        end
    end)
    return data
end

local customScriptsData = loadScriptData()

local function saveCustomScripts()
    pcall(function()
        if writefile then
            writefile(ScriptFile, HttpService:JSONEncode(customScriptsData))
        end
    end)
end

local function runScriptEntry(entry)
    if type(entry) == "function" then
        pcall(entry)
        return
    end
    if type(entry) == "string" then
        if loadstring then
            local chunk = loadstring(entry)
            if chunk then
                local ok, ret = pcall(chunk)
                if ok and type(ret) == "function" then
                    pcall(ret)
                end
                return
            end
            local wrapper = loadstring("return function()\n" .. entry .. "\nend")
            if wrapper then
                local ok2, f = pcall(wrapper)
                if ok2 and type(f) == "function" then
                    pcall(f)
                end
            end
        end
    end
end

