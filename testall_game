do
-- ============================================================
-- CÀI ĐẶT GIAO DIỆN: độ trong suốt từng lớp màu + màu chữ + Kính lỏng
-- Mọi đối tượng đăng ký vào bảng yếu (weak) nên nút bị xoá là tự dọn.
-- Công thức: trong suốt thật = gốc + (1 - gốc) * alpha  (alpha = 0 -> y hệt bản gốc)
-- ============================================================
local UIFile = "Dua2devUI.json"
local ALPHA_MAX = 0.9  -- tối đa 90% để giao diện không biến mất hoàn toàn
local UIA = {Master = 0, Bg = 0, Btn = 0, Stroke = 0, Glow = 0, Text = 0}
