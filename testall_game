-- ============================================================
-- VÒNG LẶP DUY NHẤT cho toàn bộ hiệu ứng (thay cho 3 vòng riêng trước đây):
--   (1) màu giao diện (viền + chấm)  - chỉ ghi khi màu đổi, cầu vồng thì mỗi khung hình
--   (2) màu bầu trời cầu vồng
--   (3) nhịp sáng (glow) + xoay gradient các khung + SHINE chữ tiêu đề + nhịp Kính lỏng
--       (30 lần/giây, tự nghỉ khi menu đóng)
-- Gradient được lấy sẵn 1 lần, không còn FindFirstChildOfClass / tick() cho từng đối tượng mỗi nhịp.
-- ============================================================
do
    local panelGrads = {}
    for _, obj in ipairs({ frame, header, leftSidebar, contentPanel }) do
        local g = obj:FindFirstChildOfClass("UIGradient")
        if g then table.insert(panelGrads, g) end
    end
    local logoGrad = toggleBack:FindFirstChildOfClass("UIGradient")
    local titleGrad = TitleMenu:FindFirstChildOfClass("UIGradient")
    local glowObjs = {
        { frameGlow, 0.95 },
        { headerGlow, 0.94 },
        { leftGlow, 0.95 },
        { contentGlow, 0.95 },
    }

    local themeHue, skyHue = 0, 0
    local acc = 0
    local STEP = 1 / 30

    local conn
    conn = RunService.Heartbeat:Connect(function(dt)
        if not ScreenGui.Parent then
            conn:Disconnect()
            return
        end

        -- (1) Màu giao diện
        local cfg = RainbowModes[_G.ThemeMode]
        local color
        if cfg then
            themeHue = (themeHue + cfg[1] * dt * 60) % 1
            color = cfg[2](themeHue)
        else
            color = _G.StaticColor
        end
        if cfg or color ~= CurrentThemeColor then
            CurrentThemeColor = color

            for i = #RegistryUIStrokes, 1, -1 do
                local stroke = RegistryUIStrokes[i]
                if stroke and stroke.Parent then stroke.Color = color else table.remove(RegistryUIStrokes, i) end
            end

            for i = #RegistryThemeDots, 1, -1 do
                local dot = RegistryThemeDots[i]
                if dot and dot.Parent then
                    local c = color
                    if dot:GetAttribute("IsActiveToggle") == true then
                        c = ACTIVE_GREEN
                    end
                    dot.BackgroundColor3 = c
                    -- Vòng sáng quanh chấm tròn (nếu có)
                    local glow = DotGlow[dot]
                    if glow then glow.Color = c end
                else
                    table.remove(RegistryThemeDots, i)
                end
            end
        end

        -- (2) Màu bầu trời cầu vồng (có hue riêng, nhường quyền khi Disco bật để tránh tranh chấp Lighting)
        local skyCfg = RainbowModes[_G.SkyMode]
        if skyCfg and not DiscoActive then
            skyHue = (skyHue + skyCfg[1] * dt * 60) % 1
            local c = skyCfg[2](skyHue)
            Lighting.OutdoorAmbient = c
            Lighting.Ambient = c
            Lighting.FogColor = c
        end

        -- (3) Nhịp sáng + xoay gradient + shine chữ (giới hạn 30 lần/giây)
        acc += dt
        if acc < STEP then return end
        acc = 0

        local now = os.clock()
        local glow = 0.5 + math.sin(now * 0.8) * 0.5

        -- Nút logo (hiện cả khi menu đóng)
        if toggleBack.Visible then
            toggleBack.BackgroundTransparency = 0.56 - (glow * 0.13)
            if logoGrad then logoGrad.Rotation = (now * 20) % 360 end
        end

        if not frame.Visible then return end

        -- Nhịp Kính lỏng (cầu vồng kính + vệt sáng quét)
        if UX.GlassTick then UX.GlassTick(now) end

        -- Vòng sáng quanh các khung (theo thanh "Trong suốt: Phát sáng")
        for i = 1, #glowObjs do
            local item = glowObjs[i]
            item[1].BackgroundTransparency = Tr("Glow", item[2] - (glow * 0.04))
        end

        -- Xoay gradient các khung
        local rot = (now * 20) % 360
        for i = 1, #panelGrads do
            panelGrads[i].Rotation = rot
        end

        -- Shine chữ tiêu đề
        if titleGrad then titleGrad.Rotation = (now * 28) % 360 end
    end)
end

